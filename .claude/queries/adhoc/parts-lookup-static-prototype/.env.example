SITE_ID=
DRIVE_ID=
LIBRARY_BASE=https://spitractor.sharepoint.com/sites/SouthPlainsImplement-ReportSite/Test%20%20Part%20Availability

# Teams webhook for refresh-failure alerts (added 2026-08-26) - posts to the
# "Parts Availability App Alerts" channel. Optional: if unset, run_refresh.py
# just skips the notification (logged, not fatal) rather than erroring.
TEAMS_WEBHOOK_URL=

# Optional (2026-10): which table extract.py reads - lh | dp | dp-dev (default in config.py).
# PARTS_LOOKUP_SOURCE=dp
# Test runs: copy this file to .env.test with the STAGING library's DRIVE_ID, no TEAMS_WEBHOOK_URL and
# PARTS_LOOKUP_SOURCE=dp-dev, then run with PARTS_LOOKUP_ENV_FILE=.env.test.
