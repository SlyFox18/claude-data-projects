            pi_sales_history_35             AS SalesMonth35,
            pi_sales_history_36             AS SalesMonth36,
            pi_sales_history_37             AS SalesMonth37,
            pi_sales_history_38             AS SalesMonth38,
            pi_sales_history_39             AS SalesMonth39,
