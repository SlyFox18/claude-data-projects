{
  "env": {
    "ECC_DISABLED_HOOKS": "pre:observe,post:observe,post:quality-gate"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-pq-header.sh"
          }
        ]
      }
    ]
  }
}
