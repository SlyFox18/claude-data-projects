	partition dimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDARAUTO(),
				    "Year", YEAR( [Date] ),
				    "Quarter", FORMAT( [Date] , "\QQ"),
				    "QuarterNo", QUARTER( [Date] ),
				    "Month", FORMAT( [Date], "MMM" ),
				    "MonthNo", MONTH( [Date] ),
				    "Weekday", WEEKDAY( [Date] ),
				    "WeekdayNo", WEEKDAY( [Date] ),
				    "MonthYear", FORMAT(MONTH([Date]), "00") & " " & YEAR([Date]),
				    "Day", FORMAT(DAY( [Date] ), "DD")
				)

	annotation PBI_Id = 936ab3d0dfbe447d8f966c6faa723f91

