	column 'Order Count' =
			
			VAR _CurrentOrderNo = Parts_Open_Tickets[Order_No]
			RETURN
			COUNTROWS(FILTER(Parts_Open_Tickets, Parts_Open_Tickets[Order_No] =
			_CurrentOrderNo)
			)
		formatString: 0
		lineageTag: b8ddcbaf-b236-4c57-8d8b-857df5c24f38
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

