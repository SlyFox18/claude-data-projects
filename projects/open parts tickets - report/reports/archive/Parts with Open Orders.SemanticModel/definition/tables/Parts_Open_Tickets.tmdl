	column 'Aging Sort' =
			
			SWITCH(
			    TRUE(),
			    [Days_Open] >= 0 && [Days_Open] <= 7, 1,
			    [Days_Open] >= 8 && [Days_Open] <= 30, 2,
			    [Days_Open] >= 31 && [Days_Open] <= 60, 3,
			    [Days_Open] >= 61 && [Days_Open] <= 90, 4,
			    [Days_Open] > 90, 5,
			    6
			)
		formatString: 0
		lineageTag: 790f5296-b31e-4471-9bdd-96ce7bbfac1a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

