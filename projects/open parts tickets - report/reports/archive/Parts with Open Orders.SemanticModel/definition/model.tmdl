model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Parts_Open_Tickets","Dim_Branch","Parts_Open_Tickets_Details","Data Refresh"]

annotation PBI_ProTooling = ["Copilot","CopilotMeasureDescriptions","TMDLView_Desktop","DevMode"]

ref table Parts_Open_Tickets
ref table Dim_Branch
ref table MeasuresTable
ref table Parts_Open_Tickets_Details
ref table 'Data Refresh'
ref table 'TopN Selector'
ref table dimDate
ref table 'Model Measures'
ref table 'Model Columns'
ref table 'Model Tables'
ref table 'Model Relationship'
ref table 'Data Dictionary'

ref cultureInfo en-US

