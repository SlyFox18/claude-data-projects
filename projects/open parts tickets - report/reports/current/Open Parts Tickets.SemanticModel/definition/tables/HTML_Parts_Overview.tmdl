	partition HTML_Parts_Overview = calculated
		mode: import
		source = ```
				
				SUMMARIZE(
				    Fact_Parts_Open_Tickets,
				    Fact_Parts_Open_Tickets[Aging],
				    Fact_Parts_Open_Tickets[Aging_Sort_Order],
				    "Avg_Days_Open", AVERAGE(Fact_Parts_Open_Tickets[Days_Open]),
				    
				    -- Order Total Metrics
				    "Order_Total", SUM(Fact_Parts_Open_Tickets[Order_Total_$$]),
				    "Order_Total_Available", SUM(Fact_Parts_Open_Tickets[$$_Available]),
				    "Order_Total_BackOrdered", SUM(Fact_Parts_Open_Tickets[$$_BackOrdered]),
				    
				    -- Parts Count Metrics
				    "Parts_Total", SUM(Fact_Parts_Open_Tickets[#_Parts_On_Order]),
				    "Parts_Available", SUMX(
				        Fact_Parts_Open_Tickets,
				        [#_Parts_On_Order] - [#_On_Back_Order]
				    ),
				    "Parts_BackOrdered", SUM(Fact_Parts_Open_Tickets[#_On_Back_Order]),
				    
				    -- Lines Count Metrics (using detail table)
				    "Lines_Total", CALCULATE(
				        COUNT(Fact_Parts_Open_Tickets_Details[Part_No])
				    ),
				    "Lines_Available", CALCULATE(
				        COUNT(Fact_Parts_Open_Tickets_Details[Part_No]),
				        Fact_Parts_Open_Tickets_Details[BackOrdered_QTY] = 0 
				            || ISBLANK(Fact_Parts_Open_Tickets_Details[BackOrdered_QTY])
				    ),
				    "Lines_BackOrdered", CALCULATE(
				        COUNT(Fact_Parts_Open_Tickets_Details[Part_No]),
				        Fact_Parts_Open_Tickets_Details[BackOrdered_QTY] > 0
				    ),
				    
				    -- Orders Count Metrics
				    "Orders_Total", COUNTROWS(Fact_Parts_Open_Tickets),
				    "Orders_WithoutBO", CALCULATE(
				        COUNTROWS(Fact_Parts_Open_Tickets),
				        Fact_Parts_Open_Tickets[#_On_Back_Order] = 0 
				            || ISBLANK(Fact_Parts_Open_Tickets[#_On_Back_Order])
				    ),
				    "Orders_WithBO", CALCULATE(
				        COUNTROWS(Fact_Parts_Open_Tickets),
				        Fact_Parts_Open_Tickets[#_On_Back_Order] > 0
				    )
				)
				```

	annotation PBI_Id = f844eafcc2c0486784d5a8a03d524300

