			VAR PT = CALCULATE([# Parts On Order], Fact_Parts_Open_Tickets[Aging] = Lbl)
			VAR PA = CALCULATE([Parts Available], Fact_Parts_Open_Tickets[Aging] = Lbl)
			VAR PB = CALCULATE([# on Back Order], Fact_Parts_Open_Tickets[Aging] = Lbl)
			VAR LT = CALCULATE([Parts Line Count], Fact_Parts_Open_Tickets[Aging] = Lbl)
			VAR LA = CALCULATE([Lines Available], Fact_Parts_Open_Tickets[Aging] = Lbl)
			VAR LB = CALCULATE([Lines BackOrdered], Fact_Parts_Open_Tickets[Aging] = Lbl)
			VAR OrT = CALCULATE([Total # of Orders], Fact_Parts_Open_Tickets[Aging] = Lbl)
			VAR OrN = CALCULATE([Orders without BO], Fact_Parts_Open_Tickets[Aging] = Lbl)
			VAR OrB = CALCULATE([Orders with BO], Fact_Parts_Open_Tickets[Aging] = Lbl)
			VAR OPctA = DIVIDE(OA, OT, 0) * 100
			VAR OPctB = DIVIDE(OB, OT, 0) * 100
			VAR PPctA = DIVIDE(PA, PT, 0) * 100
			VAR PPctB = DIVIDE(PB, PT, 0) * 100
			VAR LPctA = DIVIDE(LA, LT, 0) * 100
			VAR LPctB = DIVIDE(LB, LT, 0) * 100
			VAR OrPctN = DIVIDE(OrN, OrT, 0) * 100
			VAR OrPctB = DIVIDE(OrB, OrT, 0) * 100
			RETURN "<div class='aging-bucket' style='border-left: 4px solid " & Clr & "; background: linear-gradient(to right, " & ClrLt & " 0%, #ffffff 3%);'><div class='bucket-header'><div class='bucket-title' style='color: " & Clr & ";'>" & Lbl & "</div><div class='bucket-avg'>Avg: " & FORMAT(_Avg, "0.0") & " days</div></div><div class='metrics-grid'><div class='metric-card'><div class='metric-value'>" & FORMAT(OT, "$#,##0") & "</div><div class='metric-label'>Order Total</div><div class='metric-sublabel'>Not Backordered vs. Backordered</div><div class='bar-labels'><span>" & FORMAT(OA, "$#,##0") & "</span><span>" & FORMAT(OB, "$#,##0") & "</span></div><div class='comparison-bar'><div class='bar-segment bar-good' style='width: " & OPctA & "%;'>" & IF(OPctA > 15, FORMAT(OPctA/100, "0%"), "") & "</div><div class='bar-segment " & IF(OPctB > 10, "bar-warning", "bar-neutral") & "' style='width: " & OPctB & "%;'>" & IF(OPctB > 15, FORMAT(OPctB/100, "0%"), "") & "</div></div></div><div class='metric-card'><div class='metric-value'>" & FORMAT(PT, "#,##0") & "</div><div class='metric-label'># Parts on Order</div><div class='metric-sublabel'>Not Backordered vs. Backordered (Parts)</div><div class='bar-labels'><span>" & FORMAT(PA, "#,##0") & "</span><span>" & FORMAT(PB, "#,##0") & "</span></div><div class='comparison-bar'><div class='bar-segment bar-good' style='width: " & PPctA & "%;'>" & IF(PPctA > 15, FORMAT(PPctA/100, "0%"), "") & "</div><div class='bar-segment " & IF(PPctB > 10, "bar-warning", "bar-neutral") & "' style='width: " & PPctB & "%;'>" & IF(PPctB > 15, FORMAT(PPctB/100, "0%"), "") & "</div></div></div><div class='metric-card'><div class='metric-value'>" & FORMAT(LT, "#,##0") & "</div><div class='metric-label'>Parts Line Count</div><div class='metric-sublabel'>Not Backordered vs. Backordered (Lines)</div><div class='bar-labels'><span>" & FORMAT(LA, "#,##0") & "</span><span>" & FORMAT(LB, "#,##0") & "</span></div><div class='comparison-bar'><div class='bar-segment bar-good' style='width: " & LPctA & "%;'>" & IF(LPctA > 15, FORMAT(LPctA/100, "0%"), "") & "</div><div class='bar-segment " & IF(LPctB > 10, "bar-warning", "bar-neutral") & "' style='width: " & LPctB & "%;'>" & IF(LPctB > 15, FORMAT(LPctB/100, "0%"), "") & "</div></div></div><div class='metric-card'><div class='metric-value'>" & FORMAT(OrT, "#,##0") & "</div><div class='metric-label'>Total # of Orders</div><div class='metric-sublabel'>Orders without BO Part vs. with BO Part</div><div class='bar-labels'><span>" & FORMAT(OrN, "#,##0") & "</span><span>" & FORMAT(OrB, "#,##0") & "</span></div><div class='comparison-bar'><div class='bar-segment bar-good' style='width: " & OrPctN & "%;'>" & IF(OrPctN > 15, FORMAT(OrPctN/100, "0%"), "") & "</div><div class='bar-segment " & IF(OrPctB > 10, "bar-warning", "bar-neutral") & "' style='width: " & OrPctB & "%;'>" & IF(OrPctB > 15, FORMAT(OrPctB/100, "0%"), "") & "</div></div></div></div></div>"
		displayFolder: Core Metrics
		lineageTag: 40666d0a-2245-4032-8a09-add262662c42

	measure _HTML_Bucket5 =
			
