	measure 'KPI SVG - Parts On Order vs Back Order (Modern)' = ```
			
			-- ============================================================
			-- VALUES & CALCULATIONS
			-- ============================================================
			VAR TotalParts = [# Parts On Order]
			VAR BackOrderParts = [# on Back Order]
			VAR NotBackOrderParts = TotalParts - BackOrderParts
			
			VAR pct_BackOrder = DIVIDE(BackOrderParts, TotalParts, 0)
			VAR pct_NotBackOrder = DIVIDE(NotBackOrderParts, TotalParts, 0)
			
			-- ============================================================
			-- DIMENSIONS & LAYOUT
			-- ============================================================
			VAR BarWidth = 320
			VAR BarHeight = 26          // Slightly taller for better presence
			VAR SVG_Height = 68
			VAR BarCornerRadius = 4     // Rounded corners
			
			-- ============================================================
			-- COLOR SCHEME (Modern, Sophisticated)
			-- ============================================================
			VAR NotBO_Color = "#4A5B73"           // Deep slate blue
			VAR NotBO_Color_Dark = "#3d4d5f"      // Darker shade for gradient
			VAR BO_Color = IF(pct_BackOrder > 0.1, "#D45353", "#808080")
			VAR BO_Color_Dark = IF(pct_BackOrder > 0.1, "#b93f3f", "#6b6b6b")
			
			VAR LabelColor = "#2c3e50"            // Dark charcoal for text
			VAR PercentColor = "#FFFFFF"          // White for bar percentages
			
			-- ============================================================
			-- FORMATTING
			-- ============================================================
			VAR TitleText = "Not Backordered vs. Backordered (Parts)"
			VAR NotBO_Label = FORMAT(NotBackOrderParts, "#,0")
			VAR BO_Label = FORMAT(BackOrderParts, "#,0")
			VAR NotBO_Percent = FORMAT(pct_NotBackOrder, "0%")
			VAR BO_Percent = FORMAT(pct_BackOrder, "0%")
			
			-- ============================================================
			-- POSITIONING
			-- ============================================================
			VAR Title_Y = 14
			VAR Labels_Y = 32
			VAR Bar_Y = 40
			VAR PercentLabel_Y = Bar_Y + (BarHeight / 2) + 6
			
			VAR NotBO_Width = ROUND(pct_NotBackOrder * BarWidth, 0)
			VAR BO_Width = BarWidth - NotBO_Width
			
			VAR NotBO_Percent_X = NotBO_Width / 2
			VAR BO_Percent_X = NotBO_Width + (BO_Width / 2)
			
			-- ============================================================
			-- SVG GENERATION (Modern Styled)
			-- ============================================================
			VAR SVG =
			    "<svg width='" & BarWidth & "' height='" & SVG_Height & "' xmlns='http://www.w3.org/2000/svg'>" &
			        
			        // ===== GRADIENTS & FILTERS (Add depth) =====
			        "<defs>" &
			            // Not Backordered gradient
			            "<linearGradient id='notBOGrad' x1='0%' y1='0%' x2='0%' y2='100%'>" &
			                "<stop offset='0%' style='stop-color:" & NotBO_Color & ";stop-opacity:1' />" &
			                "<stop offset='100%' style='stop-color:" & NotBO_Color_Dark & ";stop-opacity:1' />" &
			            "</linearGradient>" &
			            // Backordered gradient
			            "<linearGradient id='boGrad' x1='0%' y1='0%' x2='0%' y2='100%'>" &
			                "<stop offset='0%' style='stop-color:" & BO_Color & ";stop-opacity:1' />" &
			                "<stop offset='100%' style='stop-color:" & BO_Color_Dark & ";stop-opacity:1' />" &
			            "</linearGradient>" &
			            // Subtle shadow
			            "<filter id='shadow' x='-20%' y='-20%' width='140%' height='140%'>" &
			                "<feGaussianBlur in='SourceAlpha' stdDeviation='1'/>" &
			                "<feOffset dx='0' dy='1' result='offsetblur'/>" &
			                "<feComponentTransfer><feFuncA type='linear' slope='0.2'/></feComponentTransfer>" &
			                "<feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>" &
			            "</filter>" &
			        "</defs>" &
			        
			        // ===== TITLE =====
			        "<text x='" & (BarWidth / 2) & "' y='" & Title_Y & "' " &
			              "text-anchor='middle' font-size='12' fill='" & LabelColor & "' " &
			              "font-family='Segoe UI, Arial' font-weight='600'>" &
			            TitleText &
			        "</text>" &
			        
			        // ===== COUNT LABELS =====
			        "<text x='12' y='" & Labels_Y & "' " &
			              "text-anchor='start' font-size='11' fill='" & LabelColor & "' " &
			              "font-family='Segoe UI, Arial' font-weight='600'>" &
			            NotBO_Label &
			        "</text>" &
			        "<text x='" & (BarWidth - 12) & "' y='" & Labels_Y & "' " &
			              "text-anchor='end' font-size='11' fill='" & LabelColor & "' " &
			              "font-family='Segoe UI, Arial' font-weight='600'>" &
			            BO_Label &
			        "</text>" &
			        
			        // ===== BAR CONTAINER WITH SHADOW =====
			        "<g filter='url(#shadow)'>" &
			            // Not Backordered segment (with gradient & rounded left corners)
			            "<rect x='0' y='" & Bar_Y & "' width='" & NotBO_Width & "' height='" & BarHeight & "' " &
			                  "fill='url(#notBOGrad)' " &
			                  "rx='" & BarCornerRadius & "' ry='" & BarCornerRadius & "'/>" &
			            // Cover right corners if BO segment exists
			            IF(BO_Width > 0, 
			                "<rect x='" & (NotBO_Width - BarCornerRadius) & "' y='" & Bar_Y & "' " &
			                      "width='" & BarCornerRadius & "' height='" & BarHeight & "' " &
			                      "fill='url(#notBOGrad)' />", 
			                ""
			            ) &
			            // Backordered segment (with gradient & rounded right corners)
			            IF(BO_Width > 0,
			                "<rect x='" & NotBO_Width & "' y='" & Bar_Y & "' width='" & BO_Width & "' height='" & BarHeight & "' " &
			                      "fill='url(#boGrad)' " &
			                      "rx='" & BarCornerRadius & "' ry='" & BarCornerRadius & "'/>" &
			                // Cover left corners
			                "<rect x='" & NotBO_Width & "' y='" & Bar_Y & "' " &
			                      "width='" & BarCornerRadius & "' height='" & BarHeight & "' " &
			                      "fill='url(#boGrad)' />",
			                ""
			            ) &
			        "</g>" &
			        
			        // ===== PERCENTAGE LABELS =====
			        IF(NotBO_Width > 40,  // Only show if segment is wide enough
			            "<text x='" & NotBO_Percent_X & "' y='" & PercentLabel_Y & "' " &
			                  "text-anchor='middle' font-size='14' fill='" & PercentColor & "' " &
			                  "font-family='Segoe UI, Arial' font-weight='700'>" &
			                NotBO_Percent &
			            "</text>",
			            ""
			        ) &
			        IF(BO_Width > 40,  // Only show if segment is wide enough
			            "<text x='" & BO_Percent_X & "' y='" & PercentLabel_Y & "' " &
			                  "text-anchor='middle' font-size='14' fill='" & PercentColor & "' " &
			                  "font-family='Segoe UI, Arial' font-weight='700'>" &
			                BO_Percent &
			            "</text>",
			            ""
			        ) &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & SVG
			```
