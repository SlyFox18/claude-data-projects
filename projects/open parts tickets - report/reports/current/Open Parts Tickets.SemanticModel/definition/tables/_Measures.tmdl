	measure 'KPI SVG - Order Total vs Backordered (Modern)' = ```
			
			-- ============================================================
			-- VALUES & CALCULATIONS
			-- ============================================================
			VAR TotalOrderValue = [Order Total]
			VAR BackorderedValue = SUM(Fact_Parts_Open_Tickets[$$_BackOrdered])
			VAR AvailableValue = SUM(Fact_Parts_Open_Tickets[$$_Available])
			
			VAR pct_Backordered = DIVIDE(BackorderedValue, TotalOrderValue, 0)
			VAR pct_Available = DIVIDE(AvailableValue, TotalOrderValue, 0)
			
			-- ============================================================
			-- DIMENSIONS & LAYOUT
			-- ============================================================
			VAR BarWidth = 320
			VAR BarHeight = 26
			VAR SVG_Height = 68
			VAR BarCornerRadius = 4
			
			-- ============================================================
			-- COLOR SCHEME (Modern, Sophisticated)
			-- ============================================================
			VAR Available_Color = "#4A5B73"
			VAR Available_Color_Dark = "#3d4d5f"
			VAR BO_Color = IF(pct_Backordered > 0.1, "#D45353", "#808080")
			VAR BO_Color_Dark = IF(pct_Backordered > 0.1, "#b93f3f", "#6b6b6b")
			
			VAR LabelColor = "#2c3e50"
			VAR PercentColor = "#FFFFFF"
			
			-- ============================================================
			-- FORMATTING
			-- ============================================================
			VAR TitleText = "Not Backordered vs. Backordered"
			VAR Available_Label = FORMAT(AvailableValue, "$#,0")
			VAR BO_Label = FORMAT(BackorderedValue, "$#,0")
			VAR Available_Percent = FORMAT(pct_Available, "0%")
			VAR BO_Percent = FORMAT(pct_Backordered, "0%")
			
			-- ============================================================
			-- POSITIONING
			-- ============================================================
			VAR Title_Y = 14
			VAR Labels_Y = 32
			VAR Bar_Y = 40
			VAR PercentLabel_Y = Bar_Y + (BarHeight / 2) + 6
			
			VAR Available_Width = ROUND(pct_Available * BarWidth, 0)
			VAR BO_Width = BarWidth - Available_Width
			
			VAR Available_Percent_X = Available_Width / 2
			VAR BO_Percent_X = Available_Width + (BO_Width / 2)
			
			-- ============================================================
			-- SVG GENERATION (Modern Styled)
			-- ============================================================
			VAR SVG =
			    "<svg width='" & BarWidth & "' height='" & SVG_Height & "' xmlns='http://www.w3.org/2000/svg'>" &
			        
			        // ===== GRADIENTS & FILTERS =====
			        "<defs>" &
			            "<linearGradient id='availGrad' x1='0%' y1='0%' x2='0%' y2='100%'>" &
			                "<stop offset='0%' style='stop-color:" & Available_Color & ";stop-opacity:1' />" &
			                "<stop offset='100%' style='stop-color:" & Available_Color_Dark & ";stop-opacity:1' />" &
			            "</linearGradient>" &
			            "<linearGradient id='boGrad' x1='0%' y1='0%' x2='0%' y2='100%'>" &
			                "<stop offset='0%' style='stop-color:" & BO_Color & ";stop-opacity:1' />" &
			                "<stop offset='100%' style='stop-color:" & BO_Color_Dark & ";stop-opacity:1' />" &
			            "</linearGradient>" &
			            "<filter id='shadow' x='-20%' y='-20%' width='140%' height='140%'>" &
			                "<feGaussianBlur in='SourceAlpha' stdDeviation='1'/>" &
			                "<feOffset dx='0' dy='1' result='offsetblur'/>" &
			                "<feComponentTransfer><feFuncA type='linear' slope='0.2'/></feComponentTransfer>" &
			                "<feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>" &
			            "</filter>" &
			        "</defs>" &
			        
			        // ===== TITLE =====
			        "<text x='" & (BarWidth / 2) & "' y='" & Title_Y & "' " &
			              "text-anchor='middle' font-size='12' fill='" & LabelColor & "' " &
			              "font-family='Segoe UI, Arial' font-weight='600'>" &
			            TitleText &
			        "</text>" &
			        
			        // ===== DOLLAR LABELS =====
			        "<text x='12' y='" & Labels_Y & "' " &
			              "text-anchor='start' font-size='11' fill='" & LabelColor & "' " &
			              "font-family='Segoe UI, Arial' font-weight='600'>" &
			            Available_Label &
			        "</text>" &
			        "<text x='" & (BarWidth - 12) & "' y='" & Labels_Y & "' " &
			              "text-anchor='end' font-size='11' fill='" & LabelColor & "' " &
			              "font-family='Segoe UI, Arial' font-weight='600'>" &
			            BO_Label &
			        "</text>" &
			        
			        // ===== BAR CONTAINER WITH SHADOW =====
			        "<g filter='url(#shadow)'>" &
			            "<rect x='0' y='" & Bar_Y & "' width='" & Available_Width & "' height='" & BarHeight & "' " &
			                  "fill='url(#availGrad)' " &
			                  "rx='" & BarCornerRadius & "' ry='" & BarCornerRadius & "'/>" &
			            IF(BO_Width > 0, 
			                "<rect x='" & (Available_Width - BarCornerRadius) & "' y='" & Bar_Y & "' " &
			                      "width='" & BarCornerRadius & "' height='" & BarHeight & "' " &
			                      "fill='url(#availGrad)' />", 
			                ""
			            ) &
			            IF(BO_Width > 0,
			                "<rect x='" & Available_Width & "' y='" & Bar_Y & "' width='" & BO_Width & "' height='" & BarHeight & "' " &
			                      "fill='url(#boGrad)' " &
			                      "rx='" & BarCornerRadius & "' ry='" & BarCornerRadius & "'/>" &
			                "<rect x='" & Available_Width & "' y='" & Bar_Y & "' " &
			                      "width='" & BarCornerRadius & "' height='" & BarHeight & "' " &
			                      "fill='url(#boGrad)' />",
			                ""
			            ) &
			        "</g>" &
			        
			        // ===== PERCENTAGE LABELS =====
			        IF(Available_Width > 40,
			            "<text x='" & Available_Percent_X & "' y='" & PercentLabel_Y & "' " &
			                  "text-anchor='middle' font-size='14' fill='" & PercentColor & "' " &
			                  "font-family='Segoe UI, Arial' font-weight='700'>" &
			                Available_Percent &
			            "</text>",
			            ""
			        ) &
			        IF(BO_Width > 40,
			            "<text x='" & BO_Percent_X & "' y='" & PercentLabel_Y & "' " &
			                  "text-anchor='middle' font-size='14' fill='" & PercentColor & "' " &
			                  "font-family='Segoe UI, Arial' font-weight='700'>" &
			                BO_Percent &
			            "</text>",
			            ""
			        ) &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & SVG
			```
