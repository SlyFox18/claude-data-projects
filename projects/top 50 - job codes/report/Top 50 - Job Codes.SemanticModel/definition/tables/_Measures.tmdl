		lineageTag: d43cca60-2230-4454-b37d-fead8cbdd43e

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Range Description' =
			
			VAR _Start = [Selected Range Start]
			VAR _End = [Selected Range End]
			RETURN
			    IF(
			        _Start = 1,
			        "Top " & _End & " Job Codes",
			        "Job Codes Ranked " & _Start & " to " & _End
			    )
		displayFolder: Display Measures
		lineageTag: f620a421-fc91-46b9-80ec-5194fa3ac427

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Transactions - Custom Period' = ```
			
			VAR SelectedPeriod = SELECTEDVALUE(PeriodType_Parameter[Period Type], "Last Month")
			VAR SelectedYear = SELECTEDVALUE(Dim_DateTable[Year], YEAR(TODAY()))
			VAR SelectedMonth = SELECTEDVALUE(Dim_DateTable[Month], MONTH(TODAY()))
			VAR SelectedQuarter = SELECTEDVALUE(Dim_DateTable[Quarter], QUARTER(TODAY()))
			
			VAR Result = 
			    SWITCH(
			        SelectedPeriod,
			        "Last Month", 
			            CALCULATE(
			                COUNTROWS(Fact_Top_JobCode_Analysis),
			                Dim_DateTable[IsPreviousMonth] = TRUE
			            ),
			        "Last Quarter",
			            CALCULATE(
			                COUNTROWS(Fact_Top_JobCode_Analysis),
			                Dim_DateTable[IsPreviousQuarter] = TRUE
			            ),
			        "This Quarter",
			            CALCULATE(
			                COUNTROWS(Fact_Top_JobCode_Analysis),
			                Dim_DateTable[IsCurrentYear] = TRUE,
			                Dim_DateTable[Quarter] = QUARTER(TODAY())
			            ),
			        "Year to Date",
			            CALCULATE(
			                COUNTROWS(Fact_Top_JobCode_Analysis),
			                Dim_DateTable[IsYearToDate] = TRUE
			            ),
			        "Last 30 Days",
			            CALCULATE(
			                COUNTROWS(Fact_Top_JobCode_Analysis),
			                Dim_DateTable[IsLast30Days] = TRUE
			            ),
			        "Last 60 Days",
			            CALCULATE(
			                COUNTROWS(Fact_Top_JobCode_Analysis),
			                Dim_DateTable[IsLast60Days] = TRUE
			            ),
			        "Last 90 Days",
			            CALCULATE(
			                COUNTROWS(Fact_Top_JobCode_Analysis),
			                Dim_DateTable[IsLast90Days] = TRUE
			            ),
			        "Custom Month",
			            CALCULATE(
			                COUNTROWS(Fact_Top_JobCode_Analysis),
			                Dim_DateTable[Year] = SelectedYear,
			                Dim_DateTable[Month] = SelectedMonth
			            ),
			        "Custom Quarter",
			            CALCULATE(
			                COUNTROWS(Fact_Top_JobCode_Analysis),
			                Dim_DateTable[Year] = SelectedYear,
			                Dim_DateTable[Quarter] = SelectedQuarter
			            ),
			        "Custom Date Range",
			            COUNTROWS(Fact_Top_JobCode_Analysis),  // Will use date slicer
			        BLANK()
			    )
			
			RETURN Result
			```
		formatString: 0
		displayFolder: Volume Metrics\Custom Period
		lineageTag: 350f3f7f-282d-461a-9612-8ffa3ec29cf0

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Avg InvLabor - Custom Period' = ```
			
			VAR SelectedPeriod = SELECTEDVALUE(PeriodType_Parameter[Period Type], "Last Month")
			VAR SelectedYear = SELECTEDVALUE(Dim_DateTable[Year], YEAR(TODAY()))
			VAR SelectedMonth = SELECTEDVALUE(Dim_DateTable[Month], MONTH(TODAY()))
			VAR SelectedQuarter = SELECTEDVALUE(Dim_DateTable[Quarter], QUARTER(TODAY()))
			VAR Result = 
			    SWITCH(
			        SelectedPeriod,
			        "Last Month", CALCULATE(AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]), Dim_DateTable[IsPreviousMonth] = TRUE),
			        "Last Quarter", CALCULATE(AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]), Dim_DateTable[IsPreviousQuarter] = TRUE),
			        "This Quarter", CALCULATE(AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]), Dim_DateTable[IsCurrentYear] = TRUE, Dim_DateTable[Quarter] = QUARTER(TODAY())),
			        "Year to Date", CALCULATE(AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]), Dim_DateTable[IsYearToDate] = TRUE),
			        "Last 30 Days", CALCULATE(AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]), Dim_DateTable[IsLast30Days] = TRUE),
			        "Last 60 Days", CALCULATE(AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]), Dim_DateTable[IsLast60Days] = TRUE),
			        "Last 90 Days", CALCULATE(AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]), Dim_DateTable[IsLast90Days] = TRUE),
			        "Custom Month", CALCULATE(AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]), Dim_DateTable[Year] = SelectedYear, Dim_DateTable[Month] = SelectedMonth),
			        "Custom Quarter", CALCULATE(AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]), Dim_DateTable[Year] = SelectedYear, Dim_DateTable[Quarter] = SelectedQuarter),
			        "Custom Date Range", AVERAGE(Fact_Top_JobCode_Analysis[InvLabor]),
			        BLANK()
			    )
			RETURN Result
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Labor Averages\Custom Period
		lineageTag: 5bd9cf03-e812-485c-bbf7-77c56e5569b7

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg EstLabor - Custom Period' = ```
			
			VAR SelectedPeriod = SELECTEDVALUE(PeriodType_Parameter[Period Type], "Last Month")
			VAR SelectedYear = SELECTEDVALUE(Dim_DateTable[Year], YEAR(TODAY()))
			VAR SelectedMonth = SELECTEDVALUE(Dim_DateTable[Month], MONTH(TODAY()))
			VAR SelectedQuarter = SELECTEDVALUE(Dim_DateTable[Quarter], QUARTER(TODAY()))
			VAR Result = 
