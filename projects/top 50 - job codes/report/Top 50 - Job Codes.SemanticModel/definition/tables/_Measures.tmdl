	measure 'Custom Period Page Title' = ```
			
			VAR SelectedPeriod = SELECTEDVALUE(PeriodType_Parameter[Period Type], "Last Month")
			VAR SelectedYear = SELECTEDVALUE(Dim_DateTable[Year], YEAR(TODAY()))
			VAR SelectedMonth = SELECTEDVALUE(Dim_DateTable[Month], MONTH(TODAY()))
			VAR SelectedQuarter = SELECTEDVALUE(Dim_DateTable[Quarter], QUARTER(TODAY()))
			VAR MonthName = FORMAT(DATE(SelectedYear, SelectedMonth, 1), "MMMM")
			
			VAR Title = 
			    SWITCH(
			        SelectedPeriod,
			        "Last Month", "Last Month",
			        "Last Quarter", "Last Quarter",
			        "This Quarter", "This Quarter",
			        "Year to Date", "Year to Date",
			        "Last 30 Days", "Last 30 Days",
			        "Last 60 Days", "Last 60 Days",
			        "Last 90 Days", "Last 90 Days",
			        "Custom Month", MonthName & " " & SelectedYear,
			        "Custom Quarter", "Q" & SelectedQuarter & " " & SelectedYear,
			        "Custom Date Range", "Custom Date Range",
			        "Period Not Selected"
			    )
			
			RETURN "Top Job Codes - " & Title
			```
		displayFolder: Display Measures\Custom Period
		lineageTag: 37ef8c70-1766-408c-99cc-19c4ea45b8a1

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Selected Date Range' = ```
			
			VAR SelectedPeriod = SELECTEDVALUE(PeriodType_Parameter[Period Type], "Last Month")
			VAR MinDate = 
			    CALCULATE(
			        MIN(Fact_Top_JobCode_Analysis[InvoiceDate]),
			        SWITCH(
			            SelectedPeriod,
			            "Last Month", Dim_DateTable[IsPreviousMonth] = TRUE,
			            "Last Quarter", Dim_DateTable[IsPreviousQuarter] = TRUE,
			            "This Quarter", Dim_DateTable[IsCurrentYear] = TRUE && Dim_DateTable[Quarter] = QUARTER(TODAY()),
			            "Year to Date", Dim_DateTable[IsYearToDate] = TRUE,
			            "Last 30 Days", Dim_DateTable[IsLast30Days] = TRUE,
			            "Last 60 Days", Dim_DateTable[IsLast60Days] = TRUE,
			            "Last 90 Days", Dim_DateTable[IsLast90Days] = TRUE,
			            "Custom Month", Dim_DateTable[Year] = SELECTEDVALUE(Dim_DateTable[Year]) && Dim_DateTable[Month] = SELECTEDVALUE(Dim_DateTable[Month]),
			            "Custom Quarter", Dim_DateTable[Year] = SELECTEDVALUE(Dim_DateTable[Year]) && Dim_DateTable[Quarter] = SELECTEDVALUE(Dim_DateTable[Quarter]),
			            TRUE
			        )
			    )
			VAR MaxDate = 
			    CALCULATE(
			        MAX(Fact_Top_JobCode_Analysis[InvoiceDate]),
			        SWITCH(
			            SelectedPeriod,
			            "Last Month", Dim_DateTable[IsPreviousMonth] = TRUE,
			            "Last Quarter", Dim_DateTable[IsPreviousQuarter] = TRUE,
			            "This Quarter", Dim_DateTable[IsCurrentYear] = TRUE && Dim_DateTable[Quarter] = QUARTER(TODAY()),
			            "Year to Date", Dim_DateTable[IsYearToDate] = TRUE,
			            "Last 30 Days", Dim_DateTable[IsLast30Days] = TRUE,
			            "Last 60 Days", Dim_DateTable[IsLast60Days] = TRUE,
			            "Last 90 Days", Dim_DateTable[IsLast90Days] = TRUE,
			            "Custom Month", Dim_DateTable[Year] = SELECTEDVALUE(Dim_DateTable[Year]) && Dim_DateTable[Month] = SELECTEDVALUE(Dim_DateTable[Month]),
			            "Custom Quarter", Dim_DateTable[Year] = SELECTEDVALUE(Dim_DateTable[Year]) && Dim_DateTable[Quarter] = SELECTEDVALUE(Dim_DateTable[Quarter]),
			            TRUE
			        )
			    )
			RETURN 
			    "Date Range: " & FORMAT(MinDate, "MMM DD, YYYY") & " - " & FORMAT(MaxDate, "MMM DD, YYYY")
			```
		displayFolder: Display Measures\Custom Period
		lineageTag: f087b389-c6c3-44d6-bc0a-0ffad99e3ccd

