	measure 'Selected TopN' =
			
			VAR SelectedValue = SELECTEDVALUE(TopN_Parameter[TopN_Value], 50)
			RETURN SelectedValue
		formatString: 0
		displayFolder: _Parameters
		lineageTag: ae55dd54-9742-4655-b06a-42abb40a16b4

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Is In Top N' = ```
			
			VAR SelectedTopN = [Selected TopN]
			VAR CurrentJobCode = SELECTEDVALUE(Dim_JobCode[JobCode])
			VAR CurrentTransactions = [Transactions - Rolling 12M]
			VAR RankOfCurrentJob = 
			    RANKX(
			        FILTER(
			            ALL(Dim_JobCode),
			            [Transactions - Rolling 12M] > 0
			        ),
			        [Transactions - Rolling 12M],
			        ,
			        DESC,
			        DENSE
			    )
			RETURN
			    RankOfCurrentJob <= SelectedTopN
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: _Parameters
		lineageTag: b7229fe7-31c1-48a1-9b44-ce7759718062

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Selected Range Start' =
			
			SELECTEDVALUE(TopN_RangeStart[RangeStart], 1)
		formatString: 0
		displayFolder: _Parameters
		lineageTag: d2a18f0a-60ba-4aa3-9997-bd6421e01b9d

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Selected Range End' =
			
			SELECTEDVALUE(TopN_RangeEnd[RangeEnd], 50)
		formatString: 0
		displayFolder: _Parameters
		lineageTag: d720aaf4-b0b3-4ccb-9dc5-991000a49572

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Should Show Job Code' =
			
			VAR CurrentRank = [Job Rank by Volume - Rolling 12M]
			VAR StartRange = [Selected Range Start]
			VAR EndRange = [Selected Range End]
			VAR IsInRange = CurrentRank >= StartRange && CurrentRank <= EndRange
			RETURN IsInRange
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: c1d6330a-2d98-45fb-b6ec-0e315d14fa57

		changedProperty = Name

	measure 'Transactions Display' =
			
			IF([Should Show Job Code], [Transactions - Rolling 12M], BLANK())
		formatString: 0
		displayFolder: Display Measures\Rolling 12M
		lineageTag: 70e5f5a3-482d-4911-b584-d39bca072578

		changedProperty = Name

		changedProperty = DisplayFolder

