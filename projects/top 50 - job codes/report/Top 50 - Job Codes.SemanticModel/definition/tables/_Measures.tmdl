	measure 'Job Rank by Volume - Custom Period' =
			
			IF(
			    ISINSCOPE(Dim_JobCode[JobCode]),
			    VAR CurrentJobTransactions = [Transactions - Custom Period]
			    RETURN
			        IF(
			            CurrentJobTransactions > 0,
			            RANKX(
			                FILTER(
			                    ALL(Dim_JobCode),
			                    [Transactions - Custom Period] > 0
			                ),
			                [Transactions - Custom Period],
			                ,
			                DESC,
			                DENSE
			            ),
			            BLANK()
			        ),
			    BLANK()
			)
		formatString: 0
		displayFolder: Ranking Logic\Custom Period
		lineageTag: 27ada2c9-ffc1-4e6f-b8ef-1e4e69488b2b

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Should Show Job Code - Custom Period' =
			
			VAR CurrentRank = [Job Rank by Volume - Custom Period]
			VAR StartRange = [Selected Range Start]
			VAR EndRange = [Selected Range End]
			VAR IsInRange = CurrentRank >= StartRange && CurrentRank <= EndRange
			RETURN IsInRange
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: _Parameters
