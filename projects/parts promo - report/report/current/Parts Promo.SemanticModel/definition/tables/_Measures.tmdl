	/// Total parts sales from orders with promos. Uses LOOKUPVALUE for detail rows, TREATAS for aggregations to respect promo filter context.
	measure 'Original Sale Value' = ```
			
			VAR _SingleREF = SELECTEDVALUE(Fact_PartsPromo[REF_NO])
			VAR _FilteredREFs = VALUES(Fact_PartsPromo[REF_NO])
			RETURN
			IF(
			    NOT(ISBLANK(_SingleREF)),
			    -- Detail row context: get value for this specific REF_NO
			    LOOKUPVALUE(dim_RepairOrder[TotalPartsSales], dim_RepairOrder[REF_NO], _SingleREF),
			    -- Aggregated context: sum only orders visible in current filter context
			    CALCULATE(SUM(dim_RepairOrder[TotalPartsSales]), TREATAS(_FilteredREFs, dim_RepairOrder[REF_NO]))
			)
			
			```
		formatString: "$"#,0.00;("$"#,0.00);"$"#,0.00
		lineageTag: d38c0053-a188-46d3-afaf-976f08b7cac3

	/// Original margin before discount. Uses LOOKUPVALUE for detail rows, TREATAS for aggregations to respect promo filter context.
	measure 'Original Margin $' = ```
			
			VAR _SingleREF = SELECTEDVALUE(Fact_PartsPromo[REF_NO])
			VAR _FilteredREFs = VALUES(Fact_PartsPromo[REF_NO])
			RETURN
			IF(
			    NOT(ISBLANK(_SingleREF)),
			    -- Detail row context: get margin for this specific REF_NO
			    LOOKUPVALUE(dim_RepairOrder[OriginalMargin], dim_RepairOrder[REF_NO], _SingleREF),
			    -- Aggregated context: sum only orders visible in current filter context
			    CALCULATE(SUM(dim_RepairOrder[OriginalMargin]), TREATAS(_FilteredREFs, dim_RepairOrder[REF_NO]))
			)
			
			```
