	/// Conditional color for discount % (green/yellow/red)
	measure 'Color Discount %' =
			SWITCH(
			    TRUE(),
			    [Discount %] <= 0.10, "#AFCBAA",
			    [Discount %] <= 0.15, "#FFF299",
			    [Discount %] > 0.15, "#EFB5B9",
			    "#FFFFFF"
			)
		lineageTag: aed84dec-d1b2-40e1-a8a3-a32720b54db3

	/// Time-based greeting
	measure Greeting =
			VAR CurrentHour = HOUR(NOW())
			VAR AdjustedHour = MOD(CurrentHour - 6, 24)
			RETURN
			    SWITCH(
			        TRUE(),
			        AdjustedHour < 12, "Good morning, ",
			        AdjustedHour < 18, "Good afternoon, ",
			        "Good evening, "
			    )
		lineageTag: 28c80a0a-0339-4496-8a1b-55a133e30cb4

