	/// Net sales after discount. Uses LOOKUPVALUE for detail rows, TREATAS for aggregations to respect promo filter context.
	measure 'Net Sales Value' = ```
			
			VAR _SingleREF = SELECTEDVALUE(Fact_PartsPromo[REF_NO])
			RETURN
			IF(
			    NOT(ISBLANK(_SingleREF)),
			    -- Detail row context: get net order value for this specific REF_NO
			    LOOKUPVALUE(dim_RepairOrder[NetOrderValue], dim_RepairOrder[REF_NO], _SingleREF),
			    -- Aggregated context: original sales (filtered via TREATAS) + discount
			    [Original Sale Value] + SUM(Fact_PartsPromo[SaleValue])
			)
			
			```
		formatString: "$"#,0.00;("$"#,0.00);"$"#,0.00
		lineageTag: 29a95484-7509-472d-b2ad-3ddaeddead11

	/// Net margin after discount. Uses LOOKUPVALUE for detail rows, TREATAS for aggregations to respect promo filter context.
	measure 'Net Margin $' = ```
			
			VAR _SingleREF = SELECTEDVALUE(Fact_PartsPromo[REF_NO])
			VAR _FilteredREFs = VALUES(Fact_PartsPromo[REF_NO])
			RETURN
			IF(
			    NOT(ISBLANK(_SingleREF)),
			    -- Detail row context: get net margin for this specific REF_NO
			    LOOKUPVALUE(dim_RepairOrder[NetMargin], dim_RepairOrder[REF_NO], _SingleREF),
			    -- Aggregated context: net sales - cost (both filtered to promo context)
			    [Net Sales Value] - CALCULATE(SUM(dim_RepairOrder[TotalPartsCost]), TREATAS(_FilteredREFs, dim_RepairOrder[REF_NO]))
			)
			
			```
		formatString: "$"#,0.00;("$"#,0.00);"$"#,0.00
		lineageTag: 82b7dca7-3564-4c7e-98c1-d85a58e1d59a

	/// Net margin percentage
	measure 'Net Margin %' = DIVIDE([Net Margin $], [Net Sales Value], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 24434c5d-89cb-4cf0-9469-5c845079e993

	/// Discount as percentage of original sales
	measure 'Discount %' = DIVIDE(ABS(SUM(Fact_PartsPromo[SaleValue])), [Original Sale Value], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9ac4cb31-4532-4743-a00b-edf1b1bed4f2

	/// Rolling 12 month discount total
	measure 'Rolling 12M Discount' =
			VAR _EndDate = TODAY()
			VAR _StartDate = EDATE(TODAY(), -12)
			VAR _SelectedParts = VALUES(Fact_PartsPromo[PART_NO])
			RETURN
			CALCULATE(
			    ABS(SUM(Fact_PartsPromo[SaleValue])),
			    CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			    _SelectedParts,
			    Fact_PartsPromo[TransDatetime] >= _StartDate,
			    Fact_PartsPromo[TransDatetime] <= _EndDate
			)
		formatString: "$"#,0.00;("$"#,0.00);"$"#,0.00
		lineageTag: 27fff6d9-a417-49b2-ad0c-40536e3d281d

	/// Rolling 12 month net sales
	measure 'Rolling 12M Net Sales' =
			VAR _EndDate = TODAY()
			VAR _StartDate = EDATE(TODAY(), -12)
			VAR _SelectedParts = VALUES(Fact_PartsPromo[PART_NO])
			VAR _UniqueOrders =
			    CALCULATETABLE(
			        VALUES(Fact_PartsPromo[REF_NO]),
			        CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			        _SelectedParts,
			        Fact_PartsPromo[TransDatetime] >= _StartDate,
			        Fact_PartsPromo[TransDatetime] <= _EndDate
			    )
			VAR _TotalPartsSales =
			    SUMX(
			        _UniqueOrders,
			        LOOKUPVALUE(
			            dim_RepairOrder[TotalPartsSales],
			            dim_RepairOrder[REF_NO], Fact_PartsPromo[REF_NO]
			        )
			    )
			VAR _TotalDiscount =
			    CALCULATE(
			        SUM(Fact_PartsPromo[SaleValue]),
			        CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			        _SelectedParts,
			        Fact_PartsPromo[TransDatetime] >= _StartDate,
			        Fact_PartsPromo[TransDatetime] <= _EndDate
			    )
			RETURN
			_TotalPartsSales + _TotalDiscount
		formatString: "$"#,0.00;("$"#,0.00);"$"#,0.00
		lineageTag: 16bfbafa-d10f-495b-b515-cc671aaf4341

	/// Previous year rolling 12 month discount (12-24 months ago)
	measure 'PY Rolling 12M Discount' =
			VAR _EndDate = EDATE(TODAY(), -12)
			VAR _StartDate = EDATE(TODAY(), -24)
			VAR _SelectedParts = VALUES(Fact_PartsPromo[PART_NO])
			RETURN
			CALCULATE(
			    ABS(SUM(Fact_PartsPromo[SaleValue])),
			    CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			    _SelectedParts,
			    Fact_PartsPromo[TransDatetime] >= _StartDate,
			    Fact_PartsPromo[TransDatetime] < _EndDate
			)
		formatString: "$"#,0.00;("$"#,0.00);"$"#,0.00
		lineageTag: f3300a22-78a6-44f4-8de2-2b91f5550d25

	/// Previous year rolling 12 month net sales
	measure 'PY Rolling 12M Net Sales' =
			VAR _EndDate = EDATE(TODAY(), -12)
			VAR _StartDate = EDATE(TODAY(), -24)
			VAR _SelectedParts = VALUES(Fact_PartsPromo[PART_NO])
			VAR _UniqueOrders =
			    CALCULATETABLE(
			        VALUES(Fact_PartsPromo[REF_NO]),
			        CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			        _SelectedParts,
			        Fact_PartsPromo[TransDatetime] >= _StartDate,
			        Fact_PartsPromo[TransDatetime] < _EndDate
			    )
			VAR _TotalPartsSales =
			    SUMX(
			        _UniqueOrders,
			        LOOKUPVALUE(
			            dim_RepairOrder[TotalPartsSales],
			            dim_RepairOrder[REF_NO], Fact_PartsPromo[REF_NO]
			        )
			    )
			VAR _TotalDiscount =
			    CALCULATE(
			        SUM(Fact_PartsPromo[SaleValue]),
			        CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			        _SelectedParts,
			        Fact_PartsPromo[TransDatetime] >= _StartDate,
			        Fact_PartsPromo[TransDatetime] < _EndDate
			    )
			RETURN
			_TotalPartsSales + _TotalDiscount
		formatString: "$"#,0.00;("$"#,0.00);"$"#,0.00
		lineageTag: 0155a441-69a7-401a-ae3e-5e2c4702ea37

	/// Year over year change in discount
	measure 'YoY Change Discount %' =
			DIVIDE(
			    [Rolling 12M Discount] - [PY Rolling 12M Discount],
