	/// Net sales value (original parts sales + discount) for rolling 12 months by part.
	measure 'Rolling 12M Net Sales by Part' = ```
			
			VAR _CurrentPart = MAX(Fact_PartsPromo[PART_NO])
			VAR _EndDate = TODAY()
			VAR _StartDate = EDATE(TODAY(), -12)
			-- Get unique orders for this part in the date range
			-- CROSSFILTER disconnects dim_DateTable so the date slicer on Page 2 does not interfere
			VAR _UniqueOrders =
			    CALCULATETABLE(
			        VALUES(Fact_PartsPromo[REF_NO]),
			        CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			        Fact_PartsPromo[TransDatetime] >= _StartDate,
			        Fact_PartsPromo[TransDatetime] <= _EndDate,
			        Fact_PartsPromo[PART_NO] = _CurrentPart
			    )
			-- Sum TotalPartsSales once per order (use current row's REF_NO from iteration)
			VAR _TotalPartsSales =
			    SUMX(
			        _UniqueOrders,
			        VAR _CurrentREF = Fact_PartsPromo[REF_NO]
			        RETURN LOOKUPVALUE(dim_RepairOrder[TotalPartsSales], dim_RepairOrder[REF_NO], _CurrentREF)
			    )
			-- Sum discount for all transactions
			VAR _TotalDiscount =
			    CALCULATE(
			        SUM(Fact_PartsPromo[SaleValue]),
			        CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			        Fact_PartsPromo[TransDatetime] >= _StartDate,
			        Fact_PartsPromo[TransDatetime] <= _EndDate,
			        Fact_PartsPromo[PART_NO] = _CurrentPart
			    )
			RETURN
			_TotalPartsSales + _TotalDiscount
			
			```
		formatString: $#,##0.00
		lineageTag: a21628d2-fca1-469f-820a-8874d48ffabc

	/// Net sales value for prior year rolling 12 months (12-24 months ago) by part. Deduplication now handled at Power Query level.
	measure 'PY Rolling 12M Net Sales by Part' = ```
			
			VAR _CurrentPart = MAX(Fact_PartsPromo[PART_NO])
			VAR _EndDate = EDATE(TODAY(), -12)
			VAR _StartDate = EDATE(TODAY(), -24)
			-- Get unique orders for this part in the PY date range
			-- CROSSFILTER disconnects dim_DateTable so the date slicer on Page 2 does not interfere
			VAR _UniqueOrders =
			    CALCULATETABLE(
			        VALUES(Fact_PartsPromo[REF_NO]),
			        CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			        Fact_PartsPromo[TransDatetime] >= _StartDate,
			        Fact_PartsPromo[TransDatetime] < _EndDate,
			        Fact_PartsPromo[PART_NO] = _CurrentPart
			    )
			-- Sum TotalPartsSales once per order
			VAR _TotalPartsSales =
			    SUMX(
			        _UniqueOrders,
			        LOOKUPVALUE(dim_RepairOrder[TotalPartsSales], dim_RepairOrder[REF_NO], Fact_PartsPromo[REF_NO])
			    )
			-- Sum discount for all transactions (deduplication now in PQ)
			VAR _TotalDiscount =
			    CALCULATE(
			        SUM(Fact_PartsPromo[SaleValue]),
			        CROSSFILTER(Fact_PartsPromo[TransDatetime], dim_DateTable[Date], None),
			        Fact_PartsPromo[TransDatetime] >= _StartDate,
			        Fact_PartsPromo[TransDatetime] < _EndDate,
			        Fact_PartsPromo[PART_NO] = _CurrentPart
			    )
			RETURN
			_TotalPartsSales + _TotalDiscount
			
			```
		formatString: $#,##0.00
		lineageTag: 6fca0c07-0c01-4d34-8af5-b7739aef785a

	measure 'Page 2 Details - Header' = ```
			
