	measure 'HTML Tooltip Part Header' =
			
			VAR _PART = MAX(Fact_PartsPromo[PART_NO])
			RETURN
			"
			<!DOCTYPE html>
			<html lang='en'>
			<head>
			    <meta charset='UTF-8'>
			    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
			    <style>
