table MeasuresTable
	lineageTag: 2a2cea53-6ea8-43bd-97a1-491aa144e275

	measure Discount =
			
			SUM ( Parts_Promo[SALE_VAL] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 20f0cc50-8f4d-4faa-b68d-b336037b0c3d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Cost Value' =
			
			SUM ( Parts_Promo[Part_Cost] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b0fa8323-c500-46df-b110-8a2b9bf0ca7a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Original Sale Value' =
			
			SUM ( Parts_Promo[Part_Sales] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 53a7da8b-62f8-429b-b432-fee345fe085c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Original Margin $' =
			
			[Original Sale Value] - [Cost Value]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 079397c2-a9a0-465e-8525-f3443c0816d7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Original Margin %' =
			
			DIVIDE ( [Original Margin $], [Original Sale Value] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 083e6c93-828c-4947-8c33-67e198e92d0d

	measure 'Net Sales Value' =
			
			[Original Sale Value] + [Discount]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: dce02a37-32c3-4c69-aa6e-758484ba890d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Margin $' =
			
			[Net Sales Value] - [Cost Value]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8f6c80ab-7f56-4243-b37c-67ea1c47c5fe

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Margin %' =
			
			DIVIDE ( [Net Margin $], [Net Sales Value] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c0afe6e1-78d6-4356-b2fd-554514ec408e

	measure 'Discount %' =
			
			DIVIDE ( ABS ( [Discount] ), [Original Sale Value] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3dc1fcb3-6693-419a-b36c-150b9e431a71

	measure Rolling12MonthCount =
			
			CALCULATE (
			    COUNTROWS ( 'Parts_Promo' ),
			    FILTER (
			        'Parts_Promo',
			        'Parts_Promo'[Rolling12MonthFlag] = 1
			            && 'Parts_Promo'[PART_NO] = MAX ( 'Parts_Promo'[PART_NO] )
			    )
			)
		formatString: 0
		lineageTag: f52f52b6-f96a-4a3c-bd8c-4ed38f68a8ce

	measure PreviousYearRollingCount =
			
			CALCULATE (
			    COUNTROWS ( 'Parts_Promo' ),
			    FILTER (
			        'Parts_Promo',
			        'Parts_Promo'[PreviousYearRollingFlag] = 1
			            && 'Parts_Promo'[PART_NO] = MAX ( 'Parts_Promo'[PART_NO] )
			    )
			)
		formatString: 0
		lineageTag: af7ed383-bdad-4ae8-9566-776877c95f20

	measure PercentChangeRolling =
			
			DIVIDE (
			    [Rolling12MonthCount] - [PreviousYearRollingCount],
			    [PreviousYearRollingCount],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 181870e6-0af4-430d-ba9a-2c23fab1635f

	measure Rolling12MonthNetSalesValue =
			
			CALCULATE (
			    SUMX (
			        FILTER (
			            'Parts_Promo',
			            'Parts_Promo'[Trans_Datetime] >= EDATE ( TODAY (), -12 )
			                && 'Parts_Promo'[Trans_Datetime] <= TODAY ()
			        ),
			        [Net Sales Value]
			    ),
			    FILTER (
			        ALL ( 'Parts_Promo' ),
			        'Parts_Promo'[PART_NO] = MAX ( 'Parts_Promo'[PART_NO] )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 1cfa737a-1c27-497c-9b55-a0c293d7f045

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure PreviousYearRollingNetSalesValue =
			
			CALCULATE (
			    SUMX (
			        FILTER (
			            'Parts_Promo',
			            'Parts_Promo'[Trans_Datetime] >= EDATE ( TODAY (), -24 )
			                && 'Parts_Promo'[Trans_Datetime] <= EDATE ( TODAY (), -12 )
			        ),
			        [Net Sales Value]
			    ),
			    FILTER (
			        ALL ( 'Parts_Promo' ),
			        'Parts_Promo'[PART_NO] = MAX ( 'Parts_Promo'[PART_NO] )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b8d2a4bc-5cc6-4dd4-a847-026f628b413e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure PercentChangeNetSalesValue =
			
			DIVIDE (
			    [Rolling12MonthNetSalesValue] - [PreviousYearRollingNetSalesValue],
			    [PreviousYearRollingNetSalesValue],
			    0
			)
		lineageTag: e3340740-1167-40a9-a826-26c72e3a3f4a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HTML RO Tooltip Info' = ```
			
			VAR _PART =
			    MAX ( 'Parts_Promo'[PART_NO] )
			RETURN
			    "
			<!DOCTYPE html>
			<html lang='en'>
			<head>
			    <meta charset='UTF-8'>
			    <meta name='viewport' content='width=device-width, initial-scale=1.0'> 
			
			    <style>
			        /* Animation for text appearance with a blur effect */
			        @keyframes text-focus-in {
			            0% {
			                transform: scale(1);
			                opacity: 0;
			                filter: blur(10px);
			            }
			            100% {
			                transform: scale(1);
			                opacity: 1;
			            }
			        }
			
			        .text-focus-in {
			            -webkit-animation: text-focus-in 0.6s cubic-bezier(0.550, 0.085, 0.680, 0.530) both;
			            animation: text-focus-in 0.6s cubic-bezier(0.550, 0.085, 0.680, 0.530) both;
			            color: #BEBEBE;  /* Light grey text color */
			            font-family: 'Segoe UI';  /* Sets font */
			            margin-top: -1px;  /* Adjusts position slightly */
			            display: flex;  /* Enables flexbox for alignment */
			            align-items: center;  /* Centers items vertically */
			            gap: 8px;  /* Space between the icon and text */
			        }
			
			        .dark-blue {
			            color: #303E6E;  /* Dark blue text color */
			            font-weight: bold;  /* Makes text bold */
			        }
			
			        .calendar-icon {
			            width: 14px;  /* Sets icon size */
			            height: 14px;
			            fill: #303E6E;  /* Calendar icon color */
			        }
			    </style>
			</head>
			<body>
			    <p class='text-focus-in'>  <!-- Animated text container -->
			        <!-- SVG calendar icon -->
			        <svg class='custom-icon' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='14' height='14'>
			    <path fill='#303E6E' d='M24 32.041h-18c-1.105 0-2-0.893-2-1.996v-24.097c0-1.102 0.895-1.995 2-1.995h5v2.079h-4c-0.552 0-1 0.446-1 0.998v22.017c0 0.553 0.448 0.998 1 0.998h16c0.553 0 1-0.445 1-0.998v-22.017c0-0.552-0.447-0.998-1-0.998h-4v-2.079h5c1.104 0 2 0.894 2 1.995v24.097c0 1.103-0.896 1.996-2 1.996zM11 12.019h11v0.998h-11v-0.998zM11 15.013h11v0.998h-11v-0.998zM11 18.008h11v0.998h-11v-0.998zM11 21.002h11v0.998h-11v-0.998zM22 27.986h-11v-0.996h11v0.996zM11 23.996h11v0.998h-11v-0.998zM8 11.999h1v0.998h-1v-0.998zM8 14.993h1v0.998h-1v-0.998zM8 17.986h1v0.998h-1v-0.998zM8 20.98h1v0.998h-1v-0.998zM9 27.967h-1v-0.998h1v0.998zM8 23.975h1v0.998h-1v-0.998zM21 7.091c0.553 0 1 0.447 1 0.999s0 1.933 0 1.933h-14c0 0 0-1.382 0-1.933s0.447-0.999 1-0.999h3c0 0 0.012-1.419 0.012-3.041 0-1.684 1.3-3.092 2.988-3.092s3.033 1.48 3.033 3.102c0 1.747-0.033 3.031-0.033 3.031h3zM15 3.953c-0.553 0-1 0.446-1 0.997 0 0.552 0.447 0.998 1 0.998s1-0.446 1-0.998c0-0.551-0.447-0.997-1-0.997z'/>
			    </svg>
			        <span class='dark-blue'>" & _PART & "</span>  <!-- Displays the formatted date from DAX -->
			    </p>
			</body>
			</html>
			"
			```
		lineageTag: dbfe030a-b828-43d6-a441-1173b5faa407

	measure 'HTML Tooltip Hours_Paid_Difference' = ```
			
			"<!DOCTYPE html>
			<html lang='en'>
			<head>
			    <meta charset='UTF-8'>  
			    <meta name='viewport' content='width=device-width, initial-scale=1.0'>  
			    <style>
			        @keyframes slide-in-blurred-top {
			            0% {
			                transform: translateY(-100%);
			                opacity: 0;
			                filter: blur(10px);
			            }
			            100% {
			                transform: translateY(0);
			                opacity: 1;
			                filter: blur(0);
			            }
			        }
			
			        .slide-in-blurred-top {
			            -webkit-animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
			            animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
			            animation-delay: 0.75s;
			            color: #013E72;
			            font-family: 'Segoe UI';
			            margin: 10px;
			            opacity: 0;
			            animation-fill-mode: forwards;
			        }
			
			        .category-name {
			            color: #333242;
			            position: relative;
			            padding-left: 20px;
			        }
			
			        .R12-Count::before, .PY-Count::before, .percent-change::before {
			            content: '';
			            position: absolute;
			            left: 0;
			            top: calc(50% + 1px);
			            transform: translateY(-50%);
			            width: 10px;
			            height: 10px;
			            border-radius: 10px;
			        }
			
			        .R12-Count::before { background-color: #2A497B; }
			        .PY-Count::before { background-color: #CCCCCC; }
			        .percent-change::before { background-color: #75B6CA; }
			
			        .value {
			            color: #464648;
			            font-weight: 600;
			        }
			
			        .arrow {
			            font-size: 14px;
			            margin-left: 5px;
			        }
			
			        .up-arrow {
			            color: green;
			        }
			
			        .down-arrow {
			            color: red;
			        }
			    </style>
			</head>
			<body>
			    <div class='slide-in-blurred-top'>
			        "
			    & IF (
			        NOT ( ISBLANK ( [Rolling12MonthCount] ) ),
			        "<p><span class='category-name R12-Count'>Rolling 12: </span><span class='value' id='current'>"
			            & FORMAT ( [Rolling12MonthCount], "#,0" ) & "</span></p>",
			        ""
			    )
			    & IF (
			        NOT ( ISBLANK ( [PreviousYearRollingCount] ) ),
			        "<p><span class='category-name PY-Count'>PY R12: </span><span class='value' id='previous'>"
			            & FORMAT ( [PreviousYearRollingCount], "#,0" ) & "</span></p>",
			        ""
			    )
			    & IF (
			        NOT ( ISBLANK ( [PercentChangeRolling] ) ),
			        "<p><span class='category-name percent-change'>% Change: </span><span class='value' id='current'>"
			            & FORMAT ( [PercentChangeRolling], "#,0.00%" )
			            & IF (
			                [PercentChangeRolling] > 0,
			                "<span class='arrow up-arrow'>&#9650;</span>",
			                /* Green up arrow */
			                "<span class='arrow down-arrow'>&#9660;</span>" /* Red down arrow */
			            ) & "</span></p>",
			        ""
			    ) & "
			    </div>
			</body>
			</html>"
			```
		lineageTag: eed6864d-f690-4d58-84e6-e1dfb1a91b0a

