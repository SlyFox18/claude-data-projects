			        .slide-in-blurred-top {
			            -webkit-animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
			            animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
			            animation-delay: 0.75s;
			            color: #013E72;
			            font-family: 'Segoe UI';
			            margin: 10px;
			            opacity: 0;
			            animation-fill-mode: forwards;
			        }
			
			        .category-name {
			            color: #333242;
			            position: relative;
			            padding-left: 20px;
			        }
			
			        .R12-NetSales::before, .PY-NetSales::before, .percent-change::before {
			            content: '';
			            position: absolute;
			            left: 0;
			            top: calc(50% + 1px);
			            transform: translateY(-50%);
			            width: 10px;
			            height: 10px;
			            border-radius: 10px;
			        }
			
			        .R12-NetSales::before { background-color: #2A497B; }
			        .PY-NetSales::before { background-color: #CCCCCC; }
			        .percent-change::before { background-color: #75B6CA; }
			
			        .value {
			            color: #464648;
			            font-weight: 600;
			        }
			
			        .arrow {
			            font-size: 14px;
			            margin-left: 5px;
			        }
			
			        .up-arrow {
			            color: green;
			        }
			
			        .down-arrow {
			            color: red;
			        }
			    </style>
			</head>
			<body>
			    <div class='slide-in-blurred-top'>
			        "
			    & IF (
			        NOT ( ISBLANK ( [Discount %] ) ),
			        "<p><span class='category-name R12-NetSales'>Discount: </span><span class='value' id='current'>"
			            & FORMAT ( [Discount %], "#,#0.00%" ) & "</span></p>",
			        ""
			    )
			    & IF (
			        NOT ( ISBLANK ( [Net Sales Value] ) ),
			        "<p><span class='category-name PY-NetSales'>Net Sales: </span><span class='value' id='previous'>"
			            & FORMAT ( [Net Sales Value], "$#,##0.00" ) & "</span></p>",
			        ""
			    )
			    & IF (
			        NOT ( ISBLANK ( [Original Sale Value] ) ),
			        "<p><span class='category-name percent-change'>Original Sales: </span><span class='value' id='current'>"
			            & FORMAT ( [Original Sale Value], "$#,##0.00" ) & "</span></p>",
			        ""
			    ) & "
			    </div>
			</body>
			</html>"
			```
		lineageTag: b08f9211-180e-4e96-aa5b-cc025a12e8ce

	measure 'Color Discount %' =
			
			SWITCH (
			    TRUE (),
			    [Discount %] <= 0.10, "#AFCBAA",
			    // Red for 10% and below
			    [Discount %] > 0.10
			        && [Discount %] <= 0.15, "#FFF299",
			    // Yellow for 11% to 15%
			    [Discount %] > 0.15, "#EFB5B9",
			    // Green for 16% and above
			    "#FFFFFF" // Default color (white)
			)
		lineageTag: f9747ed1-c1be-463a-8c52-0696187bbcfc

	measure 'Total Net Sales Value' =
			
			SUMX (
			    FILTER ( Parts_Promo, LEFT ( Parts_Promo[PART_NO], 1 ) = "*" ),
			    Parts_Promo[Part_Sales] + Parts_Promo[SALE_VAL]
			)
		lineageTag: 13d0543a-d94b-46d9-8b58-7f44b885712a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total SALE_VAL' =
			
			SUM ( InTrans_All_Promo[SALE_VAL] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a936e8ab-a7d9-4bed-9505-bc479ade6572

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Percent to Sale Val' =
			
			DIVIDE ( [Net Sales Value], [Total SALE_VAL], 0 )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fe33a090-c5c4-419e-85c3-e769940db282

	measure NetSalesValueByPartNo =
			
			CALCULATE (
			    SUM ( Parts_Promo[Net Sales Value] ),
			    FILTER (
			        Parts_Promo,
			        Parts_Promo[PART_NO] IN VALUES ( InTrans_All_Promo[PART_NO] )
			    )
			)
		lineageTag: 0ba967d5-a652-4849-a792-1dbe327943f1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PercentToSaleVal =
			
			DIVIDE ( [NetSalesValueByPartNo], [Total SALE_VAL], 0 )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c898e9cf-356c-4112-bb6b-402756886064

	measure Greeting =
			
			VAR CurrentHour = HOUR(NOW())
			VAR AdjustedHour = MOD(CurrentHour - 6, 24)
			RETURN
			    SWITCH (
			        TRUE(),
			        AdjustedHour < 12, "Good morning, ",
			        AdjustedHour < 18, "Good afternoon, ",
			        "Good evening, "
			    )
		lineageTag: 3b1e9019-1b35-4ae5-9b37-30c7facb6d65

	measure User =
			
			VAR _user =
			    USERNAME ()
			RETURN
			    RIGHT ( USERNAME (), LEN ( _user ) - SEARCH ( "\", _user ) )
		lineageTag: eadcfe55-ab1e-4978-ba8a-c6034c072cc3

	measure CombinedTableNetSales =
			
			MAX ( 'CalculatedTable'[Net Sales Value] )
		lineageTag: 58bb6bd1-b607-44c4-8e9a-78f1645752e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

