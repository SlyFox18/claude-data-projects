	measure ShowRow =
			
			VAR minRow = [SelectedMinRow]
			VAR maxRow = [SelectedMaxRow]
			RETURN
			IF(SELECTEDVALUE('Parts_Promo'[Index]) >= minRow && SELECTEDVALUE('Parts_Promo'[Index]) <= maxRow, 1, 0)
		lineageTag: 6b09bd21-1506-4dd3-9e3d-335fd2f772fe

	measure SelectedMaxRow =
			
