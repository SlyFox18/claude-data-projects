/*
================================================================================
PARTS PROMO - HTML TOOLTIP MEASURES
================================================================================

These measures generate HTML content for SVG/HTML visuals in Power BI.
Adapted for the new star schema model.

================================================================================
*/

-- ============================================================================
-- HTML Tooltip: Part Number Header
-- ============================================================================
HTML Tooltip Part Header =
VAR _PART = MAX(Fact_PartsPromo[PART_NO])
RETURN
"
<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <style>
        @keyframes text-focus-in {
            0% { transform: scale(1); opacity: 0; filter: blur(10px); }
            100% { transform: scale(1); opacity: 1; }
        }
        .text-focus-in {
            -webkit-animation: text-focus-in 0.6s cubic-bezier(0.550, 0.085, 0.680, 0.530) both;
            animation: text-focus-in 0.6s cubic-bezier(0.550, 0.085, 0.680, 0.530) both;
            color: #BEBEBE;
            font-family: 'Segoe UI';
            margin-top: -1px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .dark-blue { color: #303E6E; font-weight: bold; }
    </style>
</head>
<body>
    <p class='text-focus-in'>
        <svg class='custom-icon' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='14' height='14'>
            <path fill='#303E6E' d='M24 32.041h-18c-1.105 0-2-0.893-2-1.996v-24.097c0-1.102 0.895-1.995 2-1.995h5v2.079h-4c-0.552 0-1 0.446-1 0.998v22.017c0 0.553 0.448 0.998 1 0.998h16c0.553 0 1-0.445 1-0.998v-22.017c0-0.552-0.447-0.998-1-0.998h-4v-2.079h5c1.104 0 2 0.894 2 1.995v24.097c0 1.103-0.896 1.996-2 1.996zM11 12.019h11v0.998h-11v-0.998zM11 15.013h11v0.998h-11v-0.998zM11 18.008h11v0.998h-11v-0.998zM11 21.002h11v0.998h-11v-0.998zM22 27.986h-11v-0.996h11v0.996zM11 23.996h11v0.998h-11v-0.998zM8 11.999h1v0.998h-1v-0.998zM8 14.993h1v0.998h-1v-0.998zM8 17.986h1v0.998h-1v-0.998zM8 20.98h1v0.998h-1v-0.998zM9 27.967h-1v-0.998h1v0.998zM8 23.975h1v0.998h-1v-0.998zM21 7.091c0.553 0 1 0.447 1 0.999s0 1.933 0 1.933h-14c0 0 0-1.382 0-1.933s0.447-0.999 1-0.999h3c0 0 0.012-1.419 0.012-3.041 0-1.684 1.3-3.092 2.988-3.092s3.033 1.48 3.033 3.102c0 1.747-0.033 3.031-0.033 3.031h3zM15 3.953c-0.553 0-1 0.446-1 0.997 0 0.552 0.447 0.998 1 0.998s1-0.446 1-0.998c0-0.551-0.447-0.997-1-0.997z'/>
        </svg>
        <span class='dark-blue'>" & _PART & "</span>
    </p>
</body>
</html>
"


-- ============================================================================
-- HTML Tooltip: Date Header
-- ============================================================================
HTML Tooltip Date Header =
VAR _date = FORMAT(MAX(Fact_PartsPromo[TransDatetime]), "MM/DD/YYYY")
RETURN
"
<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <style>
        @keyframes text-focus-in {
            0% { transform: scale(1); opacity: 0; filter: blur(10px); }
            100% { transform: scale(1); opacity: 1; }
        }
        .text-focus-in {
            -webkit-animation: text-focus-in 0.6s cubic-bezier(0.550, 0.085, 0.680, 0.530) both;
            animation: text-focus-in 0.6s cubic-bezier(0.550, 0.085, 0.680, 0.530) both;
            color: #BEBEBE;
            font-family: 'Segoe UI';
            margin-top: -1px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .dark-blue { color: #303E6E; font-weight: bold; }
        .calendar-icon { width: 14px; height: 14px; fill: #303E6E; }
    </style>
</head>
<body>
    <p class='text-focus-in'>
        <svg class='calendar-icon' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'>
            <path d='M19 4h-1V2h-2v2H8V2H6v2H5C3.897 4 3 4.897 3 6v14c0 1.103 0.897 2 2 2h14c1.103 0 2-0.897 2-2V6c0-1.103-0.897-2-2-2zm0 16H5V10h14v10zM5 8V6h14l0.002 2H5z'/>
        </svg>
        <span class='dark-blue'>" & _date & "</span>
    </p>
</body>
</html>
"


-- ============================================================================
-- HTML Tooltip: Rolling 12 Month Comparison
-- ============================================================================
HTML Tooltip Rolling Comparison =
"<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <style>
        @keyframes slide-in-blurred-top {
            0% { transform: translateY(-100%); opacity: 0; filter: blur(10px); }
            100% { transform: translateY(0); opacity: 1; filter: blur(0); }
        }
        .slide-in-blurred-top {
            -webkit-animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
            animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
            animation-delay: 0.75s;
            color: #013E72;
            font-family: 'Segoe UI';
            margin: 10px;
            opacity: 0;
            animation-fill-mode: forwards;
        }
        .category-name { color: #333242; position: relative; padding-left: 20px; }
        .R12::before, .PY::before, .change::before {
            content: ''; position: absolute; left: 0;
            top: calc(50% + 1px); transform: translateY(-50%);
            width: 10px; height: 10px; border-radius: 10px;
        }
        .R12::before { background-color: #2A497B; }
        .PY::before { background-color: #CCCCCC; }
        .change::before { background-color: #75B6CA; }
        .value { color: #464648; font-weight: 600; }
        .arrow { font-size: 14px; margin-left: 5px; }
        .up-arrow { color: green; }
        .down-arrow { color: red; }
    </style>
</head>
<body>
    <div class='slide-in-blurred-top'>"
& IF(
    NOT(ISBLANK([Rolling 12M Net Sales])),
    "<p><span class='category-name R12'>R12 Net Sales: </span><span class='value'>"
        & FORMAT([Rolling 12M Net Sales], "$#,##0.00") & "</span></p>",
    ""
)
& IF(
    NOT(ISBLANK([PY Rolling 12M Net Sales])),
    "<p><span class='category-name PY'>PY R12 Net Sales: </span><span class='value'>"
        & FORMAT([PY Rolling 12M Net Sales], "$#,##0.00") & "</span></p>",
    ""
)
& IF(
    NOT(ISBLANK([YoY Change Net Sales %])),
    "<p><span class='category-name change'>% Change: </span><span class='value'>"
        & FORMAT([YoY Change Net Sales %], "#,0.00%")
        & IF(
            [YoY Change Net Sales %] > 0,
            "<span class='arrow up-arrow'>&#9650;</span>",
            "<span class='arrow down-arrow'>&#9660;</span>"
        ) & "</span></p>",
    ""
) & "
    </div>
</body>
</html>"


-- ============================================================================
-- HTML Tooltip: Discount Details
-- ============================================================================
HTML Tooltip Discount Details =
"<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <style>
        @keyframes slide-in-blurred-top {
            0% { transform: translateY(-100%); opacity: 0; filter: blur(10px); }
            100% { transform: translateY(0); opacity: 1; filter: blur(0); }
        }
        .slide-in-blurred-top {
            -webkit-animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
            animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
            animation-delay: 0.75s;
            color: #013E72;
            font-family: 'Segoe UI';
            margin: 10px;
            opacity: 0;
            animation-fill-mode: forwards;
        }
        .category-name { color: #333242; position: relative; padding-left: 20px; }
        .discount::before, .net::before, .original::before {
            content: ''; position: absolute; left: 0;
            top: calc(50% + 1px); transform: translateY(-50%);
            width: 10px; height: 10px; border-radius: 10px;
        }
        .discount::before { background-color: #2A497B; }
        .net::before { background-color: #CCCCCC; }
        .original::before { background-color: #75B6CA; }
        .value { color: #464648; font-weight: 600; }
    </style>
</head>
<body>
    <div class='slide-in-blurred-top'>"
& IF(
    NOT(ISBLANK([Discount %])),
    "<p><span class='category-name discount'>Discount: </span><span class='value'>"
        & FORMAT([Discount %], "#,#0.00%") & "</span></p>",
    ""
)
& IF(
    NOT(ISBLANK([Net Sales Value])),
    "<p><span class='category-name net'>Net Sales: </span><span class='value'>"
        & FORMAT([Net Sales Value], "$#,##0.00") & "</span></p>",
    ""
)
& IF(
    NOT(ISBLANK([Original Sale Value])),
    "<p><span class='category-name original'>Original Sales: </span><span class='value'>"
        & FORMAT([Original Sale Value], "$#,##0.00") & "</span></p>",
    ""
) & "
    </div>
</body>
</html>"
