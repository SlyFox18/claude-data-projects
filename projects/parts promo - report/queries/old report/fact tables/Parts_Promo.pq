let
  Source = Odbc.Query("dsn=EquipRDB64", "SELECT #(lf)    main.BRANCH, #(lf)    main.FRANCHISE, #(lf)    main.customer_no, #(lf)    main.REF_NO, #(lf)    main.PART_NO, #(lf)    main.Trans_Datetime,#(lf)    main.TYPE, #(lf)    main.QTY,#(lf)    SUM(main.SALE_VAL) AS SALE_VAL, #(lf)    SUM(main.COST_VAL) AS COST_VAL,#(lf)    main.DESCRIPTION,#(lf)    agg.Part_Sales,#(lf)    agg.Part_Cost,#(lf)    agg.Parts_Count#(lf)FROM #(lf)    InTrans AS main#(lf)JOIN (#(lf)    SELECT #(lf)        REF_NO,#(lf)        SUM(CASE WHEN PART_NO NOT LIKE '*%' AND FRANCHISE != 'ZP' THEN SALE_VAL ELSE 0 END) AS Part_Sales,#(lf)        SUM(CASE WHEN PART_NO NOT LIKE '*%' AND FRANCHISE != 'ZP' THEN COST_VAL ELSE 0 END) AS Part_Cost,#(lf)        COUNT(CASE WHEN PART_NO NOT LIKE '*%' AND FRANCHISE != 'ZP' THEN 1 ELSE NULL END) AS Parts_Count#(lf)    FROM #(lf)        InTrans#(lf)    WHERE #(lf)        Trans_Datetime >= '2022-01-01' #(lf)        AND Trans_Datetime <= CURRENT_TIMESTAMP#(lf)    GROUP BY #(lf)        REF_NO#(lf)) AS agg ON main.REF_NO = agg.REF_NO#(lf)WHERE #(lf)    main.Trans_Datetime >= '2022-01-01' #(lf)    AND main.Trans_Datetime <= CURRENT_TIMESTAMP#(lf)    AND main.PART_NO LIKE '*%'#(lf)GROUP BY #(lf)    main.BRANCH, #(lf)    main.FRANCHISE, #(lf)    main.customer_no, #(lf)    main.REF_NO, #(lf)    main.PART_NO, #(lf)    main.Trans_Datetime,#(lf)    main.TYPE, #(lf)    main.QTY,#(lf)    main.DESCRIPTION,#(lf)    agg.Part_Sales,#(lf)    agg.Part_Cost,#(lf)    agg.Parts_Count")
in
  Source