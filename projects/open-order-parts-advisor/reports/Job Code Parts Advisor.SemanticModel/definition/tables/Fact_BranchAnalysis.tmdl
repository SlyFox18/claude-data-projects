		sourceColumn: Fact_JobCodePartFrequency_Branch[Branch]

		annotation SummarizationSetBy = Automatic

	partition Fact_BranchAnalysis = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    FILTER(
				        Fact_JobCodePartFrequency_Branch,
				        Fact_JobCodePartFrequency_Branch[TotalOrdersWithJobCode] >= 3
				            && Fact_JobCodePartFrequency_Branch[FrequencyPct] >= 0.05
				            && LEFT(Fact_JobCodePartFrequency_Branch[PartNumber], 1) <> "*"
				            && LOOKUPVALUE(dim_Parts[Franchise], dim_Parts[PartNumber], Fact_JobCodePartFrequency_Branch[PartNumber]) <> "ZP"
				    ),
				    "PartDescription",     LOOKUPVALUE(dim_Parts[Description],    dim_Parts[PartNumber], [PartNumber]),
				    "SellPrice",           LOOKUPVALUE(dim_Parts[SellPrice1],      dim_Parts[PartNumber], [PartNumber]),
				    "JobDescription",      LOOKUPVALUE(dim_JobCodes[Description],  dim_JobCodes[JobCode], [JobCode]),
				    "FactoryCode",         LOOKUPVALUE(dim_JobCodes[FactoryCode],  dim_JobCodes[JobCode], [JobCode]),
				    "CompanyFrequencyPct",
				        VAR _Job  = [JobCode]
				        VAR _Part = [PartNumber]
				        RETURN MAXX(
				            FILTER(
				                Fact_JobCodePartFrequency,
				                Fact_JobCodePartFrequency[JobCode]    = _Job
				                    && Fact_JobCodePartFrequency[PartNumber] = _Part
				            ),
				            Fact_JobCodePartFrequency[FrequencyPct]
				        ),
				    "RecommendationTier",
				        IF([FrequencyPct] >= 0.50, "Always",
				        IF([FrequencyPct] >= 0.25, "Usually",
				        IF([FrequencyPct] >= 0.10, "Sometimes",
				        "Rarely"))),
				    "TierSortOrder",
				        IF([FrequencyPct] >= 0.50, 1,
				        IF([FrequencyPct] >= 0.25, 2,
				        IF([FrequencyPct] >= 0.10, 3,
				        4)))
				)
				
				```

	annotation PBI_Id = 33445566778899aabbccddeeff001122

