			    UPPER(LEFT(_LastName, 1)) & LOWER(MID(_LastName, 2, LEN(_LastName)))
			VAR WelcomeName = _FirstLetter & "." & _FormattedLastName
			
			// Get current date/time info
			VAR CurrentDate = TODAY()
			VAR DateDisplay = FORMAT(CurrentDate, "MMM D, YYYY")
