	measure 'Company Frequency %' = MAX(Fact_BranchAnalysis[CompanyFrequencyPct])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d3c4b5a6-9780-7012-dcba-987654321012

	measure 'Branch Analysis Banner' =
			
			VAR _JobCode      = SELECTEDVALUE(Fact_BranchAnalysis[JobCode])
			VAR _Branches     = FORMAT(DISTINCTCOUNT(Fact_BranchAnalysis[Branch]), "0")
			VAR _UniqueParts  = FORMAT(DISTINCTCOUNT(Fact_BranchAnalysis[PartNumber]), "0")
			VAR _CompanyOrders = FORMAT(
			    CALCULATE(MAX(Fact_GapAnalysis[TotalOrdersWithJobCode])),
			    "#,##0"
			)
			RETURN
			IF(
			    ISBLANK(_JobCode),
			    "<div style='font-family: Segoe UI, Arial, sans-serif; height: 85px; padding: 10px 20px; background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%); border-radius: 8px; border: 2px dashed rgba(255,255,255,0.3); color: rgba(255,255,255,0.6); display: flex; align-items: center; justify-content: center; box-sizing: border-box; font-size: 13px; letter-spacing: 0.8px;'>" &
			        "← SELECT A JOB CODE FROM THE LIST TO VIEW BRANCH COMPARISON" &
			    "</div>",
			    "<div style='font-family: Segoe UI, Arial, sans-serif; height: 85px; padding: 10px 20px; background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%); border-radius: 8px; color: white; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; box-shadow: 0 2px 8px rgba(0,0,0,0.2);'>" &
			        "<div style='display: flex; align-items: center; gap: 12px;'>" &
			            "<div style='background: rgba(255,255,255,0.15); border-radius: 6px; padding: 6px 10px; font-size: 11px; letter-spacing: 0.5px; opacity: 0.8;'>BRANCH COMPARISON</div>" &
			            "<div style='font-size: 22px; font-weight: 700; letter-spacing: 0.5px;'>" & _JobCode & "</div>" &
			        "</div>" &
			        "<div style='display: flex; gap: 20px; align-items: center;'>" &
			            "<div style='text-align: center;'>" &
			                "<div style='font-size: 22px; font-weight: 700;'>" & _CompanyOrders & "</div>" &
			                "<div style='font-size: 10px; opacity: 0.7; letter-spacing: 0.5px;'>COMPANY ORDERS</div>" &
			            "</div>" &
			            "<div style='width: 1px; height: 35px; background: rgba(255,255,255,0.25);'></div>" &
			            "<div style='text-align: center;'>" &
			                "<div style='font-size: 22px; font-weight: 700; color: #93C5FD;'>" & _Branches & "</div>" &
			                "<div style='font-size: 10px; opacity: 0.7; letter-spacing: 0.5px;'>BRANCHES ACTIVE</div>" &
			            "</div>" &
			            "<div style='text-align: center;'>" &
			                "<div style='font-size: 22px; font-weight: 700; color: #6EE7B7;'>" & _UniqueParts & "</div>" &
			                "<div style='font-size: 10px; opacity: 0.7; letter-spacing: 0.5px;'>UNIQUE PARTS</div>" &
			            "</div>" &
			        "</div>" &
			    "</div>"
			)
		lineageTag: c4b5a697-8601-2345-cbad-876543210123

	measure 'Branch Analysis - Header' = ```
			
			// Get user name
			VAR _User = USERPRINCIPALNAME()
			VAR _Position = SEARCH("@", _User, 1)
			VAR _Name = LEFT(_User, _Position - 1)
			VAR _FirstLetter = UPPER(LEFT(_Name, 1))
			VAR _LastName = MID(_Name, 2, LEN(_Name) - 1)
