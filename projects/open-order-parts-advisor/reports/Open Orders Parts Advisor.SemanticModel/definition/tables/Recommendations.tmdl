		annotation SummarizationSetBy = Automatic

	partition Recommendations = calculated
		mode: import
		source = ```

				ADDCOLUMNS(
				    GENERATE(
				        Fact_OpenOrders,
				        VAR vJobCode  = Fact_OpenOrders[JobCode]
				        VAR vWONumber = Fact_OpenOrders[WorkOrderNumber]
				        VAR vExistingParts =
				            CALCULATETABLE(
				                VALUES(Fact_OpenOrderParts[PartNumber]),
				                Fact_OpenOrderParts[WorkOrderNumber] = vWONumber
				            )
				        RETURN
				            SELECTCOLUMNS(
				                FILTER(
				                    Fact_JobCodePartFrequency,
				                    Fact_JobCodePartFrequency[JobCode] = vJobCode
				                        && Fact_JobCodePartFrequency[FrequencyPct] >= 0.10
				                        && NOT(Fact_JobCodePartFrequency[PartNumber] IN vExistingParts)
				                        && LEFT(Fact_JobCodePartFrequency[PartNumber], 1) <> "*"
				                        && LOOKUPVALUE(dim_Parts[Franchise], dim_Parts[PartNumber], Fact_JobCodePartFrequency[PartNumber]) <> "ZP"
				                ),
				                "PartNumber",             Fact_JobCodePartFrequency[PartNumber],
				                "TimesWithPart",          Fact_JobCodePartFrequency[TimesWithPart],
				                "TotalOrdersWithJobCode", Fact_JobCodePartFrequency[TotalOrdersWithJobCode],
				                "FrequencyPct",           Fact_JobCodePartFrequency[FrequencyPct]
				            )
				    ),
				    "SellPrice",         LOOKUPVALUE(dim_Parts[SellPrice1],   dim_Parts[PartNumber], [PartNumber]),
				    "PartDescription",   LOOKUPVALUE(dim_Parts[Description],  dim_Parts[PartNumber], [PartNumber]),
				    "CustomerName",      LOOKUPVALUE(dim_CustomerList[DisplayName], dim_CustomerList[CustomerNumber], [CustomerNumber]),
				    "DaysOpen",          DATEDIFF([OpenDate], TODAY(), DAY),
				    "ConfidenceLevel",   IF([FrequencyPct] >= 0.50, "High", IF([FrequencyPct] >= 0.25, "Medium", "Low"))
				)

				```

	annotation PBI_Id = 9c38121dde524c4f88247060e822a817

