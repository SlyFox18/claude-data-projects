		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Welcome Name' =
			
			VAR _User =
			    USERPRINCIPALNAME ()
			VAR _Position =
			    SEARCH ( "@", _User, 1 )
			VAR _Name =
			    LEFT ( _User, _Position - 1 )
			VAR _FirstLetter =
			    UPPER ( LEFT ( _Name, 1 ) )
			VAR _LastName =
			    MID ( _Name, 2, LEN ( _Name ) - 1 )
			VAR _FormattedLastName =
			    UPPER ( LEFT ( _LastName, 1 ) )
			        & LOWER ( MID ( _LastName, 2, LEN ( _LastName ) ) )
			RETURN
			    "Welcome Back, " & _FirstLetter & "." & _FormattedLastName
		lineageTag: 511a57a0-1a7e-4caa-a9ac-716fbe3404ac

