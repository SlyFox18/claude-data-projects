	measure 'Show Filter 1' =
			
			VAR MaxFilters = 7
			RETURN
			    IF (
			        ISFILTERED ( dim_BranchLocation[Branch] ),
			        VAR ___f =
			            FILTERS ( dim_BranchLocation[Branch] )
			        VAR ___r =
			            COUNTROWS ( ___f )
			        VAR ___t =
			            TOPN ( MaxFilters, ___f, dim_BranchLocation[Branch] )
			        VAR ___d =
			            CONCATENATEX ( ___t, dim_BranchLocation[Branch], ", " )
			        VAR ___x =
			            "Branch:  " & ___d
			                & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			        RETURN
			            ___x & UNICHAR ( 13 )
			                & UNICHAR ( 10 )
			    )
		lineageTag: b0911c98-5918-468f-a415-556786bb7885

	measure 'Previous Year to Date Sales' =
			
			VAR CurrentDate =
			    TODAY ()
			VAR CurrentYear =
			    YEAR ( CurrentDate )
			VAR SameDateLastYear =
			    DATE ( CurrentYear - 1, MONTH ( CurrentDate ), DAY ( CurrentDate ) )
			RETURN
			    CALCULATE (
			        [Total_Sales],
			        dim_DateTable[Date]
			            >= DATE ( CurrentYear - 1, 1, 1 ),
			        dim_DateTable[Date] <= SameDateLastYear
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f1e300ff-beeb-4d92-a643-21f8115e43c7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure SPLY_Sales_Fixed =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( dim_UniqueCustomers[CustomerName] )
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentCustomer ),
			        CALCULATE (
			            [Total_Sales],
			            SAMEPERIODLASTYEAR ( dim_DateTable[Date] ),
			            dim_UniqueCustomers[CustomerName] = CurrentCustomer
			        ),
			        BLANK ()
			    )
		lineageTag: acfa1260-3332-46f1-bd9b-e3d04172b21c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DIfference Sales' =
			
			[YTD_Sales] - [Previous Year to Date Sales]
