	measure YTD_Sales =
			
			VAR SelectedYears =
			    VALUES ( dim_DateTable[Year] )
			VAR YearCount =
			    COUNTROWS ( SelectedYears )
			VAR TargetYear =
			    IF ( YearCount = 1, SELECTEDVALUE ( dim_DateTable[Year] ), YEAR ( TODAY () ) )
			RETURN
			    CALCULATE (
			        TOTALYTD ( [Total_Sales], dim_DateTable[Date] ),
			        YEAR ( dim_DateTable[Date] ) = TargetYear
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 869a587e-5549-4a78-8fd6-9d75bf15f9de

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

