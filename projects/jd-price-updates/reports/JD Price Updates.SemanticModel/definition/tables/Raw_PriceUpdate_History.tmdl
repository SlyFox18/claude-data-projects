	column IngestedAt
		dataType: dateTime
		formatString: General Date
		lineageTag: 624cbb0a-ffe4-41c7-a42c-0fb2fe9b31c6
		summarizeBy: none
		sourceColumn: IngestedAt

		annotation SummarizationSetBy = Automatic

	/// Normalized PartNumber (Trim+Upper) for joining to dim_Parts, which uses the same convention.
	column PartNumberKey = TRIM(UPPER('Raw_PriceUpdate_History'[PartNumber]))
		dataType: string
		lineageTag: c64a21e1-9546-4671-a919-56b2f225958e

	/// Cost implied before this price-change event, derived as DealerReplacePrice - CostDiff. Verified: CostDiff follows the same New-Old sign convention as the independently-confirmed SellPrice1Diff (sibling column, same JD export).
	column OldCost = 'Raw_PriceUpdate_History'[DealerReplacePrice] - 'Raw_PriceUpdate_History'[CostDiff]
		dataType: double
		formatString: $#,##0.00
		lineageTag: 38b43179-e20a-452e-a45a-4d75e53fdc43
		summarizeBy: average

	/// Dollar margin per unit AFTER this price change (DealerSellPrice1 minus DealerReplacePrice, i.e. cost).
	column NewMarginDollars = 'Raw_PriceUpdate_History'[DealerSellPrice1] - 'Raw_PriceUpdate_History'[DealerReplacePrice]
		dataType: double
		formatString: $#,##0.00
		lineageTag: 99c1eb77-6aa6-4159-8eb3-8e989b8cf120
		summarizeBy: average

	/// Dollar margin per unit BEFORE this price change (SellPriceOld minus OldCost).
	column OldMarginDollars = 'Raw_PriceUpdate_History'[SellPriceOld] - 'Raw_PriceUpdate_History'[OldCost]
		dataType: double
		formatString: $#,##0.00
		lineageTag: 6c66c625-2b9d-4681-a844-bbcaa90386c6
		summarizeBy: average

	/// Margin % per unit AFTER this price change.
	column NewMarginPct = DIVIDE('Raw_PriceUpdate_History'[NewMarginDollars], 'Raw_PriceUpdate_History'[DealerSellPrice1])
		dataType: double
		formatString: 0.0%
		lineageTag: 2923e18c-c26c-4655-a8ff-7957d9ef57f5
		summarizeBy: average

	/// Margin % per unit BEFORE this price change.
	column OldMarginPct = DIVIDE('Raw_PriceUpdate_History'[OldMarginDollars], 'Raw_PriceUpdate_History'[SellPriceOld])
		dataType: double
		formatString: 0.0%
		lineageTag: 896f4948-e46e-4572-bd83-336b843eb94f
		summarizeBy: average

	/// Change in margin % caused by this single price-change event. Negative = margin erosion, even if dollar margin held flat or increased -- the classic case Ben flagged: price and cost both go up proportionally, dollar margin unchanged, but margin % erodes because the sell price base is now higher.
	column MarginPctChange = 'Raw_PriceUpdate_History'[NewMarginPct] - 'Raw_PriceUpdate_History'[OldMarginPct]
		dataType: double
		formatString: 0.0%;-0.0%
		lineageTag: 7bf55986-2d26-4db2-927c-41245a859740
		summarizeBy: average

	/// Change in dollar margin per unit caused by this single price-change event.
	column MarginDollarsChange = 'Raw_PriceUpdate_History'[NewMarginDollars] - 'Raw_PriceUpdate_History'[OldMarginDollars]
		dataType: double
		formatString: $#,##0.00;-$#,##0.00
		lineageTag: d431492e-6277-4e1b-bc18-667eebfe89a1
		summarizeBy: average

	/// True if both old and new sell price are at least $1. Margin % math is statistically unstable below that (near-zero denominator) -- filter to this before ranking a table by margin % change, or the list gets dominated by noise, not real business signal. About 2% of rows fail this (mostly sub-$1 hardware like cotter pins, washers, etc.), not a defect -- just not meaningful for %-based ranking.
	column IsMaterialPrice = 'Raw_PriceUpdate_History'[SellPriceOld] >= 1 && 'Raw_PriceUpdate_History'[DealerSellPrice1] >= 1
		dataType: boolean
		lineageTag: f0312b00-a486-4ddd-b5c6-de416b965d58

	/// True if branches disagree on DealerSellPrice1, DealerReplacePrice, or SellPriceOld for the same PartNumber+EffectiveDate -- violates the documented 'branch doesn't affect price' assumption. This is real source-data corruption (one branch's file reporting a wrong price for an otherwise-consistent event), confirmed 2026-08-20 via AH166493/2019-03-25 (7 branches agree at $436.70, 1 branch reports $3.33). Filter this OUT of any margin % analysis -- it was never built when Fact_PriceUpdate_Enriched was abandoned in favor of the DAX-relationship approach, and is the real driver behind most of the implausible margin swings seen in ad-hoc tables.
	column HasBranchPriceDisagreement = VAR N1 = CALCULATE(DISTINCTCOUNT('Raw_PriceUpdate_History'[DealerSellPrice1]), ALLEXCEPT('Raw_PriceUpdate_History', 'Raw_PriceUpdate_History'[PartNumber], 'Raw_PriceUpdate_History'[EffectiveDate])) VAR N2 = CALCULATE(DISTINCTCOUNT('Raw_PriceUpdate_History'[DealerReplacePrice]), ALLEXCEPT('Raw_PriceUpdate_History', 'Raw_PriceUpdate_History'[PartNumber], 'Raw_PriceUpdate_History'[EffectiveDate])) VAR N3 = CALCULATE(DISTINCTCOUNT('Raw_PriceUpdate_History'[SellPriceOld]), ALLEXCEPT('Raw_PriceUpdate_History', 'Raw_PriceUpdate_History'[PartNumber], 'Raw_PriceUpdate_History'[EffectiveDate])) RETURN N1 > 1 || N2 > 1 || N3 > 1
		dataType: boolean
		lineageTag: 505b9761-772a-49f8-94df-1c6139235d2d

	/// Default 'good data' lens for margin analysis, per Ben (do not delete/hard-filter anomalies -- set them aside as an optional lens instead). True when: both old/new sell price >= $1 (IsMaterialPrice), branches agree on price for this event (NOT HasBranchPriceDisagreement -- confirmed real JD export defect), AND the derived OldCost isn't negative (NOT IsImplausibleCost -- unambiguous defect, cost can't be negative). IsExtremeSwingVsOwnHistory deliberately dropped from this flag 2026-08-26 -- that column cost ~12 min per refresh (a per-row 'search history for prior value' pattern DAX calculated columns handle very poorly at 5M+ rows) for a payoff of ~500 flagged rows; see projects/jd-price-updates/extreme_price_swings_review.csv for that list as a static, periodically-refreshed check instead of a live model column. Filter any visual to this = True for the primary/default view; excluded rows remain fully queryable by setting this to False or ignoring the filter -- nothing is deleted.
	column IsCleanForMarginAnalysis = 'Raw_PriceUpdate_History'[IsMaterialPrice] && NOT 'Raw_PriceUpdate_History'[HasBranchPriceDisagreement] && NOT 'Raw_PriceUpdate_History'[IsImplausibleCost]
		dataType: boolean
		lineageTag: 3a719f53-07fc-404c-83c5-7b9c92dfc41f

	/// True if the derived OldCost (DealerReplacePrice - CostDiff) is negative -- cost can never be negative, so this is an unambiguous data defect (confirmed 2026-08-21 via DZ130422/2024-06-24: OldCost=-$65,664.11). Root cause is a corrupted CostDiff for that event -- DealerReplacePrice itself (the raw, directly-ingested current cost) is never negative across the whole table, confirming the raw 'new cost' field is trustworthy; only this derived 'old cost' calc is affected. ~0.2% of rows (10,020). Unlike IsExtremeSwingVsOwnHistory, this is not a judgment call -- always fold into the clean flag.
	column IsImplausibleCost = 'Raw_PriceUpdate_History'[OldCost] < 0
		dataType: boolean
		lineageTag: 1a754717-8ad0-4874-bc78-6d019bbf4edd

	/// True when OldMarginDollars is at least $1 -- i.e. the part had a real, meaningfully positive margin before this price change, not a near-zero or negative one. Margin $ % Change is only trustworthy when this is true: dividing by a near-zero base produces meaningless huge percentages (confirmed 2026-09-01: a literal $0.00 old margin produced a 61-quadrillion-percent 'change'), and dividing by a negative base flips the sign so a worsening loss reads as an improvement (confirmed via A-204013: -$1.36 -> -$2.93 margin, a real decline, displayed as +115.4%). Not a data-quality flag like IsCleanForMarginAnalysis -- this is about which METRIC is meaningful for a given row, not whether the row is corrupted. Use as an optional slicer on Margin $ % Change specifically; Margin $ Change (the plain dollar delta) remains valid and well-behaved for every row regardless of this flag.
	column IsMarginDollarBaseValid = 'Raw_PriceUpdate_History'[OldMarginDollars] >= 1
		dataType: boolean
		lineageTag: dafbb46e-c123-4cdb-86f1-744a32bd0782

	/// Same-row (not history-lookup) sell price % change for this event: (DealerSellPrice1 - SellPriceOld) / SellPriceOld. Deliberately same-row, not a cross-row 'prior event' lookup like the retired IsExtremeSwingVsOwnHistory -- this is what makes trigger detection cheap at full-table scale.
	column SellPriceChangePercent = DIVIDE('Raw_PriceUpdate_History'[DealerSellPrice1] - 'Raw_PriceUpdate_History'[SellPriceOld], 'Raw_PriceUpdate_History'[SellPriceOld])
		dataType: double
		formatString: 0.0%;-0.0%
		lineageTag: 0f3a63e1-2eca-4884-a846-4fc456ff4a7b

	/// True if this event's sell price moved +/-10% or more (SellPriceChangePercent). Per Ben: the trigger point for a 'what happened after a big price move' trend analysis -- e.g. after a big price drop, did the price/margin recover, keep falling, or hold flat. Cheap same-row flag; the 'what happened after' part is evaluated at query time, scoped to one selected part via the PartNumber slicer, not materialized as a whole-table history lookup.
	column IsTriggerEvent = ABS('Raw_PriceUpdate_History'[SellPriceChangePercent]) >= 0.10
		dataType: boolean
		lineageTag: f1c1d0f3-ed7b-44d3-9aa7-0fedd6ce9d02

	partition Raw_PriceUpdate_History = m
		mode: import
		source =
				let
				    Source = Sql.Database("xcrafcusadsu3d3wi4anbgp6we-gxnyznhdptpenfw724g3o5sjzm.datawarehouse.fabric.microsoft.com", "LH_Master_Data"),
				    dbo_Raw_PriceUpdate_History = Source{[Schema="dbo",Item="Raw_PriceUpdate_History"]}[Data]
				in
				    dbo_Raw_PriceUpdate_History

