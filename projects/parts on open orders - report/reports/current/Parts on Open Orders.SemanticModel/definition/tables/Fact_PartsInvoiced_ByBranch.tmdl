table Fact_PartsInvoiced_ByBranch
	lineageTag: f3a8c291-5d4e-4b7a-9f1c-2e6d8a0b3c5f

	column Branch
		dataType: string
		lineageTag: a7f2e841-3b9c-4d5e-8f1a-c6d2e3b4a519
		summarizeBy: none
		sourceColumn: Branch

		annotation SummarizationSetBy = Automatic

	column InvoiceDate
		dataType: dateTime
		formatString: Short Date
		lineageTag: b8e3f952-4ca0-5e6f-9021-d7e3f4c5b620
		summarizeBy: none
