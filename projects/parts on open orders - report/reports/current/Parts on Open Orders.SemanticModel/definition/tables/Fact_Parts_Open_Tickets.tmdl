	column 'Order Count' =
			
			VAR _CurrentOrderNo = Fact_Parts_Open_Tickets[Order_No]
			RETURN
			COUNTROWS(FILTER(Fact_Parts_Open_Tickets, Fact_Parts_Open_Tickets[Order_No] =
			_CurrentOrderNo)
			)
		formatString: 0
