let
  Source = Odbc.Query("dsn=EquipRDB64", "-- Define the parameter for including miscellaneous transactions#(lf)DECLARE @IncludeMisc INT = 1; -- Set to 1 to include, 0 to exclude#(lf)#(lf)-- Define the start and end dates for the current year#(lf)DECLARE @StartDate DATE = '2025-01-01';#(lf)DECLARE @EndDate DATE = GETDATE();#(lf)#(lf)-- Create temporary table for current year sales data#(lf)CREATE TABLE #CurrentYearSalesData (#(lf)    Account NVARCHAR(50),#(lf)    Customer NVARCHAR(255),#(lf)    Territory NVARCHAR(50),#(lf)    Class NVARCHAR(50),#(lf)    InvoiceMonth INT,#(lf)    InvoiceYear INT,#(lf)    TotalCounts INT,#(lf)    TotalSales DECIMAL(18, 2),#(lf)    TotalCost DECIMAL(18, 2)#(lf));#(lf)#(lf)-- Insert current year sales data into temporary table#(lf)INSERT INTO #CurrentYearSalesData#(lf)SELECT #(lf)    ACC_NO AS Account, #(lf)    CASE WHEN ISNULL(contact.company_name, '') <> '' THEN contact.company_name ELSE contact.surname + ', ' + contact.name END AS Customer,#(lf)    ISNULL(ARMaster_Customer.Territory, '') AS Territory,#(lf)    ISNULL(contact.Account_Class, '') AS Class,#(lf)    MONTH(VhStock.SALESDATE) AS InvoiceMonth,#(lf)    YEAR(VhStock.SALESDATE) AS InvoiceYear,#(lf)    COUNT(no) AS TotalCounts,#(lf)    SUM(ISNULL(SALES_VALUE, 0)) + ISNULL((SELECT SUM(ISNULL(sale_value, 0)) FROM vhstockaccess WHERE vhstock.no = vhstockaccess.stock_no GROUP BY vhstock.no, vhstockaccess.stock_no), 0) AS TotalSales,#(lf)    SUM(ISNULL(retail, 0) + ISNULL(wholesale, 0) + ISNULL(predel_cost, 0) + ISNULL(repair_cost, 0) + ISNULL(access_cost, 0) + ISNULL(other_cost, 0) + ISNULL(rego_fees, 0) + ISNULL(lot_fees, 0) + ISNULL(stamp_duty, 0) + ISNULL(transfer_fees, 0) + ISNULL(option_cost, 0) + ISNULL(paint_cost, 0) + ISNULL(trim_cost, 0) + ISNULL(charge_cost, 0) + ISNULL(after_market_cost, 0)) +#(lf)    CASE WHEN 1 = 1 THEN ISNULL((SELECT SUM(ISNULL(vht.wholesale, 0) + ISNULL(vht.retail, 0) + ISNULL(vht.predel_cost, 0) + ISNULL(vht.repair_cost, 0) + ISNULL(vht.access_cost, 0) + ISNULL(vht.rego_fees, 0) + ISNULL(vht.lot_fees, 0) + ISNULL(vht.transfer_fees, 0) + ISNULL(vht.other_cost, 0) + ISNULL(vht.option_cost, 0) + ISNULL(vht.paint_cost, 0) + ISNULL(vht.trim_cost, 0) + ISNULL(vht.charge_cost, 0) + ISNULL(vht.after_market_cost, 0)) FROM vhtrans vht WHERE vht.stock_no = vhstock.no AND vht.after_sales_act = 'Y'), 0) ELSE 0 END +#(lf)    CASE WHEN 1 = 1 THEN SUM(ISNULL(ovrallow, 0)) + SUM(ISNULL(pre_trade_ovrallow, 0)) ELSE 0 END AS TotalCost#(lf)FROM ArMaster #(lf)INNER JOIN contact ON ARMaster.contact_code = contact.contact_code #(lf)INNER JOIN VhStock ON VhStock.Owner = contact.contact_code #(lf)INNER JOIN ARMaster_Customer ON ARMaster_Customer.contact_code = ARMaster.contact_code#(lf)WHERE VhStock.SALESDATE BETWEEN @StartDate AND @EndDate#(lf)GROUP BY ACC_NO, contact.company_name, contact.surname, contact.name, ARMaster_Customer.Territory, contact.Account_Class, no, MONTH(VhStock.SALESDATE), YEAR(VhStock.SALESDATE);#(lf)#(lf)-- Create temporary table for current year sundry data#(lf)CREATE TABLE #CurrentYearSundryData (#(lf)    Account NVARCHAR(50),#(lf)    InvoiceMonth INT,#(lf)    InvoiceYear INT,#(lf)    SundrySales DECIMAL(18, 2),#(lf)    SundryCost DECIMAL(18, 2)#(lf));#(lf)#(lf)-- Insert current year sundry data into temporary table#(lf)INSERT INTO #CurrentYearSundryData#(lf)SELECT #(lf)    VhStock.Owner AS Account,#(lf)    MONTH(VhStock.SALESDATE) AS InvoiceMonth,#(lf)    YEAR(VhStock.SALESDATE) AS InvoiceYear,#(lf)    SUM(ISNULL(intrans.Sale_val, 0)) AS SundrySales,#(lf)    SUM(ISNULL(intrans.Cost_val, 0)) AS SundryCost#(lf)FROM VhStock#(lf)LEFT OUTER JOIN (#(lf)    SELECT ref_no, SUM(Sale_val) AS Sale_val, SUM(Cost_val) AS Cost_val#(lf)    FROM intrans #(lf)    WHERE intrans.trans_datetime BETWEEN @StartDate AND @EndDate#(lf)    AND franchise IN ('ZP', 'ZS') AND type IN ('I', 'C') #(lf)    GROUP BY ref_no#(lf)) AS intrans ON intrans.ref_no = VhStock.no#(lf)WHERE VhStock.SALESDATE BETWEEN @StartDate AND @EndDate#(lf)GROUP BY VhStock.Owner, MONTH(VhStock.SALESDATE), YEAR(VhStock.SALESDATE);#(lf)#(lf)-- Final query to calculate current year (YTD) values#(lf)SELECT #(lf)    a.Account, #(lf)    a.Customer,#(lf)    a.Territory, #(lf)    a.Class,#(lf)    a.InvoiceMonth,#(lf)    a.InvoiceYear,#(lf)    ISNULL(SUM(a.TotalCounts), 0) AS [Sales Counts YTD],#(lf)    ISNULL(SUM(a.TotalSales) - CASE WHEN @IncludeMisc = 0 THEN ISNULL(s.SundrySales, 0) ELSE 0 END, 0) AS [Sales YTD],#(lf)    ISNULL(SUM(a.TotalCost) - CASE WHEN @IncludeMisc = 0 THEN ISNULL(s.SundryCost, 0) ELSE 0 END, 0) AS [Cost YTD],#(lf)    ISNULL(SUM(a.TotalSales) - SUM(a.TotalCost) - CASE WHEN @IncludeMisc = 0 THEN ISNULL(s.SundrySales, 0) - ISNULL(s.SundryCost, 0) ELSE 0 END, 0) AS [Margin YTD],#(lf)    CASE WHEN ISNULL(SUM(a.TotalSales) - CASE WHEN @IncludeMisc = 0 THEN ISNULL(s.SundrySales, 0) ELSE 0 END, 0) <> 0 #(lf)    THEN ISNULL(SUM(a.TotalSales) - SUM(a.TotalCost) - CASE WHEN @IncludeMisc = 0 THEN ISNULL(s.SundrySales, 0) - ISNULL(s.SundryCost, 0) ELSE 0 END, 0) / ISNULL(SUM(a.TotalSales) - CASE WHEN @IncludeMisc = 0 THEN ISNULL(s.SundrySales, 0) ELSE 0 END, 0) #(lf)    ELSE 0 END AS [GP % YTD]#(lf)FROM #CurrentYearSalesData a#(lf)LEFT JOIN #CurrentYearSundryData s ON a.Account = s.Account AND a.InvoiceMonth = s.InvoiceMonth AND a.InvoiceYear = s.InvoiceYear#(lf)GROUP BY a.Account, a.Customer, a.Territory, a.Class, a.InvoiceMonth, a.InvoiceYear, s.SundrySales, s.SundryCost#(lf)ORDER BY a.Account, a.InvoiceYear, a.InvoiceMonth;#(lf)#(lf)-- Drop temporary tables#(lf)DROP TABLE #CurrentYearSalesData;#(lf)DROP TABLE #CurrentYearSundryData;")
in
  Source