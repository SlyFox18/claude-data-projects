	measure 'Sales GP%' =
			
			DIVIDE (
			    SUM ( Combined_Sales_Data[Margin_YTD] ),
			    SUM ( Combined_Sales_Data[Sales_YTD] ),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3ab3be08-f20d-4853-be49-8d96cb7185d8

	measure 'Parts GP%' =
			
			DIVIDE ( SUM ( Parts_Data[Margin YTD] ), SUM ( Parts_Data[Sales YTD] ), 0 )
