	measure PromoUsedCurrentYear =
			
			CALCULATE(
			    COUNTROWS(InTrans_Promo),
			    FILTER(
			        InTrans_Promo,
			        InTrans_Promo[customer_no] = SELECTEDVALUE(Base_Customer_Info[Account]) &&
			        InTrans_Promo[PromoYear] = YEAR(TODAY())
			    ))
		formatString: 0
