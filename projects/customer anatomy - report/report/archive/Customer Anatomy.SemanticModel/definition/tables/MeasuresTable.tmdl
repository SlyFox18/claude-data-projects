		lineageTag: 0e6e6865-a8ce-421d-a49e-99e97001fc69

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total GP%' =
			
			DIVIDE ( [Total Margin], [Total Sales], 0 )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 660994c5-833a-47ae-9129-43fa0f92aec6

	measure 'Total Sales PYTD' =
			
