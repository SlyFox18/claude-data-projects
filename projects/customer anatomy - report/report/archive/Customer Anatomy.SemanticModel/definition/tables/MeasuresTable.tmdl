		lineageTag: f1b365b3-a59d-457e-a563-0caacbd50cb4

	measure 'YTD Sales' =
			
			IF (
			    [_ShowValueForDates],
			    CALCULATE (
			        [Sales],
			        DATESYTD ( 'Date'[Date] )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time intelligence\To-date total\Sales
		lineageTag: 152f22e4-5024-4053-9bf1-91f284bdcff7

		annotation SQLBI_Template = TimeIntelligence

		annotation SQLBI_TimeIntelligence = Standard

		annotation SQLBI_CalendarType = Calendar

	measure 'QTD Sales' =
			
			IF (
			    [_ShowValueForDates],
			    CALCULATE (
			        [Sales],
			        DATESQTD ( 'Date'[Date] )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time intelligence\To-date total\Sales
		lineageTag: e7475279-8249-477a-96a3-368a974ea737

		annotation SQLBI_Template = TimeIntelligence

		annotation SQLBI_TimeIntelligence = Standard

		annotation SQLBI_CalendarType = Calendar

	measure 'MTD Sales' =
			
			IF (
			    [_ShowValueForDates],
			    CALCULATE (
			        [Sales],
			        DATESMTD ( 'Date'[Date] )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time intelligence\To-date total\Sales
		lineageTag: 2d8d67c1-64b7-44ea-99c6-943be1ae76fd

		annotation SQLBI_Template = TimeIntelligence

		annotation SQLBI_TimeIntelligence = Standard

		annotation SQLBI_CalendarType = Calendar

	measure 'PY Sales' =
			
			IF (
			    [_ShowValueForDates],
			    CALCULATE (
			        [Sales],
			        CALCULATETABLE (
			            DATEADD ( 'Date'[Date], -1, YEAR ),
			            'Date'[DateWithTransactions] = TRUE
			        )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time intelligence\Growth\Sales
		lineageTag: 0d0debb0-ba3f-4433-af41-ea4938ac5a3c

		annotation SQLBI_Template = TimeIntelligence

		annotation SQLBI_TimeIntelligence = Standard

		annotation SQLBI_CalendarType = Calendar

	measure 'YOY Sales' =
			
			VAR __ValueCurrentPeriod = [Sales]
			VAR __ValuePreviousPeriod = [PY Sales]
			VAR __Result =
			    IF (
			        NOT ISBLANK ( __ValueCurrentPeriod ) && NOT ISBLANK ( __ValuePreviousPeriod ),
			        __ValueCurrentPeriod - __ValuePreviousPeriod
			    )
			RETURN
			    __Result
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time intelligence\Growth\Sales
		lineageTag: 021da460-7ba1-4860-a37e-23b0697e4545

		annotation SQLBI_Template = TimeIntelligence

		annotation SQLBI_TimeIntelligence = Standard

		annotation SQLBI_CalendarType = Calendar

	measure 'YOY % Sales' = ```
			
			DIVIDE ( 
			    [YOY Sales],
			    [PY Sales]
			)
			```
		formatString: 0.00%
		displayFolder: Time intelligence\Growth\Sales
		lineageTag: de83666d-792e-442d-bc68-74b8e9eeaf55

