		lineageTag: aae31e38-968e-40e1-a4d1-095dd70c4f5a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Margin' =
			
			[Sales Margin] + [Parts Margin] + [Service Margin]
