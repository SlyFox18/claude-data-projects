		annotation SummarizationSetBy = Automatic

	partition Combined_Sales_Data = calculated
		mode: import
		source =
				
				UNION(
				    SELECTCOLUMNS(
				        Sales_Data_YTD_New,
				        "Account", Sales_Data_YTD_New[Account],
				        "Customer", Sales_Data_YTD_New[Customer],
				        "Territory", Sales_Data_YTD_New[Territory],
				        "Class", Sales_Data_YTD_New[Class],
				        "InvoiceMonth", Sales_Data_YTD_New[InvoiceMonth],
				        "InvoiceYear", Sales_Data_YTD_New[InvoiceYear],
				        "Units", Sales_Data_YTD_New[Sales Counts YTD],
				        "Sales_YTD", Sales_Data_YTD_New[Sales YTD],
				        "Cost_YTD", Sales_Data_YTD_New[Cost YTD],
				        "Margin_YTD", Sales_Data_YTD_New[Margin YTD],
				        "GP_%_YTD", Sales_Data_YTD_New[GP % YTD],
				        "Sales_Counts_PYTD", 0,
				        "Sales_PYTD", 0,
				        "Cost_PYTD", 0,
				        "Margin_PYTD", 0,
				        "GP_%_PYTD", 0
				    ),
				    SELECTCOLUMNS(
				        Sales_Data_PYTD,
				        "Account", Sales_Data_PYTD[Account],
				        "Customer", Sales_Data_PYTD[Customer],
				        "Territory", Sales_Data_PYTD[Territory],
				        "Class", Sales_Data_PYTD[Class],
				        "InvoiceMonth", Sales_Data_PYTD[InvoiceMonth],
				        "InvoiceYear", Sales_Data_PYTD[InvoiceYear],
				        "Units", 0,
				        "Sales_YTD", 0,
				        "Cost_YTD", 0,
				        "Margin_YTD", 0,
				        "GP_%_YTD", 0,
				        "Sales_Counts_PYTD", Sales_Data_PYTD[Sales Counts PYTD],
				        "Sales_PYTD", Sales_Data_PYTD[Sales PYTD],
				        "Cost_PYTD", Sales_Data_PYTD[Cost PYTD],
				        "Margin_PYTD", Sales_Data_PYTD[Margin PYTD],
				        "GP_%_PYTD", Sales_Data_PYTD[GP % PYTD]
				    )
				)

	annotation PBI_Id = c56a83b1ae1a446088ced5cd99d7108f

