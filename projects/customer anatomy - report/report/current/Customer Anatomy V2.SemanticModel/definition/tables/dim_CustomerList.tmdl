	column CSM =
			VAR AcctNum = IFERROR(VALUE(dim_CustomerList[AccountNumber]), -999)
			RETURN
			IF(
			    AcctNum IN {
			        1410, 2323, 11744, 12093, 12394, 12395, 12421, 12422, 13452, 13917,
			        14603, 14604, 14862, 14950, 14951, 15118, 15120, 15123, 15134, 15142,
			        15178, 15216, 15240, 15249, 15260, 15697, 15894, 15896, 15901, 15902,
			        15903, 15904, 15905, 15920, 16074, 16079, 16249, 16255, 16260, 16305,
			        16311, 16314, 16519, 16545, 16572, 16589, 16592, 16593, 16599, 16840,
			        17296, 17384, 17487, 18094, 18489, 18500, 18697, 18701, 18875, 18878,
			        19105, 19617, 19638, 19651, 19652, 19662, 19694, 19735, 19741, 20143,
			        21315, 21367, 21378, 21576, 21659, 21730, 21776, 22399, 23002, 25018,
			        25603, 26998, 39609, 39632, 39965, 42122, 43003
			    },
			    "San Angelo CSM",
			    BLANK()
			)
		dataType: string
		lineageTag: c5m00001-0001-0001-0001-000000000001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Route Day' =
			VAR AcctNum = IFERROR(VALUE(dim_CustomerList[AccountNumber]), -999)
			RETURN
			SWITCH(
			    TRUE(),
			    AcctNum IN {1410, 2323, 12093, 13917, 14950, 14951, 16249, 16255, 16260, 18875, 18878, 21776, 23002, 25018, 39965, 43003}, "Thursday",
			    AcctNum IN {11744, 12394, 12421, 12422, 13452, 15142, 15240, 15249, 15697, 15920, 16074, 16079, 16305, 16314, 16545, 17384, 17487, 18094, 19105, 19735, 19741, 22399, 26998, 39609, 42122}, "Wednesday",
			    AcctNum IN {12395, 14862, 15118, 15120, 15178, 15260, 16572, 16589, 16592, 16593, 16599, 18500, 18697, 18701, 19662, 20143, 21315, 21378, 25603, 39632}, "Tuesday",
			    AcctNum IN {14603, 14604, 15123, 15134, 15216, 15894, 15896, 15901, 15902, 15903, 15904, 15905, 16311, 16840, 19617, 19638, 19651, 19652, 19694, 21367, 21576}, "Monday",
			    AcctNum IN {16519, 17296, 18489, 21659, 21730}, "Friday",
			    BLANK()
			)
		dataType: string
		lineageTag: c5m00001-0001-0001-0001-000000000002
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column EngagementLevel = ```
			
			VAR CustomerNum = dim_CustomerList[CustomerNumber]
			VAR EngagementMatch = 
			    LOOKUPVALUE(
			        dim_EngagedAcres[EngagementLevel],
			        dim_EngagedAcres[CustomerNumber],
			        CustomerNum
			    )
			RETURN
			    IF(ISBLANK(EngagementMatch), "Not Tracked", EngagementMatch)
			
			```
		lineageTag: 350553a5-52fa-48b7-9e44-0b60f634efa2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column UniqueCustomerGroup = ```
			
			LOOKUPVALUE(
			    lookup_UniqueCustomers_Invoice[UniqueCustomerGroup],
			    lookup_UniqueCustomers_Invoice[CustomerNumber],
			    dim_CustomerList[CustomerNumber]
			)
			
			```
		lineageTag: df776baa-7a1d-4196-8a5d-8066d27f4891
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsUniqueCustomer = ```
			NOT ISBLANK(dim_CustomerList[UniqueCustomerGroup])
			
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: f5b3a2fb-5327-44a6-add5-6534811fe156
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

