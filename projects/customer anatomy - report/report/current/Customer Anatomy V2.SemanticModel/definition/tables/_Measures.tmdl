	measure 'Sales Margin Icon' =
			
			VAR TotalValue   = [Equipment Margin (L1)]
			VAR CurrentValue = [Prior Period Equipment Margin]
			RETURN
			IF(
			    OR(ISBLANK(TotalValue), ISBLANK(CurrentValue)),
			    BLANK(),                                      -- hides icons when either side is blank
			    SWITCH(
			        TRUE(),
			        TotalValue > CurrentValue, 1,             -- positive
			        TotalValue < CurrentValue, 2,             -- negative
			        0                                         -- equal (neutral)
			    )
			)
		formatString: 0
		lineageTag: bc73e7f7-6bc7-4499-892c-52b42f3aad17

	measure 'Parts Summary Hero Card' = ```
			
			// ============================================
			// METRIC CALCULATIONS - Using Level 2 (Invoice) measures
			// ============================================
			VAR _Sales = [Parts Sales]
			VAR _PriorSales = CALCULATE([Parts Sales], SAMEPERIODLASTYEAR(dim_DateTable[Date]))
			VAR _SalesChange = _Sales - _PriorSales
			VAR _SalesChangePct = DIVIDE(_SalesChange, _PriorSales, 0)
			
			VAR _Margin = [Parts Margin]
			VAR _PriorMargin = CALCULATE([Parts Margin], SAMEPERIODLASTYEAR(dim_DateTable[Date]))
			VAR _MarginChange = _Margin - _PriorMargin
			VAR _MarginChangePct = DIVIDE(_MarginChange, _PriorMargin, 0)
			
			VAR _GP = DIVIDE(_Margin, _Sales, 0)
			VAR _PriorGP = DIVIDE(_PriorMargin, _PriorSales, 0)
			VAR _GPChange = _GP - _PriorGP
			
			VAR _Invoices = [Parts Invoice Count]
			VAR _PriorInvoices = CALCULATE([Parts Invoice Count], SAMEPERIODLASTYEAR(dim_DateTable[Date]))
			VAR _InvoicesChange = _Invoices - _PriorInvoices
			VAR _InvoicesChangePct = DIVIDE(_InvoicesChange, _PriorInvoices, 0)
			
			// Date Context
			VAR _MinDate = MIN(dim_DateTable[Date])
			VAR _MaxDate = MAX(dim_DateTable[Date])
			VAR _DateRange = FORMAT(_MinDate, "MMM D, YYYY") & " - " & FORMAT(_MaxDate, "MMM D, YYYY")
			
			// Formatting Helpers
			VAR _SalesArrow = IF(_SalesChange > 0, "▲", IF(_SalesChange < 0, "▼", "─"))
			VAR _SalesColor = IF(_SalesChange > 0, "#86efac", IF(_SalesChange < 0, "#fca5a5", "#d1d5db"))
			VAR _MarArrow = IF(_MarginChange > 0, "▲", IF(_MarginChange < 0, "▼", "─"))
			VAR _MarColor = IF(_MarginChange > 0, "#86efac", IF(_MarginChange < 0, "#fca5a5", "#d1d5db"))
			VAR _GPArrow = IF(_GPChange > 0, "▲", IF(_GPChange < 0, "▼", "─"))
			VAR _GPColor = IF(_GPChange > 0, "#86efac", IF(_GPChange < 0, "#fca5a5", "#d1d5db"))
			VAR _InvArrow = IF(_InvoicesChange > 0, "▲", IF(_InvoicesChange < 0, "▼", "─"))
			VAR _InvColor = IF(_InvoicesChange > 0, "#86efac", IF(_InvoicesChange < 0, "#fca5a5", "#d1d5db"))
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 20px 25px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    color: white;
			    height: 160px;
			    display: flex;
			    flex-direction: column;
			'>
			    <!-- Date Context Banner -->
			    <div style='
			        text-align: center;
			        font-size: 11px;
			        opacity: 0.9;
			        margin-bottom: 12px;
			        padding: 6px 12px;
			        background: rgba(255,255,255,0.1);
			        border-radius: 6px;
			        letter-spacing: 0.5px;
			    '>
			        📅 SELECTED PERIOD: " & _DateRange & "
			    </div>
			    
			    <!-- Metrics Row -->
			    <div style='display: flex; align-items: center; justify-content: space-around; flex: 1;'>
			        
			        <!-- Parts Sales -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px;'>
			                Parts Sales
			            </div>
			            <div style='font-size: 32px; font-weight: 700; line-height: 1.2; margin: 4px 0;'>
			                " & FORMAT(_Sales, "$#,##0") & "
			            </div>
			            <div style='font-size: 18px; font-weight: 600; color: " & _SalesColor & ";'>
			                " & _SalesArrow & " " & FORMAT(_SalesChangePct, "+0.0%;-0.0%") & " vs PY
			            </div>
			        </div>
			        
			        <!-- Divider -->
			        <div style='width: 1px; height: 70px; background: rgba(255,255,255,0.25);'></div>
			        
			        <!-- Parts Margin -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px;'>
			                Parts Margin
			            </div>
			            <div style='font-size: 32px; font-weight: 700; line-height: 1.2; margin: 4px 0;'>
			                " & FORMAT(_Margin, "$#,##0") & "
			            </div>
			            <div style='font-size: 18px; font-weight: 600; color: " & _MarColor & ";'>
			                " & _MarArrow & " " & FORMAT(_MarginChangePct, "+0.0%;-0.0%") & " vs PY
			            </div>
			        </div>
			        
			        <!-- Divider -->
			        <div style='width: 1px; height: 70px; background: rgba(255,255,255,0.25);'></div>
			        
			        <!-- GP% -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px;'>
			                Gross Profit %
			            </div>
			            <div style='font-size: 32px; font-weight: 700; line-height: 1.2; margin: 4px 0; color: #fcd34d;'>
			                " & FORMAT(_GP, "0.0%") & "
			            </div>
			            <div style='font-size: 18px; font-weight: 600; color: " & _GPColor & ";'>
			                " & _GPArrow & " " & FORMAT(_GPChange, "+0.0%;-0.0%") & " vs PY
			            </div>
			        </div>
			        
			        <!-- Divider -->
			        <div style='width: 1px; height: 70px; background: rgba(255,255,255,0.25);'></div>
			        
			        <!-- Invoices -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px;'>
			                Invoices
			            </div>
			            <div style='font-size: 32px; font-weight: 700; line-height: 1.2; margin: 4px 0;'>
			                " & FORMAT(_Invoices, "#,##0") & "
			            </div>
			            <div style='font-size: 18px; font-weight: 600; color: " & _InvColor & ";'>
			                " & _InvArrow & " " & FORMAT(_InvoicesChangePct, "+0.0%;-0.0%") & " vs PY
			            </div>
			        </div>
			    </div>
			</div>
			"
			
			```
		lineageTag: 060f5d99-140b-456b-89c6-4a5be4264c26

