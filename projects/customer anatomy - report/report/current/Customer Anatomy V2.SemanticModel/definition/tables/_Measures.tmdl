	measure 'Engaged Acres Header Card' = ```
			
			VAR _CustomerCount = DISTINCTCOUNT(dim_EngagedAcres[CustomerNumber])
			VAR _SingleCustomer = _CustomerCount = 1
			VAR _DisplayName = IF(_SingleCustomer, MAX(dim_CustomerList[DisplayName]), "Multiple Customers")
			VAR _AccountNumber = IF(_SingleCustomer, MAX(dim_CustomerList[AccountNumber]), FORMAT(_CustomerCount, "#,##0") & " Accounts")
			VAR _EngagementLevel = IF(_SingleCustomer, MAX(dim_CustomerList[EngagementLevel]), "Various")
			
			// Acre Metrics
			VAR _EstimatedAcres = SUM(dim_EngagedAcres[EstimatedAcres])
			VAR _EngagedAcres = SUM(dim_EngagedAcres[EngagedAcreBreadth])
			VAR _EngagedDepth = SUM(dim_EngagedAcres[EngagedAcreDepth])
			VAR _HighlyEngaged = SUM(dim_EngagedAcres[HighlyEngagedAcres])
			
			// Lifecycle Acres
			VAR _PrepareAcres = SUM(dim_EngagedAcres[PrepareAcres])
			VAR _PlantAcres = SUM(dim_EngagedAcres[PlantAcres])
			VAR _ApplyAcres = SUM(dim_EngagedAcres[ApplyAcres])
			VAR _HarvestAcres = SUM(dim_EngagedAcres[HarvestAcres])
			
			// Revenue Metrics
			VAR _TotalRevenue = [Total Revenue]
			VAR _PartsRevenue = [Parts Revenue]
			VAR _ServiceRevenue = [Service Revenue]
			
			// Calculated Metrics
			VAR _SalesPerAcre = DIVIDE(_TotalRevenue, _EngagedAcres, 0)
			VAR _DepthPercent = DIVIDE(_EngagedDepth, _EngagedAcres, 0)
			
			// Engagement Level Badge Color
			VAR _BadgeColor = 
			    SWITCH(
			        TRUE(),
			        CONTAINSSTRING(_EngagementLevel, "Highly"), "#10b981",
			        CONTAINSSTRING(_EngagementLevel, "Land"), "#3b82f6",
			        CONTAINSSTRING(_EngagementLevel, "R12"), "#f59e0b",
			        "#6b7280"
			    )
			
			// Depth color (green if >50%, yellow if >25%, red otherwise)
			VAR _DepthColor = IF(_DepthPercent >= 0.50, "#10b981", IF(_DepthPercent >= 0.25, "#f59e0b", "#ef4444"))
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 16px 24px;
			    background: white;
			    border-radius: 10px;
			    border: 1px solid #e5e7eb;
			    height: 140px;
			    display: flex;
			    gap: 24px;
			    box-sizing: border-box;
			'>
			    <!-- LEFT: Customer Info -->
			    <div style='flex: 1; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid #e5e7eb; padding-right: 24px;'>
			        <div style='font-size: 28px; font-weight: 700; color: #1f2937; margin-bottom: 6px;'>
			            " & _DisplayName & "
			        </div>
			        <div style='font-size: 16px; color: #6b7280; margin-bottom: 8px;'>
			            " & _AccountNumber & "
			        </div>
			        <div style='display: flex; gap: 12px; align-items: center;'>
			            <div style='background: " & _BadgeColor & "; color: white; padding: 4px 12px; border-radius: 6px; font-size: 16px; font-weight: 600;'>
			                " & _EngagementLevel & "
			            </div>
			            <span style='font-size: 18px; color: #6b7280;'>
			                Est. Acres: " & FORMAT(_EstimatedAcres, "#,##0") & "
			            </span>
			        </div>
			    </div>
			    
			    <!-- CENTER: Acre Metrics -->
			    <div style='flex: 0.8; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid #e5e7eb; padding-right: 20px;'>
			        <div style='display: flex; justify-content: space-between; margin-bottom: 8px;'>
			            <div>
			                <div style='font-size: 14px; color: #9ca3af; text-transform: uppercase;'>Engaged Acres</div>
			                <div style='font-size: 26px; font-weight: 600; color: #1f2937;'>" & FORMAT(_EngagedAcres, "#,##0") & "</div>
			                <div style='font-size: 14px; color: #6b7280;'>Highly Engaged: " & FORMAT(_HighlyEngaged, "#,##0") & "</div>
			            </div>
			            <div style='text-align: right;'>
			                <div style='font-size: 14px; color: #9ca3af; text-transform: uppercase;'>Sales / Acre</div>
			                <div style='font-size: 26px; font-weight: 600; color: #1f2937;'>" & FORMAT(_SalesPerAcre, "$#,##0") & "</div>
			                <div style='font-size: 14px; color: " & _DepthColor & "; font-weight: 600;'>Depth: " & FORMAT(_DepthPercent, "0%") & "</div>
			            </div>
			        </div>
			    </div>
			    
			    <!-- RIGHT: Revenue Summary -->
			    <div style='flex: 1; display: flex; align-items: center; justify-content: space-around;'>
			        <div style='text-align: center;'>
			            <div style='font-size: 14px; color: #9ca3af; text-transform: uppercase; font-weight: 600;'>Total Revenue</div>
			            <div style='font-size: 26px; font-weight: 700; color: #1f2937;'>" & FORMAT(_TotalRevenue, "$#,##0") & "</div>
			        </div>
			        <div style='text-align: center;'>
			            <div style='font-size: 14px; color: #9ca3af; text-transform: uppercase; font-weight: 600;'>Parts</div>
			            <div style='font-size: 26px; font-weight: 700; color: #1f2937;'>" & FORMAT(_PartsRevenue, "$#,##0") & "</div>
			        </div>
			        <div style='text-align: center;'>
			            <div style='font-size: 14px; color: #9ca3af; text-transform: uppercase; font-weight: 600;'>Service</div>
			            <div style='font-size: 26px; font-weight: 700; color: #1f2937;'>" & FORMAT(_ServiceRevenue, "$#,##0") & "</div>
			        </div>
			    </div>
			</div>
			"
			
			```
		lineageTag: 471ab203-30f3-4230-9f98-3342b4279bd5

	measure 'Per Acre Performance Card' = ```
			
			VAR _EngagedAcres = SUM(dim_EngagedAcres[EngagedAcreBreadth])
			VAR _TotalRevenue = [Total Revenue]
			VAR _PartsRevenue = [Parts Revenue]
			VAR _ServiceRevenue = [Service Revenue]
			
			VAR _SalesPerAcre = DIVIDE(_TotalRevenue, _EngagedAcres, 0)
			VAR _PartsPerAcre = DIVIDE(_PartsRevenue, _EngagedAcres, 0)
			VAR _ServicePerAcre = DIVIDE(_ServiceRevenue, _EngagedAcres, 0)
			
			// Calculate percentage of total for the bar widths
			VAR _MaxPerAcre = MAX(MAX(_SalesPerAcre, _PartsPerAcre), _ServicePerAcre)
			VAR _SalesWidth = DIVIDE(_SalesPerAcre, _MaxPerAcre, 0) * 100
			VAR _PartsWidth = DIVIDE(_PartsPerAcre, _MaxPerAcre, 0) * 100
			VAR _ServiceWidth = DIVIDE(_ServicePerAcre, _MaxPerAcre, 0) * 100
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 20px 24px;
			    background: white;
			    border-radius: 10px;
			    border: 1px solid #e5e7eb;
			    height: 220px;
			    box-sizing: border-box;
			'>
			    <div style='font-size: 14px; font-weight: 600; color: #6b7280; text-transform: uppercase; margin-bottom: 16px;'>
			        Revenue Per Engaged Acre
			    </div>
			    
			    <!-- Total Sales per Acre -->
			    <div style='margin-bottom: 14px;'>
			        <div style='display: flex; justify-content: space-between; margin-bottom: 4px;'>
			            <span style='font-size: 13px; color: #374151; font-weight: 500;'>Total Sales</span>
			            <span style='font-size: 16px; color: #1f2937; font-weight: 700;'>" & FORMAT(_SalesPerAcre, "$#,##0") & "</span>
			        </div>
			        <div style='background: #e5e7eb; border-radius: 4px; height: 8px; overflow: hidden;'>
			            <div style='background: linear-gradient(90deg, #3b82f6, #1d4ed8); height: 100%; width: " & FORMAT(_SalesWidth, "0") & "%; border-radius: 4px;'></div>
			        </div>
			    </div>
			    
			    <!-- Parts per Acre -->
			    <div style='margin-bottom: 14px;'>
			        <div style='display: flex; justify-content: space-between; margin-bottom: 4px;'>
			            <span style='font-size: 13px; color: #374151; font-weight: 500;'>Parts</span>
			            <span style='font-size: 16px; color: #1f2937; font-weight: 700;'>" & FORMAT(_PartsPerAcre, "$#,##0") & "</span>
			        </div>
			        <div style='background: #e5e7eb; border-radius: 4px; height: 8px; overflow: hidden;'>
			            <div style='background: linear-gradient(90deg, #f59e0b, #d97706); height: 100%; width: " & FORMAT(_PartsWidth, "0") & "%; border-radius: 4px;'></div>
			        </div>
			    </div>
			    
			    <!-- Service per Acre -->
			    <div>
			        <div style='display: flex; justify-content: space-between; margin-bottom: 4px;'>
			            <span style='font-size: 13px; color: #374151; font-weight: 500;'>Service</span>
			            <span style='font-size: 16px; color: #1f2937; font-weight: 700;'>" & FORMAT(_ServicePerAcre, "$#,##0") & "</span>
			        </div>
			        <div style='background: #e5e7eb; border-radius: 4px; height: 8px; overflow: hidden;'>
			            <div style='background: linear-gradient(90deg, #10b981, #059669); height: 100%; width: " & FORMAT(_ServiceWidth, "0") & "%; border-radius: 4px;'></div>
			        </div>
			    </div>
			</div>
			"
			
			```
		lineageTag: 402b2727-9a1d-437a-b4cb-ba3f11d15be8

	measure 'Lifecycle Engagement Card' = ```
			
			VAR _PrepareAcres = SUM(dim_EngagedAcres[PrepareAcres])
			VAR _PlantAcres = SUM(dim_EngagedAcres[PlantAcres])
			VAR _ApplyAcres = SUM(dim_EngagedAcres[ApplyAcres])
			VAR _HarvestAcres = SUM(dim_EngagedAcres[HarvestAcres])
			VAR _TotalEngaged = SUM(dim_EngagedAcres[EngagedAcreBreadth])
			
			VAR _PreparePercent = DIVIDE(_PrepareAcres, _TotalEngaged, 0) * 100
			VAR _PlantPercent = DIVIDE(_PlantAcres, _TotalEngaged, 0) * 100
			VAR _ApplyPercent = DIVIDE(_ApplyAcres, _TotalEngaged, 0) * 100
			VAR _HarvestPercent = DIVIDE(_HarvestAcres, _TotalEngaged, 0) * 100
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 20px 24px;
			    background: white;
			    border-radius: 10px;
			    border: 1px solid #e5e7eb;
			    height: 220px;
			    box-sizing: border-box;
			'>
			    <div style='font-size: 14px; font-weight: 600; color: #6b7280; text-transform: uppercase; margin-bottom: 20px;'>
			        Farming Lifecycle Engagement
			    </div>
			    
			    <div style='display: flex; justify-content: space-between; gap: 16px;'>
			        <!-- Prepare -->
			        <div style='flex: 1; text-align: center;'>
			            <div style='
			                width: 60px; height: 60px; 
			                background: linear-gradient(135deg, #8b5cf6, #6d28d9); 
			                border-radius: 50%; 
			                margin: 0 auto 8px auto;
			                display: flex; align-items: center; justify-content: center;
			                color: white; font-size: 18px; font-weight: 700;
			            '>" & FORMAT(_PreparePercent, "0") & "%</div>
			            <div style='font-size: 16px; font-weight: 600; color: #374151;'>Prepare</div>
			            <div style='font-size: 14px; color: #6b7280;'>" & FORMAT(_PrepareAcres, "#,##0") & " ac</div>
			        </div>
			        
			        <!-- Arrow -->
			        <div style='display: flex; align-items: center; color: #d1d5db; font-size: 24px;'>→</div>
			        
			        <!-- Plant -->
			        <div style='flex: 1; text-align: center;'>
			            <div style='
			                width: 60px; height: 60px; 
			                background: linear-gradient(135deg, #10b981, #059669); 
			                border-radius: 50%; 
			                margin: 0 auto 8px auto;
			                display: flex; align-items: center; justify-content: center;
			                color: white; font-size: 18px; font-weight: 700;
			            '>" & FORMAT(_PlantPercent, "0") & "%</div>
			            <div style='font-size: 16px; font-weight: 600; color: #374151;'>Plant</div>
			            <div style='font-size: 14px; color: #6b7280;'>" & FORMAT(_PlantAcres, "#,##0") & " ac</div>
			        </div>
			        
			        <!-- Arrow -->
			        <div style='display: flex; align-items: center; color: #d1d5db; font-size: 20px;'>→</div>
			        
			        <!-- Apply -->
			        <div style='flex: 1; text-align: center;'>
			            <div style='
			                width: 60px; height: 60px; 
			                background: linear-gradient(135deg, #3b82f6, #1d4ed8); 
			                border-radius: 50%; 
			                margin: 0 auto 8px auto;
			                display: flex; align-items: center; justify-content: center;
			                color: white; font-size: 18px; font-weight: 700;
			            '>" & FORMAT(_ApplyPercent, "0") & "%</div>
			            <div style='font-size: 16px; font-weight: 600; color: #374151;'>Apply</div>
			            <div style='font-size: 14px; color: #6b7280;'>" & FORMAT(_ApplyAcres, "#,##0") & " ac</div>
			        </div>
			        
			        <!-- Arrow -->
			        <div style='display: flex; align-items: center; color: #d1d5db; font-size: 20px;'>→</div>
			        
			        <!-- Harvest -->
			        <div style='flex: 1; text-align: center;'>
			            <div style='
			                width: 60px; height: 60px; 
			                background: linear-gradient(135deg, #f59e0b, #d97706); 
			                border-radius: 50%; 
			                margin: 0 auto 8px auto;
			                display: flex; align-items: center; justify-content: center;
			                color: white; font-size: 18px; font-weight: 700;
			            '>" & FORMAT(_HarvestPercent, "0") & "%</div>
			            <div style='font-size: 16px; font-weight: 600; color: #374151;'>Harvest</div>
			            <div style='font-size: 14px; color: #6b7280;'>" & FORMAT(_HarvestAcres, "#,##0") & " ac</div>
			        </div>
			    </div>
			</div>
			"
			
			```
		lineageTag: 398bebc1-79bd-4345-a8f9-8beb751da200

