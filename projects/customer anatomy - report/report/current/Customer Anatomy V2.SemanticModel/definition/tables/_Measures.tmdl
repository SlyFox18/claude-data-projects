	measure 'Revenue Icon' =
			
			VAR TotalValue   = [Total Revenue]
			VAR CurrentValue = [Prior Period Revenue]
			RETURN
			IF(
			    OR(ISBLANK(TotalValue), ISBLANK(CurrentValue)),
			    BLANK(),                                      -- hides icons when either side is blank
			    SWITCH(
			        TRUE(),
			        TotalValue > CurrentValue, 1,             -- positive
			        TotalValue < CurrentValue, 2,             -- negative
			        0                                         -- equal (neutral)
			    )
			)
		formatString: 0
		lineageTag: fca090f8-c489-4a2a-b2ab-417006ba3753

