			            <div><strong>E</strong> = Equipment</div>
			        </div>
			        <div>
			            <div><span style='color: #86efac;'>✔</span> = Active</div>
			            <div><span style='color: #fca5a5;'>✘</span> = No Activity</div>
			        </div>
			        <div>
			            <div style='color: #93c5fd;'>PY → Current</div>
			            <div style='margin-top: 4px; font-size: 12px; opacity: 0.8;'>Example: P: ✔ → ✔ &nbsp; S: ✔ → ✘</div>
			            <div style='font-size: 12px; opacity: 0.7;'>Buying parts both periods,<br/>lost service business</div>
			        </div>
			    </div>
			</div>
			"
			
			```
		lineageTag: 9d8f9c66-9401-4151-8e40-e972966d34ea

	measure 'Sales per Acre' =
			
			VAR TotalAcres = SUM(dim_EngagedAcres[EstimatedAcres])
			RETURN
			    DIVIDE([Total Revenue], TotalAcres, BLANK())
		formatString: \$#,0;(\$#,0);\$#,0
