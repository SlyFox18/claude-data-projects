			        <div style='font-size: 13px; opacity: 0.9; margin-bottom: 6px;'>
			            " & TimeGreeting & ", " & WelcomeName & "
			        </div>
			        <div style='font-size: 16px; font-weight: 600;'>
			            📅 " & DateDisplay & "
