	/// CUSTOMER RETENTION / CHURN ANALYSIS MEASURES
	measure 'Revenue Change $' = [Total Revenue YTD] - [Total Revenue PYTD]
		formatString: "$"#,##0;("$"#,##0);"$"0
		lineageTag: a1b2c3d4-0009-0001-0001-000000000001

	measure 'Revenue Change %' = DIVIDE([Total Revenue YTD] - [Total Revenue PYTD], [Total Revenue PYTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a1b2c3d4-0009-0001-0001-000000000002

	measure 'Customer Status' =
			VAR YTDRev = [Total Revenue YTD]
			VAR PYTDRev = [Total Revenue PYTD]
			VAR ChangeRatio = DIVIDE(YTDRev, PYTDRev, 0)
			RETURN
			SWITCH(
			    TRUE(),
			    PYTDRev > 0 && YTDRev = 0, "Churned",
			    PYTDRev > 0 && ChangeRatio < 0.5, "At Risk",
			    PYTDRev > 0 && ChangeRatio < 0.8, "Declining",
			    PYTDRev = 0 && YTDRev > 0, "New Customer",
			    ChangeRatio >= 0.8 && ChangeRatio <= 1.2, "Stable",
			    ChangeRatio > 1.2, "Growing",
			    "No Activity"
			)
		lineageTag: a1b2c3d4-0009-0001-0001-000000000003

	measure 'Equipment Change $' = [Equipment Sales YTD] - [Equipment Sales PYTD]
		formatString: "$"#,##0;("$"#,##0);"$"0
		lineageTag: a1b2c3d4-0009-0001-0001-000000000004

	measure 'Parts Change $' = [Parts Sales YTD] - [Parts Sales PYTD]
		formatString: "$"#,##0;("$"#,##0);"$"0
		lineageTag: a1b2c3d4-0009-0001-0001-000000000005

	measure 'Service Change $' = [Service Sales YTD] - [Service Sales PYTD]
		formatString: "$"#,##0;("$"#,##0);"$"0
		lineageTag: a1b2c3d4-0009-0001-0001-000000000006

	measure 'Equipment Status' =
			VAR YTDRev = [Equipment Sales YTD]
			VAR PYTDRev = [Equipment Sales PYTD]
			RETURN
			SWITCH(
			    TRUE(),
			    PYTDRev > 0 && YTDRev = 0, "Lost",
			    PYTDRev = 0 && YTDRev > 0, "New",
			    PYTDRev > 0 && YTDRev > 0, "Active",
			    "None"
			)
		lineageTag: a1b2c3d4-0009-0001-0001-000000000007

	measure 'Parts Status' =
			VAR YTDRev = [Parts Sales YTD]
			VAR PYTDRev = [Parts Sales PYTD]
			RETURN
			SWITCH(
			    TRUE(),
			    PYTDRev > 0 && YTDRev = 0, "Lost",
			    PYTDRev = 0 && YTDRev > 0, "New",
			    PYTDRev > 0 && YTDRev > 0, "Active",
			    "None"
			)
		lineageTag: a1b2c3d4-0009-0001-0001-000000000008

	measure 'Service Status' =
			VAR YTDRev = [Service Sales YTD]
			VAR PYTDRev = [Service Sales PYTD]
			RETURN
			SWITCH(
			    TRUE(),
			    PYTDRev > 0 && YTDRev = 0, "Lost",
			    PYTDRev = 0 && YTDRev > 0, "New",
			    PYTDRev > 0 && YTDRev > 0, "Active",
			    "None"
			)
		lineageTag: a1b2c3d4-0009-0001-0001-000000000009

	measure 'Churned Customer Count' =
			SUMX(
			    FILTER(
			        SUMMARIZE(dim_CustomerList, dim_CustomerList[CustomerKey]),
			        CALCULATE([Total Revenue PYTD]) > 0 && CALCULATE([Total Revenue YTD]) = 0
			    ),
			    1
			)
		formatString: #,##0
		lineageTag: a1b2c3d4-0009-0001-0001-000000000012

	measure 'At Risk Customer Count' =
			SUMX(
			    FILTER(
			        SUMMARIZE(dim_CustomerList, dim_CustomerList[CustomerKey]),
			        CALCULATE([Total Revenue PYTD]) > 0 &&
			        DIVIDE(CALCULATE([Total Revenue YTD]), CALCULATE([Total Revenue PYTD]), 0) < 0.5 &&
			        DIVIDE(CALCULATE([Total Revenue YTD]), CALCULATE([Total Revenue PYTD]), 0) > 0
			    ),
			    1
			)
		formatString: #,##0
		lineageTag: a1b2c3d4-0009-0001-0001-000000000013

	measure 'Declining Customer Count' =
			SUMX(
			    FILTER(
			        SUMMARIZE(dim_CustomerList, dim_CustomerList[CustomerKey]),
			        VAR Ratio = DIVIDE(CALCULATE([Total Revenue YTD]), CALCULATE([Total Revenue PYTD]), 0)
			        RETURN CALCULATE([Total Revenue PYTD]) > 0 && Ratio >= 0.5 && Ratio < 0.8
			    ),
			    1
			)
		formatString: #,##0
		lineageTag: a1b2c3d4-0009-0001-0001-000000000014

	measure 'Growing Customer Count' =
			SUMX(
			    FILTER(
			        SUMMARIZE(dim_CustomerList, dim_CustomerList[CustomerKey]),
			        CALCULATE([Total Revenue YTD]) > CALCULATE([Total Revenue PYTD]) * 1.2
			    ),
			    1
			)
		formatString: #,##0
		lineageTag: a1b2c3d4-0009-0001-0001-000000000015

	measure 'New Customer Count' =
			SUMX(
			    FILTER(
			        SUMMARIZE(dim_CustomerList, dim_CustomerList[CustomerKey]),
			        CALCULATE([Total Revenue PYTD]) = 0 && CALCULATE([Total Revenue YTD]) > 0
			    ),
			    1
			)
		formatString: #,##0
		lineageTag: a1b2c3d4-0009-0001-0001-000000000016

