	measure 'Recurring Revenue PY' = ```
			
			CALCULATE([Parts Revenue], SAMEPERIODLASTYEAR(dim_DateTable[Date])) + 
			CALCULATE([Service Revenue], SAMEPERIODLASTYEAR(dim_DateTable[Date]))
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 066fa86a-2275-4da0-acb6-d6cd3ca0d299

	measure 'Recurring Customer Status' = ```
			
			VAR _Current = [Recurring Revenue]
			VAR _Prior = [Recurring Revenue PY]
			VAR _Ratio = DIVIDE(_Current, _Prior, 0)
			RETURN
			SWITCH(
			    TRUE(),
			    _Prior > 0 && _Current = 0, "Churned",
			    _Prior > 0 && _Ratio < 0.5, "At Risk",
			    _Prior > 0 && _Ratio < 0.8, "Declining",
			    _Prior = 0 && _Current > 0, "New",
			    _Ratio >= 0.8 && _Ratio <= 1.2, "Stable",
			    _Ratio > 1.2, "Growing",
			    "No Activity"
			)
			
			
			```
		lineageTag: 170b3ef5-46d2-4a80-9edf-769cbf63d32a

	measure 'Department Engagement' = ```
			
			VAR _PartsCY = IF([Parts Revenue] > 0, "✔", "✘")
			VAR _PartsPY = IF([Parts Revenue PY] > 0, "✔", "✘")
			VAR _ServiceCY = IF([Service Revenue] > 0, "✔", "✘")
			VAR _ServicePY = IF([Service Revenue PY] > 0, "✔", "✘")
			VAR _EquipCY = IF([Equipment Revenue] > 0, "✔", "✘")
			VAR _EquipPY = IF([Equipment Revenue PY] > 0, "✔", "✘")
			RETURN
			"P: " & _PartsPY & " → " & _PartsCY & 
			"   S: " & _ServicePY & " → " & _ServiceCY & 
			"   E: " & _EquipPY & " → " & _EquipCY
			
			
			```
		lineageTag: 80a0a267-6355-46c0-bed8-997d4883718f

	measure 'Revenue at Risk' = ```
			
			SUMX(
			    FILTER(
			        SUMMARIZE(dim_CustomerList, dim_CustomerList[CustomerKey]),
			        VAR _Status = CALCULATE([Recurring Customer Status])
			        RETURN _Status IN {"Churned", "At Risk"}
			    ),
			    CALCULATE([Recurring Revenue PY])
			)
			
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: f183e3a9-f36b-4779-8c66-3e880352e8b1

	measure 'Retention Hero Card' = ```
			
			VAR _Churned = [Recurring Churned Count]
			VAR _AtRisk = [Recurring At Risk Count]
			VAR _Declining = [Recurring Declining Count]
			VAR _Growing = [Recurring Growing Count]
			VAR _New = [Recurring New Count]
			
			VAR _MinDate = MIN(dim_DateTable[Date])
			VAR _MaxDate = MAX(dim_DateTable[Date])
			VAR _DateRange = FORMAT(_MinDate, "MMM D, YYYY") & " - " & FORMAT(_MaxDate, "MMM D, YYYY")
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 20px 25px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    color: white;
			    height: 160px;
			    display: flex;
			    flex-direction: column;
			'>
			    <!-- Date Context Banner -->
			    <div style='
			        text-align: center;
			        font-size: 11px;
			        opacity: 0.9;
			        margin-bottom: 12px;
			        padding: 6px 12px;
			        background: rgba(255,255,255,0.1);
			        border-radius: 6px;
			        letter-spacing: 0.5px;
			    '>
			        📅 SELECTED PERIOD: " & _DateRange & " &nbsp;&nbsp;|&nbsp;&nbsp; RECURRING REVENUE RETENTION (PARTS + SERVICE)
			    </div>
			    
			    <!-- Metrics Row -->
			    <div style='display: flex; align-items: center; justify-content: space-around; flex: 1;'>
			        
			        <!-- Churned -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px;'>Churned</div>
			            <div style='font-size: 32px; font-weight: 700; line-height: 1.2; margin: 4px 0; color: #fca5a5;'>" & FORMAT(_Churned, "#,##0") & "</div>
			            <div style='font-size: 14px; opacity: 0.7;'>No activity this period</div>
			        </div>
			        
			        <div style='width: 1px; height: 70px; background: rgba(255,255,255,0.25);'></div>
			        
			        <!-- At Risk -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px;'>At Risk</div>
			            <div style='font-size: 32px; font-weight: 700; line-height: 1.2; margin: 4px 0; color: #fdba74;'>" & FORMAT(_AtRisk, "#,##0") & "</div>
			            <div style='font-size: 14px; opacity: 0.7;'>Revenue &lt; 50% of PY</div>
			        </div>
			        
			        <div style='width: 1px; height: 70px; background: rgba(255,255,255,0.25);'></div>
			        
			        <!-- Declining -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px;'>Declining</div>
			            <div style='font-size: 32px; font-weight: 700; line-height: 1.2; margin: 4px 0; color: #fcd34d;'>" & FORMAT(_Declining, "#,##0") & "</div>
			            <div style='font-size: 14px; opacity: 0.7;'>Revenue 50-80% of PY</div>
			        </div>
			        
			        <div style='width: 1px; height: 70px; background: rgba(255,255,255,0.25);'></div>
			        
			        <!-- Growing -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px;'>Growing</div>
			            <div style='font-size: 32px; font-weight: 700; line-height: 1.2; margin: 4px 0; color: #86efac;'>" & FORMAT(_Growing, "#,##0") & "</div>
			            <div style='font-size: 14px; opacity: 0.7;'>Revenue &gt; 120% of PY</div>
			        </div>
			        
			        <div style='width: 1px; height: 70px; background: rgba(255,255,255,0.25);'></div>
			        
			        <!-- New -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px;'>New Customers</div>
			            <div style='font-size: 32px; font-weight: 700; line-height: 1.2; margin: 4px 0; color: #93c5fd;'>" & FORMAT(_New, "#,##0") & "</div>
			            <div style='font-size: 14px; opacity: 0.7;'>No prior activity</div>
			        </div>
			    </div>
			</div>
