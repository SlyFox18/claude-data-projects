	measure 'MoM Change' = ```
			
			VAR MinDate = MIN(dim_DateTable[Date])
			VAR MaxDate = MAX(dim_DateTable[Date])
			VAR DayCount = DATEDIFF(MinDate, MaxDate, DAY) + 1
			
			VAR CurrentRate = [Overall Capture Rate]
			
			// Determine comparison logic based on period type
			VAR ComparisonRate = 
			    SWITCH(
			        TRUE(),
			        // Single month: use PREVIOUSMONTH
			        DayCount <= 31 && DAY(MinDate) = 1 && DAY(EOMONTH(MaxDate, 0)) = DAY(MaxDate),
			            CALCULATE(
			                [Overall Capture Rate],
			                PREVIOUSMONTH(dim_DateTable[Date])
			            ),
			        // Quarter: use PREVIOUSQUARTER
			        DayCount >= 89 && DayCount <= 92 && MONTH(MinDate) IN {1,4,7,10} && DAY(MinDate) = 1,
			            CALCULATE(
			                [Overall Capture Rate],
			                PREVIOUSQUARTER(dim_DateTable[Date])
			            ),
			        // YTD: compare to same YTD last year
			        YEAR(MinDate) = YEAR(MaxDate) && MONTH(MinDate) = 1 && DAY(MinDate) = 1,
			            CALCULATE(
			                [Overall Capture Rate],
			                SAMEPERIODLASTYEAR(dim_DateTable[Date])
			            ),
			        // Rolling periods or custom ranges: compare to same period last year
			        DayCount > 100,
			            CALCULATE(
			                [Overall Capture Rate],
			                DATEADD(dim_DateTable[Date], -1, YEAR)
			            ),
			        // Short custom periods (< 100 days): month-over-month
			        CALCULATE(
			            [Overall Capture Rate],
			            DATEADD(dim_DateTable[Date], -1, MONTH)
			        )
			    )
			
			RETURN 
			IF(
			    NOT(ISBLANK(ComparisonRate)),
			    CurrentRate - ComparisonRate,
			    BLANK()
			)
			```
		lineageTag: 549ee3d9-2dce-45a3-90a2-9bd1e074699b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YTD Capture Rate' =
			
			CALCULATE(
			    [Overall Capture Rate],
