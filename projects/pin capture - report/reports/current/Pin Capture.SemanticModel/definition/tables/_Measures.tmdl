	measure 'MoM Change - Pin Capture' =
			
			VAR CurrentRate = [% Dollars with Pin (Cost)]
			VAR PriorRate = [Pin Capture Rate - Previous Month]
			VAR Change = CurrentRate - PriorRate
			
			RETURN
			IF(
			    ISBLANK(PriorRate),
			    BLANK(),
			    Change
			)
		lineageTag: 0fd34ce6-c031-4ce3-8d96-506d0ea05fb7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Change Text' = ```
			
			VAR Change = [MoM Change - Pin Capture]
			VAR ChangeText = FORMAT(Change, "+0.0%;-0.0%;0.0%")
			VAR Arrow = 
			    IF(Change > 0, "↑", 
			    IF(Change < 0, "↓", "→"))
			RETURN
			IF(
			    ISBLANK(Change),
			    "No prior data",
			    ChangeText & " " & Arrow
			)
			```
		lineageTag: 26c0767e-08f6-43e8-9f01-148dd2702dd3

	measure 'MoM Change Color' =
			
			VAR Change = [MoM Change - Pin Capture]
			RETURN
			IF(
			    ISBLANK(Change), "#94a3b8",  // Gray if no data
			    IF(Change > 0, "#4ade80",     // Green if improving
			    IF(Change < 0, "#ef4444",     // Red if declining
			    "#94a3b8"))                   // Gray if flat
			)
		lineageTag: fd8feea7-f316-428a-86f6-b2ae2f682705

	measure 'Top 3 Branches' = ```
			
			VAR TopBranches = 
			    TOPN(
			        3,
			        SUMMARIZE(
			            Fact_PinTransactions,
			            dim_BranchLocation[Branch],
			            "CaptureRate", [% Dollars with Pin (Cost)],
			            "MoMChange", [MoM Change - Pin Capture]
			        ),
			        [CaptureRate],
			        DESC
			    )
			RETURN
			CONCATENATEX(
			    TopBranches,
			    "✓ " & [Branch] & 
			    "    " & FORMAT([CaptureRate], "0.0%") & 
			    "  (" & 
			    IF([MoMChange] > 0, "↑ +" & FORMAT([MoMChange], "0.0%"), 
			    IF([MoMChange] < 0, "↓ " & FORMAT([MoMChange], "0.0%"), 
			    "→ " & FORMAT([MoMChange], "0.0%"))) & 
			    " vs last month)",
			    UNICHAR(10),  // Line break
			    [CaptureRate],
			    DESC
			)
			```
		lineageTag: 5788df6c-8761-4f3a-8fff-8ab5022be607

	measure 'Bottom 3 Branches' = ```
			
			VAR BottomBranches = 
