	measure 'Pin Capture Goal' = 0.10  // 10% target - adjust based on stakeholder goal
		lineageTag: 49b9d207-c2e0-410d-bcf1-807304ed17eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hero Card - Pin Capture' = ```
			
			VAR TotalCost = [Total Cost]
			VAR CostWithPin = [Cost with Pin]
			VAR PctCost = [% Dollars with Pin (Cost)]
			VAR PctCostText = FORMAT(PctCost, "0.0%")
			
			VAR TotalTrans = [Total Transactions]
			VAR TransWithPin = [Transactions with Pins]
			VAR PctTrans = DIVIDE(TransWithPin, TotalTrans, 0)
			VAR PctTransText = FORMAT(PctTrans, "0.0%")
			
			VAR PinGoal = 0.10  // 10% target
			VAR CostGoalColor = IF(PctCost >= PinGoal, "#4ade80", IF(PctCost >= PinGoal * 0.5, "#fbbf24", "#ef4444"))
			VAR TransGoalColor = IF(PctTrans >= PinGoal, "#4ade80", IF(PctTrans >= PinGoal * 0.5, "#fbbf24", "#ef4444"))
			
			// Section 1: Cost with Pin
			VAR CostWithPinText = 
			    IF(CostWithPin >= 1000000,
			        FORMAT(CostWithPin / 1000000, "$#,##0.0") & "M",
			        FORMAT(CostWithPin / 1000, "$#,##0") & "K"
			    )
			VAR TotalCostText = 
			    IF(TotalCost >= 1000000,
			        FORMAT(TotalCost / 1000000, "$#,##0.0") & "M",
			        FORMAT(TotalCost / 1000, "$#,##0") & "K"
			    )
			
			// Section 4: Month-over-Month Change
			VAR MoMChange = [MoM Change - Pin Capture]
			VAR MoMChangeText = 
			    IF(
			        ISBLANK(MoMChange),
			        "N/A",
			        FORMAT(MoMChange, "+0.0%;-0.0%;0.0%")
			    )
			VAR MoMArrow = 
			    IF(
			        ISBLANK(MoMChange), "",
			        IF(MoMChange > 0, " ↑", 
			        IF(MoMChange < 0, " ↓", " →"))
			    )
			VAR MoMColor = 
			    IF(
			        ISBLANK(MoMChange), "#94a3b8",
			        IF(MoMChange > 0, "#4ade80",
			        IF(MoMChange < 0, "#ef4444", "#94a3b8"))
			    )
			
			// Section 5: Top Performer (Branch)
			VAR TopBranchName = 
			    CALCULATE(
			        SELECTEDVALUE(dim_BranchLocation[Branch]),
			        TOPN(1, ALL(dim_BranchLocation[Branch]), [% Transactions with Pin], DESC)
			    )
			VAR TopBranchPct = 
			    CALCULATE(
			        [% Transactions with Pin],
			        TOPN(1, ALL(dim_BranchLocation[Branch]), [% Transactions with Pin], DESC)
			    )
			VAR TopBranchText = FORMAT(TopBranchPct, "0.0%")
			
			// Unique pins for context
			VAR UniquePins = [Unique Pins Tracked]
			
			// CONTEXT ROW
			VAR MinDate = MIN(dim_DateTable[Date])
			VAR MaxDate = MAX(dim_DateTable[Date])
			VAR SelectedPeriod = 
			    IF(
			        DATEDIFF(MinDate, MaxDate, DAY) <= 31,
			        FORMAT(MaxDate, "MMMM YYYY"),
			        IF(
			            DATEDIFF(MinDate, MaxDate, DAY) <= 100,
			            "Q" & QUARTER(MaxDate) & " " & YEAR(MaxDate),
			            "YTD " & YEAR(MaxDate)
			        )
			    )
			VAR ActiveBranches = [Active Branches]
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 25px 30px 20px 30px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    box-shadow: 0 8px 24px rgba(0,0,0,0);
			    color: white;
			    height: 210px;
			    display: flex;
			    flex-direction: column;
			    justify-content: space-between;
			'>
			    <!-- Main Content Row -->
			    <div style='display: flex; align-items: center; justify-content: space-around;'>
			        <!-- Section 1: Cost with Pin -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.9; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;'>
			                Cost with Pin Captured
			            </div>
			            <div style='font-size: 72px; font-weight: 700; line-height: 1;'>
			                " & CostWithPinText & "
			            </div>
			            <div style='font-size: 18px; margin-top: 10px; opacity: 0.9;'>
			                Total Cost: " & TotalCostText & "
			            </div>
			        </div>
			        
			        <!-- Divider -->
			        <div style='width: 2px; height: 120px; background: rgba(255,255,255,0.3); margin: 0 20px;'></div>
			        
			        <!-- Section 2: % of Dollars with Pin -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.9; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;'>
			                % of Dollars with Pin
			            </div>
			            <div style='
			                font-size: 64px; 
			                font-weight: 700; 
			                line-height: 1;
			                color: " & CostGoalColor & ";
			            '>
			                " & PctCostText & "
			            </div>
			            <div style='font-size: 18px; margin-top: 10px; font-weight: 600;'>
			                Goal: " & FORMAT(PinGoal, "0%") & " | Cost Basis
			            </div>
			        </div>
			        
			        <!-- Divider -->
			        <div style='width: 2px; height: 120px; background: rgba(255,255,255,0.3); margin: 0 20px;'></div>
			        
			        <!-- Section 3: % of Transactions with Pin -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.9; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;'>
			                Pin Capture Rate
			            </div>
			            <div style='
			                font-size: 64px; 
			                font-weight: 700; 
			                line-height: 1;
			                color: " & TransGoalColor & ";
			            '>
			                " & PctTransText & "
			            </div>
			            <div style='font-size: 18px; margin-top: 10px; font-weight: 600;'>
			                " & FORMAT(TransWithPin, "#,##0") & " of " & FORMAT(TotalTrans, "#,##0") &"
			            </div>
			        </div>
			        
			        <!-- Divider -->
			        <div style='width: 2px; height: 120px; background: rgba(255,255,255,0.3); margin: 0 20px;'></div>
			        
			        <!-- Section 4: Month-over-Month Trend -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.9; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;'>
			                Trend (MoM)
			            </div>
			            <div style='
			                font-size: 56px; 
			                font-weight: 700; 
			                line-height: 1;
			                color: " & MoMColor & ";
			            '>
			                " & MoMChangeText & MoMArrow & "
			            </div>
			            <div style='font-size: 16px; margin-top: 10px; opacity: 0.9;'>
			                " & FORMAT(UniquePins, "#,##0") & " unique pins
			            </div>
			        </div>
			        
			        <!-- Divider -->
			        <div style='width: 2px; height: 120px; background: rgba(255,255,255,0.3); margin: 0 20px;'></div>
			        
			        <!-- Section 5: Top Branch -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 14px; opacity: 0.9; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;'>
			                Top Branch
			            </div>
			            <div style='font-size: 56px; font-weight: 700; line-height: 1; color: #4ade80;'>
			                " & TopBranchText & "
			            </div>
			            <div style='font-size: 18px; margin-top: 10px; opacity: 0.9;'>
			                " & TopBranchName & "
			            </div>
			        </div>
			    </div>
			    
			    <!-- Context Footer -->
			    <div style='
			        margin-top: 10px;
			        padding-top: 10px;
			        border-top: 1px solid rgba(255,255,255,0.2);
			        font-size: 12px;
			        opacity: 0.85;
			        text-align: center;
			        letter-spacing: 0.5px;
			    '>
			        Selected: <strong>" & SelectedPeriod & "</strong> | <strong>" & ActiveBranches & "</strong> Branch Locations | Tracking <strong>" & FORMAT(UniquePins, "#,##0") & "</strong> Unique Pins
			    </div>
			</div>
			"
			```
		lineageTag: d7da257b-354f-4538-9ecd-4dac37d37fb3

