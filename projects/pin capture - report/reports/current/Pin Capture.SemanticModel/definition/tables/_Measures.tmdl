	measure '% Pin Capture by Franchise' =
			
			DIVIDE(
			    CALCULATE([Transactions with Pins], ALLEXCEPT(Fact_PinTransactions, Fact_PinTransactions[Franchise])),
			    CALCULATE([Total Transactions], ALLEXCEPT(Fact_PinTransactions, Fact_PinTransactions[Franchise])),
			    0
			)
