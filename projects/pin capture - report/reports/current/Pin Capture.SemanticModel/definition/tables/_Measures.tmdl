	measure 'Top Performers This Month' = ```
			
			VAR TopBranches = 
			    TOPN(
			        5,
			        SUMMARIZE(
			            dim_BranchLocation,
			            dim_BranchLocation[BranchName],
			            "CaptureRate", [Branch Capture Rate],
			            "MoMChange", [Branch MoM Change]
			        ),
			        [CaptureRate],
			        DESC
			    )
			RETURN
			CONCATENATEX(
			    TopBranches,
			    dim_BranchLocation[BranchName] & ": " & 
			    FORMAT([CaptureRate], "0.0%") & " (" & 
			    FORMAT([MoMChange], "+0.0%;-0.0%") & ")",
			    UNICHAR(10)  // Line break
			)
			```
