	measure 'Drill Through - Invoice Hero Card' = ```
			
			VAR InvoiceNum = SELECTEDVALUE(Fact_PinTransactions[RONumber], "N/A")
			VAR InvoiceDate = SELECTEDVALUE(Fact_PinTransactions[TransDatetime])
			VAR Branch = SELECTEDVALUE(Fact_PinTransactions[Branch])
			VAR BranchName = SELECTEDVALUE(dim_BranchLocation[BranchName], "Branch " & Branch)
			VAR CustomerNo = SELECTEDVALUE(Fact_PinTransactions[CustomerNo], "N/A")
			
			VAR LineCount = COUNTROWS(Fact_PinTransactions)
			VAR TotalCost = SUM(Fact_PinTransactions[CostValue])
			VAR TotalSales = SUM(Fact_PinTransactions[SaleValue])
			VAR TotalMargin = SUM(Fact_PinTransactions[Margin])
			VAR MarginPct = DIVIDE(TotalMargin, TotalSales)
			VAR PinsFound = COUNTROWS(FILTER(Fact_PinTransactions, NOT(ISBLANK([Pin Identifier]))))
			
			// Color coding for margin
			VAR MarginColor = IF(MarginPct >= 0.30, "#4ade80", IF(MarginPct >= 0.20, "#fbbf24", "#ef4444"))
			
			// *** SMART NUMBER FORMATTING ***
			VAR TotalCostText = FORMAT(TotalCost, "$#,##0")
			    
			VAR TotalSalesText = FORMAT(TotalSales, "$#,##0")
			
			VAR TotalMarginText = FORMAT(TotalMargin, "$#,##0")
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 20px 30px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    box-shadow: 0 8px 24px rgba(0,0,0,0);
			    color: white;
			    height: 130px;
			    display: flex;
			    justify-content: space-between;
			    align-items: center;
			    gap: 15px;
			'>
			    <!-- Section 1: Invoice Number -->
			    <div style='flex: 1.2; text-align: center; border-right: 1px solid rgba(255,255,255,0.2); padding-right: 15px;'>
			        <div style='font-size: 18px; opacity: 0.85; margin-bottom: 6px;'>Invoice Number</div>
			        <div style='font-size: 40px; font-weight: 700; margin-bottom: 4px;'>" & InvoiceNum & "</div>
			        <div style='font-size: 18px; opacity: 0.75;'>" & FORMAT(InvoiceDate, "M/D/YYYY") & "</div>
			    </div>
			    
			    <!-- Section 2: Branch & Customer -->
			    <div style='flex: 1; text-align: center; border-right: 1px solid rgba(255,255,255,0.2); padding-right: 15px;'>
			        <div style='font-size: 18px; opacity: 0.85; margin-bottom: 6px;'>Location</div>
			        <div style='font-size: 40px; font-weight: 700; margin-bottom: 4px;'>" & BranchName & "</div>
			        <div style='font-size: 18px; opacity: 0.75;'>Customer: " & CustomerNo & "</div>
			    </div>
			    
			    <!-- Section 3: Line Items -->
			    <div style='flex: 0.8; text-align: center; border-right: 1px solid rgba(255,255,255,0.2); padding-right: 15px;'>
			        <div style='font-size: 18px; opacity: 0.85; margin-bottom: 6px;'>Line Items</div>
			        <div style='font-size: 40px; font-weight: 700; margin-bottom: 4px;'>" & LineCount & "</div>
			        <div style='font-size: 18px; opacity: 0.75;'>" & PinsFound & " with pins</div>
			    </div>
			    
			    <!-- Section 4: Total Cost -->
			    <div style='flex: 0.9; text-align: center; border-right: 1px solid rgba(255,255,255,0.2); padding-right: 15px;'>
			        <div style='font-size: 18px; opacity: 0.85; margin-bottom: 6px;'>Total Cost</div>
			        <div style='font-size: 40px; font-weight: 700; margin-bottom: 4px;'>" & TotalCostText & "</div>
			        <div style='font-size: 18px; opacity: 0.75;'>Invoice total</div>
			    </div>
			    
			    <!-- Section 5: Total Sales -->
			    <div style='flex: 0.9; text-align: center; border-right: 1px solid rgba(255,255,255,0.2); padding-right: 15px;'>
			        <div style='font-size: 18px; opacity: 0.85; margin-bottom: 6px;'>Total Sales</div>
			        <div style='font-size: 40px; font-weight: 700; margin-bottom: 4px;'>" & TotalSalesText & "</div>
			        <div style='font-size: 18px; opacity: 0.75;'>Revenue</div>
			    </div>
			    
			    <!-- Section 6: Margin -->
			    <div style='flex: 0.9; text-align: center;'>
			        <div style='font-size: 18px; opacity: 0.85; margin-bottom: 6px;'>Margin</div>
			        <div style='font-size: 40px; font-weight: 700; margin-bottom: 4px;'>" & TotalMarginText & "</div>
			        <div style='font-size: 18px; opacity: 0.75; color: " & MarginColor & ";'>" & FORMAT(MarginPct, "0.0%") & " margin</div>
			    </div>
			</div>"
			```
		lineageTag: 091541de-d9cf-412a-b666-ce23f0bed4e7

	measure 'Branch Performance - Hero Card' = ```
			
			VAR TotalBranches = [Active Branches]
			VAR OverallRate = [Overall Capture Rate]
			VAR TotalTrans = [Total Transactions]
			VAR TransWithPins = [Transactions with Pins]
			VAR TotalCostWithPins = [Cost with Pin]
			VAR MonthChange = [MoM Change]
			
			// Get actual date range
			VAR MinDate = MIN(dim_DateTable[Date])
			VAR MaxDate = MAX(dim_DateTable[Date])
			VAR DayCount = DATEDIFF(MinDate, MaxDate, DAY) + 1
			
			// Smart period detection with ACTUAL date ranges for custom periods
			VAR SelectedPeriod = 
			    IF(
			        DayCount = 1,
			        // Single day
			        FORMAT(MaxDate, "MMM DD, YYYY"),
			        IF(
			            DayCount <= 31 && DAY(MinDate) = 1 && DAY(EOMONTH(MaxDate, 0)) = DAY(MaxDate),
			            // Full single month
			            FORMAT(MaxDate, "MMMM YYYY"),
			            IF(
			                DayCount >= 89 && DayCount <= 92 && MONTH(MinDate) IN {1,4,7,10} && DAY(MinDate) = 1,
			                // Full quarter
			                "Q" & QUARTER(MaxDate) & " " & YEAR(MaxDate),
			                IF(
			                    YEAR(MinDate) = YEAR(MaxDate) && MONTH(MinDate) = 1 && DAY(MinDate) = 1 && MaxDate = TODAY() - 1,
			                    // True YTD (starts Jan 1, ends yesterday)
			                    "YTD " & YEAR(MaxDate),
			                    // Everything else: show actual date range
			                    FORMAT(MinDate, "MMM DD, YYYY") & " - " & FORMAT(MaxDate, "MMM DD, YYYY")
			                )
			            )
			        )
			    )
			
			// Comparison period — actual prior date range, mirrors the branch
			// logic in [MoM Change] so the label always matches what's being
			// compared instead of a vague "Prior Period"
			VAR PriorStart =
			    SWITCH(
			        TRUE(),
			        DayCount <= 31 && DAY(MinDate) = 1 && DAY(EOMONTH(MaxDate, 0)) = DAY(MaxDate),
			            EDATE(MinDate, -1),
			        DayCount >= 89 && DayCount <= 92 && MONTH(MinDate) IN {1,4,7,10} && DAY(MinDate) = 1,
			            EDATE(MinDate, -3),
			        YEAR(MinDate) = YEAR(MaxDate) && MONTH(MinDate) = 1 && DAY(MinDate) = 1,
			            DATE(YEAR(MinDate) - 1, 1, 1),
			        DayCount > 100,
			            DATE(YEAR(MinDate) - 1, MONTH(MinDate), DAY(MinDate)),
			        EDATE(MinDate, -1)
			    )
			VAR PriorEnd =
			    SWITCH(
			        TRUE(),
			        DayCount <= 31 && DAY(MinDate) = 1 && DAY(EOMONTH(MaxDate, 0)) = DAY(MaxDate),
			            EOMONTH(MaxDate, -1),
			        DayCount >= 89 && DayCount <= 92 && MONTH(MinDate) IN {1,4,7,10} && DAY(MinDate) = 1,
			            MinDate - 1,
			        YEAR(MinDate) = YEAR(MaxDate) && MONTH(MinDate) = 1 && DAY(MinDate) = 1,
			            DATE(YEAR(MaxDate) - 1, MONTH(MaxDate), DAY(MaxDate)),
			        DayCount > 100,
			            DATE(YEAR(MaxDate) - 1, MONTH(MaxDate), DAY(MaxDate)),
			        EDATE(MaxDate, -1)
			    )
			VAR PriorRangeText = FORMAT(PriorStart, "MMM DD") & "–" & FORMAT(PriorEnd, "MMM DD, YYYY")
			
			// Trend arrow and color
			VAR ShowComparison = NOT(ISBLANK(MonthChange))
			VAR TrendArrow = IF(ShowComparison, IF(MonthChange > 0, "↑", IF(MonthChange < 0, "↓", "→")), "")
			VAR TrendColor = IF(MonthChange > 0, "#4ade80", IF(MonthChange < 0, "#ef4444", "#fbbf24"))
			VAR ChangeText = IF(ShowComparison, FORMAT(MonthChange, "+0.0%;-0.0%;0.0%"), "—")
			
			// Smart number formatting
			VAR CostFormatted = "$" & FORMAT(TotalCostWithPins, "#,##0")
			
			
			VAR TransFormatted = FORMAT(TotalTrans, "#,##0")
			VAR PinsFormatted = FORMAT(TransWithPins, "#,##0")
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 20px 30px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    box-shadow: 0 8px 24px rgba(0,0,0,0);
			    color: white;
			    height: 160px;
			    display: flex;
			    flex-direction: column;
			    justify-content: space-between;
			'>
			    <!-- Metrics Row -->
			    <div style='display: flex; justify-content: space-between; align-items: center; gap: 25px;'>
			        <!-- Capture Rate -->
			        <div style='flex: 1; text-align: center;'>
			            <div style='font-size: 42px; font-weight: 700; margin-bottom: 4px;'>" & FORMAT(OverallRate, "0.0%") & "</div>
			            <div style='font-size: 18px; opacity: 0.80;'>Capture Rate</div>
			        </div>
			        
			        <!-- Total Transactions -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 42px; font-weight: 700; margin-bottom: 4px;'>" & TransFormatted & "</div>
			            <div style='font-size: 18px; opacity: 0.80;'>Total Transactions</div>
			        </div>
			        
			        <!-- Pins Captured -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 42px; font-weight: 700; margin-bottom: 4px;'>" & PinsFormatted & "</div>
			            <div style='font-size: 18px; opacity: 0.80;'>Transactions with Pin</div>
			        </div>
			        
			        <!-- Cost with Pins -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 42px; font-weight: 700; margin-bottom: 4px;'>" & CostFormatted & "</div>
			            <div style='font-size: 18px; opacity: 0.80;'>Cost Captured</div>
			        </div>
			        
			        <!-- Change vs Prior -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 42px; font-weight: 700; margin-bottom: 4px; color: " & TrendColor & ";'>" & TrendArrow & " " & ChangeText & "</div>
			            <div style='font-size: 18px; opacity: 0.80;'>vs " & PriorRangeText & "</div>
			        </div>
			    </div>
			
			    <!-- Context Row -->
			    <div style='
			        padding-top: 12px;
			        border-top: 1px solid rgba(255,255,255,0.2);
			        font-size: 16px;
			        opacity: 0.85;
			        text-align: center;
			    '>
			        Selected: <strong>" & SelectedPeriod & "</strong> |
			        <strong>" & TotalBranches & "</strong> Branch Locations |
			        Comparison: vs <strong>" & PriorRangeText & "</strong>
			    </div>
			</div>"
			```
		lineageTag: b3ae46d1-d02f-454a-86d3-737c249dec69

