	measure 'Matrix Filter - Pin Status' =
			
			VAR SelectedOption = SELECTEDVALUE(PinFilterOptions[Filter Option], "WithPin")  // Default to WithPin
			VAR CurrentInvoiceHasPin = [Invoice Has Pin]
			RETURN
			SWITCH(
			    SelectedOption,
			    "All", 1,  // Show everything
			    "WithPin", IF(CurrentInvoiceHasPin = "Yes", 1, 0),  // Show only with pins
			    "WithoutPin", IF(CurrentInvoiceHasPin = "No", 1, 0),  // Show only without pins
			    1  // Default: show all
			)
