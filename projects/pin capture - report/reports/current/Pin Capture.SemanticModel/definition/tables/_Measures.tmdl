	measure 'Pin Capture Rate - Previous Month' = ```
			
			VAR PreviousMonthDates = 
			    FILTER(
			        ALL(dim_DateTable),
			        dim_DateTable[IsPreviousMonth] = TRUE
			    )
			VAR PreviousRate = 
			    CALCULATE(
			        [% Dollars with Pin (Cost)],
