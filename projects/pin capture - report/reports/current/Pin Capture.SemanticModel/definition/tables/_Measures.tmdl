	measure 'Transaction Detail Hero Card' = ```
			
			VAR InvoicesShown = DISTINCTCOUNT(Fact_PinTransactions[RONumber])
			
			// Remove the Invoice Has Pin Flag filter to get ALL transactions
			VAR TotalTransactions = 
			    CALCULATE(
			        DISTINCTCOUNT(Fact_PinTransactions[RONumber]),
			        REMOVEFILTERS(Fact_PinTransactions[Invoice Has Pin Flag])
			    )
			
			VAR PinCaptureRate = DIVIDE(InvoicesShown, TotalTransactions, 0)
			
			VAR TotalCost = [Cost with Pin]
			VAR TotalSales = [Sale with Pin]
			VAR TotalMargin = [Margin with Pin]
			VAR AvgInvoice = DIVIDE(TotalCost, InvoicesShown, 0)
			VAR MarginPct = DIVIDE(TotalMargin, TotalSales, 0)
			
			// Get actual date range
			VAR MinDate = MIN(dim_DateTable[Date])
			VAR MaxDate = MAX(dim_DateTable[Date])
			VAR DayCount = DATEDIFF(MinDate, MaxDate, DAY) + 1
			
			// Smart period detection with ACTUAL date ranges
			VAR SelectedPeriod = 
			    IF(
			        DayCount = 1,
			        FORMAT(MaxDate, "MMM DD, YYYY"),
			        IF(
			            DayCount <= 31 && DAY(MinDate) = 1 && DAY(EOMONTH(MaxDate, 0)) = DAY(MaxDate),
			            FORMAT(MaxDate, "MMMM YYYY"),
			            IF(
			                DayCount >= 89 && DayCount <= 92 && MONTH(MinDate) IN {1,4,7,10} && DAY(MinDate) = 1,
			                "Q" & QUARTER(MaxDate) & " " & YEAR(MaxDate),
			                IF(
			                    YEAR(MinDate) = YEAR(MaxDate) && MONTH(MinDate) = 1 && DAY(MinDate) = 1 && MaxDate = TODAY() - 1,
			                    "YTD " & YEAR(MaxDate),
			                    FORMAT(MinDate, "MMM DD, YYYY") & " - " & FORMAT(MaxDate, "MMM DD, YYYY")
			                )
			            )
			        )
			    )
			
			// *** SMART NUMBER FORMATTING ***
			VAR InvoicesShownText = FORMAT(InvoicesShown, "#,##0")
			VAR CaptureRateText = FORMAT(PinCaptureRate, "0.0%")
			
			VAR TotalCostText = FORMAT(TotalCost, "$#,##0")
			 
			VAR TotalSalesText = FORMAT(TotalSales, "$#,##0")
			
			VAR TotalMarginText = FORMAT(TotalMargin, "$#,##0")
			
			VAR AvgInvoiceText = FORMAT(AvgInvoice, "$#,##0")
			
			VAR MarginPctText = FORMAT(MarginPct, "0.0%")
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 15px 30px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    box-shadow: 0 8px 24px rgba(0,0,0,0);
			    color: white;
			    height: 155px;
			    display: flex;
			    flex-direction: column;
			    justify-content: space-between;
			'>
			    <!-- Metrics Row -->
			    <div style='display: flex; justify-content: space-around; align-items: center; gap: 20px;'>
			        <!-- Card 1: Invoices Shown -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; margin-bottom: 6px;'>
			                Invoices Shown
			            </div>
			            <div style='font-size: 40px; font-weight: 700; line-height: 1;'>
			                " & InvoicesShownText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75; margin-top: 4px;'>
			                " & CaptureRateText & " of total transactions
			            </div>
			        </div>
			        
			        <!-- Card 2: Total Cost -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; margin-bottom: 6px;'>
			                Total Cost
			            </div>
			            <div style='font-size: 40px; font-weight: 700; line-height: 1;'>
			                " & TotalCostText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75; margin-top: 4px;'>
			                All line items
			            </div>
			        </div>
			        
			        <!-- Card 3: Total Sales -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; margin-bottom: 6px;'>
			                Total Sales
			            </div>
			            <div style='font-size: 40px; font-weight: 700; line-height: 1;'>
			                " & TotalSalesText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75; margin-top: 4px;'>
			                Revenue
			            </div>
			        </div>
			        
			        <!-- Card 4: Margin -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; margin-bottom: 6px;'>
			                Margin
			            </div>
			            <div style='font-size: 40px; font-weight: 700; line-height: 1; color: #4ade80;'>
			                " & TotalMarginText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75; margin-top: 4px;'>
			                " & MarginPctText & " margin
			            </div>
			        </div>
			        
			        <!-- Card 5: Avg Invoice -->
			        <div style='text-align: center; flex: 1;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; margin-bottom: 6px;'>
			                Avg Invoice
			            </div>
			            <div style='font-size: 40px; font-weight: 700; line-height: 1; color: #60a5fa;'>
			                " & AvgInvoiceText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75; margin-top: 4px;'>
			                Per invoice
			            </div>
			        </div>
			    </div>
			    
			    <!-- Context Footer -->
			    <div style='
			        padding-top: 8px;
			        border-top: 1px solid rgba(255,255,255,0.2);
			        font-size: 14px;
			        opacity: 0.85;
			        text-align: center;
			    '>
			        Selected: <strong>" & SelectedPeriod & "</strong>
			    </div>
			</div>"
			```
		lineageTag: f5d01376-45ae-4304-83b4-c03455ab5a13

