	measure 'Franchise Overview Card' = ```
			
			// Franchise D (John Deere) metrics
			VAR FranchiseD_CaptureRate = 
			    CALCULATE(
			        [% Transactions with Pin],
			        Fact_PinTransactions[Franchise] = "D"
			    )
			VAR FranchiseD_Cost = 
			    CALCULATE(
			        [Cost with Pin],
			        Fact_PinTransactions[Franchise] = "D"
			    )
			VAR FranchiseD_Transactions = 
			    CALCULATE(
			        [Transactions with Pins],
			        Fact_PinTransactions[Franchise] = "D"
			    )
			VAR FranchiseD_UniquePins = 
			    CALCULATE(
			        [Unique Pins Tracked],
			        Fact_PinTransactions[Franchise] = "D"
			    )
			VAR FranchiseD_PctOfTotal = 
			    DIVIDE(
			        CALCULATE([Total Cost], Fact_PinTransactions[Franchise] = "D"),
			        [Total Cost],
			        0
			    )
			
			// Format Franchise D numbers
			VAR FranchiseD_CostText = "$" & FORMAT(FranchiseD_Cost, "#,##0")
			 
			VAR FranchiseD_TransText = 
			    IF(FranchiseD_Transactions >= 1000,
			        FORMAT(FranchiseD_Transactions / 1000, "#,##0.0") & "K",
			        FORMAT(FranchiseD_Transactions, "#,##0")
			    )
			VAR FranchiseD_PinsText = FORMAT(FranchiseD_UniquePins, "#,##0")
			VAR FranchiseD_PctText = FORMAT(FranchiseD_PctOfTotal, "0%")
			
			// Get top 3 other franchises
			VAR OtherFranchises = 
			    TOPN(
			        2,
			        ADDCOLUMNS(
			            SUMMARIZE(
			                FILTER(
			                    Fact_PinTransactions,
			                    Fact_PinTransactions[Franchise] <> "D" &&
			                    NOT(ISBLANK(Fact_PinTransactions[Franchise]))
			                ),
			                Fact_PinTransactions[Franchise]
			            ),
			            "CaptureRate", [% Transactions with Pin],
			            "Cost", [Cost with Pin],
			            "Transactions", [Transactions with Pins]
			        ),
			        [Cost],
			        DESC
			    )
			
			// Format top 3 other franchises
			VAR OtherFranchisesHTML = 
			    CONCATENATEX(
			        OtherFranchises,
			        "
			        <div style='
			            margin-bottom: 6px;
			            padding: 5px 10px;
			            background: rgba(255,255,255,0.08);
			            border-radius: 4px;
			            border-left: 3px solid rgba(96, 165, 250, 0.6);
			        '>
			            <div style='
			                font-size: 18px; 
			                font-weight: 600; 
			                color: #60a5fa;
			                margin-bottom: 2px;
			            '>
			                Franchise " & [Franchise] & ": " & FORMAT([CaptureRate], "0.0%") & "
			            </div>
			            <div style='font-size: 14px; opacity: 0.85;'>
			                " & 
			                IF([Cost] >= 1000000,
			                    FORMAT([Cost] / 1000000, "$#,##0.0") & "M",
			                    FORMAT([Cost] / 1000, "$#,##0") & "K"
			                ) & " (" & FORMAT([Transactions], "#,##0") & " trans)
			            </div>
			        </div>
			        ",
			        "",
			        [Cost],
			        DESC
			    )
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 15px 25px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    box-shadow: 0 8px 24px rgba(0,0,0,0);
			    color: white;
			    height: 215px;
			    display: flex;
			    gap: 15px;
			    overflow: hidden;
			'>
			    <!-- LEFT SIDE: Franchise D Spotlight -->
			    <div style='
			        flex: 6;
			        display: flex;
			        flex-direction: column;
			        justify-content: space-between;
			    '>
			        <div>
			            <div style='
			                font-size: 15px; 
			                font-weight: 700; 
			                margin-bottom: 10px;
			                text-transform: uppercase;
			                letter-spacing: 1.2px;
			                color: #fbbf24;
			                display: flex;
			                align-items: center;
			                gap: 6px;
			            '>
			                🚜 FRANCHISE D (JOHN DEERE)
			            </div>
			            
			            <div style='display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px;'>
			                <!-- Metric 1: Capture Rate -->
			                <div>
			                    <div style='font-size: 12px; opacity: 0.75; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;'>
			                        Pin Capture Rate
			                    </div>
			                    <div style='font-size: 24px; font-weight: 700; color: #4ade80; line-height: 1;'>
			                        " & FORMAT(FranchiseD_CaptureRate, "0.0%") & "
			                    </div>
			                </div>
			                
			                <!-- Metric 2: Cost Captured -->
			                <div>
			                    <div style='font-size: 12px; opacity: 0.75; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;'>
			                        Cost Captured
			                    </div>
			                    <div style='font-size: 24px; font-weight: 700; color: #60a5fa; line-height: 1;'>
			                        " & FranchiseD_CostText & "
			                    </div>
			                </div>
			                
			                <!-- Metric 3: Transactions -->
			                <div>
			                    <div style='font-size: 12px; opacity: 0.75; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;'>
			                        Transactions
			                    </div>
			                    <div style='font-size: 24px; font-weight: 700; line-height: 1;'>
			                        " & FranchiseD_TransText & "
			                    </div>
			                </div>
			                
			                <!-- Metric 4: Unique Pins -->
			                <div>
			                    <div style='font-size: 12px; opacity: 0.75; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;'>
			                        Unique Pins
			                    </div>
			                    <div style='font-size: 24px; font-weight: 700; line-height: 1;'>
			                        " & FranchiseD_PinsText & "
			                    </div>
			                </div>
			            </div>
			        </div>
			        
			        <div style='
			            font-size: 14px; 
			            opacity: 0.8; 
			            border-top: 1px solid rgba(255,255,255,0.2);
			            padding-top: 6px;
			            margin-top: 6px;
			        '>
			            <strong>" & FranchiseD_PctText & "</strong> of total business
			        </div>
			    </div>
			    
			    <!-- VERTICAL DIVIDER -->
			    <div style='width: 2px; background: rgba(255,255,255,0.3);'></div>
			    
			    <!-- RIGHT SIDE: Top 3 Other Franchises -->
			    <div style='flex: 4; display: flex; flex-direction: column;'>
			        <div style='
			            font-size: 14px; 
			            font-weight: 700; 
			            margin-bottom: 8px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            color: #60a5fa;
			        '>
			            TOP 2 - OTHER FRANCHISES
			        </div>
			        
			        " & OtherFranchisesHTML & "
			    </div>
			</div>
			"
			```
