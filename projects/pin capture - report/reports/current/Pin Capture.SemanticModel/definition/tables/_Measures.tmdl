	measure 'Pin Capture Rate' =
			
			VAR TotalTrans = [Total Transactions]
			VAR TransWithPin = [Transactions with Pins]
			RETURN
			DIVIDE(TransWithPin, TotalTrans, 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 267cbdf1-230b-46c5-a4ab-0f15f04b144d

	measure 'Page 1 - Overview Hero Card' = ```
			
			VAR TotalCostWithPins = [Cost with Pin]
			VAR TotalCost = 
			    CALCULATE(
			        SUM(Fact_PinTransactions[CostValue]),
			        REMOVEFILTERS(Fact_PinTransactions[Invoice Has Pin Flag])
			    )
			VAR PctDollarsWithPin = DIVIDE(TotalCostWithPins, TotalCost, 0)
			
			VAR TransWithPins = [Transactions with Pins]
			VAR TotalTrans = 
			    CALCULATE(
			        DISTINCTCOUNT(Fact_PinTransactions[RONumber]),
			        REMOVEFILTERS(Fact_PinTransactions[Invoice Has Pin Flag])
			    )
			VAR PctTransWithPin = DIVIDE(TransWithPins, TotalTrans, 0)
			
			VAR UniquePins = [Unique Pins Tracked]  
			VAR TotalBranches = [Active Branches]
			
			VAR MonthChange = [MoM Change]
			
			// Get top performing branch
			VAR TopBranchName = 
			    CALCULATE(
			        SELECTEDVALUE(Fact_PinTransactions[Branch]),
			        TOPN(
			            1,
			            VALUES(Fact_PinTransactions[Branch]),
			            [Pin Capture Rate],
			            DESC
			        )
			    )
			VAR TopBranchRate = 
			    CALCULATE(
			        [Pin Capture Rate],
			        TOPN(
			            1,
			            VALUES(Fact_PinTransactions[Branch]),
			            [Pin Capture Rate],
			            DESC
			        )
			    )
			
			// Get actual date range
			VAR MinDate = MIN(dim_DateTable[Date])
			VAR MaxDate = MAX(dim_DateTable[Date])
			VAR DayCount = DATEDIFF(MinDate, MaxDate, DAY) + 1
			
			// Smart period detection with ACTUAL date ranges
			VAR SelectedPeriod = 
			    IF(
			        DayCount = 1,
			        FORMAT(MaxDate, "MMM DD, YYYY"),
			        IF(
			            DayCount <= 31 && DAY(MinDate) = 1 && DAY(EOMONTH(MaxDate, 0)) = DAY(MaxDate),
			            FORMAT(MaxDate, "MMMM YYYY"),
			            IF(
			                DayCount >= 89 && DayCount <= 92 && MONTH(MinDate) IN {1,4,7,10} && DAY(MinDate) = 1,
			                "Q" & QUARTER(MaxDate) & " " & YEAR(MaxDate),
			                IF(
			                    YEAR(MinDate) = YEAR(MaxDate) && MONTH(MinDate) = 1 && DAY(MinDate) = 1 && MaxDate = TODAY() - 1,
			                    "YTD " & YEAR(MaxDate),
			                    FORMAT(MinDate, "MMM DD, YYYY") & " - " & FORMAT(MaxDate, "MMM DD, YYYY")
			                )
			            )
			        )
			    )
			
			// Comparison period — actual prior date range, mirrors the branch
			// logic in [MoM Change] so the label always matches what's being
			// compared instead of a vague category name
			VAR PriorStart =
			    SWITCH(
			        TRUE(),
			        DayCount <= 31 && DAY(MinDate) = 1 && DAY(EOMONTH(MaxDate, 0)) = DAY(MaxDate),
			            EDATE(MinDate, -1),
			        DayCount >= 89 && DayCount <= 92 && MONTH(MinDate) IN {1,4,7,10} && DAY(MinDate) = 1,
			            EDATE(MinDate, -3),
			        YEAR(MinDate) = YEAR(MaxDate) && MONTH(MinDate) = 1 && DAY(MinDate) = 1,
			            DATE(YEAR(MinDate) - 1, 1, 1),
			        DayCount > 100,
			            DATE(YEAR(MinDate) - 1, MONTH(MinDate), DAY(MinDate)),
			        EDATE(MinDate, -1)
			    )
			VAR PriorEnd =
			    SWITCH(
			        TRUE(),
			        DayCount <= 31 && DAY(MinDate) = 1 && DAY(EOMONTH(MaxDate, 0)) = DAY(MaxDate),
			            EOMONTH(MaxDate, -1),
			        DayCount >= 89 && DayCount <= 92 && MONTH(MinDate) IN {1,4,7,10} && DAY(MinDate) = 1,
			            MinDate - 1,
			        YEAR(MinDate) = YEAR(MaxDate) && MONTH(MinDate) = 1 && DAY(MinDate) = 1,
			            DATE(YEAR(MaxDate) - 1, MONTH(MaxDate), DAY(MaxDate)),
			        DayCount > 100,
			            DATE(YEAR(MaxDate) - 1, MONTH(MaxDate), DAY(MaxDate)),
			        EDATE(MaxDate, -1)
			    )
			VAR ComparisonPeriodText = "vs " & FORMAT(PriorStart, "MMM DD") & "–" & FORMAT(PriorEnd, "MMM DD, YYYY")
			
			// Trend details
			VAR ShowTrend = NOT(ISBLANK(MonthChange))
			VAR TrendArrow = IF(ShowTrend, IF(MonthChange > 0, "↑", IF(MonthChange < 0, "↓", "→")), "")
			VAR TrendColor = IF(MonthChange > 0, "#4ade80", IF(MonthChange < 0, "#ef4444", "#fbbf24"))
			VAR ChangeText = IF(ShowTrend, FORMAT(MonthChange, "+0.0%;-0.0%;0.0%"), "—")
			
			// Number formatting
			// Number formatting
			VAR CostText = "$" & FORMAT(TotalCostWithPins, "#,##0")
			    
			VAR TotalCostText = 
			    IF(TotalCost >= 1000000,
			        "$" & FORMAT(TotalCost/1000000, "#,##0.0") & "M",
			        "$" & FORMAT(TotalCost/1000, "#,##0") & "K"
			    )
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 25px 30px 20px 30px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    box-shadow: 0 8px 24px rgba(0,0,0,0);
			    color: white;
			    height: 200px;
			    display: flex;
			    flex-direction: column;
			    justify-content: space-between;
			'>
			    <!-- Top Row: 4 Main Metrics -->
			    <div style='display: flex; justify-content: space-around; align-items: center; gap: 20px; flex: 1;'>
			        <!-- Section 1: Cost with Pins -->
			        <div style='flex: 1; text-align: center;'>
			            <div style='font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                Cost with Pin Captured
			            </div>
			            <div style='font-size: 48px; font-weight: 700; line-height: 1; margin-bottom: 6px;'>
			                " & CostText & "
			            </div>
			            <div style='font-size: 14px; opacity: 0.75;'>
			                Total Cost: " & TotalCostText & "
			            </div>
			        </div>
			        
			        <!-- Section 2: % of Dollars -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                % of Dollars with Pin
			            </div>
			            <div style='font-size: 48px; font-weight: 700; line-height: 1; margin-bottom: 6px; color: " & IF(PctDollarsWithPin >= 0.1, "#4ade80", "#ef4444") & ";'>
			                " & FORMAT(PctDollarsWithPin, "0.0%") & "
			            </div>
			            <div style='font-size: 14px; opacity: 0.75;'>
			                Goal: 10% | Cost Basis
			            </div>
			        </div>
			        
			        <!-- Section 3: Pin Capture Rate -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                Pin Capture Rate
			            </div>
			            <div style='font-size: 48px; font-weight: 700; line-height: 1; margin-bottom: 6px;'>
			                " & FORMAT(PctTransWithPin, "0.0%") & "
			            </div>
			            <div style='font-size: 14px; opacity: 0.75;'>
			                " & FORMAT(TransWithPins, "#,##0") & " of " & FORMAT(TotalTrans, "#,##0") & "
			            </div>
			        </div>
			        
			        <!-- Section 4: Trend -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                Change vs Prior
			            </div>
			            <div style='font-size: 48px; font-weight: 700; line-height: 1; margin-bottom: 6px; color: " & TrendColor & ";'>
			                " & TrendArrow & " " & ChangeText & "
			            </div>
			            <div style='font-size: 14px; opacity: 0.75;'>
			                Top: " & TopBranchName & " (" & FORMAT(TopBranchRate, "0.0%") & ")
			            </div>
			        </div>
			    </div>
			    
			    <!-- Context Footer -->
			    <div style='
			        padding-top: 12px;
			        border-top: 1px solid rgba(255,255,255,0.2);
			        font-size: 16px;
			        opacity: 0.85;
			        text-align: center;
			    '>
			        Selected: <strong>" & SelectedPeriod & "</strong> | 
			        <strong>" & TotalBranches & "</strong> Branch Locations | 
			        Tracking <strong>" & FORMAT(UniquePins, "#,##0") & "</strong> Unique Pins | 
			        Comparison: <strong>" & ComparisonPeriodText & "</strong>
			    </div>
			</div>"
			```
		lineageTag: a2b1a56e-9987-41f6-a732-de83219fc6b6

	measure 'Margin %' =
			
