		sourceColumn: Notation

		annotation SummarizationSetBy = Automatic

	column 'Has Pin' = ```
			
			VAR PinNoValid = 
			    NOT(ISBLANK(Fact_PinTransactions[PinNo]))
			    && Fact_PinTransactions[PinNo] <> ""
			    && Fact_PinTransactions[PinNo] <> "0"
			
			VAR NotationValid = 
			    NOT(ISBLANK(Fact_PinTransactions[Notation]))
			    && Fact_PinTransactions[Notation] <> ""
			    && Fact_PinTransactions[Notation] <> "0"
			
			RETURN
			    PinNoValid || NotationValid
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 2645c8c8-ac12-4361-b55f-26f1b29ab16a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Pin Identifier' =
			
			IF(
			    NOT(ISBLANK(Fact_PinTransactions[PinNo])),
			    Fact_PinTransactions[PinNo],
			    Fact_PinTransactions[Notation]
			)
		lineageTag: 79c2422c-000b-4529-a1eb-e6b18df1c69e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Pin Source' =
			
			IF(
			    NOT(ISBLANK(Fact_PinTransactions[PinNo])) && NOT(ISBLANK(Fact_PinTransactions[Notation])),
			    "Both",
			    IF(
			        NOT(ISBLANK(Fact_PinTransactions[PinNo])),
			        "PinNo",
			        IF(
			            NOT(ISBLANK(Fact_PinTransactions[Notation])),
			            "Notation",
			            "No Pin"
			        )
			    )
			)
		lineageTag: 4a7c051c-ae16-4674-9358-9ba34a542dc1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Invoice Has Pin Flag' = ```
			
			VAR CurrentInvoice = Fact_PinTransactions[RONumber]
			VAR HasPin = 
			    CALCULATE(
			        COUNTROWS(Fact_PinTransactions),
			        ALLEXCEPT(Fact_PinTransactions, Fact_PinTransactions[RONumber]),
			        Fact_PinTransactions[Has Pin] = TRUE
			    ) > 0
			RETURN
			IF(HasPin, "Yes", "No")
			```
		lineageTag: 7f45780a-683d-4cbb-b335-15d9e484804b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Type
		dataType: string
		lineageTag: f0c4c064-5b09-4a2e-bae0-948b3154cde9
		summarizeBy: none
		sourceColumn: Type

		annotation SummarizationSetBy = Automatic

	column 'Unique Pins Per Invoice' = ```
			
			VAR CurrentInvoice = Fact_PinTransactions[RONumber]
			VAR UniquePins = 
			    CALCULATE(
			        DISTINCTCOUNT(Fact_PinTransactions[Pin Identifier]),
			        ALLEXCEPT(Fact_PinTransactions, Fact_PinTransactions[RONumber]),
			        NOT(ISBLANK(Fact_PinTransactions[Pin Identifier])),
			        Fact_PinTransactions[Pin Identifier] <> "",
			        Fact_PinTransactions[Pin Identifier] <> "0"
			    )
			RETURN
			UniquePins
			```
		formatString: 0
		lineageTag: 2144f4f6-7b84-4b76-8fc3-9ece4b7d79dd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Line Item Margin %' =
			
			DIVIDE(
			    Fact_PinTransactions[Margin],
			    Fact_PinTransactions[SaleValue],
			    BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f4d13a59-78c1-4b38-ae1a-ba9f188f9957
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Line Item Status Icon' = ```
			
			VAR HasPin = Fact_PinTransactions[Has Pin]
			VAR PinSource = Fact_PinTransactions[Pin Source]
			VAR MarginPct = DIVIDE(Fact_PinTransactions[Margin], Fact_PinTransactions[SaleValue])
			RETURN
			SWITCH(TRUE(),
			    // Best case: Pin + Great margin
			    HasPin = TRUE && MarginPct >= 0.25, "💎",
			    
			    // Good: Pin + Good margin
			    HasPin = TRUE && MarginPct >= 0.15, "✅",
			    
			    // OK: Pin captured but low margin
			    HasPin = TRUE && MarginPct >= 0.10, "🟡",
			    
			    // Warning: Pin but very low/negative margin
			    HasPin = TRUE && MarginPct < 0.10, "🟠",
			    
			    // Alert: No pin + low margin
			    HasPin = FALSE && MarginPct < 0.10, "⚠️",
			    
			    // No pin, normal margin
			    HasPin = FALSE, "⚪",
			    
			    // Default
			    "❓"
			)
			```
		lineageTag: 619a6d1c-67dd-4b24-9036-f39b44e75d55
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

