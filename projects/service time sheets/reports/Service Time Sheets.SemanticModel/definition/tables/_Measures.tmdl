	measure 'Draw Strip' =
			VAR D1 = [Draw 1 Total]
			VAR D2 = [Draw 2 Total]
			VAR D3 = [Draw 3 Total]
			VAR DF = [Final Draw Total]
			VAR DC = [Current Draw Total]
			
			VAR D1Text = FORMAT(D1, "0.00")
			VAR D2Text = FORMAT(D2, "0.00")
			VAR D3Text = FORMAT(D3, "0.00")
			VAR DFText = FORMAT(DF, "0.00")
			VAR DCText = FORMAT(DC, "0.00")
			
			VAR D1Color = IF(D1 > 0, "#1D3C4E", "#cbd5e1")
			VAR D2Color = IF(D2 > 0, "#1D3C4E", "#cbd5e1")
			VAR D3Color = IF(D3 > 0, "#1D3C4E", "#cbd5e1")
			VAR DFColor = IF(DF > 0, "#1D3C4E", "#cbd5e1")
			VAR DCColor = IF(DC > 0, "#3A7CA5", "#cbd5e1")
			
			RETURN
			"<div style='font-family: Segoe UI, Arial, sans-serif; padding: 8px 20px; background: #f8fafc; border-radius: 8px; border-left: 4px solid #2E5266; color: #1e293b; height: 70px; display: flex; align-items: center; gap: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); box-sizing: border-box;'>" &
			"<div style='font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 1px; white-space: nowrap; padding-right: 12px; border-right: 1px solid #e2e8f0; margin-right: 8px; line-height: 1.4;'>Draw<br>Stages</div>" &
			"<div style='flex: 1; text-align: center;'><div style='font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;'>Draw 1</div><div style='font-size: 22px; font-weight: 700; color: " & D1Color & ";'>" & D1Text & "</div></div>" &
			"<div style='font-size: 14px; color: #94a3b8; padding: 0 4px;'>&#8594;</div>" &
			"<div style='flex: 1; text-align: center;'><div style='font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;'>Draw 2</div><div style='font-size: 22px; font-weight: 700; color: " & D2Color & ";'>" & D2Text & "</div></div>" &
			"<div style='font-size: 14px; color: #94a3b8; padding: 0 4px;'>&#8594;</div>" &
			"<div style='flex: 1; text-align: center;'><div style='font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;'>Draw 3</div><div style='font-size: 22px; font-weight: 700; color: " & D3Color & ";'>" & D3Text & "</div></div>" &
			"<div style='font-size: 14px; color: #94a3b8; padding: 0 4px;'>&#8594;</div>" &
			"<div style='flex: 1; text-align: center;'><div style='font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;'>Final Draw</div><div style='font-size: 22px; font-weight: 700; color: " & DFColor & ";'>" & DFText & "</div></div>" &
			"<div style='font-size: 14px; color: #94a3b8; padding: 0 4px;'>&#8594;</div>" &
			"<div style='flex: 1; text-align: center; background: rgba(58,124,165,0.06); border-radius: 6px; padding: 4px 8px;'><div style='font-size: 10px; color: #3A7CA5; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 2px;'>Current Draw</div><div style='font-size: 22px; font-weight: 700; color: " & DCColor & ";'>" & DCText & "</div></div>" &
			"</div>"
		lineageTag: e0f1a2b3-c4d5-4789-0123-456789000045

