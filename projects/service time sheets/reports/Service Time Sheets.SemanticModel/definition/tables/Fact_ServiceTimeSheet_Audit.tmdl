	column WOBranchMismatch =
			VAR _ExpectedBranch =
			    IFERROR(
			        LOOKUPVALUE(
			            dim_BranchLocation[BranchID],
			            dim_BranchLocation[City], Fact_ServiceTimeSheet_Audit[Location],
			            dim_BranchLocation[BranchType], "Main Branch"
			        ),
			        BLANK()
			    )
			VAR _WOBranch = Fact_ServiceTimeSheet_Audit[WOBranch]
			RETURN
			    NOT(ISBLANK(_ExpectedBranch))
			        && NOT(ISBLANK(_WOBranch))
			        && _ExpectedBranch <> _WOBranch
		dataType: boolean
		lineageTag: c3d4e5f6-a7b8-4901-2abc-def012345701
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

