	column SharedRO =
			VAR _RO = Fact_ServiceTimeSheet_Audit[RONumber]
			VAR _HasTrainee = Fact_ServiceTimeSheet_Audit[HasHourlyTrainee]
			VAR _CommTechs =
			    CALCULATE(
			        DISTINCTCOUNT(Fact_ServiceTimeSheet_Audit[TechNum]),
			        ALL(Fact_ServiceTimeSheet_Audit),
			        Fact_ServiceTimeSheet_Audit[RONumber] = _RO
			    )
			RETURN
			    IF(_CommTechs > 1,
			        FORMAT(_CommTechs, "0") & " Commission Techs",
			        IF(_HasTrainee = TRUE(), "Has Trainee", "")
			    )
		dataType: string
		lineageTag: e5f6a7b8-c9d0-4123-4567-890123400039
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

