	measure 'HTML Tooltip Bottom Label' = ```
			
			
			VAR _TechnicianName = MAX('Data - Service Time Sheets'[Technician Name])  /* Retrieves the Technician Name */
			
			RETURN
			"
			<style>
			  /* Animation for sliding in from the right */
			  .slide-in-right {
			    -webkit-animation: slide-in-right 1.5s cubic-bezier(0.250, 0.460, 0.450, 0.940) both;
			    animation: slide-in-right 1.5s cubic-bezier(0.250, 0.460, 0.450, 0.940) both;
			  }
			
			  @keyframes slide-in-right {
			    0% {
			      transform: translateX(100%);  /* Starts off-screen to the right */
			      opacity: 0;  /* Initially hidden */
			    }
			    100% {
			      transform: translateX(0);  /* Moves into view */
			      opacity: 1;  /* Fully visible */
			    }
			  }
			
			  /* Reset margin and padding for all elements */
			  body, div {
			    margin: 0;
			    padding: 0;
			  }
			</style>
			
			<!-- Container for the tooltip label -->
			<div class='slide-in-right' style='display: flex; align-items: center; font-family: Segoe UI; background-color: #E8FFFF;'>
			  <div style='background-color: #E8FFFF;  /* Single background color */
			              color: #303E6E;  /* Dark blue text color */
			              padding: 5px 10px; 
			              border-radius: 4px; 
			              font-size: 12px; 
			              font-weight: bold;'>
			    " & _TechnicianName & "
			  </div>
			</div>
			"
			```
		lineageTag: da43c8b1-384f-4b01-9a8d-568cd3f40ad4

	measure SelectedMinRow =
			
			MINX(FILTER('Pagination Table', 'Pagination Table'[Page Number] = SELECTEDVALUE('Pagination Table'[Page Number])), 'Pagination Table'[Min Row])
		formatString: 0
		lineageTag: 5fc7edaa-cbba-4090-82aa-5ca77d8d3f86

	measure SelectedMaxRow =
			
			MAXX(FILTER('Pagination Table', 'Pagination Table'[Page Number] = SELECTEDVALUE('Pagination Table'[Page Number])),'Pagination Table'[Max Row])
		formatString: 0
		lineageTag: cab04140-44c7-4fc9-8f29-d7f000166ed8

	measure ShowRow =
			
			VAR minRow = [SelectedMinRow]
			VAR maxRow = [SelectedMaxRow]
			RETURN
			IF(SELECTEDVALUE('Data - Service Time Sheets'[Index]) >= minRow && SELECTEDVALUE('Data - Service Time Sheets'[Index]) <= maxRow, 1, 0)
		formatString: 0
		lineageTag: 9fb08ec0-2894-4279-8de5-ff1dd8689aae

