table MeasuresTable
	lineageTag: 6ef31180-c18b-4413-891a-540de48dbde9

	measure HoursPerRO = SUM('Data - Service Time Sheets'[totalHours])
		formatString: 0.00
		lineageTag: b70a3811-d8d3-418d-83e9-893d4f0d119d

	measure 'Invoice Hours' = SUM(TechnicianInvoiceDetailServiceForm[InvoiceHours])
		formatString: 0.00
		lineageTag: 2bdd5dc9-5598-40fa-9283-6698b3083abd

	measure 'Hours Difference' = [Invoice Hours] - [HoursPerRO]
		formatString: 0.00
		lineageTag: b317bba0-c1bf-484b-8c70-a808db9dedf1

	measure Final = SUM('Data - Service Time Sheets'[totalHours])
		lineageTag: 4f4bc792-3140-49c7-ae96-9d99048e38c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Draw 1' = SUM('Data - Service Time Sheets'[Draw1])
		formatString: #,0.00
		lineageTag: 8a4e2757-2ccb-4c95-bf69-7539038dce63

	measure 'Draw 2' = SUM('Data - Service Time Sheets'[Draw2])
		formatString: 0.00
		lineageTag: b1846675-acd7-4cc1-8042-c42c7ad5fb93

	measure 'Draw 3' = SUM('Data - Service Time Sheets'[Draw3])
		formatString: #,0.00
		lineageTag: 24684b77-919a-4a84-8b71-eae84b0ac0f0

	measure 'Pay Rate' = MAX('Data - Service Time Sheets'[Pay Rate])
		formatString: 0
		lineageTag: 77feea90-bf36-4ff1-b777-1034d9c40e2b

	measure 'Tech Pay' = [Final] * [Pay Rate]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 23d103cc-895b-4375-87fc-62a6e29eda12

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Labor Billed' = [Invoice Hours] * [Pay Rate]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 813962f2-81b7-4a8c-ba6a-256c9b2a4a77

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Billed-Paid Difference' = [Labor Billed] - [Tech Pay]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 0fdcbe3f-5961-4091-9f6b-1177ba37bc25

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Is_Empty = ```
			
			    IF(NOT ISEMPTY('Dim_Branch'), 1, 0)
			```
		formatString: 0
		lineageTag: 2e8e0804-e3b3-47fc-90bc-089a2dfe0218

	measure 'Paid Difference' = [Labor Billed] - [Tech Pay]
		lineageTag: 54bde3bf-a98b-4c19-bdcb-4e72a43e91c4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PaidDifferenceColor = IF([Paid Difference] <= -0.006, "#E68F96", BLANK())
		lineageTag: 85861ce0-6430-4792-91ed-cdb94cfdd60f

	measure HoursDifferenceColor = IF([Hours Difference] <= -0.006, "#E68F96", BLANK())
		lineageTag: 4d0363fa-7f0d-4ecc-905b-0c597e91b415

	measure FormattedPaidDifference =
			
			VAR PaidDiff = [Paid Difference]
			RETURN
			IF(
			    PaidDiff <= 0,
			    FORMAT(PaidDiff, "$#,##0.00;-$#,##0.00"),
			    FORMAT(PaidDiff, "$#,##0.00")
			)
		lineageTag: a9dec8c3-27bd-45e7-b2cb-bf532a0c97c0

	measure Draw1Color = IF([Draw 1] >= 1, "#AFCBAA", BLANK())
		lineageTag: 54a48be6-7b9d-4353-9b4f-085675b8e84b

	measure Draw2Color = IF([Draw 2] >= 1, "#AFCBAA", BLANK())
		lineageTag: 12b90c69-77a7-4afb-8ffa-fd78ab39438d

	measure Draw3Color = IF([Draw 3] >= 1, "#AFCBAA", BLANK())
		lineageTag: 9332d631-2902-4e89-a54e-b4627dd82fed

	measure 'HTML Tooltip Hours_Paid_Difference' = ```
			
			
			"<!DOCTYPE html>
			<html lang='en'>
			<head>
			    <meta charset='UTF-8'>  
			    <meta name='viewport' content='width=device-width, initial-scale=1.0'>  
			    <style>
			        /* Animation for sliding in from the top with blur effect */
			        @keyframes slide-in-blurred-top {
			            0% {
			                transform: translateY(-100%);
			                opacity: 0;
			                filter: blur(10px);
			            }
			            100% {
			                transform: translateY(0);
			                opacity: 1;
			                filter: blur(0);
			            }
			        }
			
			        .slide-in-blurred-top {
			            -webkit-animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
			            animation: slide-in-blurred-top 1.5s cubic-bezier(0.230, 1.000, 0.320, 1.000) both;
			            animation-delay: 0.75s;  /* Delays animation start */
			            color: #013E72;  /* Dark blue text color */
			            font-family: 'Segoe UI';  /* Sets font */
			            margin: 10px;
			            opacity: 0;  /* Initially hidden */
			            animation-fill-mode: forwards;  /* Ensures animation state remains after completion */
			        }
			
			        .category-name {
			            color: #333242;  /* Dark grey text */
			            position: relative;
			            padding-left: 20px;  /* Space for icons */
			        }
			
			        /* Dot icons for Hours Difference and Paid Difference and Total Draws */
			        .hours-difference::before, .paid-difference::before, .total-draws::before {
			            content: '';
			            position: absolute;
			            left: 0;
			            top: calc(50% + 1px);
			            transform: translateY(-50%);
			            width: 10px;
			            height: 10px;
			            border-radius: 10px;  /* Creates circular icons */
			        }
			
			        /* Specific colors for icons */
			        .hours-difference::before { background-color: #418FBD; }  /* Dark blue for hours-difference */
			        .paid-difference::before { background-color: #C499CA; }  /* Grey for paid-difference */
			        .total-draws::before { background-color: #AFCBAA; }  /* Light green for total-draws */
			
			        .value {
			            color: #464648;  /* Dark grey */
			            font-weight: 600;  /* Semi-bold text */
			        }
			    </style>
			</head>
			<body>
			    <div class='slide-in-blurred-top'>  <!-- Animated container for tooltip -->
			        " & 
			    IF(NOT(ISBLANK([Hours Difference])),  /* Checks if 'Current' value exists */
			        "<p><span class='category-name hours-difference'>Hours Difference: </span><span class='value' id='current'>" & 
			        FORMAT([Hours Difference], "#,0.00") &  /* Formats the 'Current' value with thousand separator */
			        "</span></p>", 
			        ""
			    ) &
			
			    IF(NOT(ISBLANK([Paid Difference])),  /* Checks if 'Previous' value exists */
			        "<p><span class='category-name paid-difference'>Paid Difference: </span><span class='value' id='previous'>" & 
			        FORMAT([Paid Difference], "$#,##0.00") &  /* Formats the 'Previous' value with thousand separator */
			        "</span></p>", 
			        ""
			    ) &
			
			        IF(NOT(ISBLANK([Total Draws])),  /* Checks if 'Current' value exists */
			        "<p><span class='category-name total-draws'>Total Draws: </span><span class='value' id='current'>" & 
			        FORMAT([Total Draws], "#,0.00") &  /* Formats the 'Current' value with thousand separator */
			        "</span></p>", 
			        ""
			    ) &
			
			    "
			    </div>
			</body>
			</html>"
			```
		lineageTag: f6b23699-dae6-4dcf-a369-dd0b841ea6bf

	measure 'HTML RO Tooltip Info' = ```
			
			
			VAR _RO = MAX('Data - Service Time Sheets'[RO #]) 
			
			RETURN
			"
			<!DOCTYPE html>
			<html lang='en'>
			<head>
			    <meta charset='UTF-8'>
			    <meta name='viewport' content='width=device-width, initial-scale=1.0'> 
			
			    <style>
			        /* Animation for text appearance with a blur effect */
			        @keyframes text-focus-in {
			            0% {
			                transform: scale(1);
			                opacity: 0;
			                filter: blur(10px);
			            }
			            100% {
			                transform: scale(1);
			                opacity: 1;
			            }
			        }
			
			        .text-focus-in {
			            -webkit-animation: text-focus-in 0.6s cubic-bezier(0.550, 0.085, 0.680, 0.530) both;
			            animation: text-focus-in 0.6s cubic-bezier(0.550, 0.085, 0.680, 0.530) both;
			            color: #BEBEBE;  /* Light grey text color */
			            font-family: 'Segoe UI';  /* Sets font */
			            margin-top: -1px;  /* Adjusts position slightly */
			            display: flex;  /* Enables flexbox for alignment */
			            align-items: center;  /* Centers items vertically */
			            gap: 8px;  /* Space between the icon and text */
			        }
			
			        .dark-blue {
			            color: #303E6E;  /* Dark blue text color */
			            font-weight: bold;  /* Makes text bold */
			        }
			
			        .calendar-icon {
			            width: 14px;  /* Sets icon size */
			            height: 14px;
			            fill: #303E6E;  /* Calendar icon color */
			        }
			    </style>
			</head>
			<body>
			    <p class='text-focus-in'>  <!-- Animated text container -->
			        <!-- SVG calendar icon -->
			        <svg class='custom-icon' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='14' height='14'>
			            <path d='M24 32.041h-18c-1.105 0-2-0.893-2-1.996v-24.097c0-1.102 0.895-1.995 2-1.995h5v2.079h-4c-0.552 0-1 0.446-1 0.998v22.017c0 0.553 0.448 0.998 1 0.998h16c0.553 0 1-0.445 1-0.998v-22.017c0-0.552-0.447-0.998-1-0.998h-4v-2.079h5c1.104 0 2 0.894 2 1.995v24.097c0 1.103-0.896 1.996-2 1.996zM11 12.019h11v0.998h-11v-0.998zM11 15.013h11v0.998h-11v-0.998zM11 18.008h11v0.998h-11v-0.998zM11 21.002h11v0.998h-11v-0.998zM22 27.986h-11v-0.996h11v0.996zM11 23.996h11v0.998h-11v-0.998zM8 11.999h1v0.998h-1v-0.998zM8 14.993h1v0.998h-1v-0.998zM8 17.986h1v0.998h-1v-0.998zM8 20.98h1v0.998h-1v-0.998zM9 27.967h-1v-0.998h1v0.998zM8 23.975h1v0.998h-1v-0.998zM21 7.091c0.553 0 1 0.447 1 0.999s0 1.933 0 1.933h-14c0 0 0-1.382 0-1.933s0.447-0.999 1-0.999h3c0 0 0.012-1.419 0.012-3.041 0-1.684 1.3-3.092 2.988-3.092s3.033 1.48 3.033 3.102c0 1.747-0.033 3.031-0.033 3.031h3zM15 3.953c-0.553 0-1 0.446-1 0.997 0 0.552 0.447 0.998 1 0.998s1-0.446 1-0.998c0-0.551-0.447-0.997-1-0.997z'/>
			        </svg>
			        <span class='dark-blue'>" & _RO & "</span>  <!-- Displays the formatted date from DAX -->
			    </p>
			</body>
			</html>
			"
			```
		lineageTag: 90df0ca3-56f3-46bb-b4c7-125616e16c60

