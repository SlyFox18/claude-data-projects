		measure 'Show Filter 1' = ```
				
				VAR MaxFilters = 3
				RETURN
				    IF (
				        ISFILTERED ( Parts_Open_Tickets[Aging] ),
				        VAR ___f =
				            FILTERS ( Parts_Open_Tickets[Aging] )
				        VAR ___r =
				            COUNTROWS ( ___f )
				        VAR ___t =
				            TOPN ( MaxFilters, ___f, Parts_Open_Tickets[Aging] )
				        VAR ___d =
				            CONCATENATEX ( ___t, Parts_Open_Tickets[Aging], ", " )
				        VAR ___x =
				            "Aging:  " & ___d
				                & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
				        RETURN
				            ___x & UNICHAR ( 13 )
				                & UNICHAR ( 10 )
				    )
				        & IF (
				            ISFILTERED ( Dim_Branch[Branch] ),
				            VAR ___f =
				                FILTERS ( Dim_Branch[Branch] )
				            VAR ___r =
				                COUNTROWS ( ___f )
				            VAR ___t =
				                TOPN ( MaxFilters, ___f, Dim_Branch[Branch] )
				            VAR ___d =
				                CONCATENATEX ( ___t, Dim_Branch[Branch], ", " )
				            VAR ___x =
				                "Branch:  " & ___d
				                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
				            RETURN
				                ___x & UNICHAR ( 13 )
				                    & UNICHAR ( 10 )
				        )
				        & IF (
				            ISFILTERED ( Parts_Open_Tickets[Invoice_Type] ),
				            VAR ___f =
				                FILTERS ( Parts_Open_Tickets[Invoice_Type] )
				            VAR ___r =
				                COUNTROWS ( ___f )
				            VAR ___t =
				                TOPN ( MaxFilters, ___f, Parts_Open_Tickets[Invoice_Type] )
				            VAR ___d =
				                CONCATENATEX ( ___t, Parts_Open_Tickets[Invoice_Type], ", " )
				            VAR ___x =
				                "Type:  " & ___d
				                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
				            RETURN
				                ___x & UNICHAR ( 13 )
				                    & UNICHAR ( 10 )
				        )
				        & IF (
				            ISFILTERED ( Parts_Open_Tickets[Order_Date] ),
				            VAR ___f =
				                FILTERS ( Parts_Open_Tickets[Order_Date] )
				            VAR ___r =
				                COUNTROWS ( ___f )
				            VAR ___t =
				                TOPN ( MaxFilters, ___f, Parts_Open_Tickets[Order_Date] )
				            VAR ___d =
				                CONCATENATEX ( ___t, Parts_Open_Tickets[Order_Date], ", " )
				            VAR ___x =
				                "Date:  " & ___d
				                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
				            RETURN
				                ___x & UNICHAR ( 13 )
				                    & UNICHAR ( 10 )
				        )
				        & IF (
				            ISFILTERED ( Parts_Open_Tickets[Customer] ),
				            VAR ___f =
				                FILTERS ( Parts_Open_Tickets[Customer] )
				            VAR ___r =
				                COUNTROWS ( ___f )
				            VAR ___t =
				                TOPN ( MaxFilters, ___f, Parts_Open_Tickets[Customer] )
				            VAR ___d =
				                CONCATENATEX ( ___t, Parts_Open_Tickets[Customer], ", " )
				            VAR ___x =
				                "Customer:  " & ___d
				                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
				            RETURN
				                ___x & UNICHAR ( 13 )
				                    & UNICHAR ( 10 )
				        )
				            & IF (
				            ISFILTERED ( Parts_Open_Tickets[Contact_Code] ),
				            VAR ___f =
				                FILTERS ( Parts_Open_Tickets[Contact_Code] )
				            VAR ___r =
				                COUNTROWS ( ___f )
				            VAR ___t =
				                TOPN ( MaxFilters, ___f, Parts_Open_Tickets[Contact_Code] )
				            VAR ___d =
				                CONCATENATEX ( ___t, Parts_Open_Tickets[Contact_Code], ", " )
				            VAR ___x =
				                "Contact Code:  " & ___d
				                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
				            RETURN
				                ___x & UNICHAR ( 13 )
				                    & UNICHAR ( 10 )
				        )
				        
				
				---- MODEL MEASURES END ----
				```
			lineageTag: 9f13d257-918e-4dc1-bc76-48862edae745

