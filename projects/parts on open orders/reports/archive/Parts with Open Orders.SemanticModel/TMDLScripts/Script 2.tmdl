		/// Determines if the current location's back order count is the maximum or minimum among all locations and returns a corresponding string label.
		measure 'Back Order Label' = ```
				
				VAR ThisLocation = SELECTEDVALUE(Dim_Branch[LocationID])
				VAR ThisBackOrder = [# on Back Order]
				
				VAR MaxBackOrder = 
				CALCULATE(
				    MAXX(
				        VALUES(Dim_Branch[LocationID]),
				        [# on Back Order]
				    ),
				    REMOVEFILTERS(Dim_Branch)
				)
				
				VAR MinBackOrder = 
				CALCULATE(
				    MINX(
				        VALUES(Dim_Branch[LocationID]),
				        [# on Back Order]
				    ),
				    REMOVEFILTERS(Dim_Branch)
				)
				
				RETURN
				    SWITCH(
				        TRUE(),
				        ThisBackOrder = MaxBackOrder, "Highest Back Order",
				        ThisBackOrder = MinBackOrder, "Lowest Back Order",
				        BLANK()
				    )
				
				```
			lineageTag: c4fa3d45-a0d5-4677-8e39-fe7770c8cf5a

