		/// Determines the bar color hex value for customer count based on whether the count is the maximum or minimum value.
		measure 'Bar Color Hex - Customer Count' =
				
				VAR ThisCustomer = SELECTEDVALUE(Parts_Open_Tickets[Customer])
				VAR ThisValue = CALCULATE(COUNT(Parts_Open_Tickets[Order_No]))
				
				VAR MaxValue =
				    CALCULATE(
				        MAXX(
				            VALUES(Parts_Open_Tickets[Customer]),
				            CALCULATE(COUNT(Parts_Open_Tickets[Order_No]))
				        ),
				        REMOVEFILTERS(Parts_Open_Tickets[Customer])
				    )
				
				VAR MinValue =
				    CALCULATE(
				        MINX(
				            VALUES(Parts_Open_Tickets[Customer]),
				            CALCULATE(COUNT(Parts_Open_Tickets[Order_No]))
				        ),
				        REMOVEFILTERS(Parts_Open_Tickets[Customer])
				    )
				
				RETURN
				    IF(
				        ThisValue = MaxValue || ThisValue = MinValue,
				        "#446FA7",  // Highlight
				        "#B3B3B3"   // Default
				    )
			lineageTag: 8aa6c707-f83c-4eff-b0c4-c0d75558ee8b

