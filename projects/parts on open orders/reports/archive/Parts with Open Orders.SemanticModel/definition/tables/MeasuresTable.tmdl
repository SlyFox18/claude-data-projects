		lineageTag: b23852e1-d2ed-4fd1-9c41-1f47c9e20984

	measure 'copy KPI SVG - Orders vs Orders with BO Parts (Compact, Square Bars)' = ```
			
			VAR TotalOrders = [Total # of Orders]
			VAR OrdersWithBO = [Orders with Backordered Parts]
			VAR OrdersWithoutBO = TotalOrders - OrdersWithBO
			
			VAR pct_WithBO = DIVIDE(OrdersWithBO, TotalOrders, 0)
			VAR pct_WithoutBO = DIVIDE(OrdersWithoutBO, TotalOrders, 0)
			
			VAR BarWidth = 320
			VAR BarHeight = 24
			VAR SVG_Height = 65   // Compact for card grid
			
			VAR LabelFontColor = "#000000"
			VAR PercentFontColor = "#FFFFFF"
			VAR NotBO_Color = "#4A5B73"
			VAR BO_Color = IF(pct_WithBO > 0.1, "#D45353", "#808080")
			
			VAR TitleText = "Orders without BO Part vs. with BO Part"
			VAR TitleFontSize = 12
			
			VAR NotBO_Label = FORMAT(OrdersWithoutBO, "#,0")
			VAR BO_Label = FORMAT(OrdersWithBO, "#,0")
			
			VAR NotBO_Percent_Label = FORMAT(pct_WithoutBO, "0%")
			VAR BO_Percent_Label = FORMAT(pct_WithBO, "0%")
			
			// X positions
			VAR LabelMargin = 12
			VAR NotBO_Label_X = LabelMargin
			VAR BO_Label_X = BarWidth - LabelMargin
			VAR Title_X = BarWidth / 2
			
			// Y positions (compact!)
			VAR Title_Y = 14
			VAR Labels_Y = 30
			VAR Bar_Y = 38
			VAR PercentLabel_Y = Bar_Y + (BarHeight / 2) + 5
			
			// Bar segment widths
			VAR NotBO_Width = ROUND(pct_WithoutBO * BarWidth, 0)
			VAR BO_Width = BarWidth - NotBO_Width
			
			// X positions for percent labels
			VAR NotBO_Percent_X = NotBO_Width / 2
			VAR BO_Percent_X = NotBO_Width + (BO_Width / 2)
			
			VAR SVG =
			    "<svg width='" & BarWidth & "' height='" & SVG_Height & "' viewBox='0 0 " & BarWidth & " " & SVG_Height & "' xmlns='http://www.w3.org/2000/svg'>" &
			        // Title
			        "<text x='" & Title_X & "' y='" & Title_Y & "' text-anchor='middle' font-size='" & TitleFontSize & "' fill='" & LabelFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			            TitleText &
			        "</text>" &
			        // Orders without BO label (far left)
			        "<text x='" & NotBO_Label_X & "' y='" & Labels_Y & "' text-anchor='start' font-size='11' fill='" & LabelFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			            NotBO_Label &
			        "</text>" &
			        // Orders with BO label (far right)
			        "<text x='" & BO_Label_X & "' y='" & Labels_Y & "' text-anchor='end' font-size='11' fill='" & LabelFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			            BO_Label &
			        "</text>" &
			        // Orders without BO Bar (square)
			        "<rect x='0' y='" & Bar_Y & "' width='" & NotBO_Width & "' height='" & BarHeight & "' fill='" & NotBO_Color & "' />" &
			        // Orders with BO Bar (square, conditional color)
			        "<rect x='" & NotBO_Width & "' y='" & Bar_Y & "' width='" & BO_Width & "' height='" & BarHeight & "' fill='" & BO_Color & "' />" &
			        // Orders without BO percent label
			        IF(
			            NotBO_Width > 36,
			            "<text x='" & NotBO_Percent_X & "' y='" & PercentLabel_Y & "' text-anchor='middle' font-size='15' fill='" & PercentFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			                NotBO_Percent_Label &
			            "</text>",
			            ""
			        ) &
			        // Orders with BO percent label
			        IF(
			            BO_Width > 36,
			            "<text x='" & BO_Percent_X & "' y='" & PercentLabel_Y & "' text-anchor='middle' font-size='15' fill='" & PercentFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			                BO_Percent_Label &
			            "</text>",
			            ""
			        ) &
			    "</svg>"
			
			RETURN
			    "data:image/svg+xml;utf8," & SVG
			
			```
		lineageTag: aaf0e3b2-53fa-4895-a6cc-a84703c69baf

	measure 'copy KPI SVG - Line Count vs Backordered Line (Compact, Square Bars)' = ```
			
			VAR TotalLines = [Line Count]
			VAR BackorderedLines = [Backordered Line Count]
			VAR NotBackorderedLines = TotalLines - BackorderedLines
			
			VAR pct_Backordered = DIVIDE(BackorderedLines, TotalLines, 0)
			VAR pct_NotBackordered = DIVIDE(NotBackorderedLines, TotalLines, 0)
			
			VAR BarWidth = 320
			VAR BarHeight = 24
			VAR SVG_Height = 65   // Compact for card grid
			
			VAR LabelFontColor = "#000000"
			VAR PercentFontColor = "#FFFFFF"
			VAR NotBO_Color = "#4A5B73"
			// Conditional coloring for backordered segment
			VAR BO_Color = IF(pct_Backordered > 0.1, "#D45353", "#808080")
			
			VAR TitleText = "Not Backordered vs. Backordered (Lines)"
			VAR TitleFontSize = 12
			
			VAR NotBO_Label = FORMAT(NotBackorderedLines, "#,0")
			VAR BO_Label = FORMAT(BackorderedLines, "#,0")
			
			VAR NotBO_Percent_Label = FORMAT(pct_NotBackordered, "0%")
			VAR BO_Percent_Label = FORMAT(pct_Backordered, "0%")
			
			// X positions
			VAR LabelMargin = 12
			VAR NotBO_Label_X = LabelMargin
			VAR BO_Label_X = BarWidth - LabelMargin
			VAR Title_X = BarWidth / 2
			
			// Y positions (compact)
			VAR Title_Y = 14
			VAR Labels_Y = 30
			VAR Bar_Y = 38
			VAR PercentLabel_Y = Bar_Y + (BarHeight / 2) + 5
			
			// Bar segment widths
			VAR NotBO_Width = ROUND(pct_NotBackordered * BarWidth, 0)
			VAR BO_Width = BarWidth - NotBO_Width
			
			// X positions for percent labels (centered in each bar segment)
			VAR NotBO_Percent_X = NotBO_Width / 2
			VAR BO_Percent_X = NotBO_Width + (BO_Width / 2)
			
			VAR SVG =
			    "<svg width='" & BarWidth & "' height='" & SVG_Height & "' viewBox='0 0 " & BarWidth & " " & SVG_Height & "' xmlns='http://www.w3.org/2000/svg'>" &
			        // Title
			        "<text x='" & Title_X & "' y='" & Title_Y & "' text-anchor='middle' font-size='" & TitleFontSize & "' fill='" & LabelFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			            TitleText &
			        "</text>" &
			        // Not Backordered line count (far left)
			        "<text x='" & NotBO_Label_X & "' y='" & Labels_Y & "' text-anchor='start' font-size='11' fill='" & LabelFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			            NotBO_Label &
			        "</text>" &
			        // Backordered line count (far right)
			        "<text x='" & BO_Label_X & "' y='" & Labels_Y & "' text-anchor='end' font-size='11' fill='" & LabelFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			            BO_Label &
			        "</text>" &
			        // Not Backordered Bar (square)
			        "<rect x='0' y='" & Bar_Y & "' width='" & NotBO_Width & "' height='" & BarHeight & "' fill='" & NotBO_Color & "' />" &
			        // Backordered Bar (conditional color, square)
			        "<rect x='" & NotBO_Width & "' y='" & Bar_Y & "' width='" & BO_Width & "' height='" & BarHeight & "' fill='" & BO_Color & "' />" &
			        // Not Backordered percent label
			        IF(
			            NotBO_Width > 36,
			            "<text x='" & NotBO_Percent_X & "' y='" & PercentLabel_Y & "' text-anchor='middle' font-size='15' fill='" & PercentFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			                NotBO_Percent_Label &
			            "</text>",
			            ""
			        ) &
			        // Backordered percent label
			        IF(
			            BO_Width > 36,
			            "<text x='" & BO_Percent_X & "' y='" & PercentLabel_Y & "' text-anchor='middle' font-size='15' fill='" & PercentFontColor & "' font-family='Segoe UI' font-weight='bold'>" &
			                BO_Percent_Label &
			            "</text>",
			            ""
			        ) &
			    "</svg>"
			
			RETURN
			    "data:image/svg+xml;utf8," & SVG
			
			```
		lineageTag: 2a2fe3a0-bcd2-4bd5-bfdd-a250f6f50d35

	measure ShowFilterBranch =
			
			IF (
			    ISFILTERED ( Dim_Branch[Branch] ),
			    VAR _Location =
			        VALUES ( Dim_Branch[Branch] )
			    VAR _Itemscombined =
			        CONCATENATEX ( _Location, Dim_Branch[Branch], UNICHAR ( 10 ) )
			    RETURN
			        _Itemscombined & UNICHAR ( 10 ),
			    ""
			)
