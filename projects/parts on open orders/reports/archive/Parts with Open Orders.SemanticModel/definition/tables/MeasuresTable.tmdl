	/// Determines if the order count for the selected location is either the maximum or minimum order count across all locations, returning 1 if true and 0 otherwise.
	measure 'Bar Color Order Count' =
			
			VAR ThisLocation =
			    SELECTEDVALUE ( Dim_Branch[LocationID] )
			VAR ThisOrderCount = [Order Count]
			VAR MaxOrderCount =
			    CALCULATE (
			        MAXX ( VALUES ( Dim_Branch[LocationID] ), [Order Count] ),
			        REMOVEFILTERS ( Dim_Branch )
			    )
			VAR MinOrderCount =
			    CALCULATE (
			        MINX ( VALUES ( Dim_Branch[LocationID] ), [Order Count] ),
			        REMOVEFILTERS ( Dim_Branch )
			    )
			RETURN
			    IF (
			        ThisOrderCount = MaxOrderCount
			            || ThisOrderCount = MinOrderCount,
			        1,
			        // Highlight
			        0 // Grey
			    )
		formatString: 0
