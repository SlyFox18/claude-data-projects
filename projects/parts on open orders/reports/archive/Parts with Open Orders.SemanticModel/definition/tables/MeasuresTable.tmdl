			VAR BO_Label = FORMAT(OrdersWithBO, "#,0")
			
			VAR NotBO_Percent_Label = FORMAT(pct_WithoutBO, "0%")
			VAR BO_Percent_Label = FORMAT(pct_WithBO, "0%")
			
