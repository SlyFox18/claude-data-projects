	measure 'Page 1 KPI Cards' =
			
			VAR _NegOH = [Negative On Hand Count]
			VAR _NoBin = [On Hand No Bin Count]
			VAR _Aging = [Open Tickets Aging Count]
			RETURN
			"
			<div style='display:flex;gap:12px;padding:8px;font-family:Segoe UI,Arial,sans-serif;height:100%;box-sizing:border-box;align-items:stretch;'>
			
			    <div style='flex:1;background:linear-gradient(135deg,#1D3C4E 0%,#2E5266 50%,#3A7CA5 100%);border-radius:8px;padding:18px 22px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;'>
			        <div style='font-size:20px;color:rgba(255,255,255,0.65);letter-spacing:0.6px;'>Negative On Hand</div>
			        <div style='font-size:48px;font-weight:700;color:white;line-height:1;margin-bottom:10px;'>" & FORMAT(_NegOH, "#,0") & "</div>
			    </div>
			
			    <div style='flex:1;background:linear-gradient(135deg,#1D3C4E 0%,#2E5266 50%,#3A7CA5 100%);border-radius:8px;padding:18px 22px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;'>
			        <div style='font-size:20px;color:rgba(255,255,255,0.65);letter-spacing:0.6px;'>On Hand No Bin</div>
			        <div style='font-size:48px;font-weight:700;color:white;line-height:1;margin-bottom:10px;'>" & FORMAT(_NoBin, "#,0") & "</div>
			    </div>
			
			    <div style='flex:1;background:linear-gradient(135deg,#1D3C4E 0%,#2E5266 50%,#3A7CA5 100%);border-radius:8px;padding:18px 22px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;'>
			        <div style='font-size:20px;color:rgba(255,255,255,0.65);letter-spacing:0.6px;'>Open Tickets</div>
			        <div style='font-size:48px;font-weight:700;color:white;line-height:1;margin-bottom:10px;'>" & FORMAT(_Aging, "#,0") & "</div>
			    </div>
			
			</div>
			"
		lineageTag: 4d5e6f7a-8b9c-0123-def0-234567890123

