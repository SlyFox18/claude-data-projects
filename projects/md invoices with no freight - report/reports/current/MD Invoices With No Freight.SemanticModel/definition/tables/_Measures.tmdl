	measure 'Freight Status Color - Closed' =
			VAR FreightStatusVal = MAX(Fact_MDInvoices_Closed[FreightStatus])
			VAR MissedAmt = [Closed - Missed Freight]
			RETURN
			    SWITCH(
			        TRUE(),
			        FreightStatusVal = "No Freight",                          "#fca5a5",
			        FreightStatusVal = "No Freight Charged",                  "#fcd34d",
			        NOT ISBLANK(MissedAmt) && MissedAmt > 1,                 "#fef08a",
			        NOT ISBLANK(MissedAmt) && MissedAmt <= 1,                "#bbf7d0",
			        "#e5e7eb"
			    )
		lineageTag: 165bf634-2d86-4bbc-85d3-b2c58de85893

	measure 'Closed - Missed Freight Icon' =
			VAR MissedAmt = [Closed - Missed Freight]
			VAR FreightStatusVal = MAX(Fact_MDInvoices_Closed[FreightStatus])
			RETURN
			    IF(
			        ISBLANK(MissedAmt),                           1,
			        IF(FreightStatusVal = "No Freight",           2,
			        IF(FreightStatusVal = "No Freight Charged",   2,
			        IF(MissedAmt > 50,                            2,
			        IF(MissedAmt > 1,                             3,
			        IF(MissedAmt >= -1,                           4,
			                                                      5)))))
			    )
		lineageTag: 2f3a4b5c-d6e7-48f9-0a1b-2c3d4e5f6a7b

	measure 'Closed - Is In Selected Group' =
			VAR SelectedGroup = SELECTEDVALUE(dim_FreightPerformanceGroup[Group])
			VAR MissedAmt = [Closed - Missed Freight]
			VAR FreightStatusVal = MAX(Fact_MDInvoices_Closed[FreightStatus])
			RETURN
			    IF(
			        ISBLANK(SelectedGroup),
			        1,
			        SWITCH(
			            SelectedGroup,
			            "No Freight",
			                IF(FreightStatusVal = "No Freight" || FreightStatusVal = "No Freight Charged", 1, 0),
			            "Needs Review",
			                IF(FreightStatusVal = "Has Freight" && NOT ISBLANK(MissedAmt) && MissedAmt > 1, 1, 0),
			            "Good / Above Baseline",
			                IF(FreightStatusVal = "Has Freight" && (ISBLANK(MissedAmt) || MissedAmt <= 1), 1, 0),
			            1
			        )
			    )
		lineageTag: 3a4b5c6d-e7f8-49a0-1b2c-3d4e5f6a7b8c

	measure 'Closed - Worst Branch' =
			VAR MinInvoices = 3
			VAR BranchRates =
			    ADDCOLUMNS(
			        VALUES(dim_BranchLocation[Branch]),
			        "@Rate",  CALCULATE([Closed - No Freight Rate]),
			        "@Count", CALCULATE([Closed - Total Invoices])
			    )
			VAR QualifiedBranches =
			    FILTER(BranchRates, [@Count] >= MinInvoices)
			VAR TopBranch =
			    TOPN(1, QualifiedBranches, [@Rate], DESC)
			RETURN
			    MAXX(TopBranch, dim_BranchLocation[Branch])
		lineageTag: 4b5c6d7e-f8a9-40b1-2c3d-4e5f6a7b8c9d

	measure 'Closed - Worst Branch Rate' =
			VAR MinInvoices = 3
			VAR BranchRates =
			    ADDCOLUMNS(
			        VALUES(dim_BranchLocation[Branch]),
			        "@Rate",  CALCULATE([Closed - No Freight Rate]),
			        "@Count", CALCULATE([Closed - Total Invoices])
			    )
			VAR QualifiedBranches =
			    FILTER(BranchRates, [@Count] >= MinInvoices)
			VAR TopBranch =
			    TOPN(1, QualifiedBranches, [@Rate], DESC)
			RETURN
			    MAXX(TopBranch, [@Rate])
		formatString: 0.0%
		lineageTag: 5c6d7e8f-a9b0-41c2-3d4e-5f6a7b8c9d0e

	measure 'Closed - Top Opportunity Salesperson' =
			VAR SalesOpps =
			    ADDCOLUMNS(
			        VALUES(dim_Salesperson[SalespersonCode]),
			        "@Opp", CALCULATE([Closed - Missed Freight])
			    )
			VAR QualifiedSales =
			    FILTER(SalesOpps, [@Opp] > 0)
			VAR TopSales =
			    TOPN(1, QualifiedSales, [@Opp], DESC)
			VAR TopCode =
			    MAXX(TopSales, dim_Salesperson[SalespersonCode])
			RETURN
			    CALCULATE(
			        MAX(dim_Salesperson[FullName]),
			        dim_Salesperson[SalespersonCode] = TopCode
			    )
		lineageTag: 6d7e8f9a-b0c1-42d3-4e5f-6a7b8c9d0e1f

