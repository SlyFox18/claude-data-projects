			            Freight Opportunity
			        </div>
			        <div style='font-size: 50px; font-weight: 700; line-height: 1; color: #fbbf24;'>
			            " & FORMAT(Opportunity, "$#,##0") & "
			        </div>
			        <div style='font-size: 13px; margin-top: 8px; color: #4ade80; font-weight: 600;'>
			            +" & FORMAT(AboveBaseline, "$#,##0") & " above baseline
			        </div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 2px; height: 120px; background: rgba(255,255,255,0.3); margin: 0 15px;'></div>
			
			    <!-- Section 3: Worst Branch -->
			    <div style='text-align: center; flex: 1;'>
			        <div style='font-size: 13px; opacity: 0.9; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px;'>
			            Highest No Freight Rate
			        </div>
			        <div style='font-size: 36px; font-weight: 700; line-height: 1; color: " & WorstBranchColor & ";'>
			            " & WorstBranch & "
			        </div>
			        <div style='font-size: 20px; margin-top: 8px; font-weight: 600; color: " & WorstBranchColor & ";'>
			            " & FORMAT(WorstBranchRate, "0.0%") & " no freight rate
			        </div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 2px; height: 120px; background: rgba(255,255,255,0.3); margin: 0 15px;'></div>
			
			    <!-- Section 4: Top Opportunity Salesperson -->
			    <div style='text-align: center; flex: 1;'>
			        <div style='font-size: 13px; opacity: 0.9; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px;'>
			            Top Opportunity
			        </div>
			        <div style='font-size: 36px; font-weight: 700; line-height: 1; color: #fbbf24;'>
			            " & TopSales & "
			        </div>
			        <div style='font-size: 20px; margin-top: 8px; font-weight: 600; color: #fbbf24;'>
			            " & FORMAT(TopSalesAmt, "$#,##0") & " potential
			        </div>
			    </div>
			
			</div>
			"
		lineageTag: 9a0b1c2d-e3f4-45a6-7b8c-9d0e1f2a3b4c

