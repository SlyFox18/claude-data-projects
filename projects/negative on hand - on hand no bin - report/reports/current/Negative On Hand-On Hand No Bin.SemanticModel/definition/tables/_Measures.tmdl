	measure 'Severity Color' =
			
			VAR CriticalCount = [Critical Issues]
			VAR HighCount = [High Severity Issues]
			VAR TotalCount = [Total Parts with Issues]
			RETURN
			    SWITCH(
			        TRUE(),
			        DIVIDE(CriticalCount, TotalCount, 0) > 0.3, "Red",
			        DIVIDE(HighCount, TotalCount, 0) > 0.5, "Orange",
			        "Yellow"
			    )
		displayFolder: Formatting
		lineageTag: ceaa04a6-07d5-416a-b972-d9a238483dda

	measure 'Negative Bin Qty Display' =
			
			VAR NegQty = [Total Negative Bin Qty]
			RETURN
			    IF(
			        ISBLANK(NegQty),
			        "No Issues",
			        FORMAT(ABS(NegQty), "#,##0") & " units"
			    )
		displayFolder: Display Format
		lineageTag: a08cab43-1fec-4ef7-a266-514da85cb2da

	measure 'Value at Risk Display' =
			
			VAR ValueRisk = [Total Inventory Value at Risk]
			RETURN
			    IF(
			        ISBLANK(ValueRisk) || ValueRisk = 0,
			        "No Risk",
			        FORMAT(ValueRisk, "$#,##0")
			    )
		displayFolder: Display Format
		lineageTag: bd6e7ec0-82ed-4192-a8fa-2587f52c267c

	measure 'Report Title Dynamic' =
			
			VAR SelectedBranch = SELECTEDVALUE('dim_BranchLocation'[Branch])
			VAR SelectedFranchise = SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[Franchise])
			VAR IssueCount = [Total Parts with Issues]
			VAR BranchCount = DISTINCTCOUNT('Fact_NegativeOnHand_OnHandNoBin'[Branch])
			
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT ISBLANK(SelectedBranch) && NOT ISBLANK(SelectedFranchise),
			            "Inventory Issues: Branch " & SelectedBranch & " - " & SelectedFranchise & " (" & IssueCount & " parts)",
			        NOT ISBLANK(SelectedBranch),
			            "Inventory Issues: Branch " & SelectedBranch & " (" & IssueCount & " parts)",
			        NOT ISBLANK(SelectedFranchise),
			            "Inventory Issues: " & SelectedFranchise & " Franchise (" & IssueCount & " parts)",
			        BranchCount = 1,
			            "Inventory Issues: " & IssueCount & " Parts Across All Franchises",
			        "Inventory Issues: " & IssueCount & " Parts Across " & BranchCount & " Branches"
			    )
		displayFolder: Dynamic Title
		lineageTag: 9f10c61d-a153-4a9a-b91a-db75486fc507

	measure 'Negative Bin Qty Title' =
			
			VAR NegCount = [Parts with Negative Bin Qty]
			VAR NegQty = ABS([Total Negative Bin Qty])
			VAR ValueAtRisk = [Total Negative Inventory Value]
			VAR SelectedBranch = SELECTEDVALUE('dim_BranchLocation'[Branch])
			
			RETURN
			    IF(
			        ISBLANK(SelectedBranch),
			        "Negative On Hand: " & NegCount & " Parts | " & FORMAT(NegQty, "#,##0") & " Units | " & FORMAT(ValueAtRisk, "$#,##0") & " at Risk",
			        "Negative On Hand - Branch " & SelectedBranch & ": " & NegCount & " Parts | " & FORMAT(NegQty, "#,##0") & " Units"
			    )
		displayFolder: Dynamic Title
		lineageTag: 6e6a5ec4-16bc-40b0-affc-8ccfbcae0935

	measure 'On Hand No Bin Title' =
			
			VAR NoBinCount = [Parts with On Hand No Bin]
			VAR NoBinQty = [Total Qty No Bin]
			VAR ValueNoBin = [Total Value No Bin]
			VAR SelectedBranch = SELECTEDVALUE('dim_BranchLocation'[Branch])
			
			RETURN
			    IF(
			        ISBLANK(SelectedBranch),
			        "On Hand No Bin: " & NoBinCount & " Parts | " & FORMAT(NoBinQty, "#,##0") & " Units | " & FORMAT(ValueNoBin, "$#,##0") & " Value",
			        "On Hand No Bin - Branch " & SelectedBranch & ": " & NoBinCount & " Parts | " & FORMAT(NoBinQty, "#,##0") & " Units"
			    )
		displayFolder: Dynamic Title
		lineageTag: 781d7b73-7f26-4b1f-a4e2-d85233df5048

	measure 'Summary Title with Severity' = ```
			
			VAR TotalIssues = [Total Parts with Issues]
			VAR CriticalCount = [Critical Issues]
			VAR HighCount = [High Severity Issues]
			
			RETURN
			    "Inventory Issues Summary" & UNICHAR(10) &
			    TotalIssues & " Total Parts | " & 
			    CriticalCount & " Critical | " & 
			    HighCount & " High Priority"
			```
		displayFolder: Dynamic Title
		lineageTag: f9e04cbd-00ad-42c0-a6e5-9efd982fc62a

	measure 'Franchise Breakdown Title' = ```
			
			VAR FranchiseCount = DISTINCTCOUNT('Fact_NegativeOnHand_OnHandNoBin'[Franchise])
			VAR TopFranchise = 
			    CALCULATE(
			        SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[Franchise]),
			        TOPN(1, 
			            VALUES('Fact_NegativeOnHand_OnHandNoBin'[Franchise]),
			            [Total Parts with Issues],
			            DESC
			        )
			    )
			VAR TopFranchiseCount = 
			    CALCULATE(
			        [Total Parts with Issues],
			        'Fact_NegativeOnHand_OnHandNoBin'[Franchise] = TopFranchise
			    )
			
			RETURN
			    "Issues by Franchise (" & FranchiseCount & " Total)" & UNICHAR(10) &
			    "Highest: " & TopFranchise & " with " & TopFranchiseCount & " parts"
			```
		displayFolder: Dynamic Title
		lineageTag: 2444d103-4cdd-4f30-be60-d7fa121177a3

	measure 'Branch Comparison Title' =
			
			VAR BranchCount = DISTINCTCOUNT('Fact_NegativeOnHand_OnHandNoBin'[Branch])
			VAR AvgIssuesPerBranch = DIVIDE([Total Parts with Issues], BranchCount, 0)
			
			RETURN
			    "Branch Analysis (" & BranchCount & " branches)" & UNICHAR(10) &
			    "Average " & FORMAT(AvgIssuesPerBranch, "#,##0.0") & " issues per branch"
		displayFolder: Dynamic Title
		lineageTag: 59b1a959-9518-45a6-90ec-2d72f5660f4f

	measure 'Active Filters Display' = ```
			
			VAR BranchFilter = SELECTEDVALUE('dim_BranchLocation'[Branch])
			VAR FranchiseFilter = SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[Franchise])
			VAR IssueTypeFilter = SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[IssueType])
			VAR SeverityFilter = SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[IssueSeverity])
			
			VAR FilterText = 
			    CONCATENATEX(
			        FILTER(
			            {
			                ("Branch", BranchFilter),
			                ("Franchise", FranchiseFilter),
			                ("Issue Type", IssueTypeFilter),
			                ("Severity", SeverityFilter)
			            },
			            NOT ISBLANK([Value2])
			        ),
			        [Value1] & ": " & [Value2],
			        " | "
			    )
			
			RETURN
			    IF(
			        ISBLANK(FilterText),
			        "All Data",
			        "Filtered by: " & FilterText
			    )
			```
		displayFolder: Dynamic Title
		lineageTag: d53273a5-1946-4c84-9b10-d969905aa8be

	measure 'Chart Subtitle Key Metric' = ```
			
			VAR SelectedIssueType = SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[IssueType])
			VAR MetricValue = 
			    SWITCH(
			        SelectedIssueType,
			        "Negative Bin Qty", [Total Negative Inventory Value],
			        "On Hand No Bin", [Total Value No Bin],
			        [Total Inventory Value at Risk]
			    )
			
			RETURN
			    IF(
			        ISBLANK(SelectedIssueType),
			        "Total Value at Risk: " & FORMAT(MetricValue, "$#,##0"),
			        SelectedIssueType & " - Value Impact: " & FORMAT(MetricValue, "$#,##0")
			    )
			```
		displayFolder: Dynamic Title
		lineageTag: 1b913cc9-f6ff-423d-b28c-44b12de8ca18

	measure 'Parts Created Last 30 Days' =
			
			VAR Today = TODAY()
			VAR ThirtyDaysAgo = Today - 30
			RETURN
			    CALCULATE(
			        COUNTROWS('Fact_NegativeOnHand_OnHandNoBin'),
			        'Fact_NegativeOnHand_OnHandNoBin'[DateCreated] >= ThirtyDaysAgo
			    )
		formatString: 0
		displayFolder: Time Intelligence
		lineageTag: 4b137d1e-dcb5-41f8-975f-5ef36a2c731f

	measure 'Parts Created Last 90 Days' =
			
