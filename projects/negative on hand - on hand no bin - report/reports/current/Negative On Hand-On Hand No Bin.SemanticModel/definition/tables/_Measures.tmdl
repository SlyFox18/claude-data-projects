	measure 'Summary HTML Clean' = ```
			
			VAR TotalIssues = [Total Parts with Issues]
			VAR TopBranch = 
			    CALCULATE(
			        SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[Branch]),
			        TOPN(1, VALUES('Fact_NegativeOnHand_OnHandNoBin'[Branch]), [Total Parts with Issues], DESC)
			    )
			VAR TopBranchCount = 
			    CALCULATE([Total Parts with Issues], 'Fact_NegativeOnHand_OnHandNoBin'[Branch] = TopBranch)
			VAR BranchesAffected = DISTINCTCOUNT('Fact_NegativeOnHand_OnHandNoBin'[Branch])
			VAR TopFranchise = 
			    CALCULATE(
			        SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[Franchise]),
			        TOPN(1, VALUES('Fact_NegativeOnHand_OnHandNoBin'[Franchise]), [Total Parts with Issues], DESC)
			    )
			VAR BackOrderCount = [Parts with Back Orders]
			VAR BackOrderPct = DIVIDE(BackOrderCount, TotalIssues, 0)
			VAR NegativeCount = [Parts with Negative Bin Qty]
			VAR NoBinCount = [Parts with On Hand No Bin]
			VAR _HTML = 
			    "<div style='font-family: Segoe UI, Arial, sans-serif; padding: 0; background: white; height: 100%;'>" &
			    "<div style='background: #3d5a80; color: white; padding: 15px; text-align: center;'>" &
			    "<div style='font-size: 18px; font-weight: 600;'>📊 SUMMARY</div>" &
			    "<div style='font-size: 11px; opacity: 0.9; margin-top: 3px;'>Issues across " & BranchesAffected & " branches</div>" &
			    "</div>" &
			    "<div style='padding: 20px;'>" &
			    "<div style='background: #f8f9fa; padding: 12px; border-left: 4px solid #3d5a80; margin-bottom: 15px;'>" &
			    "<div style='font-size: 12px; color: #6c757d; margin-bottom: 5px;'>HIGHEST IMPACT</div>" &
			    "<div style='font-size: 14px; color: #212529;'>Branch <strong>" & TopBranch & "</strong> has <strong>" & TopBranchCount & "</strong> issues</div>" &
			    "</div>" &
			    "<div style='background: #f8f9fa; padding: 12px; border-left: 4px solid #3d5a80; margin-bottom: 15px;'>" &
			    "<div style='font-size: 12px; color: #6c757d; margin-bottom: 5px;'>MOST AFFECTED</div>" &
			    "<div style='font-size: 14px; color: #212529;'>Franchise <strong>" & TopFranchise & "</strong></div>" &
			    "</div>" &
			    "<div style='border-top: 2px solid #e9ecef; padding-top: 15px; margin-top: 15px;'>" &
			    "<div style='font-size: 13px; font-weight: 600; color: #3d5a80; margin-bottom: 10px;'>ISSUE BREAKDOWN</div>" &
			    "<div style='display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #e9ecef;'>" &
			    "<span style='font-size: 13px; color: #495057;'>Negative inventory</span>" &
			    "<strong style='font-size: 13px; color: #dc3545;'>" & NegativeCount & "</strong>" &
			    "</div>" &
			    "<div style='display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #e9ecef;'>" &
			    "<span style='font-size: 13px; color: #495057;'>No bin assignment</span>" &
			    "<strong style='font-size: 13px; color: #fd7e14;'>" & NoBinCount & "</strong>" &
			    "</div>" &
			    "<div style='display: flex; justify-content: space-between; padding: 8px 0;'>" &
			    "<span style='font-size: 13px; color: #495057;'>Customer back orders</span>" &
			    "<strong style='font-size: 13px; color: #0d6efd;'>" & BackOrderCount & " (" & FORMAT(BackOrderPct, "0.0%") & ")</strong>" &
			    "</div>" &
			    "</div>" &
			    "</div>" &
			    "</div>"
			RETURN _HTML
			```
		displayFolder: Summary
		lineageTag: 84128b13-a233-4f20-9d6d-5087c61a2e42

	measure 'Summary HTML' = ```
			
			VAR TotalIssues = [Total Parts with Issues]
			VAR TopBranch = 
			    CALCULATE(
			        SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[Branch]),
			        TOPN(1, VALUES('Fact_NegativeOnHand_OnHandNoBin'[Branch]), [Total Parts with Issues], DESC)
			    )
			VAR TopBranchCount = 
			    CALCULATE([Total Parts with Issues], 'Fact_NegativeOnHand_OnHandNoBin'[Branch] = TopBranch)
			VAR BranchesAffected = DISTINCTCOUNT('Fact_NegativeOnHand_OnHandNoBin'[Branch])
			VAR TopFranchise = 
			    CALCULATE(
			        SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[Franchise]),
			        TOPN(1, VALUES('Fact_NegativeOnHand_OnHandNoBin'[Franchise]), [Total Parts with Issues], DESC)
			    )
			VAR BackOrderCount = [Parts with Back Orders]
			VAR BackOrderPct = DIVIDE(BackOrderCount, TotalIssues, 0)
			VAR NegativeCount = [Parts with Negative Bin Qty]
			VAR NoBinCount = [Parts with On Hand No Bin]
			
			VAR _HTML = 
			"<div style='font-family: Segoe UI, Arial, sans-serif; padding: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 8px; color: white; height: 100%;'>
			    
			    <div style='text-align: center; margin-bottom: 20px;'>
			        <div style='font-size: 24px; font-weight: bold; margin-bottom: 5px;'>📊 SUMMARY</div>
			        <div style='font-size: 12px; opacity: 0.9;'>Inventory Issues Overview</div>
			    </div>
			    
			    <div style='background: rgba(255,255,255,0.15); padding: 15px; border-radius: 6px; margin-bottom: 15px; backdrop-filter: blur(10px);'>
			        <div style='font-size: 14px; font-weight: 600; margin-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.3); padding-bottom: 5px;'>Distribution</div>
			        <div style='font-size: 13px; line-height: 1.8;'>
			            Issues across <strong>" & BranchesAffected & " branches</strong><br/>
