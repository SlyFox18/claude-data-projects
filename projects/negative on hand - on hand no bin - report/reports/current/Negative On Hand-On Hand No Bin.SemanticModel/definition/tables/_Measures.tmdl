			        <div style='font-size: 14px; font-weight: 600; margin-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.3); padding-bottom: 5px;'>Issue Breakdown</div>
			        <div style='font-size: 13px; line-height: 1.8;'>
			            <div style='display: flex; justify-content: space-between; margin-bottom: 5px;'>
			                <span>🔴 Negative inventory</span>
			                <strong>" & NegativeCount & " parts</strong>
			            </div>
			            <div style='display: flex; justify-content: space-between; margin-bottom: 5px;'>
			                <span>📦 No bin assignment</span>
			                <strong>" & NoBinCount & " parts</strong>
			            </div>
			            <div style='display: flex; justify-content: space-between; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.2);'>
			                <span>⚠️ Customer back orders</span>
			                <strong>" & BackOrderCount & " (" & FORMAT(BackOrderPct, "0.0%") & ")</strong>
			            </div>
			        </div>
			    </div>
			    
			</div>"
			
			RETURN _HTML
