table _Measures
	lineageTag: 3b1a6758-3ca4-47e9-8791-b5d6002e665c

	measure 'Welcome Name' =
			
			VAR _User =
			    USERPRINCIPALNAME ()
			VAR _Position =
			    SEARCH ( "@", _User, 1 )
			VAR _Name =
			    LEFT ( _User, _Position - 1 )
			VAR _FirstLetter =
			    UPPER ( LEFT ( _Name, 1 ) )
			VAR _LastName =
			    MID ( _Name, 2, LEN ( _Name ) - 1 )
			VAR _FormattedLastName =
			    UPPER ( LEFT ( _LastName, 1 ) )
			        & LOWER ( MID ( _LastName, 2, LEN ( _LastName ) ) )
			RETURN
			    "Welcome Back, " & _FirstLetter & "." & _FormattedLastName
		displayFolder: Accessories
		lineageTag: 1ebd317f-6819-4431-9dc5-f7f3415056d0

	measure 'Total Parts with Issues' =
			
			COUNTROWS('Fact_NegativeOnHand_OnHandNoBin')
		formatString: 0
		displayFolder: Basic Issue Counts
		lineageTag: 33c98878-b405-4102-ab10-b17f331262f6

	measure 'Parts with Negative Bin Qty' =
			
			CALCULATE(
			    COUNTROWS('Fact_NegativeOnHand_OnHandNoBin'),
			    'Fact_NegativeOnHand_OnHandNoBin'[HasNegativeBinQty] = TRUE
			)
		formatString: 0
		displayFolder: Basic Issue Counts
		lineageTag: a91ad5bd-28f2-45bc-bba0-862d8907b550

	measure 'Parts with On Hand No Bin' =
			
			CALCULATE(
			    COUNTROWS('Fact_NegativeOnHand_OnHandNoBin'),
