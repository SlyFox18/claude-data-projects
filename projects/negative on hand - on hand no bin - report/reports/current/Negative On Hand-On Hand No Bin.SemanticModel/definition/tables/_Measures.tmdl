	measure 'Avg Negative Qty per Part' =
			
			CALCULATE(
			    AVERAGE('Fact_NegativeOnHand_OnHandNoBin'[BinQty]),
			    'Fact_NegativeOnHand_OnHandNoBin'[HasNegativeBinQty] = TRUE
			)
		displayFolder: Quantity Aggregations
		lineageTag: 5414a64a-287d-4269-93cc-2fee49979c19

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Qty No Bin per Part' =
			
			CALCULATE(
			    AVERAGE('Fact_NegativeOnHand_OnHandNoBin'[BinQty]),
			    'Fact_NegativeOnHand_OnHandNoBin'[HasBinQtyNoBin] = TRUE
			)
		displayFolder: Quantity Aggregations
		lineageTag: 8b2235a1-19ab-4bba-8fe5-1bbfa3871132

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Negative Inventory Value' =
			
			SUMX(
			    FILTER(
			        'Fact_NegativeOnHand_OnHandNoBin',
			        'Fact_NegativeOnHand_OnHandNoBin'[HasNegativeBinQty] = TRUE
			    ),
			    ABS('Fact_NegativeOnHand_OnHandNoBin'[BinQty]) * 'Fact_NegativeOnHand_OnHandNoBin'[Cost]
			)
		displayFolder: Financial Impact
		lineageTag: 685676d6-ac79-44a9-bdcb-d92584a602e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Value No Bin' =
			
			SUMX(
			    FILTER(
			        'Fact_NegativeOnHand_OnHandNoBin',
			        'Fact_NegativeOnHand_OnHandNoBin'[HasBinQtyNoBin] = TRUE
			    ),
			    'Fact_NegativeOnHand_OnHandNoBin'[BinQty] * 'Fact_NegativeOnHand_OnHandNoBin'[Cost]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Financial Impact
		lineageTag: d1c0012e-454b-4797-83ae-99039268aeaf

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Inventory Value at Risk' =
			
