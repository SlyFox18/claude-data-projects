	measure 'Avg Days Since Request' =
			
			AVERAGE('Fact_NegativeOnHand_OnHandNoBin'[DaysSinceLastRequest])
		displayFolder: Time Intelligence
		lineageTag: fc205526-2c4c-48dc-a5b0-7e638b02904d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Issues by Age Category' =
			
			VAR ActiveCount = [Active Issues (Last 30 Days)]
			VAR StaleCount = [Stale Issues (90+ Days)]
			VAR VeryStaleCount = [Very Stale Issues (180+ Days)]
			VAR RecentCount = [Total Parts with Issues] - ActiveCount - StaleCount
			
			RETURN
			    "Active (≤30d): " & ActiveCount & " | " &
			    "Recent (31-89d): " & RecentCount & " | " &
			    "Stale (90-179d): " & (StaleCount - VeryStaleCount) & " | " &
			    "Very Stale (≥180d): " & VeryStaleCount
		displayFolder: Time Intelligence
		lineageTag: 93aafa6a-0003-4703-b0a9-7360d3a9fed7

	measure 'Key Insights Summary' = ```
			
			VAR TotalIssues = [Total Parts with Issues]
			VAR TopBranch = 
			    CALCULATE(
			        SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[Branch]),
			        TOPN(1, VALUES('Fact_NegativeOnHand_OnHandNoBin'[Branch]), [Total Parts with Issues], DESC)
			    )
			VAR TopBranchCount = 
			    CALCULATE([Total Parts with Issues], 'Fact_NegativeOnHand_OnHandNoBin'[Branch] = TopBranch)
			VAR BranchesAffected = DISTINCTCOUNT('Fact_NegativeOnHand_OnHandNoBin'[Branch])
			VAR TopFranchise = 
			    CALCULATE(
			        SELECTEDVALUE('Fact_NegativeOnHand_OnHandNoBin'[Franchise]),
			        TOPN(1, VALUES('Fact_NegativeOnHand_OnHandNoBin'[Franchise]), [Total Parts with Issues], DESC)
			    )
			VAR BackOrderCount = [Parts with Back Orders]
			VAR BackOrderPct = DIVIDE(BackOrderCount, TotalIssues, 0)
			VAR NegativeCount = [Parts with Negative Bin Qty]
			VAR NoBinCount = [Parts with On Hand No Bin]
			
			RETURN
			"📊 SUMMARY" & UNICHAR(10) & UNICHAR(10) &
			"Issues across " & BranchesAffected & " branches" & UNICHAR(10) &
