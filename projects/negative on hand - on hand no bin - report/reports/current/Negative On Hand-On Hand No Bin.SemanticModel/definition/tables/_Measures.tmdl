			    "<div style='display: flex; justify-content: space-between; margin-bottom: 3px;'>" &
			    "<span>📦 No bin assignment</span>" &
			    "<strong>" & NoBinCount & " parts</strong>" &
			    "</div>" &
			    "<div style='display: flex; justify-content: space-between; padding-top: 5px; border-top: 1px solid rgba(74, 91, 115, 0.15);'>" &
			    "<span>⚠️ Customer back orders</span>" &
			    "<strong>" & BackOrderCount & " (" & FORMAT(BackOrderPct, "0.0%") & ")</strong>" &
