	measure 'Part Sales Total' =
			
			SUMX (
			    SUMMARIZE (
			        Planter_Inspection_Parts,
			        Planter_Inspection_Parts[Customer],
			        "Part Sale $", MAX ( Planter_Inspection_Parts[Total_SALE_VAL] )
			    ),
			    [Part Sale $]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 6b115583-f661-4526-9648-0875c8577154

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Part Cost Total' =
			
			SUMX (
			    SUMMARIZE (
			        Planter_Inspection_Parts,
			        Planter_Inspection_Parts[Customer],
			        "Part Sale $", MAX ( Planter_Inspection_Parts[Total_COST_VAL] )
			    ),
			    [Parts Cost $]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3cac2c4a-52f3-4d95-a5d6-975142f00e0b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Labor' =
			
			CALCULATE (
			    SUM ( Planter_Inspection_Parts[Inv_Lab_Val] ),
			    Planter_Inspection_Parts[Total_SALE_VAL] <> BLANK ()
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 42d5fb95-af19-491d-a0e5-fcb475d93317

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Show Filter 1' =
			
			VAR MaxFilters = 3
			RETURN
			    IF (
			        ISFILTERED ( Base_Customer_Info[Customer] ),
			        VAR ___f =
			            FILTERS ( Base_Customer_Info[Customer] )
			        VAR ___r =
			            COUNTROWS ( ___f )
			        VAR ___t =
			            TOPN ( MaxFilters, ___f, Base_Customer_Info[Customer] )
			        VAR ___d =
			            CONCATENATEX ( ___t, Base_Customer_Info[Customer], ", " )
			        VAR ___x =
			            "" & ___d
			                & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			        RETURN
			            ___x & UNICHAR ( 13 )
			                & UNICHAR ( 10 )
			    )
			        & IF (
			            ISFILTERED ( Dim_Branch[Branch] ),
			            VAR ___f =
			                FILTERS ( Dim_Branch[Branch] )
			            VAR ___r =
			                COUNTROWS ( ___f )
			            VAR ___t =
			                TOPN ( MaxFilters, ___f, Dim_Branch[Branch] )
			            VAR ___d =
			                CONCATENATEX ( ___t, Dim_Branch[Branch], ", " )
			            VAR ___x =
			                "" & ___d
			                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			            RETURN
			                ___x & UNICHAR ( 13 )
			                    & UNICHAR ( 10 )
			        )
			        & IF (
			            ISFILTERED ( Planter_Part_List[pi_Commodity_Code] ),
			            VAR ___f =
			                FILTERS ( Planter_Part_List[pi_Commodity_Code] )
			            VAR ___r =
			                COUNTROWS ( ___f )
			            VAR ___t =
			                TOPN ( MaxFilters, ___f, Planter_Part_List[pi_Commodity_Code] )
			            VAR ___d =
			                CONCATENATEX ( ___t, Planter_Part_List[pi_Commodity_Code], ", " )
			            VAR ___x =
			                "" & ___d
			                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			            RETURN
			                ___x & UNICHAR ( 13 )
			                    & UNICHAR ( 10 )
			        )
			        & IF (
			            ISFILTERED ( Planter_Part_List[pi_Part_No] ),
			            VAR ___f =
			                FILTERS ( Planter_Part_List[pi_Part_No] )
			            VAR ___r =
			                COUNTROWS ( ___f )
			            VAR ___t =
			                TOPN ( MaxFilters, ___f, Planter_Part_List[pi_Part_No] )
			            VAR ___d =
			                CONCATENATEX ( ___t, Planter_Part_List[pi_Part_No], ", " )
			            VAR ___x =
			                "" & ___d
			                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			            RETURN
			                ___x & UNICHAR ( 13 )
			                    & UNICHAR ( 10 )
			        )
			---- MODEL MEASURES END ----
		lineageTag: 0c3dce0e-a642-4e23-8648-da5f22858dff

