let
  Source = Odbc.Query("dsn=EquipRDB64", "-- First, identify all REF_NO with PLANTER parts#(lf)WITH PlantRefNos AS (#(lf)    SELECT DISTINCT#(lf)        REF_NO#(lf)    FROM#(lf)        InTrans#(lf)    WHERE#(lf)        PART_NO LIKE '%PLANTER%'#(lf)        AND Trans_Datetime > '2025-03-01'#(lf)),#(lf)-- Get customer info and totals for these planter parts#(lf)PartTotals AS (#(lf)    SELECT#(lf)        it.customer_no,#(lf)        it.BRANCH,#(lf)        SUM(it.SALE_VAL) AS Total_SALE_VAL,#(lf)        SUM(it.COST_VAL) AS Total_COST_VAL#(lf)    FROM#(lf)        InTrans it#(lf)    WHERE#(lf)        it.REF_NO IN (SELECT REF_NO FROM PlantRefNos)#(lf)        AND Trans_Datetime > '2025-03-01'#(lf)        AND it.customer_no IS NOT NULL#(lf)        AND TRIM(it.customer_no) <> ''#(lf)    GROUP BY#(lf)        it.customer_no,#(lf)        it.BRANCH#(lf)),#(lf)-- Get inspection data with Location, Customer, Job_Code, Inv_Lab_Val#(lf)PlantInspections AS (#(lf)    SELECT #(lf)        rof.branch AS Location,#(lf)        COALESCE(#(lf)            (SELECT #(lf)                CASE #(lf)                    WHEN TRIM(company_name) <> '' THEN company_name #(lf)                    ELSE STRING(surname, ', ', name) #(lf)                END #(lf)            FROM contact #(lf)            INNER JOIN armaster ON contact.contact_code = armaster.contact_code  #(lf)            WHERE armaster.acc_no = wir.CHARGE_ACCT), #(lf)            CASE rod.type#(lf)                WHEN 'e' THEN 'Excess'#(lf)                WHEN 'f' THEN 'Fleet'#(lf)                WHEN 'i' THEN 'Internal'#(lf)                WHEN 'p' THEN 'Policy'#(lf)                WHEN 'b' THEN 'Billing'#(lf)                WHEN 'r' THEN 'Retail'#(lf)                WHEN 's' THEN 'Misc'#(lf)                WHEN 'w' THEN 'Warranty'#(lf)                ELSE rod.type #(lf)            END || COALESCE(NULLIF(wir.CHARGE_ACCT, ''), '')#(lf)        ) AS Customer,#(lf)        rod.job_code AS Job_Code,#(lf)        os.Inv_Lab_Val,#(lf)        wir.CHARGE_ACCT AS account_no#(lf)    FROM #(lf)        wkrofile rof#(lf)    INNER JOIN #(lf)        wkothsub os ON rof.branch = os.ro_branch AND rof.ro_number = os.ro_number#(lf)    INNER JOIN #(lf)        WkInvReg wir ON os.invoice_no = wir.document_no#(lf)    INNER JOIN #(lf)        wkrodesc rod ON rof.branch = rod.ro_branch AND rof.ro_number = rod.ro_number #(lf)        AND rod.job_code = os.job_code AND rod.type = os.type#(lf)    WHERE #(lf)        rof.ro_progress_status <> '' #(lf)        AND rod.line_no = 1 #(lf)        AND DATE(expected_datetime) BETWEEN '2025-03-01' AND CURRENT DATE#(lf)        AND rod.job_code = 'IS-PLANTER INSPECT'#(lf))#(lf)-- Join inspections with part totals based on account numbers only#(lf)SELECT#(lf)    pi.Location,#(lf)    pi.Customer,#(lf)    pi.Job_Code,#(lf)    pi.Inv_Lab_Val,#(lf)    pi.account_no,#(lf)    pt.BRANCH AS Part_Branch,#(lf)    COALESCE(pt.Total_SALE_VAL, 0) AS Total_SALE_VAL,#(lf)    COALESCE(pt.Total_COST_VAL, 0) AS Total_COST_VAL#(lf)FROM#(lf)    PlantInspections pi#(lf)LEFT JOIN#(lf)    PartTotals pt ON TRIM(pi.account_no) = TRIM(pt.customer_no)#(lf)WHERE#(lf)    pi.account_no IS NOT NULL#(lf)    AND TRIM(pi.account_no) <> ''#(lf)ORDER BY#(lf)    pi.Location, pi.Customer, pi.Job_Code;")
in
  Source