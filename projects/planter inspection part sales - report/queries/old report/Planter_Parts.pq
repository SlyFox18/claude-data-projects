Odbc.Query("dsn=EquipRDB64", "
WITH PlantRefNos AS (#(lf)
    -- Find all REF_NO that contain at least one part with *PLANTER and TYPE = 'I'#(lf)
    SELECT DISTINCT#(lf)
        REF_NO#(lf)
    FROM#(lf)
        InTrans#(lf)
    WHERE#(lf)
        PART_NO LIKE '%*PLANTER%'#(lf)
        AND Trans_Datetime > '2025-03-01'#(lf)
        AND TYPE = 'I'#(lf)
),#(lf)
CommodityParts AS (#(lf)
    -- Get all PART_NO where the commodity code is between 310 and 318#(lf)
    SELECT#(lf)
        pi_Part_No#(lf)
    FROM#(lf)
        jdis_Part_Information#(lf)
    WHERE#(lf)
        pi_Commodity_Code IN ('310', '311', '312', '313', '314', '315', '316', '317', '318')#(lf)
),#(lf)
CombinedParts AS (#(lf)
    -- Combine parts from both criteria#(lf)
    SELECT DISTINCT#(lf)
        PART_NO#(lf)
    FROM#(lf)
        InTrans#(lf)
    WHERE#(lf)
        PART_NO LIKE '%*PLANTER%'#(lf)
        AND Trans_Datetime > '2025-03-01'#(lf)
        AND TYPE = 'I'#(lf)
    UNION#(lf)
    SELECT#(lf)
        pi_Part_No AS PART_NO#(lf)
    FROM#(lf)
        CommodityParts#(lf)
),#(lf)
FinalRefNos AS (#(lf)
    -- Get all REF_NO that include the parts from CombinedParts#(lf)
    SELECT DISTINCT#(lf)
        REF_NO#(lf)
    FROM#(lf)
        InTrans#(lf)
    WHERE#(lf)
        PART_NO IN (SELECT PART_NO FROM CombinedParts)#(lf)
        AND TYPE = 'I'#(lf)
)#(lf)
SELECT#(lf)
    it.REF_NO,#(lf)
    it.PART_NO,#(lf)
    it.DESCRIPTION,#(lf)
    it.SALE_VAL,#(lf)
    it.COST_VAL,#(lf)
    it.BRANCH,#(lf)
    it.customer_no,#(lf)
    it.Trans_Datetime#(lf)
FROM#(lf)
    InTrans it#(lf)
WHERE#(lf)
    it.REF_NO IN (SELECT REF_NO FROM FinalRefNos)#(lf)
    AND it.Trans_Datetime > '2025-03-01'#(lf)
    AND it.TYPE = 'I'#(lf)
ORDER BY#(lf)
    it.REF_NO, it.PART_NO;
")