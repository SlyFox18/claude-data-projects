	partition FilteredJobCodes = calculated
		mode: import
		source = ```
				
				VAR RelevantWoNumbers = 
				    CALCULATETABLE(
				        VALUES('Job_Code_Times'[wo_number]),
				        FILTER(
				            'Job_Code_Times',
				            'Job_Code_Times'[job_code] IN {"IS-CS690 INSPECT", "IS-CS770 INSPECT"}
				        )
				    )
				RETURN
				    FILTER(
				        'Job_Code_Times',
				        'Job_Code_Times'[wo_number] IN RelevantWoNumbers &&
				        'Job_Code_Times'[location] = 'Job_Code_Times'[location]
				    )
				```

	annotation PBI_Id = da8b103eeb134829ad2050ab70a8ced3

