	column InspectionGoal =
			
			LOOKUPVALUE(
			    'Inspection Goals'[2025 Inspections Goal],
			    'Inspection Goals'[LOCATION],
			    'Job_Code_Times'[Location]
			)
		formatString: 0
		lineageTag: 5dca435a-036e-4200-a7ed-ff35c08b04c7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column PartsGoal$$ =
			
			LOOKUPVALUE(
			    'Inspection Goals'[2025 Total Parts $$ Goal],
			    'Inspection Goals'[LOCATION],
			    'Job_Code_Times'[Location]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 39f7724c-af42-48a9-b635-6c1614425e0b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column LaborGoal$$ =
			
			LOOKUPVALUE(
			    'Inspection Goals'[2025 Labor $$ w/ Inspection Goal],
			    'Inspection Goals'[LOCATION],
			    'Job_Code_Times'[Location]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 40bacaa6-21fd-41f8-8cb6-cdd4267ea842
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

