table Job_Code_Times
	lineageTag: 6ef5c199-ccd3-4dd4-af3b-cebbb8f27999

	measure PartsGoal =
			
			CALCULATE (
			    SUM ( 'Inspection Goals'[2025 Total Parts $$ Goal] ),
			    TREATAS ( VALUES ( 'Dim_Branch'[BranchID] ), 'Inspection Goals'[LOCATION] )
			)
		lineageTag: 8177cae0-116a-4903-9e48-668067d1512d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PartsPercentageOfGoal =
			
			DIVIDE ( [Parts $ Total], [PartsGoal], 0 )
		formatString: 0%;-0%;0%
		lineageTag: b1d98773-d135-48b1-9497-ded973330a7f

