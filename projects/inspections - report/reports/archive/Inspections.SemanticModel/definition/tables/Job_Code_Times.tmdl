	column HasInspectionJobCode =
			
			IF(
			    CALCULATE(
			        COUNTROWS(
			            SUMMARIZE(
			                FILTER(
			                    'Job_Code_Times',
			                    'Job_Code_Times'[job_code] IN VALUES(JobCodes[job_code])
			                ),
			                'Job_Code_Times'[wo_number],
			                'Job_Code_Times'[job_code]
			            )
			        )
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 3a843a6e-e6ad-4833-8a82-86c17459b510
		summarizeBy: count

		annotation SummarizationSetBy = Automatic

	column HasRelevantJobCode =
			
			IF(
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                'Job_Code_Times',
			                'Job_Code_Times'[job_code] IN VALUES(JobCodes[job_code])
			            )
			        ),
			        ALLEXCEPT('Job_Code_Times', 'Job_Code_Times'[wo_number])
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: fac7695f-c81f-47dd-84e6-f60d9664647c
		summarizeBy: count

		annotation SummarizationSetBy = Automatic

	column MonthCreated = FORMAT('Job_Code_Times'[WO_Created], "MMM")
		lineageTag: 81b6f647-8f58-40d2-a408-726bf26aae16
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column YearCreated = FORMAT('Job_Code_Times'[WO_Created], "YYYY")
		lineageTag: e29f2121-f311-4770-8e5a-5dd63f2a3302
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column RelevantJobCodeFlag =
			
			IF(
			    'Job_Code_Times'[job_code] IN {"IS-CS690 INSPECT", "IS-CS770 INSPECT"},
			    1,
			    0
			)
		formatString: 0
		lineageTag: 2bcf00c7-06dd-4c05-9472-99ee859f70fa
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column account_number
		dataType: double
		lineageTag: d813dac9-1232-4e46-b205-1fac78b9b33c
