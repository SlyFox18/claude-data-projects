table DistinctLaborValuesByWoNumber
	lineageTag: f30d80c2-3903-4158-9133-4bdce5fd141e

	column wo_number
		formatString: 0
		lineageTag: 1518d1a9-9472-43ea-a939-719ba25ee722
		summarizeBy: sum
		isNameInferred
		sourceColumn: Job_Code_Times[wo_number]

		annotation SummarizationSetBy = Automatic

	column TotalInv_Lab_Val
		lineageTag: ef361e9f-129c-42a2-807d-b318688e522f
		summarizeBy: sum
		isNameInferred
		sourceColumn: [TotalInv_Lab_Val]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column HasInspectionJobCode
		formatString: 0
		lineageTag: 94d6b09b-260f-4a31-8b68-b9fb5f8aed9c
		summarizeBy: count
		isNameInferred
		sourceColumn: [HasInspectionJobCode]

		annotation SummarizationSetBy = Automatic

	partition DistinctLaborValuesByWoNumber = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    SUMMARIZE(
				        'Job_Code_Times',
				        'Job_Code_Times'[wo_number],
				        "TotalInv_Lab_Val", SUMX(
				            DISTINCT(
				                SELECTCOLUMNS(
				                    'Job_Code_Times',
				                    "wo_number", 'Job_Code_Times'[wo_number],
				                    "job_code", 'Job_Code_Times'[job_code],  // Include job_code to ensure uniqueness
				                    "Inv_Lab_Val", 'Job_Code_Times'[Inv_Lab_Val]
				                )
				            ),
				            [Inv_Lab_Val]
				        )
				    ),
				    "HasInspectionJobCode", 
				    VAR InspectionJobCodes = VALUES(JobCodes[job_code])
				    RETURN IF(
				        CALCULATE(
				            COUNTROWS(
				                FILTER(
				                    'Job_Code_Times',
				                    'Job_Code_Times'[wo_number] = 'Job_Code_Times'[wo_number] &&
				                    'Job_Code_Times'[job_code] IN InspectionJobCodes
				                )
				            )
				        ) > 0,
				        1,
				        0
				    )
				)
				```

	annotation PBI_Id = 94c6b3f6c0dd46738455412671e5968b

