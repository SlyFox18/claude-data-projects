		lineageTag: c995486d-055d-41dc-8974-7d8115beb865
		summarizeBy: none
		sortByColumn: CreationMonthSort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column CreationMonthSort = ```
			
			YEAR(Fact_LaborJobSummary[WorkOrderCreationDate]) * 100 + 
			MONTH(Fact_LaborJobSummary[WorkOrderCreationDate])
			```
		formatString: 0
		lineageTag: 28344a23-d22d-4517-9b1c-ffddc4c2ef58
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column WorkOrderCreationDateKey =
			
			IF(
			    ISBLANK(Fact_LaborJobSummary[WorkOrderCreationDate]),
			    BLANK(),
			    INT(FORMAT(Fact_LaborJobSummary[WorkOrderCreationDate], "YYYYMMDD"))
			)
		formatString: 0
		lineageTag: b20f1e7a-954c-4c4c-bc85-bddc49c28f42
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsPendingInspection =
			
			COUNTROWS(
			    FILTER(
			        Fact_PendingInspections,
			        Fact_PendingInspections[WorkOrderNumber] = Fact_LaborJobSummary[WorkOrderNumber]
			    )
			) > 0
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 31c9ac5a-8718-4da5-944b-7f4434a09c0f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column InspectionCategory =
			SWITCH(
			    TRUE(),
			    Fact_LaborJobSummary[JobCode] IN {
			        "IS-LA115", "IS-LT180", "IS-D110(-500000)", "IS-D125",
			        "IS-D130(-400000)", "IS-D130(400001-)", "IS-D140(-400000)",
			        "IS-D140(400001-)", "IS-D160", "IS-D170", "IS-E120", "IS-E130-QCD",
			        "IS-S240", "IS-X300(-180000)", "IS-X300(180001-)", "IS-X300R(120001-)",
			        "IS-X310", "IS-X350", "IS-Z225(-060000)", "IS-Z335E", "IS-Z345R",
			        "IS-Z355E", "IS-Z355R", "IS-Z425(-040000)", "IS-Z435",
			        "IS-Z445(-100000)", "IS-Z515E", "IS-Z540M", "IS-Z540R",
			        "IS-MOWER INSPECTION"
			    }, "IS-MOWER INSPECTION",
			    Fact_LaborJobSummary[JobCode] IN {
			        "IS-TS4X2", "IS-XUV550", "IS-XUV560", "IS-XUV590M",
			        "IS-XUV835R", "IS-XUV855D", "IS-GATOR INSPECTION"
			    }, "IS-GATOR INSPECTION",
			    Fact_LaborJobSummary[JobCode]
			)
		lineageTag: 7a3f2b1c-9d4e-4a8f-b5c6-e2d1f0a3b4c5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

