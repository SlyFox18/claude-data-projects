			        <div style='
			            background: #dbeafe;
			            padding: 10px 12px;
			            border-radius: 6px;
			            font-size: 12px;
			            color: #1e40af;
			            line-height: 1.4;
			        '>
			            All labor on WOs with inspections ("
			        & FORMAT ( InspectionRev, "$#,##0" ) & " insp + "
			        & FORMAT ( LaborAdditional, "$#,##0" ) & " other)
			        </div>
			    </div>
			    
			    <!-- Card 4: Hours -->
			    <div style='
			        flex: 1;
			        background: white;
			        border-radius: 12px;
			        padding: 22px;
