			    <!-- Right side: Branch info -->
			    <div style='text-align: right;'>
			        <div style='font-size: 11px; opacity: 0.75; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.8px;'>
			            Branch
			        </div>
			        <div style='font-size: 18px; font-weight: 600;'>
			            " & BranchDisplay & "
