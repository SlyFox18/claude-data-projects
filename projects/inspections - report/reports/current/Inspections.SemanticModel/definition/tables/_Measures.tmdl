			'>
			    <!-- Left side: Back arrow + Work Order Number + Details -->
			    <div style='display: flex; align-items: center; gap: 15px; flex: 1;'>
			        <!-- Back arrow -->
			        <div style='
			            width: 40px;
			            height: 40px;
			            background: rgba(255,255,255,0.15);
