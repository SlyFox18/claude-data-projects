	measure 'Date Range Display' =
			
			VAR MinDate =
			    CALCULATE ( MIN ( dim_DateTable[Date] ) )
			VAR MaxDate =
			    CALCULATE ( MAX ( dim_DateTable[Date] ) )
			VAR MinFormatted =
			    FORMAT ( MinDate, "MMM D, YYYY" )
			VAR MaxFormatted =
			    FORMAT ( MaxDate, "MMM D, YYYY" )
			VAR IsSingleDate = MinDate = MaxDate
			VAR AllMinDate =
			    CALCULATE ( MIN ( dim_DateTable[Date] ), ALL ( dim_DateTable ) )
			VAR AllMaxDate =
			    CALCULATE ( MAX ( dim_DateTable[Date] ), ALL ( dim_DateTable ) )
			VAR IsAllDates = MinDate = AllMinDate && MaxDate = AllMaxDate
			RETURN
			    IF (
			        IsAllDates,
			        "📅 All Dates",
			        IF (
			            IsSingleDate,
			            "📅 " & MinFormatted,
			            "📅 " & MinFormatted & " → " & MaxFormatted
			        )
			    )
		lineageTag: a6e84087-7c47-43d2-a65d-0e040da339ee

	measure IsPendingInspection =
			
			VAR CurrentWO =
			    SELECTEDVALUE ( Fact_LaborJobSummary[WorkOrderNumber] )
			RETURN
			    IF (
			        ISBLANK ( CurrentWO ),
			        BLANK (),
			        IF (
			            COUNTROWS (
			                FILTER (
			                    Fact_PendingInspections,
			                    Fact_PendingInspections[WorkOrderNumber] = CurrentWO
			                )
			            ) > 0,
			            1,
			            // Is pending
			            0 // Not pending
			        )
			    )
		formatString: 0
		lineageTag: 27c633c8-4161-4bc2-a3f9-8ce9062db257

	measure 'Avg Parts $ /Inspection' =
			
			DIVIDE([WO List - Total Parts], [Inspection Count by Job Code], 0)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: babcc8fa-fdcc-43c4-8226-7b4be3b07a61

	measure 'Total Inspections LY' = ```
			
			CALCULATE(
			    [Total Inspections],
			    DATEADD( dim_DateTable[Date], -1, YEAR )
			)
			
			```
		formatString: 0
		lineageTag: a1660ac9-8877-4c9d-ab62-013a0ddeb833

	measure 'Parts $ Total (Filtered)' =
			
			VAR ValidInv =
			    CALCULATETABLE(
			        VALUES(Fact_LaborJobSummary[InvoiceNumber]),
			        Fact_LaborJobSummary[IsInspection] = TRUE,
			        NOT(ISBLANK(Fact_LaborJobSummary[InvoiceNumber])),
			        ALL(dim_DateTable)
			    )
			RETURN
			    CALCULATE(
			        SUM(Fact_WorkOrderParts[SaleValue]),
			        Fact_WorkOrderParts[InvoiceNumber] IN ValidInv,
			        Fact_WorkOrderParts[Franchise] <> "ZP",
			        NOT(Fact_WorkOrderParts[PartNumber] IN {"ADV", "LEGACY", "4900", "*10PROMO"})
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 79497b74-305f-4e1f-8e1f-2fe57d8ca52e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Parts $ / Inspection (Rolling 12)' =
			
			DIVIDE([Parts $ Total (Filtered)], [Total Inspections], 0)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 94434eca-2607-4b3b-adde-f0e70d148cfc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Labor $ / Inspection (Rolling 12)' =
			
			DIVIDE([WO List - Total Labor], [Total Inspections], 0)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d733f574-d8c0-448a-ad63-37c8aebc3897

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Parts $ Total Fixed LY' =
			
			CALCULATE(
			    [Parts $ Total (Filtered)],
			    DATEADD( dim_DateTable[Date], -1, YEAR )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8f85adef-1227-4053-95f8-768eca827f3b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'WO List - Total Labor LY' =
			
			CALCULATE(
			    [WO List - Total Labor],
			    DATEADD( dim_DateTable[Date], -1, YEAR )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b2baa986-32a7-4240-8b5f-7b44a843fbec

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Parts $ / Inspection (Rolling 12) LY' =
			
			CALCULATE(
			    [Avg Parts $ / Inspection (Rolling 12)],
			    DATEADD( dim_DateTable[Date], -1, YEAR )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 305ad147-b886-4780-b0f3-57b15ec79d95

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Labor $ / Inspection (Rolling 12) LY' =
			
			CALCULATE(
			    [Avg Labor $ / Inspection (Rolling 12)],
			    DATEADD( dim_DateTable[Date], -1, YEAR )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: edccb391-3997-4169-92d8-8723727b6d30

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Trend Tooltip - HTML' =
			
			VAR _Month = SELECTEDVALUE( dim_DateTable[MonthYear], "This Month" )
			VAR _PartsCur = [Parts $ Total (Filtered)]
			VAR _PartsLY = [Parts $ Total Fixed LY]
			VAR _PartsVar = DIVIDE( _PartsCur - _PartsLY, _PartsLY )
			VAR _PartsUp = _PartsVar >= 0
			VAR _PartsArrow = IF( _PartsUp, "▲", "▼" )
			VAR _PartsColor = IF( _PartsUp, "#22C55E", "#EF4444" )
			VAR _PartsVarTxt = IF( _PartsUp, "+", "" ) & FORMAT( _PartsVar, "0.0%" )
			VAR _PartsCurTxt = "$" & FORMAT( ROUND( _PartsCur / 1000, 0 ), "#,0" ) & "K"
			VAR _PartsLYTxt = "$" & FORMAT( ROUND( _PartsLY / 1000, 0 ), "#,0" ) & "K"
			VAR _LaborCur = [WO List - Total Labor]
			VAR _LaborLY = [WO List - Total Labor LY]
			VAR _LaborVar = DIVIDE( _LaborCur - _LaborLY, _LaborLY )
			VAR _LaborUp = _LaborVar >= 0
			VAR _LaborArrow = IF( _LaborUp, "▲", "▼" )
			VAR _LaborColor = IF( _LaborUp, "#22C55E", "#EF4444" )
			VAR _LaborVarTxt = IF( _LaborUp, "+", "" ) & FORMAT( _LaborVar, "0.0%" )
			VAR _LaborCurTxt = "$" & FORMAT( ROUND( _LaborCur / 1000, 0 ), "#,0" ) & "K"
			VAR _LaborLYTxt = "$" & FORMAT( ROUND( _LaborLY / 1000, 0 ), "#,0" ) & "K"
			VAR _AvgParts = [Avg Parts $ / Inspection (Rolling 12)]
			VAR _AvgPartsLY = [Avg Parts $ / Inspection (Rolling 12) LY]
			VAR _AvgPartsVar = DIVIDE( _AvgParts - _AvgPartsLY, _AvgPartsLY )
			VAR _AvgPartsUp = _AvgPartsVar >= 0
			VAR _AvgPartsArrow = IF( _AvgPartsUp, "▲", "▼" )
			VAR _AvgPartsColor = IF( _AvgPartsUp, "#22C55E", "#EF4444" )
			VAR _AvgPartsVarTxt = IF( _AvgPartsUp, "+", "" ) & FORMAT( _AvgPartsVar, "0.0%" )
			VAR _AvgPartsTxt = "$" & FORMAT( _AvgParts, "#,0.00" )
			VAR _AvgPartsLYTxt = "$" & FORMAT( _AvgPartsLY, "#,0.00" )
			VAR _AvgLabor = [Avg Labor $ / Inspection (Rolling 12)]
			VAR _AvgLaborLY = [Avg Labor $ / Inspection (Rolling 12) LY]
			VAR _AvgLaborVar = DIVIDE( _AvgLabor - _AvgLaborLY, _AvgLaborLY )
			VAR _AvgLaborUp = _AvgLaborVar >= 0
			VAR _AvgLaborArrow = IF( _AvgLaborUp, "▲", "▼" )
			VAR _AvgLaborColor = IF( _AvgLaborUp, "#22C55E", "#EF4444" )
			VAR _AvgLaborVarTxt = IF( _AvgLaborUp, "+", "" ) & FORMAT( _AvgLaborVar, "0.0%" )
			VAR _AvgLaborTxt = "$" & FORMAT( _AvgLabor, "#,0.00" )
			VAR _AvgLaborLYTxt = "$" & FORMAT( _AvgLaborLY, "#,0.00" )
			VAR _Inspections = [Total Inspections]
			VAR _InspLY = [Total Inspections LY]
			VAR _InspDiff = _Inspections - _InspLY
			VAR _InspUp = _InspDiff >= 0
			VAR _InspArrow = IF( _InspUp, "▲", "▼" )
			VAR _InspColor = IF( _InspUp, "#22C55E", "#EF4444" )
			VAR _InspDiffTxt = IF( _InspUp, "+", "" ) & FORMAT( _InspDiff, "#,0" )
			VAR _InspectionsTxt = FORMAT( _Inspections, "#,0" )
			VAR _InspLYTxt = FORMAT( _InspLY, "#,0" )
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;width:100%;background:#1D3C4E;border-radius:12px;padding:16px 18px;color:#fff;box-shadow:0 4px 14px rgba(0,0,0,0.3);box-sizing:border-box;'>
			    <div style='font-size:13px;font-weight:600;letter-spacing:0.5px;opacity:0.75;text-transform:uppercase;margin-bottom:12px;'>" & _Month & "</div>
			    <div style='display:flex;gap:10px;margin-bottom:10px;'>
			        <div style='flex:1;padding:10px 12px;background:rgba(129,140,248,0.15);border-left:4px solid #818CF8;border-radius:6px;'>
			            <div style='font-size:11px;opacity:0.75;margin-bottom:2px;'>Parts $</div>
			            <div style='font-size:20px;font-weight:700;line-height:1.15;'>" & _PartsCurTxt & "</div>
			            <div style='font-size:11px;opacity:0.6;margin-bottom:4px;'>LY: " & _PartsLYTxt & "</div>
			            <div style='color:" & _PartsColor & ";font-weight:700;font-size:14px;'>" & _PartsArrow & " " & _PartsVarTxt & "</div>
			        </div>
			        <div style='flex:1;padding:10px 12px;background:rgba(251,191,36,0.15);border-left:4px solid #FBBF24;border-radius:6px;'>
			            <div style='font-size:11px;opacity:0.75;margin-bottom:2px;'>Labor $</div>
			            <div style='font-size:20px;font-weight:700;line-height:1.15;'>" & _LaborCurTxt & "</div>
			            <div style='font-size:11px;opacity:0.6;margin-bottom:4px;'>LY: " & _LaborLYTxt & "</div>
			            <div style='color:" & _LaborColor & ";font-weight:700;font-size:14px;'>" & _LaborArrow & " " & _LaborVarTxt & "</div>
			        </div>
			    </div>
			    <div style='display:flex;gap:10px;margin-bottom:12px;'>
			        <div style='flex:1;padding:9px 12px;background:rgba(129,140,248,0.08);border-left:4px solid #818CF8;border-radius:6px;'>
			            <div style='font-size:10px;opacity:0.7;margin-bottom:2px;'>Avg Parts $ / Insp</div>
			            <div style='font-size:16px;font-weight:700;line-height:1.15;'>" & _AvgPartsTxt & "</div>
			            <div style='font-size:10px;opacity:0.55;margin-bottom:3px;'>LY: " & _AvgPartsLYTxt & "</div>
			            <div style='color:" & _AvgPartsColor & ";font-weight:700;font-size:12px;'>" & _AvgPartsArrow & " " & _AvgPartsVarTxt & "</div>
			        </div>
			        <div style='flex:1;padding:9px 12px;background:rgba(251,191,36,0.08);border-left:4px solid #FBBF24;border-radius:6px;'>
			            <div style='font-size:10px;opacity:0.7;margin-bottom:2px;'>Avg Labor $ / Insp</div>
			            <div style='font-size:16px;font-weight:700;line-height:1.15;'>" & _AvgLaborTxt & "</div>
			            <div style='font-size:10px;opacity:0.55;margin-bottom:3px;'>LY: " & _AvgLaborLYTxt & "</div>
			            <div style='color:" & _AvgLaborColor & ";font-weight:700;font-size:12px;'>" & _AvgLaborArrow & " " & _AvgLaborVarTxt & "</div>
			        </div>
			    </div>
			    <div style='display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(255,255,255,0.15);padding-top:10px;'>
			        <div>
			            <div style='font-size:10px;opacity:0.7;'>Total Inspections</div>
			            <div style='font-size:18px;font-weight:700;'>" & _InspectionsTxt & "</div>
			        </div>
			        <div style='text-align:center;'>
			            <div style='font-size:10px;opacity:0.7;'>Last Year</div>
			            <div style='font-size:16px;font-weight:600;opacity:0.85;'>" & _InspLYTxt & "</div>
			        </div>
			        <div style='text-align:right;color:" & _InspColor & ";font-weight:700;font-size:15px;'>" & _InspArrow & " " & _InspDiffTxt & "</div>
			    </div>
			</div>
			"
		lineageTag: f5a0bb5f-c81d-49cc-820d-b87ecf1d9a95

	column Value
		isHidden
		lineageTag: 9bebaa8d-37e0-4801-a109-64f1ce8274e2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

