			                    Parts Promo
			                </div>
			                <div style='font-size: 28px; font-weight: 700; color: #111827; line-height: 1;'>
			                    "
			        & FORMAT ( PartsDisc, "$#,##0" ) & "
			                </div>
			            </div>
			            
			        </div>
			    </div>
			</div>
			"
