	measure 'WO List - Total Orders' =
			
			DISTINCTCOUNT ( Fact_LaborJobSummary[WorkOrderNumber] )
		formatString: 0
		lineageTag: ace6c53f-1ed3-4020-8124-aa9342693ad8

	measure 'WO List - Total Revenue' =
			
			[WO List - Total Labor] + [WO List - Total Parts]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 05803ae8-7451-4a37-98f2-22f3811afdff

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'WO List - Total Labor' =
			
			VAR InMatrixContext = ISFILTERED(Fact_LaborJobSummary[JobCode])
			    || ISFILTERED(Fact_LaborJobSummary[InspectionCategory])
			
			RETURN
			    IF(
			        InMatrixContext,
			        // Matrix context: Use filtered work orders from context
			        SUMX (
			            VALUES(Fact_LaborJobSummary[WorkOrderNumber]),
			            CALCULATE (
			                SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ),
			                ALLEXCEPT ( Fact_LaborJobSummary, Fact_LaborJobSummary[WorkOrderNumber] ),
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        ),
			        // Card/Total context: Explicitly filter to inspections, exclude pending
			        SUMX (
			            CALCULATETABLE(
			                VALUES(Fact_LaborJobSummary[WorkOrderNumber]),
			                Fact_LaborJobSummary[IsInspection] = TRUE,
			                Fact_LaborJobSummary[IsPendingInspection] = FALSE  // ADD THIS
			            ),
			            CALCULATE (
			                SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ),
			                ALLEXCEPT ( Fact_LaborJobSummary, Fact_LaborJobSummary[WorkOrderNumber] ),
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 1b744c8e-7a2c-45d6-b212-052eefea7fea

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'WO List - Total Parts' = ```
			
			// Only check if we're at the absolute grand total
			VAR IsAtGrandTotal =
			    NOT(ISFILTERED(Fact_LaborJobSummary[JobCode]))
			    && NOT(ISFILTERED(Fact_LaborJobSummary[BranchName]))
			    && NOT(ISFILTERED(Fact_LaborJobSummary[InspectionCategory]))
			
			RETURN
			    IF(
			        IsAtGrandTotal,
			        // ============================================
			        // GRAND TOTAL ONLY - Use home page measure
			        // ============================================
			        [Parts $ Total],
			        
			        // ============================================
			        // EVERYTHING ELSE - Rows, Branch Subtotals, etc.
			        // ============================================
			        VAR WorkOrdersInContext = VALUES(Fact_LaborJobSummary[WorkOrderNumber])
			        
			        RETURN
			            SUMX (
			                WorkOrdersInContext,
			                VAR CurrentWO = Fact_LaborJobSummary[WorkOrderNumber]
			                VAR InvoiceForThisWO =
			                    CALCULATE (
			                        SELECTEDVALUE ( Fact_LaborJobSummary[InvoiceNumber] ),
			                        Fact_LaborJobSummary[WorkOrderNumber] = CurrentWO,
			                        NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) ),
			                        ALL ( Fact_LaborJobSummary[JobCode] )
			                    )
			                RETURN
			                    IF (
			                        NOT ( ISBLANK ( InvoiceForThisWO ) ),
			                        CALCULATE (
			                            SUM ( Fact_WorkOrderParts[SaleValue] ),
			                            Fact_WorkOrderParts[InvoiceNumber] = InvoiceForThisWO,
			                            Fact_WorkOrderParts[Franchise] <> "ZP",
			                            NOT ( Fact_WorkOrderParts[PartNumber] IN { "ADV", "LEGACY", "4900", "*10PROMO" } )
			                        ),
			                        0
			                    )
			            )
			    )
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 9058330b-ebe2-4191-889f-ef898703b7a3

	measure 'WO List - Labor %' =
			
			DIVIDE ( [WO List - Total Labor], [WO List - Total Revenue], 0 )
		lineageTag: e49cd3d2-4531-4071-8950-8e3a8754e5e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'WO List - Parts %' =
			
			DIVIDE ( [WO List - Total Parts], [WO List - Total Revenue], 0 )
		lineageTag: 81f6643a-4cc9-44fc-9e6f-26da14d3ec58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'WO List - Avg per Order' =
			
			DIVIDE ( [WO List - Total Revenue], [WO List - Total Orders], 0 )
		lineageTag: 67d530a7-cac7-4bfd-9369-2127fcf5cf3a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'WO Labor Total - Fixed' =
			
			IF (
			    ISINSCOPE ( Fact_LaborJobSummary[WorkOrderNumber] ),
			    // Row-level: Calculate for this specific WO
			    CALCULATE (
			        SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ),
			        ALLEXCEPT ( Fact_LaborJobSummary, Fact_LaborJobSummary[WorkOrderNumber] )
			    ),
			    // Total row: Respect all filters
			    CALCULATE (
			        SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ),
			        NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2c6a3ee7-bae2-4b49-bd09-334b017e6c07

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'WO Parts Total - Fixed' =
			
			IF (
			    ISINSCOPE ( Fact_LaborJobSummary[WorkOrderNumber] ),
			    // Row-level: Calculate for this specific WO
			    VAR CurrentWO =
			        SELECTEDVALUE ( Fact_LaborJobSummary[WorkOrderNumber] )
			    VAR InvoiceForThisWO =
			        CALCULATE (
			            SELECTEDVALUE ( Fact_LaborJobSummary[InvoiceNumber] ),
			            Fact_LaborJobSummary[WorkOrderNumber] = CurrentWO,
			            NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			        )
			    RETURN
			        CALCULATE (
			            SUM ( Fact_WorkOrderParts[SaleValue] ),
			            Fact_WorkOrderParts[InvoiceNumber] = InvoiceForThisWO,
			            Fact_WorkOrderParts[Franchise] <> "ZP",
			            NOT ( Fact_WorkOrderParts[PartNumber] IN { "ADV", "LEGACY", "4900", "*10PROMO" } )
			        ),
			    // Total row: Sum all parts respecting filters
			    SUMX (
			        VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			        VAR CurrentWO = Fact_LaborJobSummary[WorkOrderNumber]
			        VAR InvoiceForThisWO =
			            CALCULATE (
			                SELECTEDVALUE ( Fact_LaborJobSummary[InvoiceNumber] ),
			                Fact_LaborJobSummary[WorkOrderNumber] = CurrentWO,
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        RETURN
			            IF (
			                NOT ( ISBLANK ( InvoiceForThisWO ) ),
			                CALCULATE (
			                    SUM ( Fact_WorkOrderParts[SaleValue] ),
			                    Fact_WorkOrderParts[InvoiceNumber] = InvoiceForThisWO,
			                    Fact_WorkOrderParts[Franchise] <> "ZP",
			                    NOT ( Fact_WorkOrderParts[PartNumber] IN { "ADV", "LEGACY", "4900", "*10PROMO" } )
			                ),
			                0
			            )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c8a0180a-2af6-457e-bdff-f1036cbb4514

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'WO Total Revenue - Fixed' =
			
			[WO Labor Total - Fixed] + [WO Parts Total - Fixed]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d443c219-4e55-403e-a0e7-de3b5f48b2c7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'WO List - Summary Cards HTML' =
			
			VAR WorkOrders = [WO List - Total Orders]
			VAR TotalRevenue = [WO List - Total Revenue]
			VAR LaborRevenue = [WO List - Total Labor]
			VAR PartsRevenue = [WO List - Total Parts]
			VAR LaborPct = [WO List - Labor %]
			VAR PartsPct = [WO List - Parts %]
			VAR AvgPerOrder = [WO List - Avg per Order] // Format values
			VAR TotalRevText =
			    IF (
			        TotalRevenue >= 1000000,
			        FORMAT ( TotalRevenue / 1000000, "$#,##0.0" ) & "M",
			        IF (
			            TotalRevenue >= 10000,
			            FORMAT ( TotalRevenue / 1000, "$#,##0.0" ) & "K",
			            FORMAT ( TotalRevenue, "$#,##0" )
			        )
			    )
			VAR LaborRevText =
			    IF (
			        LaborRevenue >= 1000000,
			        FORMAT ( LaborRevenue / 1000000, "$#,##0.0" ) & "M",
			        IF (
			            LaborRevenue >= 10000,
			            FORMAT ( LaborRevenue / 1000, "$#,##0.0" ) & "K",
			            FORMAT ( LaborRevenue, "$#,##0" )
			        )
			    )
			VAR PartsRevText =
			    IF (
			        PartsRevenue >= 1000000,
			        FORMAT ( PartsRevenue / 1000000, "$#,##0.0" ) & "M",
			        IF (
			            PartsRevenue >= 10000,
			            FORMAT ( PartsRevenue / 1000, "$#,##0.0" ) & "K",
			            FORMAT ( PartsRevenue, "$#,##0" )
			        )
			    )
			VAR AvgPerOrderText =
			    IF (
			        AvgPerOrder >= 10000,
			        FORMAT ( AvgPerOrder / 1000, "$#,##0.0" ) & "K",
			        FORMAT ( AvgPerOrder, "$#,##0" )
			    )
			RETURN
			    "
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    display: flex;
			    gap: 15px;
			    padding: 0;
			'>
			    <!-- Card 1: Work Orders -->
			    <div style='
			        flex: 1;
			        background: white;
			        padding: 20px;
			        border-radius: 8px;
			        box-shadow: 0 2px 8px rgba(0,0,0,0);
			        border-top: 4px solid #1D3C4E;
			    '>
			        <div style='
			            font-size: 11px;
			            color: #6B7280;
			            font-weight: 600;
			            text-transform: uppercase;
			            letter-spacing: 0.8px;
			            margin-bottom: 12px;
			        '>
			            Work Orders
			        </div>
			        <div style='
			            font-size: 42px;
			            font-weight: 700;
			            color: #1D3C4E;
			            line-height: 1;
			            margin-bottom: 8px;
			        '>
			            "
			        & FORMAT ( WorkOrders, "#,##0" ) & "
			        </div>
			        <div style='
			            font-size: 12px;
			            color: #6B7280;
			        '>
			            In this selection
			        </div>
			    </div>
			
			    <!-- Card 2: Labor Revenue -->
			    <div style='
			        flex: 1;
			        background: white;
			        padding: 20px;
			        border-radius: 8px;
			        box-shadow: 0 2px 8px rgba(0,0,0,0);
			        border-top: 4px solid #3A7CA5;
			    '>
			        <div style='
			            font-size: 11px;
			            color: #6B7280;
			            font-weight: 600;
			            text-transform: uppercase;
			            letter-spacing: 0.8px;
			            margin-bottom: 12px;
			        '>
			            Labor Revenue
			        </div>
			        <div style='
			            font-size: 42px;
			            font-weight: 700;
			            color: #3A7CA5;
			            line-height: 1;
			            margin-bottom: 8px;
			        '>
			            " & LaborRevText & "
			        </div>
			        <div style='
			            font-size: 12px;
			            color: #6B7280;
			        '>
			            "
			        & FORMAT ( LaborPct, "0%" ) & " of total
			        </div>
			    </div>
			
			    <!-- Card 3: Parts Revenue -->
			    <div style='
			        flex: 1;
			        background: white;
			        padding: 20px;
			        border-radius: 8px;
