	measure 'Total Discount %' =
			
			DIVIDE (
			    ABS ( [Total Discount $] ),
			    [Inspection $$] + [Parts $ Total] + [Labor $$],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 24c8c985-0e8e-4996-a410-7e6719ddcc9b

	measure 'Hours Realization Rate' =
			
