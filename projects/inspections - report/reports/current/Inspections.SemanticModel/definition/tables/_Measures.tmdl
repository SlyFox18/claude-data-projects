	measure 'Average Inspection Revenue' =
			
			CALCULATE (
			    DIVIDE (
			        SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ) + [Parts $ Total],
			        DISTINCTCOUNT ( Fact_LaborJobSummary[WorkOrderNumber] )
			    ),
			    Fact_LaborJobSummary[IsInspection] = TRUE,
			    NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 6a92267a-654e-4f9b-bd25-b1d77bcc0252

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Revenue by Job Code' =
			
			VAR CurrentJobCode =
			    SELECTEDVALUE ( Fact_PendingInspections[JobCode] )
			RETURN
			    IF (
			        NOT ( ISBLANK ( CurrentJobCode ) ),
			        CALCULATE (
			            DIVIDE (
			                [Total $ - Discounts by Job Code],
			                DISTINCTCOUNT ( Fact_LaborJobSummary[WorkOrderNumber] ),
			                0
			            ),
			            Fact_LaborJobSummary[JobCode] = CurrentJobCode,
			            Fact_LaborJobSummary[IsInspection] = TRUE,
			            Fact_LaborJobSummary[IsPendingInspection] = FALSE
			        ),
			        BLANK ()
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c8ae8bed-4ebd-40c9-a638-eff2a62fe310

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Estimated Revenue - Pending' =
			
			VAR PendingCount = [Total Pending Inspections]
			VAR AvgRevenue =
			    CALCULATE (
			        DIVIDE (
			            [Total $ - Discounts by Job Code],
			            DISTINCTCOUNT ( Fact_LaborJobSummary[WorkOrderNumber] ),
			            0
			        ),
			        Fact_LaborJobSummary[IsInspection] = TRUE,
			        Fact_LaborJobSummary[IsPendingInspection] = FALSE
			    )
			RETURN
			    PendingCount * AvgRevenue
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 52c10f69-7a26-4e6a-bdb3-3a3e02bc5d7b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Estimated Revenue by Job Code' =
			
			VAR CurrentJobCode =
			    SELECTEDVALUE ( Fact_PendingInspections[JobCode] )
			VAR PendingCountThisCode =
			    CALCULATE (
			        COUNTROWS ( Fact_PendingInspections ),
			        Fact_PendingInspections[JobCode] = CurrentJobCode
			    )
			VAR AvgRevenueThisCode =
			    CALCULATE (
			        DIVIDE (
			            SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ) + [Parts $ Total],
			            DISTINCTCOUNT ( Fact_LaborJobSummary[WorkOrderNumber] )
			        ),
			        Fact_LaborJobSummary[JobCode] = CurrentJobCode,
			        Fact_LaborJobSummary[IsInspection] = TRUE,
			        NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			    )
			RETURN
			    PendingCountThisCode * AvgRevenueThisCode
		lineageTag: f63cf6fd-9255-4f37-b0d4-636b82e5fd8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Completed Inspections - Selected JobCode' =
			
			VAR SelectedJobCode =
			    SELECTEDVALUE ( Fact_PendingInspections[JobCode] )
			RETURN
			    IF (
			        NOT ( ISBLANK ( SelectedJobCode ) ),
			        CALCULATE (
			            DISTINCTCOUNT ( Fact_LaborJobSummary[WorkOrderNumber] ),
			            Fact_LaborJobSummary[JobCode] = SelectedJobCode,
			            Fact_LaborJobSummary[IsInspection] = TRUE,
			            NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			        ),
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 51245346-cc76-4ff4-aaba-3bd432a9f358

	measure 'Part Sold Count - For JobCode' =
			
			VAR SelectedJobCode =
			    SELECTEDVALUE ( Fact_PendingInspections[JobCode] )
			VAR CurrentPart =
			    SELECTEDVALUE ( dim_Parts[PartNumber] ) // ← Changed this line
			RETURN
			    IF (
			        NOT ( ISBLANK ( SelectedJobCode ) ) && NOT ( ISBLANK ( CurrentPart ) ),
			        VAR CompletedWOs =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			                Fact_LaborJobSummary[JobCode] = SelectedJobCode,
			                Fact_LaborJobSummary[IsInspection] = TRUE,
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        VAR InvoicesForWOs =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[InvoiceNumber] ),
			                Fact_LaborJobSummary[WorkOrderNumber] IN CompletedWOs,
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        VAR PartSoldCount =
			            CALCULATE (
			                DISTINCTCOUNT ( Fact_WorkOrderParts[InvoiceNumber] ),
			                Fact_WorkOrderParts[InvoiceNumber] IN InvoicesForWOs,
			                Fact_WorkOrderParts[PartNumber] = CurrentPart,
			                Fact_WorkOrderParts[Franchise] <> "ZP"
			            )
			        RETURN
			            PartSoldCount,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 243eef61-f0eb-42da-9c00-dc310726e931

	measure 'Part Frequency % - For JobCode' =
			
			DIVIDE (
			    [Part Sold Count - For JobCode],
			    [Completed Inspections - Selected JobCode],
			    0
			)
		formatString: 0%;-0%;0%
		lineageTag: 8bad27c6-5df0-4ae7-85d7-37763b8156fc

	measure 'Avg Part Quantity - For JobCode' =
			
			VAR SelectedJobCode =
			    SELECTEDVALUE ( Fact_PendingInspections[JobCode] )
			VAR CurrentPart =
			    SELECTEDVALUE ( Fact_WorkOrderParts[PartNumber] )
			RETURN
			    IF (
			        NOT ( ISBLANK ( SelectedJobCode ) ) && NOT ( ISBLANK ( CurrentPart ) ),
			        VAR CompletedWOs =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			                Fact_LaborJobSummary[JobCode] = SelectedJobCode,
			                Fact_LaborJobSummary[IsInspection] = TRUE,
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        VAR InvoicesForWOs =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[InvoiceNumber] ),
			                Fact_LaborJobSummary[WorkOrderNumber] IN CompletedWOs,
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        VAR TotalQty =
			            CALCULATE (
			                SUM ( Fact_WorkOrderParts[Quantity] ),
			                Fact_WorkOrderParts[InvoiceNumber] IN InvoicesForWOs,
			                Fact_WorkOrderParts[PartNumber] = CurrentPart,
			                Fact_WorkOrderParts[Franchise] <> "ZP"
			            )
			        VAR TimesUsed = [Part Sold Count - For JobCode]
			        RETURN
			            DIVIDE ( TotalQty, TimesUsed, 0 ),
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 853dc63c-862c-480c-8471-3c1078fdb13d

	measure 'Est Quantity Needed - For Pending' =
			
			VAR PendingCount =
			    CALCULATE (
			        COUNTROWS ( Fact_PendingInspections ),
			        ALLEXCEPT ( Fact_PendingInspections, Fact_PendingInspections[JobCode] )
			    )
			VAR Frequency = [Part Frequency % - For JobCode]
			VAR AvgQty = [Avg Part Quantity - For JobCode]
			RETURN
			    PendingCount * Frequency * AvgQty
		formatString: 0
		lineageTag: 1a4b42e9-8130-4fd6-b4d5-b777e01fcb75

	measure 'Show Part for JobCode' =
			
			VAR SelectedJobCode =
			    SELECTEDVALUE ( Fact_PendingInspections[JobCode] )
			VAR CurrentPart =
			    SELECTEDVALUE ( dim_Parts[PartNumber] )
			RETURN
			    IF (
			        NOT ( ISBLANK ( SelectedJobCode ) ) && NOT ( ISBLANK ( CurrentPart ) ),
			        IF ( [Part Sold Count - For JobCode] > 0, 1, 0 ),
			        0
			    )
		formatString: 0
		lineageTag: 9094f27e-70fb-4e20-a69e-0a50390c5a87

	measure 'Est Parts Value - For Pending' =
			
			SUMX (
			    FILTER ( dim_Parts, [Show Part for JobCode] = 1 ),
			    [Est Quantity Needed - For Pending] * dim_Parts[SellPrice1]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a6a62950-8659-4d6a-b146-b15792d6d117

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Service Count - For JobCode' =
			
			VAR SelectedInspectionCode =
			    SELECTEDVALUE ( Fact_PendingInspections[JobCode] )
			VAR CurrentServiceCode =
			    SELECTEDVALUE ( Fact_LaborJobSummary[JobCode] )
			RETURN
			    IF (
			        NOT ( ISBLANK ( SelectedInspectionCode ) )
			            && NOT ( ISBLANK ( CurrentServiceCode ) )
			                && CurrentServiceCode <> SelectedInspectionCode,
			        // Check this OUTSIDE the CALCULATE
			        // Get work orders that have the selected inspection
			        VAR WorkOrdersWithInspection =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			                Fact_LaborJobSummary[JobCode] = SelectedInspectionCode,
			                Fact_LaborJobSummary[IsInspection] = TRUE,
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            ) // Count how many of those work orders ALSO have the current service
			        VAR ServiceCount =
			            CALCULATE (
			                DISTINCTCOUNT ( Fact_LaborJobSummary[WorkOrderNumber] ),
			                Fact_LaborJobSummary[WorkOrderNumber] IN WorkOrdersWithInspection,
			                Fact_LaborJobSummary[JobCode] = CurrentServiceCode
			            )
			        RETURN
			            ServiceCount,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: b67d6552-4005-4f0d-8a9f-52feb143de26

	measure 'Service Frequency % - For JobCode' =
			
			DIVIDE (
			    [Service Count - For JobCode],
			    [Completed Inspections - Selected JobCode],
			    0
			)
		formatString: 0%;-0%;0%
		lineageTag: 5d26c3ae-c891-454c-a7cf-5d17b011fe06

	measure 'Avg Labor $ - For Service' =
			
			VAR SelectedInspectionCode =
			    SELECTEDVALUE ( Fact_PendingInspections[JobCode] )
			VAR CurrentServiceCode =
			    SELECTEDVALUE ( Fact_LaborJobSummary[JobCode] )
			RETURN
			    IF (
			        NOT ( ISBLANK ( SelectedInspectionCode ) )
			            && NOT ( ISBLANK ( CurrentServiceCode ) )
			                && CurrentServiceCode <> SelectedInspectionCode,
			        VAR WorkOrdersWithInspection =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			                Fact_LaborJobSummary[JobCode] = SelectedInspectionCode,
			                Fact_LaborJobSummary[IsInspection] = TRUE,
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        VAR TotalLabor =
			            CALCULATE (
			                SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ),
			                Fact_LaborJobSummary[WorkOrderNumber] IN WorkOrdersWithInspection,
			                Fact_LaborJobSummary[JobCode] = CurrentServiceCode
			            )
			        VAR ServiceCount = [Service Count - For JobCode]
			        RETURN
			            DIVIDE ( TotalLabor, ServiceCount, 0 ),
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 7ba0644d-a4f2-4778-bb5d-a90c342d897b

	measure 'Est Service Opportunities' =
			
			VAR PendingCount =
			    CALCULATE (
			        COUNTROWS ( Fact_PendingInspections ),
			        ALLEXCEPT ( Fact_PendingInspections, Fact_PendingInspections[JobCode] )
			    )
			RETURN
			    PendingCount * [Service Frequency %]
		formatString: 0
		lineageTag: d3195968-40f2-4dc3-89f9-3155d6808d22

	measure 'Est Service Revenue' =
			
			[Est Service Opportunities] * [Avg Service Labor]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 609e4b33-11ce-4ba4-a533-644b2d6fec23

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Show Service for JobCode' =
			
			VAR SelectedInspectionCode =
			    SELECTEDVALUE ( Fact_PendingInspections[JobCode] )
			VAR CurrentServiceCode =
			    SELECTEDVALUE ( Fact_LaborJobSummary[JobCode] )
			RETURN
			    IF (
			        NOT ( ISBLANK ( SelectedInspectionCode ) )
			            && NOT ( ISBLANK ( CurrentServiceCode ) )
			                && CurrentServiceCode <> SelectedInspectionCode
			                && [Service Count - For JobCode] > 0,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 8a687385-fc54-4b11-b936-253c45fdb03d

	measure 'Service Frequency %' =
			
			DIVIDE (
			    SUM ( ServiceRecommendations[TimesAdded] ),
			    MAX ( ServiceRecommendations[CompletedInspections] ),
			    0
			)
		formatString: 0%;-0%;0%
		lineageTag: 2c6ec7f8-b192-4468-a5f1-33c72cc85f65

	measure 'Avg Service Labor' =
			
