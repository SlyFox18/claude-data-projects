	measure 'Inspection Count by Job Code' =
			
			CALCULATE (
			    DISTINCTCOUNT ( Fact_LaborJobSummary[WorkOrderNumber] ),
			    Fact_LaborJobSummary[IsInspection] = TRUE
			)
		formatString: 0
		lineageTag: 8cbd1748-cf6a-458b-af5f-541abcd8f846

	measure 'Parts $ by Job Code' =
			
			VAR CurrentJobCode =
			    SELECTEDVALUE ( Fact_LaborJobSummary[JobCode] )
			VAR WorkOrdersWithThisJobCode =
			    CALCULATETABLE (
			        VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			        Fact_LaborJobSummary[JobCode] = CurrentJobCode,
			        Fact_LaborJobSummary[IsInspection] = TRUE
			    )
			VAR InvoicesForTheseWOs =
			    CALCULATETABLE (
			        VALUES ( Fact_LaborJobSummary[InvoiceNumber] ),
			        Fact_LaborJobSummary[WorkOrderNumber] IN WorkOrdersWithThisJobCode,
			        NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			    )
			RETURN
			    CALCULATE (
			        SUM ( Fact_WorkOrderParts[SaleValue] ),
			        Fact_WorkOrderParts[InvoiceNumber] IN InvoicesForTheseWOs,
			        Fact_WorkOrderParts[Franchise] <> "ZP",
			        NOT ( Fact_WorkOrderParts[PartNumber] IN { "ADV", "LEGACY", "4900", "*10PROMO" } )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5133fb14-e5bf-4dbb-bdba-31e5a04738cb

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Labor $ by Job Code' =
			
			VAR CurrentJobCode =
			    SELECTEDVALUE ( Fact_LaborJobSummary[JobCode] )
			VAR WorkOrdersWithThisJobCode =
			    CALCULATETABLE (
			        VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			        Fact_LaborJobSummary[JobCode] = CurrentJobCode,
			        Fact_LaborJobSummary[IsInspection] = TRUE
			    )
			RETURN
			    CALCULATE (
			        SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ),
			        Fact_LaborJobSummary[WorkOrderNumber] IN WorkOrdersWithThisJobCode
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: be006fae-70a3-4d65-b18a-0ce1979c1e3d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Parts $ by Job Code' =
			
			DIVIDE ( [WO List - Total Parts], [Inspection Count by Job Code], 0 )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 76c28d8c-1e5e-4930-8bcd-28f286b9d4a6

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Labor $ by Job Code' =
			
			DIVIDE ( [WO List - Total Labor], [Inspection Count by Job Code], 0 )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: f5c22f17-a552-4671-ae37-db6b859cd451

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total $ - Discounts by Job Code' =
			
			VAR TotalRevenue = [WO List - Total Parts] + [WO List - Total Labor]
			VAR TotalDiscounts = [Parts Discount by Job Code] + [Labor Discount by Job Code]
			RETURN
			    TotalRevenue + TotalDiscounts
			// Add because discounts are already negative
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 90970d52-3586-4c7c-b859-4b086e910f5c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg % Discounted by Job Code' =
			
			VAR TotalDiscount =
			    ABS ( [Labor Discount by Job Code] + [Parts Discount by Job Code] )
			VAR TotalRevenue = [WO List - Total Parts] + [WO List - Total Labor]
			RETURN
			    DIVIDE ( TotalDiscount, TotalRevenue, 0 )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 363dad33-01ba-4af2-95af-2eda2cc4fcab

	measure 'Labor Discount by Job Code' =
			
			VAR InMatrixContext = ISFILTERED(Fact_LaborJobSummary[JobCode])
			    || ISFILTERED(Fact_LaborJobSummary[InspectionCategory])
			
			RETURN
			    IF(
			        InMatrixContext,
			        // Row level: existing logic
			        VAR CurrentJobCode = SELECTEDVALUE(Fact_LaborJobSummary[JobCode])
			        VAR WorkOrdersWithThisJobCode =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			                Fact_LaborJobSummary[JobCode] = CurrentJobCode,
			                Fact_LaborJobSummary[IsInspection] = TRUE
			            )
			        VAR InvoicesForTheseWOs =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[InvoiceNumber] ),
			                Fact_LaborJobSummary[WorkOrderNumber] IN WorkOrdersWithThisJobCode,
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        RETURN
			            CALCULATE (
			                SUM ( Fact_WorkOrderParts[SaleValue] ),
			                Fact_WorkOrderParts[InvoiceNumber] IN InvoicesForTheseWOs,
			                Fact_WorkOrderParts[PartNumber] IN { "ADV", "LEGACY" }
			            ),
			        // Total level: use home page measure
			        [ADV Discount]
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c2914f47-2521-43e9-80e9-a80309b01495

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Parts Discount by Job Code' =
			
			VAR InMatrixContext = ISFILTERED(Fact_LaborJobSummary[JobCode])
			    || ISFILTERED(Fact_LaborJobSummary[InspectionCategory])
			
			RETURN
			    IF(
			        InMatrixContext,
			        // Row level: existing logic
			        VAR CurrentJobCode = SELECTEDVALUE(Fact_LaborJobSummary[JobCode])
			        VAR WorkOrdersWithThisJobCode =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			                Fact_LaborJobSummary[JobCode] = CurrentJobCode,
			                Fact_LaborJobSummary[IsInspection] = TRUE
			            )
			        VAR InvoicesForTheseWOs =
			            CALCULATETABLE (
			                VALUES ( Fact_LaborJobSummary[InvoiceNumber] ),
			                Fact_LaborJobSummary[WorkOrderNumber] IN WorkOrdersWithThisJobCode,
			                NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			            )
			        RETURN
			            CALCULATE (
			                SUM ( Fact_WorkOrderParts[SaleValue] ),
			                Fact_WorkOrderParts[InvoiceNumber] IN InvoicesForTheseWOs,
			                Fact_WorkOrderParts[PartNumber] = "*10PROMO"
			            ),
			        // Total level: use home page measure
			        [Parts Discount]
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: acfc5cfe-a21a-4db1-940f-985aed2e5357

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Trucking Discount by Job Code' =
			
			VAR CurrentJobCode =
			    SELECTEDVALUE ( Fact_LaborJobSummary[JobCode] )
			VAR WorkOrdersWithThisJobCode =
			    CALCULATETABLE (
			        VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			        Fact_LaborJobSummary[JobCode] = CurrentJobCode,
			        Fact_LaborJobSummary[IsInspection] = TRUE
			    )
			VAR InvoicesForTheseWOs =
			    CALCULATETABLE (
			        VALUES ( Fact_LaborJobSummary[InvoiceNumber] ),
			        Fact_LaborJobSummary[WorkOrderNumber] IN WorkOrdersWithThisJobCode,
			        NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )
			    )
			RETURN
			    CALCULATE (
			        SUM ( Fact_WorkOrderParts[SaleValue] ),
			        Fact_WorkOrderParts[InvoiceNumber] IN InvoicesForTheseWOs,
			        Fact_WorkOrderParts[PartNumber] = "4900"
			    )
		lineageTag: 9d260486-5d8e-4827-ba3f-c28666fa2fb7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Part Discount by Job Code' =
			
