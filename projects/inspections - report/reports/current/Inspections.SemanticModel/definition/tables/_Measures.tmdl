table _Measures
	lineageTag: 3b1a6758-3ca4-47e9-8791-b5d6002e665c

	measure 'Welcome Name' =
			
			VAR _User =
			    USERPRINCIPALNAME ()
			VAR _Position =
			    SEARCH ( "@", _User, 1 )
			VAR _Name =
			    LEFT ( _User, _Position - 1 )
			VAR _FirstLetter =
			    UPPER ( LEFT ( _Name, 1 ) )
			VAR _LastName =
			    MID ( _Name, 2, LEN ( _Name ) - 1 )
			VAR _FormattedLastName =
			    UPPER ( LEFT ( _LastName, 1 ) )
			        & LOWER ( MID ( _LastName, 2, LEN ( _LastName ) ) )
			RETURN
			    "Welcome Back, " & _FirstLetter & "." & _FormattedLastName
		lineageTag: 1ebd317f-6819-4431-9dc5-f7f3415056d0

	measure 'Applied Filters' =
			
			VAR MaxFilters = 7
			RETURN
			    IF (
			        ISFILTERED ( dim_BranchLocation[Branch] ),
			        VAR ___f =
			            FILTERS ( dim_BranchLocation[Branch] )
			        VAR ___r =
			            COUNTROWS ( ___f )
			        VAR ___t =
			            TOPN ( MaxFilters, ___f, dim_BranchLocation[Branch] )
			        VAR ___d =
			            CONCATENATEX ( ___t, dim_BranchLocation[Branch], ", " )
			        VAR ___x =
			            "Branch:  " & ___d
			                & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			        RETURN
			            ___x & UNICHAR ( 13 ) & UNICHAR ( 10 )
			    )
		lineageTag: 55ecb7c5-666c-4eee-81ed-601b4d20b195

	measure 'Total Inspections' =
			
			CALCULATE (
			    COUNTROWS ( Fact_LaborJobSummary ),
			    Fact_LaborJobSummary[IsInspection] = TRUE,
			    NOT(Fact_LaborJobSummary[WorkOrderNumber] IN VALUES(Fact_PendingInspections[WorkOrderNumber]))
			)
		formatString: 0
		lineageTag: 35b83e37-1ab5-4391-9b69-93e28dcbabbb

	measure 'Inspection $$' =
			
			CALCULATE (
			    SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ),
			    Fact_LaborJobSummary[IsInspection] = TRUE
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b1418458-a908-45ba-bd35-9600eea1df7f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Parts $ Total' =
			
			CALCULATE (
			    SUM ( Fact_WorkOrderParts[SaleValue] ),
			    Fact_WorkOrderParts[InvoiceNumber]
			        IN VALUES ( ValidInvoiceNumbers[InvoiceNumber] ),
			    Fact_WorkOrderParts[Franchise] <> "ZP",
			    NOT ( Fact_WorkOrderParts[PartNumber] IN { "ADV", "LEGACY", "4900", "*10PROMO" } )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c2c22c94-4eb2-4165-84de-82ac491af1ba

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Labor $$' =
			
			[Labor With Inspection] - [Inspection $$]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 6c0621e4-0756-4b11-becd-007c27f0c820

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Hours Worked' =
			
			CALCULATE (
			    SUM ( Fact_LaborJobSummary[ActualHoursWorked] ),
			    Fact_LaborJobSummary[IsInspection] = TRUE
			)
		lineageTag: fdc26976-8a2a-45d4-8c51-94c4949396f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Labor With Inspection' =
			
			VAR InspectionWOs =
			    CALCULATETABLE (
			        VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			        Fact_LaborJobSummary[IsInspection] = TRUE,
			        Fact_LaborJobSummary[IsPendingInspection] = FALSE  // EXCLUDE PENDING
			    )
			RETURN
			    CALCULATE (
			        SUM ( Fact_LaborJobSummary[InvoicedLaborAmount] ),
			        Fact_LaborJobSummary[WorkOrderNumber] IN InspectionWOs,
			        NOT ( ISBLANK ( Fact_LaborJobSummary[InvoiceNumber] ) )  // ONLY INVOICED
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e487d4e4-8437-41ac-b7f8-44a29298a614

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Has Inspection' =
			
			VAR InspectionWOs =
			    CALCULATETABLE (
			        VALUES ( Fact_LaborJobSummary[WorkOrderNumber] ),
			        Fact_LaborJobSummary[IsInspection] = TRUE
			    )
			RETURN
			    IF (
			        SELECTEDVALUE ( Fact_LaborJobSummary[WorkOrderNumber] ) IN InspectionWOs,
			        TRUE,
			        FALSE
			    )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 16401fdf-83d5-41a5-bd3a-b9d77ef5f9ab

	measure 'Parts Discount' = ```
			
			VAR InspectionWOs = 
			    CALCULATETABLE(
			        VALUES(Fact_LaborJobSummary[WorkOrderNumber]),
			        Fact_LaborJobSummary[IsInspection] = TRUE,
			        Fact_LaborJobSummary[IsPendingInspection] = FALSE
			    )
			VAR InspectionInvoices = 
			    CALCULATETABLE(
			        VALUES(Fact_LaborJobSummary[InvoiceNumber]),
			        Fact_LaborJobSummary[WorkOrderNumber] IN InspectionWOs,
			        NOT(ISBLANK(Fact_LaborJobSummary[InvoiceNumber]))
			    )
			VAR ValidInspectionInvoices = 
			    FILTER(
			        VALUES(ValidInvoiceNumbers[InvoiceNumber]),
			        ValidInvoiceNumbers[InvoiceNumber] IN InspectionInvoices
			    )
			RETURN
			    CALCULATE(
			        SUM(Fact_WorkOrderParts[SaleValue]),
			        Fact_WorkOrderParts[InvoiceNumber] IN ValidInspectionInvoices,
			        Fact_WorkOrderParts[PartNumber] = "*10PROMO"
			    )
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 1c6fef32-3294-49b4-b5e7-f1ceebd60323

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'ADV Discount' = ```
			
			// Get inspection work orders
			VAR InspectionWOs = 
			    CALCULATETABLE(
			        VALUES(Fact_LaborJobSummary[WorkOrderNumber]),
			        Fact_LaborJobSummary[IsInspection] = TRUE,
			        Fact_LaborJobSummary[IsPendingInspection] = FALSE
			    )
			
			// Get invoices for these work orders
			VAR InspectionInvoices = 
			    CALCULATETABLE(
			        VALUES(Fact_LaborJobSummary[InvoiceNumber]),
			        Fact_LaborJobSummary[WorkOrderNumber] IN InspectionWOs,
			        NOT(ISBLANK(Fact_LaborJobSummary[InvoiceNumber]))
			    )
			
			// Filter to valid invoices only
			VAR ValidInspectionInvoices = 
			    FILTER(
			        VALUES(ValidInvoiceNumbers[InvoiceNumber]),
			        ValidInvoiceNumbers[InvoiceNumber] IN InspectionInvoices
			    )
			
			RETURN
			    CALCULATE(
			        SUM(Fact_WorkOrderParts[SaleValue]),
			        Fact_WorkOrderParts[InvoiceNumber] IN ValidInspectionInvoices,
			        Fact_WorkOrderParts[PartNumber] IN {"ADV", "LEGACY"}
			    )
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f9a577d1-6fc6-4916-b78e-e779e5508f3c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Trucking Discount' = ```
			
			VAR InspectionWOs = 
			    CALCULATETABLE(
			        VALUES(Fact_LaborJobSummary[WorkOrderNumber]),
			        Fact_LaborJobSummary[IsInspection] = TRUE,
			        Fact_LaborJobSummary[IsPendingInspection] = FALSE
			    )
			VAR InspectionInvoices = 
			    CALCULATETABLE(
			        VALUES(Fact_LaborJobSummary[InvoiceNumber]),
			        Fact_LaborJobSummary[WorkOrderNumber] IN InspectionWOs,
			        NOT(ISBLANK(Fact_LaborJobSummary[InvoiceNumber]))
			    )
			VAR ValidInspectionInvoices = 
			    FILTER(
			        VALUES(ValidInvoiceNumbers[InvoiceNumber]),
			        ValidInvoiceNumbers[InvoiceNumber] IN InspectionInvoices
			    )
			RETURN
			    CALCULATE(
			        SUM(Fact_WorkOrderParts[SaleValue]),
			        Fact_WorkOrderParts[InvoiceNumber] IN ValidInspectionInvoices,
			        Fact_WorkOrderParts[PartNumber] = "4900"
			    )
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c0299390-8209-45e3-879c-c3707de8f55d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Parts Total $ - Discount $' =
			
