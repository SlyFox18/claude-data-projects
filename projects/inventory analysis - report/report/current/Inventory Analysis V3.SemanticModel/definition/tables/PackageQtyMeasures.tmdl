	measure 'TrueActiveInventory - Tooltip HTML' =
			
			VAR Total = [TrueActiveInventory]
			VAR Packaged = [TrueActiveInventory - Packaged]
			VAR Single = [TrueActiveInventory - Single]
			VAR PackagePct = [TrueActiveInventory - Package %]
			VAR SinglePct = 1 - PackagePct
			RETURN
			IF(
			    ISBLANK(Total) || Total = 0,
			    BLANK(),
			    "<div style='font-family: Segoe UI; padding: 12px; background: #ffffff; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);'>
			        <div style='font-size: 11px; font-weight: 600; color: #2d5f3f; letter-spacing: 0.3px; margin-bottom: 8px; border-bottom: 1px solid #e0e0e0; padding-bottom: 6px;'>
			            ACTIVE INVENTORY BREAKDOWN
			        </div>
			        <div style='margin-bottom: 10px;'>
			            <div style='font-size: 10px; color: #666; margin-bottom: 2px;'>Total Value</div>
			            <div style='font-size: 16px; font-weight: 700; color: #1a1a1a;'>" & FORMAT(Total, "$#,##0") & "</div>
			        </div>
			        <div style='display: flex; gap: 12px;'>
			            <div style='flex: 1; padding: 8px; background: #fff3e0; border-radius: 3px; border-left: 3px solid #f57c00;'>
			                <div style='font-size: 9px; font-weight: 600; color: #e65100; letter-spacing: 0.3px; margin-bottom: 3px;'>📦 IN PACKAGES</div>
			                <div style='font-size: 13px; font-weight: 700; color: #f57c00;'>" & FORMAT(Packaged, "$#,##0") & "</div>
			                <div style='font-size: 10px; color: #e65100; margin-top: 2px;'>" & FORMAT(PackagePct, "0.0%") & " of total</div>
			            </div>
			            <div style='flex: 1; padding: 8px; background: #e8f5e9; border-radius: 3px; border-left: 3px solid #4caf50;'>
			                <div style='font-size: 9px; font-weight: 600; color: #2e7d32; letter-spacing: 0.3px; margin-bottom: 3px;'>✓ SINGLE UNITS</div>
			                <div style='font-size: 13px; font-weight: 700; color: #4caf50;'>" & FORMAT(Single, "$#,##0") & "</div>
			                <div style='font-size: 10px; color: #2e7d32; margin-top: 2px;'>" & FORMAT(SinglePct, "0.0%") & " of total</div>
			            </div>
			        </div>
			        <div style='margin-top: 8px; padding: 6px; background: #f5f5f5; border-radius: 3px; font-size: 9px; color: #666; line-height: 1.3;'>
			            <span style='font-weight: 600;'>Note:</span> Package inventory represents multi-unit sets with limited liquidity
			        </div>
			    </div>"
			)
		lineageTag: 48064a4d-645b-431e-9214-33740df1eed0

