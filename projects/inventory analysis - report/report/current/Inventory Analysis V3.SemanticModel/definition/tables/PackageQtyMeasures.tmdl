table PackageQtyMeasures
	lineageTag: 3307ccbb-d31b-4c58-a328-6f37b9cc9957

	measure 'TrueActiveInventory - Packaged' = ```
			
			VAR ActivePackaged = 
			    CALCULATE(
			        [TotalInventory_Active],
			        Fact_Inventory[PackageQty] > 1
			    )
			VAR ExcessPackaged = 
			    SUMX(
			        FILTER(
			            Fact_Inventory,
			            Fact_Inventory[Current12MoSales] > 0
			                && Fact_Inventory[QuantityOnHand] > Fact_Inventory[Current12MoSales]
			                && Fact_Inventory[QuantityOnHand] > 0
			                && Fact_Inventory[InventoryCost] > 0
			                && Fact_Inventory[PackageQty] > 1
			        ),
			        VAR _ExcessQty = Fact_Inventory[QuantityOnHand] - Fact_Inventory[Current12MoSales]
			        VAR _UnitCost = DIVIDE(Fact_Inventory[InventoryCost], Fact_Inventory[QuantityOnHand])
			        RETURN _ExcessQty * _UnitCost
			    )
			RETURN ActivePackaged - ExcessPackaged
			```
		lineageTag: 18a1eecc-cfb5-4f87-9690-6ae1da71d83b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TrueActiveInventory - Single' = ```
			
			VAR ActiveSingle = 
			    CALCULATE(
			        [TotalInventory_Active],
			        OR(
			            Fact_Inventory[PackageQty] = 1,
			            ISBLANK(Fact_Inventory[PackageQty])
			        )
			    )
			VAR ExcessSingle = 
			    SUMX(
			        FILTER(
			            Fact_Inventory,
			            Fact_Inventory[Current12MoSales] > 0
			                && Fact_Inventory[QuantityOnHand] > Fact_Inventory[Current12MoSales]
			                && Fact_Inventory[QuantityOnHand] > 0
			                && Fact_Inventory[InventoryCost] > 0
			                && (Fact_Inventory[PackageQty] = 1 || ISBLANK(Fact_Inventory[PackageQty]))
			        ),
			        VAR _ExcessQty = Fact_Inventory[QuantityOnHand] - Fact_Inventory[Current12MoSales]
			        VAR _UnitCost = DIVIDE(Fact_Inventory[InventoryCost], Fact_Inventory[QuantityOnHand])
			        RETURN _ExcessQty * _UnitCost
			    )
			RETURN ActiveSingle - ExcessSingle
			```
		lineageTag: f4f9a894-7c10-4b0b-8c4a-171599b6df0b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TrueActiveInventory - Package %' =
			
			DIVIDE(
			    [TrueActiveInventory - Packaged],
			    [TrueActiveInventory],
			    0
			)
		lineageTag: 7bf4c00f-d673-4810-8ebf-7b1432f079c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TrueActiveInventory - Tooltip' =
			
			VAR Total = [TrueActiveInventory]
			VAR Packaged = [TrueActiveInventory - Packaged]
			VAR Single = [TrueActiveInventory - Single]
			VAR PackagePct = [TrueActiveInventory - Package %]
			RETURN
			    IF(
			        ISBLANK(Total) || Total = 0,
			        BLANK(),
			        "Total: " & FORMAT(Total, "$#,##0") & UNICHAR(10) &
			        "In Packages: " & FORMAT(Packaged, "$#,##0") & " (" & FORMAT(PackagePct, "0.0%") & ")" & UNICHAR(10) &
			        "Single Units: " & FORMAT(Single, "$#,##0") & " (" & FORMAT(1 - PackagePct, "0.0%") & ")"
			    )
		lineageTag: 969997e2-7639-42db-9b14-ab74344abcf2

