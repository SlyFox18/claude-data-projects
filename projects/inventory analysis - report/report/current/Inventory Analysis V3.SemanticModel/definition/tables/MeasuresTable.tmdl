			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 8px;
			            text-align: center;
			        '>Previous 12" & IF(_IsPeak12, " ⭐", "") & "</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _Color12 & ";
			            margin: 8px 0;
			        '>" & _Prev12Text & "</div>
			        
			        <div style='
			            font-size: 18px;
			            opacity: 0.75;
			            margin-top: 8px;
			        '>" & _Prev12MarginText & " Margin</div>
			        
			        <div style='
			            font-size: 13px;
			            margin-top: 8px;
			            background: " & _Prev12StatusColor & "25;
			            border: 1.5px solid " & _Prev12StatusColor & ";
			            border-radius: 12px;
			            padding: 6px 14px;
			            display: inline-block;
			            font-weight: 600;
