		lineageTag: 700bdbd9-57e1-4687-b9fe-4b08beee4e96

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Diff Previous 60 with Arrow' =
			
			VAR uparrow =
			    UNICHAR ( 129129 )
			VAR downarrow =
			    UNICHAR ( 129131 )
			VAR salesdiff = [Sales Diff Previous 60]
			VAR formatedvalue =
			    SWITCH (
			        TRUE (),
			        ABS ( salesdiff ) >= 1000000,
			            FORMAT ( salesdiff / 1000000, "$#.00" ) & "M",
			        ABS ( salesdiff ) >= 1000,
			            FORMAT ( salesdiff / 1000, "$#.00" ) & "K",
			        FORMAT ( salesdiff, "$#.00" )
			    )
			RETURN
			    IF (
			        [Rolling12_Sales] = 0,
