		lineageTag: 9d36d6fd-05fc-4a79-a170-029bccbde7ed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PartsSales with Payment %' =
			
			VAR SalesAmount = SUM(Fact_Invoice_InventoryAnalysis[PartsSaleValue])
			VAR BranchTotal = CALCULATE(
			    SUM(Fact_Invoice_InventoryAnalysis[PartsSaleValue]),
			    ALLSELECTED(dim_PaymentMethod),
			    VALUES(dim_BranchLocation[Branch])
			)
			VAR Percentage = DIVIDE(SalesAmount, BranchTotal, 0)
			RETURN
			    IF(
			        ISBLANK(SalesAmount) || SalesAmount = 0,
			        BLANK(),
			        FORMAT(SalesAmount, "$#,##0.00") & " (" & FORMAT(Percentage, "0.0%") & ")"
			    )
		lineageTag: b91aa520-8003-461d-ac2d-56061845623f

	measure 'Payment Sales Label' =
			
			VAR SalesAmount = [Parts Sales]
			VAR Percentage = [Payment Method %]
			RETURN
			    FORMAT(SalesAmount / 1000000, "$#,##0.0") & "M (" & FORMAT(Percentage, "0.0%") & ")"
		lineageTag: 34686a78-e9f8-4d8d-a19f-1ec23b99b7ac

