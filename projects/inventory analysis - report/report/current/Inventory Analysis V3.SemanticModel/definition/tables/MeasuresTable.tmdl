	measure 'Hero Card - 60 Month Summary' = ```
			
			// ============================================================================
			// Calculate aggregate metrics across all periods
			// ============================================================================
			VAR _TotalSales = 
			    [Rolling12_Sales] + 
			    [Previous 12 Sales] + 
			    [Previous 24 Sales] + 
			    [Previous 36 Sales] + 
			    [Previous 48 Sales] + 
			    [Previous 60 Sales]
			
			VAR _AvgMargin = 
			    DIVIDE(
			        [Rolling12_MarginPct] + 
			        [% Previous 12] + 
			        [% Previous 24] + 
			        [% Previous 36] + 
			        [% Previous 48] + 
			        [% Previous 60],
			        6,
			        0
			    )
			
			// ============================================================================
			// Determine overall trend
			// ============================================================================
			VAR _CurrentSales = [Rolling12_Sales]
			VAR _OldestSales = [Previous 60 Sales]
			VAR _TrendDirection = 
			    SWITCH(
			        TRUE(),
			        _CurrentSales > _OldestSales * 1.1, "↗ Strong Growth",
			        _CurrentSales > _OldestSales * 1.02, "↑ Growing",
			        _CurrentSales < _OldestSales * 0.9, "↘ Declining",
			        _CurrentSales < _OldestSales * 0.98, "↓ Weakening",
			        "→ Stable"
			    )
			
			VAR _TrendColor = 
			    SWITCH(
			        TRUE(),
			        _CurrentSales > _OldestSales * 1.1, "#4ADE80",  // Green
			        _CurrentSales > _OldestSales * 1.02, "#86EFAC",  // Light Green
			        _CurrentSales < _OldestSales * 0.9, "#EF4444",   // Red
			        _CurrentSales < _OldestSales * 0.98, "#FCA5A5",  // Light Red
			        "#FCD34D"  // Yellow (stable)
			    )
			
			// ============================================================================
			// Format values
			// ============================================================================
			VAR _TotalSalesText = 
			    IF(_TotalSales >= 1000000, 
			       FORMAT(_TotalSales / 1000000, "$#,##0.0") & "M", 
			       FORMAT(_TotalSales / 1000, "$#,##0") & "K")
			
			VAR _AvgMarginText = FORMAT(_AvgMargin, "0.00%")
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 6px;
			    padding: 15px 30px;
			    display: flex;
			    justify-content: space-around;
			    align-items: center;
			    gap: 40px;
			    color: white;
			    margin-top: 10px;
			'>
			    <!-- Total Sales -->
			    <div style='
			        display: flex;
			        align-items: center;
			        gap: 10px;
			    '>
			        <div style='
			            font-size: 12px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.7;
			        '>60-Month Total Sales:</div>
			        <div style='
			            font-size: 22px;
			            font-weight: 700;
			            color: #3A7CA5;
			        '>" & _TotalSalesText & "</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; height: 30px; background: rgba(255,255,255,0.2);'></div>
			
			    <!-- Average Margin -->
			    <div style='
			        display: flex;
			        align-items: center;
			        gap: 10px;
			    '>
			        <div style='
			            font-size: 12px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.7;
			        '>Average Margin:</div>
			        <div style='
			            font-size: 22px;
			            font-weight: 700;
			            color: #4ADE80;
			        '>" & _AvgMarginText & "</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; height: 30px; background: rgba(255,255,255,0.2);'></div>
			
			    <!-- Trend -->
			    <div style='
			        display: flex;
			        align-items: center;
			        gap: 10px;
			    '>
			        <div style='
			            font-size: 12px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.7;
			        '>5-Year Trend:</div>
			        <div style='
			            font-size: 22px;
			            font-weight: 700;
			            color: " & _TrendColor & ";
			        '>" & _TrendDirection & "</div>
			    </div>
			</div>"
			```
