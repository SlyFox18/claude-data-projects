	measure 'PartsSales % of Total' =
			
			DIVIDE (
			    SUM ( Fact_Invoice_InventoryAnalysis[PartsSaleValue] ),
			    CALCULATE (
			        SUM ( Fact_Invoice_InventoryAnalysis[PartsSaleValue] ),
			        ALLSELECTED ( dim_ModuleType )
			    ),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fe78e5c1-9032-4144-9919-2ffc8e3ecc6a

	measure 'PartsSales with %' =
			
			VAR SalesAmount =
			    SUM ( Fact_Invoice_InventoryAnalysis[PartsSaleValue] )
			VAR TotalSales =
			    CALCULATE (
			        SUM ( Fact_Invoice_InventoryAnalysis[PartsSaleValue] ),
			        ALLSELECTED ( dim_ModuleType )
			    )
			VAR Percentage =
			    DIVIDE ( SalesAmount, TotalSales, 0 )
			VAR FormattedAmount =
			    SWITCH (
			        TRUE (),
			        SalesAmount >= 1000000,
			            FORMAT ( SalesAmount / 1000000, "$#,##0.00" ) & "M",
			        SalesAmount >= 1000,
			            FORMAT ( SalesAmount / 1000, "$#,##0.00" ) & "K",
			        FORMAT ( SalesAmount, "$#,##0" )
			    )
			RETURN
			    FormattedAmount & " ("
			        & FORMAT ( Percentage, "0.00%" ) & ")"
		lineageTag: 27c41696-2181-4d58-b748-461034d04a07

	measure 'PartsSales % of Grand Total' =
			
			DIVIDE (
			    SUM ( Fact_Invoice_InventoryAnalysis[PartsSaleValue] ),
			    CALCULATE (
			        SUM ( Fact_Invoice_InventoryAnalysis[PartsSaleValue] ),
			        ALL ( dim_ModuleType )
			    ),
			    0
			)
		lineageTag: 92957294-2902-4a48-abd5-aec37130ff0a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PartsSales with Branch %' =
			
			VAR SalesAmount =
			    SUM ( Fact_Invoice_InventoryAnalysis[PartsSaleValue] )
			VAR BranchTotal =
			    CALCULATE (
			        SUM ( Fact_Invoice_InventoryAnalysis[PartsSaleValue] ),
			        ALLSELECTED ( dim_ModuleType ),
			        VALUES ( dim_BranchLocation[Branch] )
			    )
			VAR Percentage =
			    DIVIDE ( SalesAmount, BranchTotal, 0 )
			RETURN
			    IF (
			        ISBLANK ( SalesAmount )
			            || SalesAmount = 0,
			        BLANK (),
			        FORMAT ( SalesAmount, "$#,##0.00" ) & " ("
			            & FORMAT ( Percentage, "0.0%" ) & ")"
			    )
		lineageTag: e8baf2e6-623c-4348-b15d-54f102052749

	measure 'Welcome Name' =
			
			VAR _User =
			    USERPRINCIPALNAME ()
			VAR _Position =
			    SEARCH ( "@", _User, 1 )
			VAR _Name =
			    LEFT ( _User, _Position - 1 )
			VAR _FirstLetter =
			    UPPER ( LEFT ( _Name, 1 ) )
			VAR _LastName =
			    MID ( _Name, 2, LEN ( _Name ) - 1 )
			VAR _FormattedLastName =
			    UPPER ( LEFT ( _LastName, 1 ) )
			        & LOWER ( MID ( _LastName, 2, LEN ( _LastName ) ) )
			RETURN
			    "Welcome Back, " & _FirstLetter & "." & _FormattedLastName
		lineageTag: 357aaed4-6fc0-4dfb-a620-4f4224dd225c

