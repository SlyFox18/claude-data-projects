			        TRUE (),
			        ABS ( salesdiff ) >= 1000000,
			            FORMAT ( salesdiff / 1000000, "$#.00" ) & "M",
			        ABS ( salesdiff ) >= 1000,
			            FORMAT ( salesdiff / 1000, "$#.00" ) & "K",
			        FORMAT ( salesdiff, "$#.00" )
			    )
			RETURN
			    IF (
			        [Rolling12_Sales] = 0,
			        "0",
			        IF (
			            salesdiff < 0,
			            formatedvalue & "  " & downarrow,
			            formatedvalue & "  " & uparrow
			        )
			    )
		lineageTag: 35bb80d1-2ff0-4409-b5cb-1e5ca2126183

	measure 'Sales Diff Previous 60' =
			
