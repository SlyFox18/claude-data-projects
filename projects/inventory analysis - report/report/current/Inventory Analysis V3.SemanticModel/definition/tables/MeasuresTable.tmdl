	measure 'Status Hero Bar' = ```
			
			// ============================================================================
			// Calculate overall business health
			// ============================================================================
			VAR _TotalSales = 
			    [Rolling12_Sales] + [Previous 12 Sales] + [Previous 24 Sales] + 
			    [Previous 36 Sales] + [Previous 48 Sales] + [Previous 60 Sales]
			
			VAR _AvgMargin = 
			    DIVIDE(
			        [Rolling12_MarginPct] + [% Previous 12] + [% Previous 24] + 
			        [% Previous 36] + [% Previous 48] + [% Previous 60],
			        6, 0
			    )
			
			VAR _YoYGrowth = DIVIDE([Rolling12_Sales] - [Previous 12 Sales], [Previous 12 Sales], 0)
			
			// Determine overall status with dramatic thresholds
			VAR _OverallStatus = 
			    SWITCH(
			        TRUE(),
			        _YoYGrowth > 0.05 && [Rolling12_MarginPct] > _AvgMargin, "🔥 EXCEPTIONAL",
			        _YoYGrowth > 0.02, "✓ STRONG",
			        _YoYGrowth > -0.02, "→ STABLE",
			        _YoYGrowth > -0.05, "⚠ CAUTION",
			        "🔴 ALERT"
			    )
			
			VAR _StatusColor = 
			    SWITCH(
			        TRUE(),
			        _YoYGrowth > 0.05 && [Rolling12_MarginPct] > _AvgMargin, "#10B981",  // Bright Green
			        _YoYGrowth > 0.02, "#4ADE80",  // Green
			        _YoYGrowth > -0.02, "#FCD34D",  // Yellow
			        _YoYGrowth > -0.05, "#FB923C",  // Orange
			        "#EF4444"  // Red
			    )
			
			VAR _StatusBgColor = 
			    SWITCH(
			        TRUE(),
			        _YoYGrowth > 0.05 && [Rolling12_MarginPct] > _AvgMargin, "rgba(16, 185, 129, 0.15)",
			        _YoYGrowth > 0.02, "rgba(74, 222, 128, 0.15)",
			        _YoYGrowth > -0.02, "rgba(252, 211, 77, 0.15)",
			        _YoYGrowth > -0.05, "rgba(251, 146, 60, 0.15)",
			        "rgba(239, 68, 68, 0.15)"
			    )
			
			VAR _TrendText = 
			    SWITCH(
			        TRUE(),
			        _YoYGrowth > 0.05, "↗ Strong Growth",
			        _YoYGrowth > 0.02, "↑ Growing",
			        _YoYGrowth > -0.02, "→ Stable",
			        _YoYGrowth > -0.05, "↓ Declining",
			        "↘ Sharp Decline"
			    )
			
			// Format values
			VAR _TotalSalesText = 
			    IF(_TotalSales >= 1000000, 
			       FORMAT(_TotalSales / 1000000, "$#,##0.0") & "M", 
			       FORMAT(_TotalSales / 1000, "$#,##0") & "K")
			
			VAR _AvgMarginText = FORMAT(_AvgMargin, "0.00%")
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 8px;
			    padding: 20px 40px;
			    display: grid;
			    grid-template-columns: auto 1fr auto;
			    gap: 40px;
			    align-items: center;
			    color: white;
			    border: 3px solid " & _StatusColor & ";
			    box-shadow: 0 0 30px " & _StatusBgColor & ";
			'>
			    <!-- Left: Status Badge -->
			    <div style='
			        background: " & _StatusBgColor & ";
			        border: 2px solid " & _StatusColor & ";
			        border-radius: 6px;
			        padding: 12px 24px;
			        text-align: center;
			    '>
			        <div style='
			            font-size: 11px;
			            text-transform: uppercase;
			            letter-spacing: 2px;
			            opacity: 0.7;
			            margin-bottom: 6px;
			        '>Performance Status</div>
			        <div style='
			            font-size: 26px;
			            font-weight: 900;
			            color: " & _StatusColor & ";
			            letter-spacing: 1px;
			        '>" & _OverallStatus & "</div>
			    </div>
			
			    <!-- Center: Key Metrics -->
			    <div style='
			        display: grid;
			        grid-template-columns: repeat(3, 1fr);
			        gap: 30px;
			    '>
			        <!-- 60-Month Total -->
			        <div style='text-align: center;'>
			            <div style='
			                font-size: 11px;
			                text-transform: uppercase;
			                letter-spacing: 1px;
			                opacity: 0.6;
			                margin-bottom: 6px;
			            '>60-Month Total Sales</div>
			            <div style='
			                font-size: 28px;
			                font-weight: 700;
			                color: #3A7CA5;
			            '>" & _TotalSalesText & "</div>
			        </div>
			
			        <!-- Average Margin -->
			        <div style='text-align: center;'>
			            <div style='
			                font-size: 11px;
			                text-transform: uppercase;
			                letter-spacing: 1px;
			                opacity: 0.6;
			                margin-bottom: 6px;
			            '>Average Margin</div>
			            <div style='
			                font-size: 28px;
			                font-weight: 700;
			                color: #4ADE80;
			            '>" & _AvgMarginText & "</div>
			        </div>
			
			        <!-- Trend -->
			        <div style='text-align: center;'>
			            <div style='
			                font-size: 11px;
			                text-transform: uppercase;
			                letter-spacing: 1px;
			                opacity: 0.6;
			                margin-bottom: 6px;
			            '>5-Year Trend</div>
			            <div style='
			                font-size: 28px;
			                font-weight: 700;
			                color: " & _StatusColor & ";
			            '>" & _TrendText & "</div>
			        </div>
			    </div>
			
			    <!-- Right: Quick Stats -->
			    <div style='
			        background: rgba(255,255,255,0.05);
			        border-radius: 6px;
			        padding: 12px 20px;
			        text-align: center;
			        min-width: 140px;
			    '>
			        <div style='
			            font-size: 11px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.6;
			            margin-bottom: 6px;
			        '>YoY Growth</div>
			        <div style='
			            font-size: 32px;
			            font-weight: 700;
			            color: " & _StatusColor & ";
			        '>" & FORMAT(_YoYGrowth, "+0.0%;-0.0%") & "</div>
			    </div>
			</div>"
			```
		lineageTag: 5080bb8a-5cbc-4e3f-820e-c37e0863f309

	measure 'Hero Card - Historical Periods Enhanced V2' = ```
			
			// ============================================================================
			// Calculate all previous period sales
			// ============================================================================
			VAR _Prev12 = [Previous 12 Sales]
			VAR _Prev24 = [Previous 24 Sales]
			VAR _Prev36 = [Previous 36 Sales]
			VAR _Prev48 = [Previous 48 Sales]
			VAR _Prev60 = [Previous 60 Sales]
			
			VAR _Prev12Margin = [% Previous 12]
			VAR _Prev24Margin = [% Previous 24]
			VAR _Prev36Margin = [% Previous 36]
			VAR _Prev48Margin = [% Previous 48]
			VAR _Prev60Margin = [% Previous 60]
			
			// ============================================================================
			// Get variance arrows (comparing to Rolling 12)
			// ============================================================================
			VAR _Prev12Arrow = [Sales Diff Previous 12 with Arrow]
			VAR _Prev24Arrow = [Sales Diff Previous 24 with Arrow]
			VAR _Prev36Arrow = [Sales Diff Previous 36 with Arrow]
			VAR _Prev48Arrow = [Sales Diff Previous 48 with Arrow]
			VAR _Prev60Arrow = [Sales Diff Previous 60 with Arrow]
			
			// ============================================================================
			// Add performance status indicators (vs Rolling 12)
			// ============================================================================
			VAR _R12 = [Rolling12_Sales]
			
			VAR _Prev12Status = 
			    SWITCH(
			        TRUE(),
			        _Prev12 > _R12 * 1.05, "↗",
			        _Prev12 > _R12 * 0.95, "→",
			        "↘"
			    )
			
			VAR _Prev24Status = 
			    SWITCH(
			        TRUE(),
			        _Prev24 > _R12 * 1.05, "↗",
			        _Prev24 > _R12 * 0.95, "→",
			        "↘"
			    )
			
			VAR _Prev36Status = 
			    SWITCH(
			        TRUE(),
			        _Prev36 > _R12 * 1.05, "↗",
			        _Prev36 > _R12 * 0.95, "→",
			        "↘"
			    )
			
			VAR _Prev48Status = 
			    SWITCH(
			        TRUE(),
			        _Prev48 > _R12 * 1.05, "↗",
			        _Prev48 > _R12 * 0.95, "→",
			        "↘"
			    )
			
			VAR _Prev60Status = 
			    SWITCH(
			        TRUE(),
			        _Prev60 > _R12 * 1.05, "↗",
			        _Prev60 > _R12 * 0.95, "→",
			        "↘"
			    )
			
			// Status colors
			VAR _Prev12StatusColor = 
			    SWITCH(
			        TRUE(),
			        _Prev12 > _R12 * 1.05, "#10B981",
			        _Prev12 > _R12 * 0.95, "#FCD34D",
			        "#EF4444"
			    )
			
			VAR _Prev24StatusColor = 
			    SWITCH(
			        TRUE(),
			        _Prev24 > _R12 * 1.05, "#10B981",
			        _Prev24 > _R12 * 0.95, "#FCD34D",
			        "#EF4444"
			    )
			
			VAR _Prev36StatusColor = 
			    SWITCH(
			        TRUE(),
			        _Prev36 > _R12 * 1.05, "#10B981",
			        _Prev36 > _R12 * 0.95, "#FCD34D",
			        "#EF4444"
			    )
			
			VAR _Prev48StatusColor = 
			    SWITCH(
			        TRUE(),
			        _Prev48 > _R12 * 1.05, "#10B981",
			        _Prev48 > _R12 * 0.95, "#FCD34D",
			        "#EF4444"
			    )
			
			VAR _Prev60StatusColor = 
			    SWITCH(
			        TRUE(),
			        _Prev60 > _R12 * 1.05, "#10B981",
			        _Prev60 > _R12 * 0.95, "#FCD34D",
			        "#EF4444"
			    )
			
			// ============================================================================
			// Identify peak period for highlighting
			// ============================================================================
			VAR _PeakValue = 
			    MAX(
			        _Prev12,
			        MAX(_Prev24, MAX(_Prev36, MAX(_Prev48, _Prev60)))
			    )
			
			VAR _IsPeak12 = IF(_Prev12 = _PeakValue, TRUE(), FALSE())
			VAR _IsPeak24 = IF(_Prev24 = _PeakValue, TRUE(), FALSE())
			VAR _IsPeak36 = IF(_Prev36 = _PeakValue, TRUE(), FALSE())
			VAR _IsPeak48 = IF(_Prev48 = _PeakValue, TRUE(), FALSE())
			VAR _IsPeak60 = IF(_Prev60 = _PeakValue, TRUE(), FALSE())
			
			// ============================================================================
			// Format values with M/K suffix
			// ============================================================================
			VAR _Prev12Text = 
			    IF(_Prev12 >= 1000000, 
			       FORMAT(_Prev12 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev12 / 1000, "$#,##0.00") & "K")
			
			VAR _Prev24Text = 
			    IF(_Prev24 >= 1000000, 
			       FORMAT(_Prev24 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev24 / 1000, "$#,##0.00") & "K")
			
			VAR _Prev36Text = 
			    IF(_Prev36 >= 1000000, 
			       FORMAT(_Prev36 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev36 / 1000, "$#,##0.00") & "K")
			
			VAR _Prev48Text = 
			    IF(_Prev48 >= 1000000, 
			       FORMAT(_Prev48 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev48 / 1000, "$#,##0.00") & "K")
			
			VAR _Prev60Text = 
			    IF(_Prev60 >= 1000000, 
			       FORMAT(_Prev60 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev60 / 1000, "$#,##0.00") & "K")
			
			// ============================================================================
			// Format percentages
			// ============================================================================
			VAR _Prev12MarginText = FORMAT(_Prev12Margin, "0.00%")
			VAR _Prev24MarginText = FORMAT(_Prev24Margin, "0.00%")
			VAR _Prev36MarginText = FORMAT(_Prev36Margin, "0.00%")
			VAR _Prev48MarginText = FORMAT(_Prev48Margin, "0.00%")
			VAR _Prev60MarginText = FORMAT(_Prev60Margin, "0.00%")
			
			// ============================================================================
			// Define gradient colors (coolest to warmest - temporal progression)
			// ============================================================================
			VAR _Color12 = "#3A7CA5"  // Teal-Blue (most recent)
			VAR _Color24 = "#60A5C4"  // Light Blue
			VAR _Color36 = "#8AC6D0"  // Cyan
			VAR _Color48 = "#A0D4DB"  // Pale Cyan
			VAR _Color60 = "#B8E2E8"  // Very Pale Cyan (oldest)
			
			VAR _PeakGlow = "0 0 15px rgba(255, 215, 0, 0.6)"  // Gold glow for peak
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 8px;
			    padding: 30px 20px;
			    display: flex;
			    justify-content: space-between;
			    align-items: stretch;
			    gap: 0;
			    color: white;
			'>
			    <!-- Section 1: Previous 12 -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			        " & IF(_IsPeak12, "box-shadow: " & _PeakGlow & ";", "") & "
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 8px;
			            text-align: center;
			        '>Previous 12" & IF(_IsPeak12, " ⭐", "") & "</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _Color12 & ";
			            margin: 8px 0;
			        '>" & _Prev12Text & "</div>
			        
			        <div style='
			            font-size: 18px;
			            opacity: 0.75;
			            margin-top: 8px;
			        '>" & _Prev12MarginText & " Margin</div>
			        
			        <div style='
			            font-size: 13px;
			            opacity: 0.65;
			            margin-top: 6px;
			        '>vs R12: " & _Prev12Arrow & "</div>
			        
			        <div style='
			            font-size: 36px;
			            margin-top: 4px;
			            color: " & _Prev12StatusColor & ";
			            font-weight: 700;
			        '>" & _Prev12Status & "</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; background: rgba(255,255,255,0.2); margin: 10px 0;'></div>
			
			    <!-- Section 2: Previous 24 -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			        " & IF(_IsPeak24, "box-shadow: " & _PeakGlow & ";", "") & "
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 8px;
			            text-align: center;
			        '>Previous 24" & IF(_IsPeak24, " ⭐", "") & "</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _Color24 & ";
			            margin: 8px 0;
			        '>" & _Prev24Text & "</div>
			        
			        <div style='
			            font-size: 18px;
			            opacity: 0.75;
			            margin-top: 8px;
			        '>" & _Prev24MarginText & " Margin</div>
			        
			        <div style='
			            font-size: 13px;
			            opacity: 0.65;
			            margin-top: 6px;
			        '>vs R12: " & _Prev24Arrow & "</div>
			        
			        <div style='
			            font-size: 36px;
			            margin-top: 4px;
			            color: " & _Prev24StatusColor & ";
			            font-weight: 700;
			        '>" & _Prev24Status & "</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; background: rgba(255,255,255,0.2); margin: 10px 0;'></div>
			
			    <!-- Section 3: Previous 36 -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			        " & IF(_IsPeak36, "box-shadow: " & _PeakGlow & ";", "") & "
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 8px;
			            text-align: center;
			        '>Previous 36" & IF(_IsPeak36, " ⭐", "") & "</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _Color36 & ";
			            margin: 8px 0;
			        '>" & _Prev36Text & "</div>
			        
			        <div style='
			            font-size: 18px;
			            opacity: 0.75;
			            margin-top: 8px;
			        '>" & _Prev36MarginText & " Margin</div>
			        
			        <div style='
			            font-size: 13px;
			            opacity: 0.65;
			            margin-top: 6px;
			        '>vs R12: " & _Prev36Arrow & "</div>
			        
			        <div style='
			            font-size: 36px;
			            margin-top: 4px;
			            color: " & _Prev36StatusColor & ";
			            font-weight: 700;
			        '>" & _Prev36Status & "</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; background: rgba(255,255,255,0.2); margin: 10px 0;'></div>
			
			    <!-- Section 4: Previous 48 -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			        " & IF(_IsPeak48, "box-shadow: " & _PeakGlow & ";", "") & "
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 8px;
			            text-align: center;
			        '>Previous 48" & IF(_IsPeak48, " ⭐", "") & "</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _Color48 & ";
			            margin: 8px 0;
			        '>" & _Prev48Text & "</div>
			        
			        <div style='
			            font-size: 18px;
			            opacity: 0.75;
			            margin-top: 8px;
			        '>" & _Prev48MarginText & " Margin</div>
			        
			        <div style='
			            font-size: 13px;
			            opacity: 0.65;
			            margin-top: 6px;
			        '>vs R12: " & _Prev48Arrow & "</div>
			        
			        <div style='
			            font-size: 36px;
			            margin-top: 4px;
			            color: " & _Prev48StatusColor & ";
			            font-weight: 700;
			        '>" & _Prev48Status & "</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; background: rgba(255,255,255,0.2); margin: 10px 0;'></div>
			
			    <!-- Section 5: Previous 60 -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
