	measure 'Show Filter 1' =
			
			VAR MaxFilters = 7
			RETURN
			    IF (
			        ISFILTERED ( dim_BranchLocation[Branch] ),
			        VAR ___f =
			            FILTERS ( dim_BranchLocation[Branch] )
			        VAR ___r =
			            COUNTROWS ( ___f )
			        VAR ___t =
			            TOPN ( MaxFilters, ___f, dim_BranchLocation[Branch] )
			        VAR ___d =
			            CONCATENATEX ( ___t, dim_BranchLocation[Branch], ", " )
			        VAR ___x =
			            "Branch:  " & ___d
			                & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			        RETURN
			            ___x & UNICHAR ( 13 )
			                & UNICHAR ( 10 )
			    )
			        & IF (
			            ISFILTERED ( dim_Franchise[Franchise] ),
			            VAR ___f =
			                FILTERS ( dim_Franchise[Franchise] )
			            VAR ___r =
			                COUNTROWS ( ___f )
			            VAR ___t =
			                TOPN ( MaxFilters, ___f, dim_Franchise[Franchise] )
			            VAR ___d =
			                CONCATENATEX ( ___t, dim_Franchise[Franchise], ", " )
			            VAR ___x =
			                "Franchise:  " & ___d
			                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			            RETURN
			                ___x & UNICHAR ( 13 )
			                    & UNICHAR ( 10 )
			        )
			        & IF (
			            ISFILTERED ( dim_Source[Source] ),
			            VAR ___f =
			                FILTERS ( dim_Source[Source] )
			            VAR ___r =
			                COUNTROWS ( ___f )
			            VAR ___t =
			                TOPN ( MaxFilters, ___f, dim_Source[Source] )
			            VAR ___d =
			                CONCATENATEX ( ___t, dim_Source[Source], ", " )
			            VAR ___x =
			                "Source:  " & ___d
			                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			            RETURN
			                ___x & UNICHAR ( 13 )
			                    & UNICHAR ( 10 )
			        )
			        & IF (
			            ISFILTERED ( dim_DealerGroupCode[DealerGroupCode] ),
			            VAR ___f =
			                FILTERS ( dim_DealerGroupCode[DealerGroupCode] )
			            VAR ___r =
			                COUNTROWS ( ___f )
			            VAR ___t =
			                TOPN ( MaxFilters, ___f, dim_DealerGroupCode[DealerGroupCode] )
			            VAR ___d =
			                CONCATENATEX ( ___t, dim_DealerGroupCode[DealerGroupCode], ", " )
			            VAR ___x =
			                "Dealer Group Code:  " & ___d
			                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			            RETURN
			                ___x & UNICHAR ( 13 )
			                    & UNICHAR ( 10 )
			        )
			        & IF (
			            ISFILTERED ( dim_VendorCode[VendorCode] ),
			            VAR ___f =
			                FILTERS ( dim_VendorCode[VendorCode] )
			            VAR ___r =
			                COUNTROWS ( ___f )
			            VAR ___t =
			                TOPN ( MaxFilters, ___f, dim_VendorCode[VendorCode] )
			            VAR ___d =
			                CONCATENATEX ( ___t, dim_VendorCode[VendorCode], ", " )
			            VAR ___x =
			                "Vendor Code:  " & ___d
			                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			            RETURN
			                ___x & UNICHAR ( 13 )
			                    & UNICHAR ( 10 )
			        )
			        & IF (
			            ISFILTERED ( dim_SLC[SLC] ),
			            VAR ___f =
			                FILTERS ( dim_SLC[SLC] )
			            VAR ___r =
			                COUNTROWS ( ___f )
			            VAR ___t =
			                TOPN ( MaxFilters, ___f, dim_SLC[SLC] )
			            VAR ___d =
			                CONCATENATEX ( ___t, dim_SLC[SLC], ", " )
			            VAR ___x =
			                "SLC:  " & ___d
			                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			            RETURN
			                ___x & UNICHAR ( 13 )
			                    & UNICHAR ( 10 )
			        )
			        & IF (
			            ISFILTERED ( dim_Parts[PartNumber] ),
			            VAR ___f =
			                FILTERS ( dim_Parts[PartNumber] )
			            VAR ___r =
			                COUNTROWS ( ___f )
			            VAR ___t =
			                TOPN ( MaxFilters, ___f, dim_Parts[PartNumber] )
			            VAR ___d =
			                CONCATENATEX ( ___t, dim_Parts[PartNumber], ", " )
			            VAR ___x =
			                "Part #:  " & ___d
			                    & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			            RETURN
			                ___x & UNICHAR ( 13 )
			                    & UNICHAR ( 10 )
			        )
			---- MODEL MEASURES END ----
		lineageTag: 9ba3bf3a-02c3-47d8-a820-a45c2bf1529c

	measure Rolling12_Sales =
			
			CALCULATE ( [Sales], DATESINPERIOD ( 'dim_Date'[Date], TODAY (), -12, MONTH ) )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 997b400f-74ea-4183-be4c-a55f1b9c37c4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Sales =
			
			CALCULATE(
			    SUM(Fact_Part_Transactions[SaleAmount]),
			    Fact_Part_Transactions[SaleAmount] > 0
