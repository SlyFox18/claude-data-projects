	measure 'Hero Card - Rolling 12 Performance' = ```
			
			// ============================================================================
			// Calculate Rolling 12 values
			// ============================================================================
			VAR _Sales = [Rolling12_Sales]
			VAR _Cost = [Rolling 12 Cost]
			VAR _Margin = [Rolling 12 Margin]
			VAR _MarginPct = [Rolling12_MarginPct]
			
			// ============================================================================
			// Format values with M/K suffix
			// ============================================================================
			VAR _SalesText = 
			    IF(_Sales >= 1000000, 
			       FORMAT(_Sales / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Sales / 1000, "$#,##0.00") & "K")
			       
			VAR _CostText = 
			    IF(_Cost >= 1000000, 
			       FORMAT(_Cost / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Cost / 1000, "$#,##0.00") & "K")
			       
			VAR _MarginText = 
			    IF(_Margin >= 1000000, 
			       FORMAT(_Margin / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Margin / 1000, "$#,##0.00") & "K")
			
			VAR _MarginPctText = FORMAT(_MarginPct, "0.00%")
			
			// ============================================================================
			// Define colors
			// ============================================================================
			VAR _SalesColor = "#3A7CA5"    // Teal-Blue (primary)
			VAR _CostColor = "#F97316"     // Orange (expense)
			VAR _MarginColor = "#4ADE80"   // Green (profit)
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 8px;
			    padding: 30px 20px;
			    display: flex;
			    justify-content: space-between;
			    align-items: stretch;
			    gap: 0;
			    color: white;
			'>
			    <!-- Section 1: Sales -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 12px;
			            text-align: center;
			        '>Rolling 12 Sales</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _SalesColor & ";
			            margin: 10px 0;
			        '>" & _SalesText & "</div>
			        
			        <div style='
			            font-size: 20px;
			            opacity: 0.75;
			            margin-top: 12px;
			        '>Last 12 Months</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; background: rgba(255,255,255,0.2); margin: 10px 0;'></div>
			
			    <!-- Section 2: Cost -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 12px;
			            text-align: center;
			        '>Rolling 12 Cost</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _CostColor & ";
			            margin: 10px 0;
			        '>" & _CostText & "</div>
			        
			        <div style='
			            font-size: 20px;
			            opacity: 0.75;
			            margin-top: 12px;
			        '>Total Expenses</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; background: rgba(255,255,255,0.2); margin: 10px 0;'></div>
			
			    <!-- Section 3: Margin -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 12px;
			            text-align: center;
			        '>Rolling 12 Margin</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _MarginColor & ";
			            margin: 10px 0;
			        '>" & _MarginText & "</div>
			        
			        <div style='
			            font-size: 20px;
			            opacity: 0.75;
			            margin-top: 12px;
			        '>" & _MarginPctText & " Margin</div>
			    </div>
			</div>"
			```
