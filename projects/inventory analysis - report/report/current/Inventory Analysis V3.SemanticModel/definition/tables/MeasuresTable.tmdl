	measure Sales_KPI_Card = ```
			
			VAR _Current = [Sales_CurrentYear]
			VAR Previous = [Sales_2024]
			VAR Change = DIVIDE(_Current - Previous, Previous)
			VAR FormattedCurrent = FORMAT(_Current, "$#,##0.0,,") & "M"
			VAR FormattedChange = FORMAT(Change, "0.0%")
			
			VAR ArrowPoints =
			    IF(Change > 0, "10,20 20,10 30,20",   // Up
			    IF(Change < 0, "10,10 20,20 30,10",   // Down
			    ""))
			
			VAR ArrowColor =
			    IF(Change > 0, "green",
			    IF(Change < 0, "red", "gray"))
			
			RETURN
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' width='200' height='50'>" &
			    "<text x='10' y='20' font-size='18' font-family='Segoe UI' fill='black'>" & FormattedCurrent & "</text>" &
			    IF(
			        ArrowPoints <> "",
			        "<polyline points='" & ArrowPoints & "' fill='none' stroke='" & ArrowColor & "' stroke-width='3'/>",
			        ""
			    ) &
			    "<text x='40' y='20' font-size='14' font-family='Segoe UI' fill='" & ArrowColor & "'>" & FormattedChange & "</text>" &
			"</svg>"
			
			```
		lineageTag: dfa66221-7d67-41d2-8f47-e2647bd5f480
		dataCategory: ImageUrl

