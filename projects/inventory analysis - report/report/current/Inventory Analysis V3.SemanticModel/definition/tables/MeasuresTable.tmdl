	measure 'Active Stock Franchise Label' = ```
			
			VAR _Value = [TrueActiveInventory]
			
			// Calculate total Active Stock across ALL franchises
			VAR _TotalActiveStock = 
			    CALCULATE(
			        [TrueActiveInventory],
			        ALL(dim_Franchise)  // Remove franchise filter to get total
			    )
			
			// Calculate percentage of total Active Stock
			VAR _Pct = DIVIDE(_Value, _TotalActiveStock, 0)
			
			// Smart formatting based on value size
			VAR _FormattedValue = 
			    SWITCH(TRUE(),
			        _Value >= 1000000, 
			            FORMAT(_Value / 1000000, "$#,0.00") & "M",  // $X.XXM for millions
			        _Value >= 100000, 
			            FORMAT(_Value / 1000, "$#,0") & "K",         // $XXXK for hundreds of thousands
			        FORMAT(_Value / 1000, "$#,0.0") & "K"            // $XX.XK for smaller values
			    )
			
			RETURN
			    _FormattedValue & " (" & FORMAT(_Pct, "0.0%") & ")"
			```
		lineageTag: 32e50460-66c4-41d6-b273-9676f5fa4729

	measure 'Active Filters Detail' = ```
			
			// Filter status detection
			VAR IsBranchFiltered = ISFILTERED(dim_BranchLocation[Branch])
			VAR IsFranchiseFiltered = ISFILTERED(dim_Franchise[Franchise])
			VAR IsSourceFiltered = ISFILTERED(dim_Source[Source])
			VAR IsDealerGroupFiltered = ISFILTERED(dim_DealerGroupCode[DealerGroupCode])
			VAR IsVendorFiltered = ISFILTERED(dim_VendorCode[VendorCode])
			VAR IsSLCFiltered = ISFILTERED(dim_SLC[SLC])
			
			VAR ActiveFilterCount = 
			    (IF(IsBranchFiltered, 1, 0)) +
			    (IF(IsFranchiseFiltered, 1, 0)) +
			    (IF(IsSourceFiltered, 1, 0)) +
			    (IF(IsDealerGroupFiltered, 1, 0)) +
			    (IF(IsVendorFiltered, 1, 0)) +
			    (IF(IsSLCFiltered, 1, 0))
			
			// Get filtered values for each dimension
			VAR BranchValues = 
			    IF(IsBranchFiltered,
			        VAR ValueCount = COUNTROWS(VALUES(dim_BranchLocation[Branch]))
			        VAR ValueList = 
			            IF(ValueCount <= 3,
			                CONCATENATEX(VALUES(dim_BranchLocation[Branch]), dim_BranchLocation[Branch], ", ", dim_BranchLocation[Branch], ASC),
			                CONCATENATEX(TOPN(3, VALUES(dim_BranchLocation[Branch]), dim_BranchLocation[Branch], ASC), dim_BranchLocation[Branch], ", ") & " (+" & (ValueCount - 3) & " more)"
			            )
			        RETURN ValueList,
			        ""
			    )
			
			VAR FranchiseValues = 
			    IF(IsFranchiseFiltered,
			        VAR ValueCount = COUNTROWS(VALUES(dim_Franchise[Franchise]))
			        VAR ValueList = 
			            IF(ValueCount <= 3,
			                CONCATENATEX(VALUES(dim_Franchise[Franchise]), dim_Franchise[Franchise], ", ", dim_Franchise[Franchise], ASC),
			                CONCATENATEX(TOPN(3, VALUES(dim_Franchise[Franchise]), dim_Franchise[Franchise], ASC), dim_Franchise[Franchise], ", ") & " (+" & (ValueCount - 3) & " more)"
			            )
			        RETURN ValueList,
			        ""
			    )
			
			VAR SourceValues = 
			    IF(IsSourceFiltered,
			        VAR ValueCount = COUNTROWS(VALUES(dim_Source[Source]))
			        VAR ValueList = 
			            IF(ValueCount <= 3,
			                CONCATENATEX(VALUES(dim_Source[Source]), dim_Source[Source], ", ", dim_Source[Source], ASC),
			                CONCATENATEX(TOPN(3, VALUES(dim_Source[Source]), dim_Source[Source], ASC), dim_Source[Source], ", ") & " (+" & (ValueCount - 3) & " more)"
			            )
			        RETURN ValueList,
			        ""
			    )
			
			VAR DealerGroupValues = 
			    IF(IsDealerGroupFiltered,
			        VAR ValueCount = COUNTROWS(VALUES(dim_DealerGroupCode[DealerGroupCode]))
			        VAR ValueList = 
			            IF(ValueCount <= 3,
			                CONCATENATEX(VALUES(dim_DealerGroupCode[DealerGroupCode]), dim_DealerGroupCode[DealerGroupCode], ", ", dim_DealerGroupCode[DealerGroupCode], ASC),
			                CONCATENATEX(TOPN(3, VALUES(dim_DealerGroupCode[DealerGroupCode]), dim_DealerGroupCode[DealerGroupCode], ASC), dim_DealerGroupCode[DealerGroupCode], ", ") & " (+" & (ValueCount - 3) & " more)"
			            )
			        RETURN ValueList,
			        ""
			    )
			
			VAR VendorValues = 
			    IF(IsVendorFiltered,
			        VAR ValueCount = COUNTROWS(VALUES(dim_VendorCode[VendorCode]))
			        VAR ValueList = 
			            IF(ValueCount <= 3,
			                CONCATENATEX(VALUES(dim_VendorCode[VendorCode]), dim_VendorCode[VendorCode], ", ", dim_VendorCode[VendorCode], ASC),
			                CONCATENATEX(TOPN(3, VALUES(dim_VendorCode[VendorCode]), dim_VendorCode[VendorCode], ASC), dim_VendorCode[VendorCode], ", ") & " (+" & (ValueCount - 3) & " more)"
			            )
			        RETURN ValueList,
			        ""
			    )
			
			VAR SLCValues = 
			    IF(IsSLCFiltered,
			        VAR ValueCount = COUNTROWS(VALUES(dim_SLC[SLC]))
			        VAR ValueList = 
			            IF(ValueCount <= 3,
			                CONCATENATEX(VALUES(dim_SLC[SLC]), dim_SLC[SLC], ", ", dim_SLC[SLC], ASC),
			                CONCATENATEX(TOPN(3, VALUES(dim_SLC[SLC]), dim_SLC[SLC], ASC), dim_SLC[SLC], ", ") & " (+" & (ValueCount - 3) & " more)"
			            )
			        RETURN ValueList,
			        ""
			    )
			
			// Build plain text filter list with line breaks
			VAR FilterText = 
			    IF(IsBranchFiltered, 
			        "📍 Branch: " & BranchValues & UNICHAR(10), 
			        "") &
			    IF(IsFranchiseFiltered, 
			        "🏢 Franchise: " & FranchiseValues & UNICHAR(10), 
			        "") &
			    IF(IsSourceFiltered, 
			        "📦 Source: " & SourceValues & UNICHAR(10), 
			        "") &
			    IF(IsDealerGroupFiltered, 
			        "👥 Dealer Group: " & DealerGroupValues & UNICHAR(10), 
			        "") &
			    IF(IsVendorFiltered, 
			        "🏭 Vendor: " & VendorValues & UNICHAR(10), 
			        "") &
			    IF(IsSLCFiltered, 
			        "🔧 SLC: " & SLCValues, 
			        "")
			
			RETURN
			IF(ActiveFilterCount = 0, 
			    "✓ Viewing All Data - No Filters Applied",  // Show message instead of blank
			    "🔍 ACTIVE FILTERS (" & ActiveFilterCount & ")" & UNICHAR(10) & UNICHAR(10) & FilterText
			)
			```
		lineageTag: 02d4bedd-7e1c-4270-b21c-5854a208dec1

	measure 'Franchise D Compact Banner' =
			
