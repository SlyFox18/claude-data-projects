			        ISBLANK(SalesAmount) || SalesAmount = 0,
			        BLANK(),
			        FORMAT(SalesAmount, "$#,##0") & " (" & FORMAT(Percentage, "0.0%") & ")" & UNICHAR(10) & FORMAT(InvoiceCount, "#,##0") & " "
