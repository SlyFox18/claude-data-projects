	measure DeadStockFlag =
			
			VAR Last36Start =
			    TODAY () - 365 * 3
			VAR QtySold =
			    CALCULATE (
			        SUM ( Fact_Part_Transactions[Quantity] ),
			        Fact_Part_Transactions[PartNumberKey],
			        FILTER ( dim_Date, dim_Date[Date] >= Last36Start )
			    )
			VAR QtyOnHand =
			    CALCULATE ( SUM ( Fact_Inventory[QuantityOnHand] ) )
			RETURN
			    IF ( QtySold = 0 && QtyOnHand > 0, 1, 0 )
		formatString: 0
		lineageTag: 257994c2-6dd1-4e15-8477-7778aabc999c

	measure 'Sales Diff Previous 12' =
			
			[Previous 12 Sales] - [Rolling12_Sales]
		lineageTag: 5c09afdb-c03a-4f41-b8bc-1cf460f41f79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Diff Rolling 12' =
			
			[Rolling12_Sales] - [Previous 12 Sales]
		lineageTag: f3815143-6f88-4f62-972c-bcb36b12ff28

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Diff R12 with Arrow' =
			
			VAR uparrow =
			    UNICHAR ( 129129 )
			VAR downarrow =
			    UNICHAR ( 129131 )
			VAR salesdiff = [Sales Diff Rolling 12]
			VAR formatedvalue =
			    SWITCH (
			        TRUE (),
			        ABS ( salesdiff ) >= 1000000,
			            FORMAT ( salesdiff / 1000000, "$#.00" ) & "M",
			        ABS ( salesdiff ) >= 1000,
			            FORMAT ( salesdiff / 1000, "$#.00" ) & "K",
			        FORMAT ( salesdiff, "$#.00" )
			    )
			RETURN
			    IF (
			        [Previous 12 Sales] = 0,
			        "0",
			        IF (
			            salesdiff < 0,
			            formatedvalue & "  " & downarrow,
			            formatedvalue & "  " & uparrow
			        )
			    )
		lineageTag: 42a7651d-4ca4-476d-97f9-4db88e57b2d9

