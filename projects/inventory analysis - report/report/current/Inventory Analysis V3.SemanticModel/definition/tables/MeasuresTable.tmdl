	measure 'Active Stock Bar Color' = ```
			
			VAR _CurrentValue = [TrueActiveInventory]
			VAR _CompanyAvg = 
			    CALCULATE(
			        AVERAGEX(VALUES(dim_BranchLocation[BranchKey]), [TrueActiveInventory]),
			        ALL(dim_BranchLocation)
			    )
			VAR _TopThreshold = _CompanyAvg * 1.5  // 50% above average
			VAR _BottomThreshold = _CompanyAvg * 0.7  // 30% below average
			RETURN
			    SWITCH(TRUE(),
			        _CurrentValue >= _TopThreshold, "#2d5f3f",  // Dark green - top performers
			        _CurrentValue <= _BottomThreshold, "#5a7a8a",  // Lighter blue - needs attention
			        "#3A7CA5"  // Standard blue - your current color
			    )
			```
		lineageTag: b7b71eab-3894-41e6-b7bc-dbeae2eec89a

	measure 'Active Stock Label' = ```
			
			VAR _Value = [TrueActiveInventory]
			VAR _TotalActiveStock = 
			    CALCULATE([TrueActiveInventory], ALL(dim_BranchLocation))
			VAR _Pct = DIVIDE(_Value, _TotalActiveStock, 0)
			VAR _FormattedValue = 
			    IF(
			        _Value >= 1000000,
			        // For millions: Use 1 decimal if it's a round number (like 1.5M), 2 decimals otherwise
			        IF(
			            MOD(_Value, 100000) = 0,
			            FORMAT(_Value / 1000000, "$#,0.0") & "M",
			            FORMAT(_Value / 1000000, "$#,0.00") & "M"
			        ),
			        FORMAT(_Value / 1000, "$#,0") & "K"
			    )
			RETURN
			    _FormattedValue & " (" & FORMAT(_Pct, "0.0%") & ")"
			```
		lineageTag: 05a68195-f6b6-4a48-a20a-b7f655dc8c10

	measure 'Active Stock Chart Title' = ```
			
			VAR _Total = [TrueActiveInventory]
			VAR _BranchCount = DISTINCTCOUNT(dim_BranchLocation[BranchKey])
			VAR _View = SELECTEDVALUE(dim_BranchLocation[Branch], "Branch")  // Your button parameter
			RETURN
			    "Active Stock by " & _View & " - " & 
			    FORMAT(_Total / 1000000, "$#,0.0M") & 
			    " across " & _BranchCount & " locations"
			```
		lineageTag: 982f77df-654c-46a5-a22a-e94898a3636a

	measure 'Active Stock Tooltip' =
			
			VAR _Value = [TrueActiveInventory]
			VAR _Total = CALCULATE([TrueActiveInventory], ALL(dim_BranchLocation))
			VAR _Pct = DIVIDE(_Value, _Total)
			VAR _Rank = RANKX(ALL(dim_BranchLocation[Branch]), [TrueActiveInventory], , DESC, DENSE)
			VAR _TopValue = CALCULATE([TrueActiveInventory], TOPN(1, ALL(dim_BranchLocation), [TrueActiveInventory], DESC))
			VAR _Gap = _TopValue - _Value
			RETURN
			    "Active Stock: " & FORMAT(_Value, "$#,##0") & UNICHAR(10) &
			    "Rank: #" & _Rank & " of " & DISTINCTCOUNT(dim_BranchLocation[Branch]) & UNICHAR(10) &
			    FORMAT(_Pct, "0.0%") & " of company total" & UNICHAR(10) &
			    IF(_Rank > 1, FORMAT(_Gap, "$#,##0") & " behind #1", "Top performer! 🏆")
		lineageTag: e23877e9-93ab-48a0-b76a-b188936bbb58

