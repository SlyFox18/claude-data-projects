	measure 'Sales - Gross' =
			
			CALCULATE(
			    SUM(Fact_Part_Transactions[SaleAmount]),
			    Fact_Part_Transactions[SaleAmount] > 0
			)
		lineageTag: 9c5ba1b0-4ab7-4513-8024-02ace93505ad

