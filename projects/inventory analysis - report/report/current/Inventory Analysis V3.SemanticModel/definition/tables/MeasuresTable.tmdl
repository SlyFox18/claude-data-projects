	measure 'Bold Insights Bar' = ```
			
			// ============================================================================
			// Calculate insights
			// ============================================================================
			VAR _YoYGrowth = DIVIDE([Rolling12_Sales] - [Previous 12 Sales], [Previous 12 Sales], 0)
			VAR _MarginChange = [Rolling12_MarginPct] - [% Previous 12]
			VAR _CurrentVsAvg = DIVIDE(
			    [Rolling12_Sales] - DIVIDE(
			        [Previous 12 Sales] + [Previous 24 Sales] + [Previous 36 Sales] + 
			        [Previous 48 Sales] + [Previous 60 Sales], 5, 0
			    ),
			    DIVIDE(
			        [Previous 12 Sales] + [Previous 24 Sales] + [Previous 36 Sales] + 
			        [Previous 48 Sales] + [Previous 60 Sales], 5, 0
			    ),
			    0
			)
			
			// Create bold statements
			VAR _Insight1 = 
			    SWITCH(
			        TRUE(),
			        _YoYGrowth > 0.05, "🚀 STRONG GROWTH",
			        _YoYGrowth > 0.02, "✓ POSITIVE GROWTH",
			        _YoYGrowth > -0.02, "→ STABLE",
			        "⚠ DECLINING"
			    )
			
			VAR _Insight1Color = 
			    SWITCH(
			        TRUE(),
			        _YoYGrowth > 0.05, "#10B981",
			        _YoYGrowth > 0.02, "#4ADE80",
			        _YoYGrowth > -0.02, "#FCD34D",
			        "#EF4444"
			    )
			
			VAR _Insight1Detail = FORMAT(_YoYGrowth, "+0.0%;-0.0%") & " YoY"
			
			VAR _Insight2 = 
			    SWITCH(
			        TRUE(),
			        _MarginChange > 0.01, "📈 MARGIN EXPANDING",
			        _MarginChange > 0, "✓ MARGIN GROWING",
			        _MarginChange > -0.01, "→ MARGIN STABLE",
			        "📉 MARGIN PRESSURE"
			    )
			
			VAR _Insight2Color = 
			    SWITCH(
			        TRUE(),
			        _MarginChange > 0.01, "#10B981",
			        _MarginChange > 0, "#4ADE80",
			        _MarginChange > -0.01, "#FCD34D",
			        "#EF4444"
			    )
			
			VAR _Insight2Detail = FORMAT(_MarginChange, "+0.00%;-0.00%") & " vs Prev 12"
			
			VAR _Insight3 = 
			    SWITCH(
			        TRUE(),
			        _CurrentVsAvg > 0.05, "🔥 ABOVE AVERAGE",
			        _CurrentVsAvg > 0, "✓ OUTPERFORMING",
			        _CurrentVsAvg > -0.05, "→ AT AVERAGE",
			        "⚠ BELOW AVERAGE"
			    )
			
			VAR _Insight3Color = 
			    SWITCH(
			        TRUE(),
			        _CurrentVsAvg > 0.05, "#10B981",
			        _CurrentVsAvg > 0, "#4ADE80",
			        _CurrentVsAvg > -0.05, "#FCD34D",
			        "#EF4444"
			    )
			
			VAR _Insight3Detail = FORMAT(_CurrentVsAvg, "+0.0%;-0.0%") & " vs Historical Avg"
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 6px;
			    padding: 40px 30px;
			    display: grid;
			    grid-template-columns: repeat(3, 1fr);
			    gap: 20px;
			    color: white;
			    margin-top: 12px;
			    border-top: 3px solid rgba(255,255,255,0.1);
			'>
			    <!-- Insight 1 -->
			    <div style='
			        background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
			        border-radius: 6px;
			        padding: 15px 20px;
			        border-left: 4px solid " & _Insight1Color & ";
			        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
			    '>
			        <div style='
			            font-size: 18px;
			            font-weight: 900;
			            color: " & _Insight1Color & ";
			            margin-bottom: 6px;
			            letter-spacing: 0.5px;
			        '>" & _Insight1 & "</div>
			        <div style='
			            font-size: 16px;
			            opacity: 0.8;
			        '>" & _Insight1Detail & "</div>
			    </div>
			
			    <!-- Insight 2 -->
			    <div style='
			        background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
			        border-radius: 6px;
			        padding: 15px 20px;
			        border-left: 4px solid " & _Insight2Color & ";
			        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
			    '>
			        <div style='
			            font-size: 18px;
			            font-weight: 900;
			            color: " & _Insight2Color & ";
			            margin-bottom: 6px;
			            letter-spacing: 0.5px;
			        '>" & _Insight2 & "</div>
			        <div style='
			            font-size: 16px;
			            opacity: 0.8;
			        '>" & _Insight2Detail & "</div>
			    </div>
			
			    <!-- Insight 3 -->
			    <div style='
			        background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
			        border-radius: 6px;
			        padding: 15px 20px;
			        border-left: 4px solid " & _Insight3Color & ";
			        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
			    '>
			        <div style='
			            font-size: 18px;
			            font-weight: 900;
			            color: " & _Insight3Color & ";
			            margin-bottom: 6px;
			            letter-spacing: 0.5px;
			        '>" & _Insight3 & "</div>
			        <div style='
			            font-size: 16px;
			            opacity: 0.8;
			        '>" & _Insight3Detail & "</div>
			    </div>
			</div>"
			```
