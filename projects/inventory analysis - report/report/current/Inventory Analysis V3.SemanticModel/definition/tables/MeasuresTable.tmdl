table MeasuresTable
	lineageTag: 0d039455-6ff6-47ec-acba-7d08b99b993f

	measure ActiveStockPct =
			
			DIVIDE ( [TotalInventory_Active], [Total Inventory], 0 )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: dc4b2249-edab-452b-b519-c929bd85b77b

	/// Calculates the total inventory cost of parts that have been sold in the last 365 days.
	measure ActiveStockInventoryCost =
			
			SUMX (
			    FILTER (
			        Fact_Inventory,
			        Fact_Inventory[DateLastRequested]
			            >= TODAY () - 365
			            && Fact_Inventory[QuantityOnHand] > 0
			            && Fact_Inventory[InventoryCost] > 0
			    ),
			    VAR _RecentQty =
			        MIN ( Fact_Inventory[QuantityOnHand], Fact_Inventory[Current12MoSales] )
			    VAR _UnitCost =
			        DIVIDE ( Fact_Inventory[InventoryCost], Fact_Inventory[QuantityOnHand] )
			    RETURN
			        _RecentQty * _UnitCost
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e23e8d68-083b-4ce0-8d89-fb3a9086d609

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Calculates the percentage of excess inventory by dividing the excess stock inventory cost by the total inventory.
	measure '% Excess Inventory' =
			
			DIVIDE ( [ExcessStockInventoryCost], [Total Inventory] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 72de834c-ba15-408c-bf13-ed1763605d01

	/// Calculates the cost of excess stock inventory by comparing the quantity on hand with the quantity sold in the last 12 months and multiplying the excess quantity by the unit cost.
	measure ExcessStockInventoryCost =
			
			SUMX (
			    FILTER (
			        Fact_Inventory,
			        Fact_Inventory[Current12MoSales] > 0
			            && Fact_Inventory[QuantityOnHand] > Fact_Inventory[Current12MoSales]
			            && Fact_Inventory[QuantityOnHand] > 0
			            && Fact_Inventory[InventoryCost] > 0
			    ),
			    VAR _ExcessQty = Fact_Inventory[QuantityOnHand] - Fact_Inventory[Current12MoSales]
			    VAR _UnitCost =
			        DIVIDE ( Fact_Inventory[InventoryCost], Fact_Inventory[QuantityOnHand] )
			    RETURN
			        _ExcessQty * _UnitCost
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 171f3cae-511d-4a67-a9d3-86354b964aad

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure ZeroSalesInventoryCost_12Mo =
			
			CALCULATE (
			    SUM ( Fact_Inventory[InventoryCost] ),
			    FILTER (
			        ALL ( Fact_Inventory ),
			        Fact_Inventory[DateLastRequested]
			            <= TODAY () - 365
			            && Fact_Inventory[DateLastRequested]
			                > TODAY () - 730
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 1a8f42a8-833f-4d59-993f-5f3bf19cd44c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

