	measure DeadStockFlagExpanded =
			
			VAR TodayDate =
			    TODAY ()
			VAR Last12Start =
			    EDATE ( TodayDate, -12 )
			VAR Last24Start =
			    EDATE ( TodayDate, -24 )
			VAR Last36Start =
			    EDATE ( TodayDate, -36 )
			VAR QtySold12 =
			    CALCULATE (
			        SUM ( Fact_Part_Transactions[Quantity] ),
			        FILTER ( dim_Date, dim_Date[Date] >= Last12Start )
			    )
			VAR QtySold24 =
			    CALCULATE (
			        SUM ( Fact_Part_Transactions[Quantity] ),
			        FILTER ( dim_Date, dim_Date[Date] >= Last24Start )
			    )
			VAR QtySold36 =
			    CALCULATE (
			        SUM ( Fact_Part_Transactions[Quantity] ),
			        FILTER ( dim_Date, dim_Date[Date] >= Last36Start )
			    )
			VAR QtyOnHand =
			    CALCULATE ( SUM ( Fact_Inventory[QuantityOnHand] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        QtySold12 = 0
			            && QtyOnHand > 0, 1,
			        QtySold24 = 0
			            && QtyOnHand > 0, 2,
			        QtySold36 = 0
			            && QtyOnHand > 0, 3,
			        0
			    )
		formatString: 0
		lineageTag: 8d7ebffd-89d6-42f1-a396-f8db21a5259b

