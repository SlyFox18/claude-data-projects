	measure 'Hero Card - Historical Periods Enhanced' = ```
			
			// ============================================================================
			// Calculate all previous period sales
			// ============================================================================
			VAR _Prev12 = [Previous 12 Sales]
			VAR _Prev24 = [Previous 24 Cost]
			VAR _Prev36 = [Previous 36 Sales]
			VAR _Prev48 = [Previous 48 Sales]
			VAR _Prev60 = [Previous 60 Sales]
			
			VAR _Prev12Margin = [% Previous 12]
			VAR _Prev24Margin = [% Previous 24]
			VAR _Prev36Margin = [% Previous 36]
			VAR _Prev48Margin = [% Previous 48]
			VAR _Prev60Margin = [% Previous 60]
			
			// ============================================================================
			// Get variance arrows (comparing to Rolling 12)
			// ============================================================================
			VAR _Prev12Arrow = [Sales Diff Previous 12 with Arrow]
			VAR _Prev24Arrow = [Sales Diff Previous 24 with Arrow]
			VAR _Prev36Arrow = [Sales Diff Previous 36 with Arrow]
			VAR _Prev48Arrow = [Sales Diff Previous 48 with Arrow]
			VAR _Prev60Arrow = [Sales Diff Previous 60 with Arrow]
			
			// ============================================================================
			// Identify peak period for highlighting
			// ============================================================================
			VAR _PeakValue = 
			    MAX(
			        _Prev12,
			        MAX(_Prev24, MAX(_Prev36, MAX(_Prev48, _Prev60)))
			    )
			
			VAR _IsPeak12 = IF(_Prev12 = _PeakValue, TRUE(), FALSE())
			VAR _IsPeak24 = IF(_Prev24 = _PeakValue, TRUE(), FALSE())
			VAR _IsPeak36 = IF(_Prev36 = _PeakValue, TRUE(), FALSE())
			VAR _IsPeak48 = IF(_Prev48 = _PeakValue, TRUE(), FALSE())
			VAR _IsPeak60 = IF(_Prev60 = _PeakValue, TRUE(), FALSE())
			
			// ============================================================================
			// Format values with M/K suffix
			// ============================================================================
			VAR _Prev12Text = 
			    IF(_Prev12 >= 1000000, 
			       FORMAT(_Prev12 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev12 / 1000, "$#,##0.00") & "K")
			
			VAR _Prev24Text = 
			    IF(_Prev24 >= 1000000, 
			       FORMAT(_Prev24 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev24 / 1000, "$#,##0.00") & "K")
			
			VAR _Prev36Text = 
			    IF(_Prev36 >= 1000000, 
			       FORMAT(_Prev36 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev36 / 1000, "$#,##0.00") & "K")
			
			VAR _Prev48Text = 
			    IF(_Prev48 >= 1000000, 
			       FORMAT(_Prev48 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev48 / 1000, "$#,##0.00") & "K")
			
			VAR _Prev60Text = 
			    IF(_Prev60 >= 1000000, 
			       FORMAT(_Prev60 / 1000000, "$#,##0.00") & "M", 
			       FORMAT(_Prev60 / 1000, "$#,##0.00") & "K")
			
			// ============================================================================
			// Format percentages
			// ============================================================================
			VAR _Prev12MarginText = FORMAT(_Prev12Margin, "0.00%")
			VAR _Prev24MarginText = FORMAT(_Prev24Margin, "0.00%")
			VAR _Prev36MarginText = FORMAT(_Prev36Margin, "0.00%")
			VAR _Prev48MarginText = FORMAT(_Prev48Margin, "0.00%")
			VAR _Prev60MarginText = FORMAT(_Prev60Margin, "0.00%")
			
			// ============================================================================
			// Define gradient colors (coolest to warmest - temporal progression)
			// ============================================================================
			VAR _Color12 = "#3A7CA5"  // Teal-Blue (most recent)
			VAR _Color24 = "#60A5C4"  // Light Blue
			VAR _Color36 = "#8AC6D0"  // Cyan
			VAR _Color48 = "#A0D4DB"  // Pale Cyan
			VAR _Color60 = "#B8E2E8"  // Very Pale Cyan (oldest)
			
			VAR _PeakGlow = "0 0 15px rgba(255, 215, 0, 0.6)"  // Gold glow for peak
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 8px;
			    padding: 40px 20px;
			    display: flex;
			    justify-content: space-between;
			    align-items: stretch;
			    gap: 0;
			    color: white;
			'>
			    <!-- Section 1: Previous 12 -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			        " & IF(_IsPeak12, "box-shadow: " & _PeakGlow & ";", "") & "
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 8px;
			            text-align: center;
			        '>Previous 12" & IF(_IsPeak12, " ⭐", "") & "</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _Color12 & ";
			            margin: 8px 0;
			        '>" & _Prev12Text & "</div>
			        
			        <div style='
			            font-size: 18px;
			            opacity: 0.75;
			            margin-top: 8px;
			        '>" & _Prev12MarginText & " Margin</div>
			        
			        <div style='
			            font-size: 13px;
			            opacity: 0.65;
			            margin-top: 6px;
			        '>vs R12: " & _Prev12Arrow & "</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; background: rgba(255,255,255,0.2); margin: 10px 0;'></div>
			
			    <!-- Section 2: Previous 24 -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			        " & IF(_IsPeak24, "box-shadow: " & _PeakGlow & ";", "") & "
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 8px;
			            text-align: center;
			        '>Previous 24" & IF(_IsPeak24, " ⭐", "") & "</div>
			        
			        <div style='
			            font-size: 45px;
			            font-weight: 700;
			            line-height: 1;
			            color: " & _Color24 & ";
			            margin: 8px 0;
			        '>" & _Prev24Text & "</div>
			        
			        <div style='
			            font-size: 18px;
			            opacity: 0.75;
			            margin-top: 8px;
			        '>" & _Prev24MarginText & " Margin</div>
			        
			        <div style='
			            font-size: 13px;
			            opacity: 0.65;
			            margin-top: 6px;
			        '>vs R12: " & _Prev24Arrow & "</div>
			    </div>
			
			    <!-- Divider -->
			    <div style='width: 1px; background: rgba(255,255,255,0.2); margin: 10px 0;'></div>
			
			    <!-- Section 3: Previous 36 -->
			    <div style='
			        flex: 1;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        justify-content: space-between;
			        padding: 0 20px;
			        min-height: 140px;
			        " & IF(_IsPeak36, "box-shadow: " & _PeakGlow & ";", "") & "
			    '>
			        <div style='
			            font-size: 14px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.85;
			            font-weight: 600;
			            margin-bottom: 8px;
			            text-align: center;
			        '>Previous 36" & IF(_IsPeak36, " ⭐", "") & "</div>
			        
			        <div style='
