	measure 'Hero Card - Rolling Periods with Margin' = ```
			
			// ============================================================================
			// Calculate rolling period sales and margins
			// ============================================================================
			VAR _R12Sales = [Rolling12_Sales]
			VAR _P12Sales = [Previous 12 Sales]
			VAR _P24Sales = [Previous 24 Sales]
			VAR _P36Sales = [Previous 36 Sales]
			VAR _P48Sales = [Previous 48 Sales]
			VAR _P60Sales = [Previous 60 Sales]
			
			VAR _R12Margin = [% Rolling12]
			VAR _P12Margin = [% Previous 12]
			VAR _P24Margin = [% Previous 24]
			VAR _P36Margin = [% Previous 36]
			VAR _P48Margin = [% Previous 48]
			VAR _P60Margin = [% Previous 60]
			
			// ============================================================================
			// Calculate variance vs R12
			// ============================================================================
			VAR _VarP12 = DIVIDE(_P12Sales - _R12Sales, _R12Sales)
			VAR _VarP24 = DIVIDE(_P24Sales - _R12Sales, _R12Sales)
			VAR _VarP36 = DIVIDE(_P36Sales - _R12Sales, _R12Sales)
			VAR _VarP48 = DIVIDE(_P48Sales - _R12Sales, _R12Sales)
			VAR _VarP60 = DIVIDE(_P60Sales - _R12Sales, _R12Sales)
			
			// [Rest of formatting VARs similar to calendar years...]
			
			// ============================================================================
			// Key difference: Show variance vs R12 instead of YoY
			// ============================================================================
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
