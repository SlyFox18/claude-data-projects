	measure 'Performance Status Indicator' = ```
			
			// ============================================================================
			// Determine overall business health
			// ============================================================================
			VAR _CurrentMargin = [Rolling12_MarginPct]
			VAR _AvgHistoricalMargin = 
			    DIVIDE(
			        [% Previous 12] + [% Previous 24] + [% Previous 36] + [% Previous 48] + [% Previous 60],
			        5, 0
			    )
			
			VAR _YoYGrowth = DIVIDE([Rolling12_Sales] - [Previous 12 Sales], [Previous 12 Sales], 0)
			
			VAR _MarginHealth = 
			    SWITCH(
			        TRUE(),
			        _CurrentMargin > _AvgHistoricalMargin * 1.02, "Strong",
			        _CurrentMargin > _AvgHistoricalMargin * 0.98, "Healthy",
			        _CurrentMargin > _AvgHistoricalMargin * 0.95, "Watch",
			        "At Risk"
			    )
			
			VAR _GrowthHealth = 
			    SWITCH(
			        TRUE(),
			        _YoYGrowth > 0.05, "Growing",
			        _YoYGrowth > 0.02, "Stable Growth",
			        _YoYGrowth > -0.02, "Flat",
			        "Declining"
			    )
			
			VAR _OverallStatus = 
			    SWITCH(
			        TRUE(),
			        _MarginHealth IN {"Strong", "Healthy"} && _YoYGrowth > 0.02, "Excellent",
			        _MarginHealth IN {"Strong", "Healthy"} && _YoYGrowth > -0.02, "Good",
			        _MarginHealth = "Watch" || _YoYGrowth < -0.02, "Caution",
			        "Needs Attention"
			    )
			
			VAR _StatusColor = 
			    SWITCH(
			        _OverallStatus,
			        "Excellent", "#4ADE80",
			        "Good", "#86EFAC",
			        "Caution", "#FCD34D",
			        "#F97316"
			    )
			
			VAR _StatusIcon = 
			    SWITCH(
			        _OverallStatus,
			        "Excellent", "🟢",
			        "Good", "🟢",
			        "Caution", "🟡",
			        "🟠"
			    )
			
			VAR _MarginCompare = FORMAT(_CurrentMargin - _AvgHistoricalMargin, "+0.00%;-0.00%")
			VAR _GrowthText = FORMAT(_YoYGrowth, "+0.0%;-0.0%")
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 100%);
			    border-radius: 8px;
			    padding: 30px;
			    color: white;
			    margin-top: 15px;
			'>
			    <!-- Header -->
			    <div style='
			        text-align: center;
			        margin-bottom: 25px;
			    '>
			        <div style='
			            font-size: 16px;
			            text-transform: uppercase;
			            letter-spacing: 2px;
			            opacity: 0.8;
			            margin-bottom: 10px;
			        '>Business Health Status</div>
			        
			        <div style='
			            font-size: 52px;
			            font-weight: 700;
			            color: " & _StatusColor & ";
			            margin: 10px 0;
			        '>" & _StatusIcon & " " & _OverallStatus & "</div>
			    </div>
			
			    <!-- Metrics Grid -->
			    <div style='
			        display: grid;
			        grid-template-columns: 1fr 1fr;
			        gap: 20px;
			        margin-top: 20px;
			    '>
			        <!-- Margin Status -->
			        <div style='
			            background: rgba(255,255,255,0.05);
			            border-radius: 6px;
			            padding: 20px;
			            border-left: 4px solid " & SWITCH(_MarginHealth, "Strong", "#4ADE80", "Healthy", "#86EFAC", "Watch", "#FCD34D", "#F97316") & ";
			        '>
			            <div style='
			                font-size: 13px;
			                text-transform: uppercase;
			                opacity: 0.7;
			                margin-bottom: 8px;
			            '>Margin Performance</div>
			            <div style='
			                font-size: 28px;
			                font-weight: 700;
			                color: " & SWITCH(_MarginHealth, "Strong", "#4ADE80", "Healthy", "#86EFAC", "Watch", "#FCD34D", "#F97316") & ";
			            '>" & _MarginHealth & "</div>
			            <div style='
			                font-size: 14px;
			                opacity: 0.65;
			                margin-top: 8px;
			            '>" & _MarginCompare & " vs Historical Avg</div>
			        </div>
			
			        <!-- Growth Status -->
			        <div style='
			            background: rgba(255,255,255,0.05);
			            border-radius: 6px;
			            padding: 20px;
			            border-left: 4px solid " & SWITCH(_GrowthHealth, "Growing", "#4ADE80", "Stable Growth", "#86EFAC", "Flat", "#FCD34D", "#F97316") & ";
			        '>
			            <div style='
			                font-size: 13px;
			                text-transform: uppercase;
			                opacity: 0.7;
			                margin-bottom: 8px;
			            '>Sales Trajectory</div>
			            <div style='
			                font-size: 28px;
			                font-weight: 700;
			                color: " & SWITCH(_GrowthHealth, "Growing", "#4ADE80", "Stable Growth", "#86EFAC", "Flat", "#FCD34D", "#F97316") & ";
			            '>" & _GrowthHealth & "</div>
			            <div style='
			                font-size: 14px;
			                opacity: 0.65;
			                margin-top: 8px;
			            '>YoY: " & _GrowthText & "</div>
			        </div>
			    </div>
			</div>"
			```
		lineageTag: 9a85d356-dff8-450d-a513-154a9ff54fa1

	measure 'Key Insights Card' = ```
			
			// ============================================================================
			// Generate automated insights based on data patterns
			// ============================================================================
			VAR _R12 = [Rolling12_Sales]
			VAR _P12 = [Previous 12 Sales]
			VAR _P24 = [Previous 24 Sales]
			
			VAR _R12Margin = [Rolling12_MarginPct]
			VAR _P12Margin = [% Previous 12]
			
			VAR _YoYChange = _R12 - _P12
			VAR _YoYPct = DIVIDE(_YoYChange, _P12, 0)
			VAR _MarginChange = _R12Margin - _P12Margin
			
			// Find peak and valley
			VAR _Peak = MAX([Previous 24 Sales], MAX([Previous 36 Sales], MAX([Previous 48 Sales], [Previous 60 Sales])))
			VAR _Valley = MIN([Previous 24 Sales], MIN([Previous 36 Sales], MIN([Previous 48 Sales], [Previous 60 Sales])))
			
			VAR _PeakPeriod = 
			    SWITCH(
			        TRUE(),
			        [Previous 24 Sales] = _Peak, "Previous 24",
			        [Previous 36 Sales] = _Peak, "Previous 36",
			        [Previous 48 Sales] = _Peak, "Previous 48",
			        [Previous 60 Sales] = _Peak, "Previous 60",
			        "Unknown"
			    )
			
			// Generate insights
			VAR _Insight1 = 
			    IF(
			        _YoYPct > 0.02,
			        "✓ Sales up " & FORMAT(_YoYPct, "+0.0%") & " YoY - positive momentum",
			        IF(
			            _YoYPct < -0.02,
			            "⚠ Sales down " & FORMAT(_YoYPct, "0.0%") & " YoY - declining trend",
			            "→ Sales flat YoY - stable performance"
			        )
			    )
			
			VAR _Insight2 = 
			    IF(
			        _MarginChange > 0.005,
			        "✓ Margin improving (" & FORMAT(_MarginChange, "+0.00%") & ") - efficiency gains",
			        IF(
			            _MarginChange < -0.005,
			            "⚠ Margin declining (" & FORMAT(_MarginChange, "-0.00%") & ") - cost pressures",
			            "→ Margin stable - consistent operations"
			        )
			    )
			
			VAR _Insight3 = 
			    "📊 Historical peak was " & _PeakPeriod & " at " & 
			    IF(_Peak >= 1000000, FORMAT(_Peak / 1000000, "$#,##0.0") & "M", FORMAT(_Peak / 1000, "$#,##0") & "K")
			
			VAR _Insight4 = 
			    IF(
			        _R12 > _Peak,
			        "🎯 Current R12 is an all-time high",
			        "📈 Current R12 is " & FORMAT(DIVIDE(_Peak - _R12, _Peak, 0), "0.0%") & " below historical peak"
			    )
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #2E5266 0%, #3A7CA5 100%);
			    border-radius: 8px;
			    padding: 30px;
			    color: white;
			    margin-top: 15px;
			'>
			    <!-- Header -->
			    <div style='
			        font-size: 16px;
			        text-transform: uppercase;
			        letter-spacing: 2px;
			        opacity: 0.85;
			        margin-bottom: 20px;
			        padding-bottom: 15px;
			        border-bottom: 1px solid rgba(255,255,255,0.2);
			    '>📊 Key Insights</div>
			
			    <!-- Insights List -->
			    <div style='
			        display: flex;
			        flex-direction: column;
			        gap: 15px;
			    '>
			        <div style='
			            background: rgba(255,255,255,0.08);
			            border-radius: 6px;
			            padding: 15px 20px;
			            border-left: 3px solid #3A7CA5;
			            font-size: 15px;
			            line-height: 1.6;
			        '>" & _Insight1 & "</div>
			
			        <div style='
			            background: rgba(255,255,255,0.08);
			            border-radius: 6px;
			            padding: 15px 20px;
			            border-left: 3px solid #3A7CA5;
			            font-size: 15px;
			            line-height: 1.6;
			        '>" & _Insight2 & "</div>
			
			        <div style='
			            background: rgba(255,255,255,0.08);
			            border-radius: 6px;
			            padding: 15px 20px;
			            border-left: 3px solid #3A7CA5;
			            font-size: 15px;
			            line-height: 1.6;
			        '>" & _Insight3 & "</div>
			
			        <div style='
			            background: rgba(255,255,255,0.08);
			            border-radius: 6px;
			            padding: 15px 20px;
			            border-left: 3px solid #3A7CA5;
			            font-size: 15px;
			            line-height: 1.6;
			        '>" & _Insight4 & "</div>
			    </div>
			</div>"
			```
		lineageTag: 88f8ff11-b259-4a78-8f9f-24790e452bdc

	measure 'Quick Stats Grid' = ```
			
			// ============================================================================
			// Calculate key metrics for compact display
			// ============================================================================
			VAR _AvgPeriodSales = 
			    DIVIDE(
			        [Rolling12_Sales] + [Previous 12 Sales] + [Previous 24 Sales] + 
			        [Previous 36 Sales] + [Previous 48 Sales] + [Previous 60 Sales],
			        6, 0
			    )
			
			VAR _CurrentVsAvg = DIVIDE([Rolling12_Sales] - _AvgPeriodSales, _AvgPeriodSales, 0)
			
			VAR _BestPeriod = 
			    MAX([Rolling12_Sales], 
			        MAX([Previous 12 Sales], 
			            MAX([Previous 24 Sales], 
			                MAX([Previous 36 Sales], 
			                    MAX([Previous 48 Sales], [Previous 60 Sales])))))
			
			VAR _WorstPeriod = 
			    MIN([Rolling12_Sales], 
			        MIN([Previous 12 Sales], 
			            MIN([Previous 24 Sales], 
			                MIN([Previous 36 Sales], 
			                    MIN([Previous 48 Sales], [Previous 60 Sales])))))
			
			VAR _Volatility = DIVIDE(_BestPeriod - _WorstPeriod, _AvgPeriodSales, 0)
			
			VAR _ConsecutiveGrowth = 
			    SWITCH(
			        TRUE(),
			        [Rolling12_Sales] > [Previous 12 Sales] && [Previous 12 Sales] > [Previous 24 Sales], 2,
			        [Rolling12_Sales] > [Previous 12 Sales], 1,
			        0
			    )
			
			// Format values
			VAR _AvgText = 
			    IF(_AvgPeriodSales >= 1000000, 
			       FORMAT(_AvgPeriodSales / 1000000, "$#,##0.0") & "M", 
			       FORMAT(_AvgPeriodSales / 1000, "$#,##0") & "K")
			
			VAR _VsAvgText = FORMAT(_CurrentVsAvg, "+0.0%;-0.0%;0.0%")
			VAR _VsAvgColor = IF(_CurrentVsAvg > 0, "#4ADE80", IF(_CurrentVsAvg < 0, "#F97316", "#FCD34D"))
			
			VAR _VolatilityText = FORMAT(_Volatility, "0.0%")
			VAR _VolatilityStatus = IF(_Volatility < 0.15, "Low", IF(_Volatility < 0.30, "Moderate", "High"))
			
			VAR _GrowthStreakText = 
			    SWITCH(
			        _ConsecutiveGrowth,
			        2, "2+ Periods",
			        1, "1 Period",
			        "None"
			    )
			VAR _GrowthStreakColor = 
			    SWITCH(
			        _ConsecutiveGrowth,
			        2, "#4ADE80",
			        1, "#86EFAC",
			        "#94A3B8"
			    )
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 100%);
			    border-radius: 8px;
			    padding: 25px;
			    color: white;
			    margin-top: 15px;
			'>
			    <!-- Grid Layout -->
			    <div style='
			        display: grid;
			        grid-template-columns: repeat(3, 1fr);
			        gap: 20px;
			    '>
			        <!-- Average Period Sales -->
			        <div style='
			            background: rgba(255,255,255,0.05);
			            border-radius: 6px;
			            padding: 20px;
			            text-align: center;
			        '>
			            <div style='
			                font-size: 12px;
			                text-transform: uppercase;
			                letter-spacing: 1px;
			                opacity: 0.7;
			                margin-bottom: 10px;
			            '>Avg Period Sales</div>
			            <div style='
			                font-size: 32px;
			                font-weight: 700;
			                color: #3A7CA5;
			                margin: 8px 0;
			            '>" & _AvgText & "</div>
			            <div style='
			                font-size: 13px;
			                opacity: 0.65;
			            '>60-Month Average</div>
			        </div>
			
			        <!-- Current vs Average -->
			        <div style='
			            background: rgba(255,255,255,0.05);
			            border-radius: 6px;
			            padding: 20px;
			            text-align: center;
			        '>
			            <div style='
			                font-size: 12px;
			                text-transform: uppercase;
			                letter-spacing: 1px;
			                opacity: 0.7;
			                margin-bottom: 10px;
			            '>R12 vs Average</div>
			            <div style='
			                font-size: 32px;
			                font-weight: 700;
			                color: " & _VsAvgColor & ";
			                margin: 8px 0;
			            '>" & _VsAvgText & "</div>
			            <div style='
			                font-size: 13px;
			                opacity: 0.65;
			            '>" & IF(_CurrentVsAvg > 0, "Above", IF(_CurrentVsAvg < 0, "Below", "At")) & " Historical Avg</div>
			        </div>
			
			        <!-- Sales Volatility -->
			        <div style='
			            background: rgba(255,255,255,0.05);
			            border-radius: 6px;
			            padding: 20px;
			            text-align: center;
			        '>
			            <div style='
			                font-size: 12px;
			                text-transform: uppercase;
			                letter-spacing: 1px;
			                opacity: 0.7;
			                margin-bottom: 10px;
			            '>Volatility</div>
			            <div style='
			                font-size: 32px;
			                font-weight: 700;
			                color: " & IF(_Volatility < 0.15, "#4ADE80", IF(_Volatility < 0.30, "#FCD34D", "#F97316")) & ";
			                margin: 8px 0;
			            '>" & _VolatilityStatus & "</div>
			            <div style='
			                font-size: 13px;
			                opacity: 0.65;
			            '>" & _VolatilityText & " Range</div>
			        </div>
			
			        <!-- Growth Streak -->
			        <div style='
			            background: rgba(255,255,255,0.05);
			            border-radius: 6px;
			            padding: 20px;
			            text-align: center;
			            grid-column: span 3;
			        '>
			            <div style='
			                font-size: 12px;
			                text-transform: uppercase;
			                letter-spacing: 1px;
			                opacity: 0.7;
			                margin-bottom: 10px;
			            '>Consecutive Growth Streak</div>
			            <div style='
			                font-size: 32px;
			                font-weight: 700;
			                color: " & _GrowthStreakColor & ";
			                margin: 8px 0;
			            '>" & _GrowthStreakText & "</div>
			        </div>
			    </div>
			</div>"
			
			```
		lineageTag: 7dfbeffb-1757-4743-a3a1-422218db7725

	measure 'Slim Metrics Bar' = ```
			
			// ============================================================================
			// Calculate compact metrics
			// ============================================================================
			VAR _AvgPeriodSales = 
			    DIVIDE(
			        [Rolling12_Sales] + [Previous 12 Sales] + [Previous 24 Sales] + 
			        [Previous 36 Sales] + [Previous 48 Sales] + [Previous 60 Sales],
			        6, 0
			    )
			
			VAR _CurrentVsAvg = DIVIDE([Rolling12_Sales] - _AvgPeriodSales, _AvgPeriodSales, 0)
			
			VAR _YoYGrowth = DIVIDE([Rolling12_Sales] - [Previous 12 Sales], [Previous 12 Sales], 0)
			
			VAR _BestPeriod = 
			    MAX([Rolling12_Sales], 
			        MAX([Previous 12 Sales], 
			            MAX([Previous 24 Sales], 
			                MAX([Previous 36 Sales], 
			                    MAX([Previous 48 Sales], [Previous 60 Sales])))))
			
			VAR _CurrentRank = 
			    SWITCH(
			        TRUE(),
			        [Rolling12_Sales] = _BestPeriod, "1st",
			        [Rolling12_Sales] >= [Previous 12 Sales], "Top 2",
			        [Rolling12_Sales] >= [Previous 24 Sales], "Top 3",
			        [Rolling12_Sales] >= [Previous 36 Sales], "Top 4",
			        [Rolling12_Sales] >= [Previous 48 Sales], "Top 5",
			        "6th"
			    )
			
			VAR _TrendDirection = 
			    SWITCH(
			        TRUE(),
			        _YoYGrowth > 0.05, "↗ Strong Growth",
			        _YoYGrowth > 0.02, "↑ Growing",
			        _YoYGrowth > -0.02, "→ Stable",
			        _YoYGrowth > -0.05, "↓ Declining",
			        "↘ Sharp Decline"
			    )
			
			VAR _TrendColor = 
			    SWITCH(
			        TRUE(),
			        _YoYGrowth > 0.05, "#4ADE80",
			        _YoYGrowth > 0.02, "#86EFAC",
			        _YoYGrowth > -0.02, "#FCD34D",
			        _YoYGrowth > -0.05, "#FCA5A5",
			        "#EF4444"
			    )
			
			// Format values
			VAR _AvgText = 
			    IF(_AvgPeriodSales >= 1000000, 
			       FORMAT(_AvgPeriodSales / 1000000, "$#,##0.0") & "M", 
			       FORMAT(_AvgPeriodSales / 1000, "$#,##0") & "K")
			
			VAR _VsAvgText = FORMAT(_CurrentVsAvg, "+0.0%;-0.0%;0.0%")
			VAR _VsAvgColor = IF(_CurrentVsAvg > 0, "#4ADE80", IF(_CurrentVsAvg < 0, "#F97316", "#FCD34D"))
			
			VAR _YoYText = FORMAT(_YoYGrowth, "+0.0%;-0.0%;0.0%")
			
			VAR _RankColor = 
			    SWITCH(
			        _CurrentRank,
			        "1st", "#FFD700",  // Gold
			        "Top 2", "#3A7CA5",
			        "Top 3", "#60A5C4",
			        "#94A3B8"
			    )
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(90deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 6px;
			    padding: 20px 30px;
			    display: grid;
			    grid-template-columns: repeat(5, 1fr);
			    gap: 30px;
			    align-items: center;
			    color: white;
			    margin-top: 10px;
			    height: 110px;
			'>
			    <!-- Metric 1: Historical Average -->
			    <div style='
			        text-align: center;
			        border-right: 1px solid rgba(255,255,255,0.15);
			    '>
			        <div style='
			            font-size: 11px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.6;
			            margin-bottom: 8px;
			        '>Historical Avg</div>
			        <div style='
			            font-size: 28px;
			            font-weight: 700;
			            color: #3A7CA5;
			        '>" & _AvgText & "</div>
			    </div>
			
			    <!-- Metric 2: R12 vs Average -->
			    <div style='
			        text-align: center;
			        border-right: 1px solid rgba(255,255,255,0.15);
			    '>
			        <div style='
			            font-size: 11px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.6;
			            margin-bottom: 8px;
			        '>R12 vs Avg</div>
			        <div style='
			            font-size: 28px;
			            font-weight: 700;
			            color: " & _VsAvgColor & ";
			        '>" & _VsAvgText & "</div>
			    </div>
			
			    <!-- Metric 3: YoY Growth -->
			    <div style='
			        text-align: center;
			        border-right: 1px solid rgba(255,255,255,0.15);
			    '>
			        <div style='
			            font-size: 11px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.6;
			            margin-bottom: 8px;
			        '>YoY Growth</div>
			        <div style='
			            font-size: 28px;
			            font-weight: 700;
			            color: " & _TrendColor & ";
			        '>" & _YoYText & "</div>
			    </div>
			
			    <!-- Metric 4: Historical Rank -->
			    <div style='
			        text-align: center;
			        border-right: 1px solid rgba(255,255,255,0.15);
			    '>
			        <div style='
			            font-size: 11px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.6;
			            margin-bottom: 8px;
			        '>Period Ranking</div>
			        <div style='
			            font-size: 28px;
			            font-weight: 700;
			            color: " & _RankColor & ";
			        '>" & _CurrentRank & "</div>
			        <div style='
			            font-size: 10px;
			            opacity: 0.5;
			            margin-top: 4px;
			        '>of 6 Periods</div>
			    </div>
			
			    <!-- Metric 5: Trend -->
			    <div style='
			        text-align: center;
			    '>
			        <div style='
			            font-size: 11px;
			            text-transform: uppercase;
			            letter-spacing: 1px;
			            opacity: 0.6;
			            margin-bottom: 8px;
			        '>Trajectory</div>
			        <div style='
			            font-size: 20px;
			            font-weight: 700;
			            color: " & _TrendColor & ";
			        '>" & _TrendDirection & "</div>
			    </div>
			</div>"
			```
