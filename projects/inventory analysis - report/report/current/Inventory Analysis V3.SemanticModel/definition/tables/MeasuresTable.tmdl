	measure '% Rolling12' =
			
			VAR _Sales = [Rolling12_Sales]
			VAR _Cost = CALCULATE([Cost], DATESINPERIOD('dim_Date'[Date], TODAY(), -12, MONTH))
			RETURN
			DIVIDE(_Sales - _Cost, _Sales)
		lineageTag: 0189fe1d-2a1c-4318-b1ea-dad165f3b6b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MarginPct_2020 =
			
