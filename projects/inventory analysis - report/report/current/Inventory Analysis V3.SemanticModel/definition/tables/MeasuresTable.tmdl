		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales - Net' =
			
			[Sales - Gross] - [Sales - Returns]
		lineageTag: 330b59d3-1c47-4139-937f-5a35d90a3aec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

