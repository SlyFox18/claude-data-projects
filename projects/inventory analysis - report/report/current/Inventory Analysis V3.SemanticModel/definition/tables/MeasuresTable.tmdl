	measure 'Hero Card - Calendar Years with Margin' = ```
			
			// ============================================================================
			// Calculate yearly sales and margins
			// ============================================================================
			VAR _2020Sales = [Sales_2020]
			VAR _2021Sales = [Sales_2021]
			VAR _2022Sales = [Sales_2022]
			VAR _2023Sales = [Sales_2023]
			VAR _2024Sales = [Sales_2024]
			VAR _2025Sales = [Sales_CurrentYear]
			
			VAR _2020Margin = DIVIDE([Sales_2020] - [Cost_2020], [Sales_2020])
			VAR _2021Margin = DIVIDE([Sales_2021] - [Cost_2021], [Sales_2021])
			VAR _2022Margin = DIVIDE([Sales_2022] - [Cost_2022], [Sales_2022])
			VAR _2023Margin = DIVIDE([Sales_2023] - [Cost_2023], [Sales_2023])
			VAR _2024Margin = DIVIDE([Sales_2024] - [Cost_2024], [Sales_2024])
			VAR _2025Margin = DIVIDE([Sales_CurrentYear] - [Cost_CurrentYear], [Sales_CurrentYear])
			
			// ============================================================================
			// Calculate YoY growth (sales)
			// ============================================================================
			VAR _GrowthSales2021 = DIVIDE(_2021Sales - _2020Sales, _2020Sales)
			VAR _GrowthSales2022 = DIVIDE(_2022Sales - _2021Sales, _2021Sales)
			VAR _GrowthSales2023 = DIVIDE(_2023Sales - _2022Sales, _2022Sales)
			VAR _GrowthSales2024 = DIVIDE(_2024Sales - _2023Sales, _2023Sales)
			VAR _GrowthSales2025 = DIVIDE(_2025Sales - _2024Sales, _2024Sales)
			
			// ============================================================================
			// Format values
			// ============================================================================
			VAR _2020SalesText = FORMAT(_2020Sales / 1000000, "$#,##0") & "M"
			VAR _2021SalesText = FORMAT(_2021Sales / 1000000, "$#,##0") & "M"
			VAR _2022SalesText = FORMAT(_2022Sales / 1000000, "$#,##0") & "M"
			VAR _2023SalesText = FORMAT(_2023Sales / 1000000, "$#,##0") & "M"
			VAR _2024SalesText = FORMAT(_2024Sales / 1000000, "$#,##0") & "M"
			VAR _2025SalesText = FORMAT(_2025Sales / 1000000, "$#,##0") & "M"
			
			VAR _2020MarginText = FORMAT(_2020Margin, "0.0%")
			VAR _2021MarginText = FORMAT(_2021Margin, "0.0%")
			VAR _2022MarginText = FORMAT(_2022Margin, "0.0%")
			VAR _2023MarginText = FORMAT(_2023Margin, "0.0%")
			VAR _2024MarginText = FORMAT(_2024Margin, "0.0%")
			VAR _2025MarginText = FORMAT(_2025Margin, "0.0%")
			
			VAR _GrowthSales2021Text = FORMAT(_GrowthSales2021, "+0.0%;-0.0%")
			VAR _GrowthSales2022Text = FORMAT(_GrowthSales2022, "+0.0%;-0.0%")
			VAR _GrowthSales2023Text = FORMAT(_GrowthSales2023, "+0.0%;-0.0%")
			VAR _GrowthSales2024Text = FORMAT(_GrowthSales2024, "+0.0%;-0.0%")
			VAR _GrowthSales2025Text = FORMAT(_GrowthSales2025, "+0.0%;-0.0%")
			
			// ============================================================================
			// Identify peak year
			// ============================================================================
			VAR _PeakSales = MAX(_2020Sales, MAX(_2021Sales, MAX(_2022Sales, MAX(_2023Sales, MAX(_2024Sales, _2025Sales)))))
			VAR _IsPeak2021 = IF(_2021Sales = _PeakSales, TRUE(), FALSE())
			VAR _IsPeak2022 = IF(_2022Sales = _PeakSales, TRUE(), FALSE())
			VAR _IsPeak2023 = IF(_2023Sales = _PeakSales, TRUE(), FALSE())
			VAR _IsPeak2024 = IF(_2024Sales = _PeakSales, TRUE(), FALSE())
			
			// ============================================================================
			// Growth arrow colors
			// ============================================================================
			VAR _ArrowColor2021 = IF(_GrowthSales2021 > 0.05, "#10B981", IF(_GrowthSales2021 > -0.05, "#FCD34D", "#EF4444"))
			VAR _ArrowColor2022 = IF(_GrowthSales2022 > 0.05, "#10B981", IF(_GrowthSales2022 > -0.05, "#FCD34D", "#EF4444"))
			VAR _ArrowColor2023 = IF(_GrowthSales2023 > 0.05, "#10B981", IF(_GrowthSales2023 > -0.05, "#FCD34D", "#EF4444"))
			VAR _ArrowColor2024 = IF(_GrowthSales2024 > 0.05, "#10B981", IF(_GrowthSales2024 > -0.05, "#FCD34D", "#EF4444"))
			VAR _ArrowColor2025 = IF(_GrowthSales2025 > 0.05, "#10B981", IF(_GrowthSales2025 > -0.05, "#FCD34D", "#EF4444"))
			
			VAR _Arrow2021 = IF(_GrowthSales2021 > 0.05, "↗", IF(_GrowthSales2021 > -0.05, "→", "↘"))
			VAR _Arrow2022 = IF(_GrowthSales2022 > 0.05, "↗", IF(_GrowthSales2022 > -0.05, "→", "↘"))
			VAR _Arrow2023 = IF(_GrowthSales2023 > 0.05, "↗", IF(_GrowthSales2023 > -0.05, "→", "↘"))
			VAR _Arrow2024 = IF(_GrowthSales2024 > 0.05, "↗", IF(_GrowthSales2024 > -0.05, "→", "↘"))
			VAR _Arrow2025 = IF(_GrowthSales2025 > 0.05, "↗", IF(_GrowthSales2025 > -0.05, "→", "↘"))
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 8px;
			    padding: 20px 25px;
			    color: white;
			'>
			    <!-- Header -->
			    <div style='
			        font-size: 16px;
			        font-weight: 700;
			        text-transform: uppercase;
			        letter-spacing: 2px;
			        margin-bottom: 20px;
			        opacity: 0.95;
			        text-align: center;
			    '>Calendar Years • 2020-2025</div>
			    
			    <!-- Timeline Container -->
			    <div style='
			        display: flex;
			        justify-content: space-between;
			        align-items: flex-end;
			        position: relative;
			        padding: 15px 0;
			    '>
			        <!-- Connecting Line -->
			        <div style='
			            position: absolute;
			            top: 55%;
			            left: 5%;
			            right: 5%;
			            height: 2px;
			            background: linear-gradient(90deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0.2) 100%);
			        '></div>
			        
			        <!-- 2020 Node -->
			        <div style='
			            flex: 1;
			            display: flex;
			            flex-direction: column;
			            align-items: center;
			            z-index: 1;
			        '>
			            <div style='
			                font-size: 35px;
			                font-weight: 700;
			                color: #B8E2E8;
			                margin-bottom: 4px;
			            '>" & _2020SalesText & "</div>
			            
			            <div style='
			                font-size: 20px;
			                color: #4ADE80;
			                opacity: 0.9;
			                margin-bottom: 8px;
			            '>" & _2020MarginText & "</div>
			            
			            <div style='
			                width: 14px;
			                height: 14px;
			                border-radius: 50%;
			                background: #B8E2E8;
			                box-shadow: 0 0 10px rgba(184, 226, 232, 0.5);
			                margin-bottom: 6px;
			            '></div>
			            
			            <div style='
			                font-size: 12px;
			                font-weight: 600;
			                opacity: 0.8;
			            '>2020</div>
			        </div>
			        
			        <!-- 2021 Node -->
			        <div style='
			            flex: 1;
			            display: flex;
			            flex-direction: column;
			            align-items: center;
			            z-index: 1;
			        '>
			            <div style='
			                font-size: 20px;
			                color: " & _ArrowColor2021 & ";
			                margin-bottom: 3px;
			                font-weight: 600;
			            '>" & _Arrow2021 & " " & _GrowthSales2021Text & "</div>
			            
			            <div style='
			                font-size: 35px;
			                font-weight: 700;
			                color: #A0D4DB;
			                margin-bottom: 4px;
			            '>" & _2021SalesText & "</div>
			            
			            <div style='
			                font-size: 20px;
			                color: #4ADE80;
			                opacity: 0.9;
			                margin-bottom: 8px;
			            '>" & _2021MarginText & "</div>
			            
			            <div style='
			                width: 14px;
			                height: 14px;
			                border-radius: 50%;
			                background: #A0D4DB;
			                box-shadow: 0 0 10px rgba(160, 212, 219, 0.5);
			                margin-bottom: 6px;
			                " & IF(_IsPeak2021, "width: 18px; height: 18px; box-shadow: 0 0 20px rgba(255, 215, 0, 0.8);", "") & "
			            '></div>
			            
			            <div style='
			                font-size: 20px;
			                font-weight: 600;
			                opacity: 0.8;
			            '>2021" & IF(_IsPeak2021, " ⭐", "") & "</div>
			        </div>
			        
			        <!-- 2022 Node -->
			        <div style='
			            flex: 1;
			            display: flex;
			            flex-direction: column;
			            align-items: center;
			            z-index: 1;
			        '>
			            <div style='
			                font-size: 20px;
			                color: " & _ArrowColor2022 & ";
			                margin-bottom: 3px;
			                font-weight: 600;
			            '>" & _Arrow2022 & " " & _GrowthSales2022Text & "</div>
			            
			            <div style='
			                font-size: 35px;
			                font-weight: 700;
			                color: #8AC6D0;
			                margin-bottom: 4px;
			            '>" & _2022SalesText & "</div>
			            
			            <div style='
