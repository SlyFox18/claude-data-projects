	column CategoryIcon =
			
			SWITCH([SalesCategory],
			    "Active", "✅",
			    "Active Stock No Demand", "⚠️",
			    "Zero Sales 12", "📊",
			    "Zero Sales 24", "📉",
			    "Zero Sales 36", "⚠️",
			    "Zero Sales 48 Plus", "🚨",
			    "Excess", "📦"
			) & " " & [SalesCategory]
		lineageTag: 756db110-d463-4b7f-8412-47e4655d29ef
