	column InventoryCategory = ```
			
			VAR TodayDate = TODAY()
			VAR DateRequested = Fact_Inventory[DateLastRequested]
			VAR SalesQty = Fact_Inventory[Current12MoSales]
			VAR QtyOnHand = Fact_Inventory[QuantityOnHand]
			VAR InventoryCost = Fact_Inventory[InventoryCost]
			VAR ExcessQty = QtyOnHand - SalesQty
			
			RETURN
			    SWITCH (
			        TRUE(),
			
			        // Exclude any rows with no cost or no inventory
			        InventoryCost <= 0 || QtyOnHand <= 0, "Uncategorized",
			
			        // Excess first, but only if there are some sales
			        SalesQty > 0 && ExcessQty > 0, "Excess",
			
			        // Now assign Zero Sales based on DateLastRequested
			        SalesQty = 0 && DateRequested >= TodayDate - 365, "ZeroSales12",
			        SalesQty = 0 && DateRequested >= TodayDate - 730, "ZeroSales24",
			        SalesQty = 0 && DateRequested >= TodayDate - 1095, "ZeroSales36",
			
			        // Then Active
			        SalesQty > 0 && DateRequested >= TodayDate - 365, "Active",
			
			        // Catch anything else
			        "Uncategorized"
			    )
			
			```
		lineageTag: c2d2e4a9-1e85-4a44-b0da-fc7f160bea7f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ExcessQtyFlag =
			
			VAR _BinQty = Fact_Inventory[BinQty]
			VAR _SalesQty = Fact_Inventory[Current12MoSales]
			RETURN
			    IF(
			        _BinQty > _SalesQty && _SalesQty > 0,
			        _BinQty - _SalesQty,
			        BLANK()
			    )
		formatString: 0
		lineageTag: 3156bd9c-1701-4ca0-9bbb-0b3be830a3b3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ExcessInventoryCostPerRow =
			
			VAR _ExcessQty = [ExcessQtyFlag]
			VAR _UnitCost = DIVIDE([InventoryCost], [QuantityOnHand])
			RETURN IF(NOT ISBLANK(_ExcessQty), _ExcessQty * _UnitCost)
		lineageTag: 0d9df473-73f0-4640-968f-33fa3a3f6f37
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column InventoryStatusCategory = ```
			
			VAR TodayDate = TODAY()
			VAR DateLast = Fact_Inventory[DateLastRequested]
			VAR OnHand = Fact_Inventory[QuantityOnHand]
			VAR Bin = Fact_Inventory[BinQty]
			VAR Sales = Fact_Inventory[Current12MoSales]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        // No sales in last 36 months (i.e., last sale was more than 3 years ago)
			        OnHand > 0 && DateLast < TodayDate - 1095, "No Sales - 36 Months",
			        // No sales in last 24 months
			        OnHand > 0 && DateLast < TodayDate - 730, "No Sales - 24 Months",
			        // No sales in last 12 months
			        OnHand > 0 && DateLast < TodayDate - 365, "No Sales - 12 Months",
			        // Excess Stock
			        Sales > 0 && Bin > Sales && OnHand > 0, "Excess Stock",
			        BLANK()
			    )
			
			```
		lineageTag: 6e40f07c-c1f0-4395-b2cc-0d375f349b4c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ExcessQty = ```
			
			VAR _OnHand = Fact_Inventory[QuantityOnHand]
			VAR _Sales12Mo = Fact_Inventory[Current12MoSales]
			VAR _EstExcess = _OnHand - _Sales12Mo
			RETURN
			IF(
			    _OnHand > 0 &&
			    _Sales12Mo > 0 &&
			    _EstExcess > 0,
			    _EstExcess,
			    BLANK()
			)
			
			```
		formatString: 0
		lineageTag: 1f245a12-0d70-4b13-bc8d-45d52a988586
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ExcessLevel = ```
			
			SWITCH(
			    TRUE(),
			    Fact_Inventory[ExcessQty] >= 50, "High",
			    Fact_Inventory[ExcessQty] >= 10, "Medium",
			    Fact_Inventory[ExcessQty] > 0, "Low",
			    BLANK()
			)
			
			```
		lineageTag: 5d8e694f-6fb4-4217-82f6-49258d12b7da
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ExcessStockFlag =
			
			IF(Fact_Inventory[ExcessQty] > 0, 1, 0)
		formatString: 0
		lineageTag: b1f4adbb-a305-42aa-aeeb-c78f54cac4a0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DeadStockFlag =
			
			VAR TodayDate = TODAY()
			VAR Last12Start = EDATE(TodayDate, -12)
			VAR Last24Start = EDATE(TodayDate, -24)
			VAR Last36Start = EDATE(TodayDate, -36)
			VAR LastRequested = Fact_Inventory[DateLastRequested]
			VAR QtyOnHand = Fact_Inventory[QuantityOnHand]
			
			RETURN
			SWITCH(
			    TRUE(),
			    QtyOnHand > 0 && LastRequested <= Last12Start && LastRequested > Last24Start, 1,   // 12M
			    QtyOnHand > 0 && LastRequested <= Last24Start && LastRequested > Last36Start, 2,   // 24M
			    QtyOnHand > 0 && LastRequested <= Last36Start, 3,                                  // 36M
			    0
			)
		formatString: 0
		lineageTag: 5a7afcd9-5a5d-4ed7-9584-ace8c6073864
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column SalesCategory = ```
			
			VAR _DateLast = Fact_Inventory[DateLastRequested]
			VAR _Sales12Mo = Fact_Inventory[Current12MoSales]
			VAR _Today = TODAY()
			
			RETURN
			SWITCH(
			    TRUE(),
			    
			    // Case 1: No demand history (blank or sentinel date)
			    ISBLANK(_DateLast) || _DateLast = DATE(1900,1,1),
			        "Active Stock No Demand",
			    
			    // Case 2: Has sales in last 12 months
			    NOT ISBLANK(_Sales12Mo) && _Sales12Mo > 0,
			        "Active",
			    
			    // Case 3: Requested in last 12 months (even if no sales)
			    _DateLast >= _Today - 365,
			        "Active",
			    
			    // Case 4: Last requested 12-24 months ago
			    _DateLast >= _Today - 730,
			        "Zero Sales 12",
			    
			    // Case 5: Last requested 24-36 months ago
			    _DateLast >= _Today - 1095,
			        "Zero Sales 24",
			    
			    // Case 6: Last requested 36-48 months ago
			    _DateLast >= _Today - 1460,
			        "Zero Sales 36",
			    
			    // Case 7: Last requested 48+ months ago
			    _DateLast < _Today - 1460,
			        "Zero Sales 48 Plus",
			    
			    // DEFAULT CASE - catches everything else
			    "Uncategorized"
			)
			```
		lineageTag: d191a720-15d9-4e02-96e2-5f242417d000
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

