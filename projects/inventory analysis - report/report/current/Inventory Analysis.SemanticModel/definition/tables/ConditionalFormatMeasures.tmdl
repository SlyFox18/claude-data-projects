table ConditionalFormatMeasures
	lineageTag: 553700be-8cab-444f-bda0-35398a173c89

	measure 'CF R12 vs P12' =
			
			IF (
			    NOT ( ISBLANK ( [Rolling12_Sales]  ) )
			        && NOT ( ISBLANK ( [Previous 12 Sales] ) )
			            && [Rolling12_Sales] > [Previous 12 Sales],
			    1,
			    0
			)
		formatString: 0
		lineageTag: cb415cac-9538-48c2-948f-94bde1ae88ce

