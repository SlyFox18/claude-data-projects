model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Data Refresh","TableColumns","TableRelationships","Views","Indexes","TableDescriptions","TableStats","Timestamp Columns","Unique Constraints"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Data Refresh'
ref table 'New Report Tables'
ref table 'New Report Relationships'
ref table 'New Report Columns'
ref table _Measures
ref table TableColumns
ref table TableRelationships
ref table Views
ref table Indexes
ref table TableDescriptions
ref table TableStats
ref table 'Timestamp Columns'
ref table 'Unique Constraints'
ref table Tables
ref table AllTableRelationships

ref cultureInfo en-US

