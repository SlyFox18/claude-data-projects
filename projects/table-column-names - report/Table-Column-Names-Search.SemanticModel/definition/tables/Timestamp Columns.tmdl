table 'Timestamp Columns'
	lineageTag: 1d21dd57-5ee9-4e75-9f17-d6b2c59a2e52

	column table_name
		dataType: string
		lineageTag: 5559dff3-74c5-4205-8bb9-334ffdccd3ae
		summarizeBy: none
		sourceColumn: table_name

		annotation SummarizationSetBy = Automatic

	column column_name
		dataType: string
		lineageTag: 46560d88-79b3-4955-9872-60d2726747ba
		summarizeBy: none
		sourceColumn: column_name

		annotation SummarizationSetBy = Automatic

	column data_type
		dataType: string
		lineageTag: 6f4d9d9a-952b-4c30-8a94-2f4c28a2f949
		summarizeBy: none
		sourceColumn: data_type

		annotation SummarizationSetBy = Automatic

	column field_category
		dataType: string
		lineageTag: 80bae39c-ea23-4442-991a-1911c3af0328
		summarizeBy: none
		sourceColumn: field_category

		annotation SummarizationSetBy = Automatic

	partition 'Timestamp Columns' = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=EquipRDB64", "-- Find all date/time columns (potential audit fields)#(lf)SELECT #(lf)    t.table_name,#(lf)    c.column_name,#(lf)    c.base_type_str as data_type,#(lf)    CASE #(lf)        WHEN LOWER(c.column_name) LIKE '%created%' THEN 'Created Date'#(lf)        WHEN LOWER(c.column_name) LIKE '%modified%' THEN 'Modified Date'#(lf)        WHEN LOWER(c.column_name) LIKE '%updated%' THEN 'Updated Date'#(lf)        WHEN LOWER(c.column_name) LIKE '%date%' THEN 'Date Field'#(lf)        WHEN LOWER(c.column_name) LIKE '%time%' THEN 'Time Field'#(lf)        ELSE 'Date/Time Field'#(lf)    END as field_category#(lf)FROM sys.systable t#(lf)INNER JOIN sys.systabcol c ON t.table_id = c.table_id#(lf)WHERE t.creator NOT IN (1, 3)#(lf)    AND t.table_type = 'BASE'#(lf)    AND (c.base_type_str LIKE '%date%' #(lf)         OR c.base_type_str LIKE '%time%' #(lf)         OR c.base_type_str LIKE '%stamp%')#(lf)ORDER BY t.table_name, c.column_name;")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

