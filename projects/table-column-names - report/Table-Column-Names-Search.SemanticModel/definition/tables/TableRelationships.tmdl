	partition TableRelationships = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=EquipRDB64", "-- Foreign key relationships (confirmed for your version)#(lf)SELECT #(lf)    pt.table_name as primary_table,#(lf)    ft.table_name as foreign_table,#(lf)    fk.role as relationship_name,#(lf)    fc.column_name as foreign_key_column,#(lf)    pc.column_name as references_column#(lf)FROM sys.sysforeignkey fk#(lf)INNER JOIN sys.systable pt ON fk.primary_table_id = pt.table_id#(lf)INNER JOIN sys.systable ft ON fk.foreign_table_id = ft.table_id#(lf)INNER JOIN sys.sysfkcol fkc ON fk.foreign_key_id = fkc.foreign_key_id#(lf)INNER JOIN sys.systabcol fc ON fkc.foreign_column_id = fc.column_id AND fc.table_id = ft.table_id#(lf)INNER JOIN sys.systabcol pc ON fkc.primary_column_id = pc.column_id AND pc.table_id = pt.table_id#(lf)WHERE pt.creator NOT IN (1, 3) AND ft.creator NOT IN (1, 3)#(lf)ORDER BY ft.table_name, fk.role;")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

