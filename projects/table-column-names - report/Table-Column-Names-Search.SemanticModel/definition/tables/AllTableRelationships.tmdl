	partition AllTableRelationships = calculated
		mode: import
		source =
				
				UNION(
				    SELECTCOLUMNS(
				        TableRelationships,
				        "table_name", TableRelationships[foreign_table],
				        "relationship_name", TableRelationships[relationship_name],
				        "relationship_type", "Foreign Key",
				        "related_table", TableRelationships[primary_table],
				        "this_column", TableRelationships[foreign_key_column],
				        "related_column", TableRelationships[references_column]
				    ),
				    SELECTCOLUMNS(
				        TableRelationships,
				        "table_name", TableRelationships[primary_table],
				        "relationship_name", TableRelationships[relationship_name],
				        "relationship_type", "Primary Key",
				        "related_table", TableRelationships[foreign_table],
				        "this_column", TableRelationships[references_column],
				        "related_column", TableRelationships[foreign_key_column]
				    )
				)

	annotation PBI_Id = 4d0c9dc9a61240b0aee63c788873da1a

