	partition TableColumns = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=EquipRDB64", "-- Optimized for your SQL Anywhere version#(lf)SELECT #(lf)    t.table_name,#(lf)    c.column_name,#(lf)    c.base_type_str as data_type,#(lf)    c.width as column_length,#(lf)    c.scale as decimal_scale,#(lf)    CASE WHEN c.nulls = 'Y' THEN 'Yes' ELSE 'No' END as is_nullable,#(lf)    c.""default"" as default_value,#(lf)    c.column_id as ordinal_position,#(lf)    t.count as table_row_count,#(lf)    CASE WHEN idx.index_name IS NOT NULL THEN 'Yes' ELSE 'No' END as is_primary_key#(lf)FROM sys.systable t#(lf)INNER JOIN sys.systabcol c ON t.table_id = c.table_id#(lf)LEFT JOIN sys.sysidxcol ic ON c.column_id = ic.column_id AND c.table_id = ic.table_id#(lf)LEFT JOIN sys.sysidx idx ON ic.index_id = idx.index_id AND ic.table_id = idx.table_id AND idx.index_category = 1#(lf)WHERE t.creator NOT IN (1, 3)#(lf)    AND t.table_type = 'BASE'#(lf)ORDER BY t.table_name, c.column_id;")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

