table TableDescriptions
	lineageTag: 6364a45e-31e7-4408-a8f9-b49996a8dc29

	column table_name
		dataType: string
		lineageTag: e331f61e-875c-4d22-b767-d2176438b7e0
		summarizeBy: none
		sourceColumn: table_name

		annotation SummarizationSetBy = Automatic

	column table_type
		dataType: string
		lineageTag: c71578d2-e389-4636-9250-556974653dc5
		summarizeBy: none
		sourceColumn: table_type

		annotation SummarizationSetBy = Automatic

	column table_description
		dataType: string
		lineageTag: 76864d78-75f5-43da-97df-19c648bad872
		summarizeBy: none
		sourceColumn: table_description

		annotation SummarizationSetBy = Automatic

	partition TableDescriptions = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=EquipRDB64", "-- Check if tables have remarks/comments#(lf)SELECT #(lf)    t.table_name,#(lf)    t.table_type,#(lf)    COALESCE(t.remarks, '') as table_description#(lf)FROM sys.systable t#(lf)WHERE t.creator NOT IN (1, 3)#(lf)    AND t.table_type IN ('BASE', 'VIEW')#(lf)    AND t.remarks IS NOT NULL#(lf)ORDER BY t.table_name;")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

