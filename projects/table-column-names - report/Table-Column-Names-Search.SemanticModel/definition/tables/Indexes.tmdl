	column column_order_in_index
		dataType: int64
		formatString: 0
		lineageTag: 51935cef-a820-4fe9-bf21-67b75cba46d7
		summarizeBy: sum
		sourceColumn: column_order_in_index

		annotation SummarizationSetBy = Automatic

	partition Indexes = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=EquipRDB64", "-- All indexes and their columns#(lf)SELECT #(lf)    t.table_name,#(lf)    idx.index_name,#(lf)    c.column_name,#(lf)    CASE idx.index_category #(lf)        WHEN 1 THEN 'Primary Key'#(lf)        WHEN 2 THEN 'Foreign Key'#(lf)        WHEN 3 THEN 'Unique'#(lf)        WHEN 4 THEN 'Non-Unique'#(lf)        ELSE 'Other'#(lf)    END as index_type,#(lf)    CASE WHEN idx.""unique"" = 1 THEN 'Yes' ELSE 'No' END as is_unique,#(lf)    ic.sequence as column_order_in_index#(lf)FROM sys.sysidx idx#(lf)INNER JOIN sys.systable t ON idx.table_id = t.table_id#(lf)INNER JOIN sys.sysidxcol ic ON idx.index_id = ic.index_id AND idx.table_id = ic.table_id#(lf)INNER JOIN sys.systabcol c ON ic.column_id = c.column_id AND ic.table_id = c.table_id#(lf)WHERE t.creator NOT IN (1, 3)#(lf)    AND t.table_type = 'BASE'#(lf)ORDER BY t.table_name, idx.index_name, ic.sequence;")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

