	partition Views = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=EquipRDB64", "-- All views and their columns#(lf)SELECT #(lf)    t.table_name as view_name,#(lf)    c.column_name,#(lf)    c.base_type_str as data_type,#(lf)    c.width as column_length,#(lf)    c.column_id as ordinal_position,#(lf)    'View' as object_type#(lf)FROM sys.systable t#(lf)INNER JOIN sys.systabcol c ON t.table_id = c.table_id#(lf)WHERE t.creator NOT IN (1, 3)#(lf)    AND t.table_type = 'VIEW'#(lf)ORDER BY t.table_name, c.column_id;")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

