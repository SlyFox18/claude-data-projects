		annotation SummarizationSetBy = Automatic

	partition 'Unique Constraints' = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=EquipRDB64", "-- Find all unique constraints#(lf)SELECT #(lf)    t.table_name,#(lf)    idx.index_name as constraint_name,#(lf)    c.column_name#(lf)FROM sys.sysidx idx#(lf)INNER JOIN sys.systable t ON idx.table_id = t.table_id#(lf)INNER JOIN sys.sysidxcol ic ON idx.index_id = ic.index_id AND idx.table_id = ic.table_id#(lf)INNER JOIN sys.systabcol c ON ic.column_id = c.column_id AND ic.table_id = c.table_id#(lf)WHERE t.creator NOT IN (1, 3)#(lf)    AND idx.""unique"" = 1#(lf)    AND idx.index_category = 3  -- Unique constraint#(lf)ORDER BY t.table_name, idx.index_name, ic.sequence;")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

