	measure 'Margin $ Discrepancy' = [Actual Margin $ (INV)] - [Desired Margin $]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ff9dbbce-1f75-447d-b5b2-c84bf9ce6d4e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Part Description' = ```
			
			    VAR CurrentPartNumber = SELECTEDVALUE(dim_Parts_LowMargin[PartNumber])
			    VAR FromDimParts =
			        LOOKUPVALUE(
			            dim_Parts[Description],
			            dim_Parts[PartNumber], CurrentPartNumber
			        )
			    RETURN
			    IF(FromDimParts <> BLANK(), FromDimParts, "")
			```
		lineageTag: 83241c09-9496-4872-ad93-56e6b46be05b

	measure 'Measure Filter 2' =
			
			VAR MinValue = MIN('Percentage Filter'[Value])
			VAR MaxValue = MAX('Percentage Filter'[Value])
			VAR CurrentMeasureValue = [Actual Margin % (INV)]
			RETURN
			IF(
			    CurrentMeasureValue >= MinValue && CurrentMeasureValue <= MaxValue,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 87f82fbc-2743-47e3-85be-edef9cd35801

	measure Cost = SUM(dim_Parts_LowMargin[Cost])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: dcd80539-9f39-435c-9337-8e47226cbe5a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Cost Value' = [Cost] * [Total SOH Qty]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3cfd2f1a-77ca-4a0d-bb61-5b0256482fff

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'New Sell Price' = ```
			
			    DIVIDE(
			        ABS([Margin $ Discrepancy]),
			        [Total SOH Qty],
			        0
			    ) + [List Price]
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 85aac12d-10b5-4f8b-9fe6-bc7f8af66743

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Margin % Color Code' =
			
			SWITCH(
			    TRUE(),
			    [Actual Margin % (INV)] >= .39999, 1,  // Dark Green
			    [Actual Margin % (INV)] >= 0.305 && [Actual Margin % (INV)] <= 0.4, 3,  // Green
			    [Actual Margin % (INV)] = .3 && [Actual Margin % (INV)] = 0.30, 2,  // White
			    [Actual Margin % (INV)] >= 0.199 && [Actual Margin % (INV)] < 0.299, 4,  // Yellow
			    [Actual Margin % (INV)] >= 0.099 && [Actual Margin % (INV)] < 0.199, 5,  // Orange
			    [Actual Margin % (INV)] >= 0 && [Actual Margin % (INV)] < 0.099, 6,  // Red
			    [Actual Margin % (INV)] <= 0, 7,  // Dark Red
			    BLANK()
			)
		formatString: 0
		lineageTag: 3a8c5f3b-d5a1-4463-af7c-a98a974bdd05

	measure 'Test Row Count' = COUNTROWS(dim_Parts_LowMargin)
		formatString: 0
		lineageTag: 8fa42cc6-a9e1-4593-b09a-10d570b04dfc

	measure 'Test NULL Check' = ```
			
			VAR NullPartNumber = CALCULATE(COUNTROWS(Fact_InTrans), ISBLANK(Fact_InTrans[PartNumber]))
			VAR NullBranch = CALCULATE(COUNTROWS(Fact_InTrans), ISBLANK(Fact_InTrans[Branch]))
			VAR NullFranchise = CALCULATE(COUNTROWS(Fact_InTrans), ISBLANK(Fact_InTrans[Franchise]))
			RETURN
			"NULL PartNumber: " & NullPartNumber & 
			" | NULL Branch: " & NullBranch & 
			" | NULL Franchise: " & NullFranchise
			
			```
		lineageTag: 273bb89c-b591-4b22-8370-5488282587c7

	measure 'Test Manual Sum Positive' = ```
			
			VAR TableWithCalc = 
			    ADDCOLUMNS(
			        dim_Parts_LowMargin,
			        "_Discrepancy",
			            (([SellPrice1] * [OnHandQty]) - [InventoryCost]) -
			            (([SellPrice1] * [OnHandQty]) - ([Cost] * [OnHandQty]))
			    )
			VAR PositiveOnly = FILTER(TableWithCalc, [_Discrepancy] > 0)
			RETURN
			"Positive Sum: " & FORMAT(SUMX(PositiveOnly, [_Discrepancy]), "$#,##0.00")
			    & " | Row Count: " & COUNTROWS(PositiveOnly)
			
			```
		lineageTag: 2a51dda8-891c-465d-857e-539a1bbe33d8

