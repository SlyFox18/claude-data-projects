	measure 'Original MDP Value' = [Stock Order Price] * [Total SOH Qty]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 46ebf0cb-9402-4883-b0f0-fd555e23afa2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Measure Filter 3' =
			
			VAR MinValue = MIN('Percentage Filter'[Value])
			VAR MaxValue = MAX('Percentage Filter'[Value])
			VAR CurrentMeasureValue = [% Difference]
			RETURN
			IF(
			    CurrentMeasureValue >= MinValue && CurrentMeasureValue <= MaxValue,
			    1,
			    0
