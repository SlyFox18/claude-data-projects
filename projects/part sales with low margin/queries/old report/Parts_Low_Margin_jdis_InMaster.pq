let
  Source = Odbc.Query("dsn=EquipRDB64", "WITH jdis_Part_Info_Filtered AS (#(lf)    SELECT #(lf)        pi_Branch AS ""Branch"",#(lf)     pi_List_Price_Manuf_File AS ""List Price Manuf"",#(lf)     pi_Franchise AS ""Franchise"",#(lf)        pi_Part_No AS ""Part No"",#(lf)        pi_Description AS ""Description"",#(lf)        pi_Bin AS ""Bin"",#(lf)        pi_Bin_Qty AS ""Bin Qty"",#(lf)        pi_Bulk_Bin AS ""Bulk Bin"",#(lf)        pi_Bulk_Bin_Qty AS ""Bulk Bin Qty"",#(lf)        pi_On_Hand_Qty AS ""On Hand Qty"",#(lf)        pi_Pending_Qty AS ""Pending Qty"",#(lf)        pi_Date_Last_Request AS ""Date Last Requested"",#(lf)        pi_Stocktake_Date AS ""Stock Take Date"",#(lf)        pi_Cost AS ""Cost"",#(lf)        pi_List_Price_Master_File AS ""List Price"",#(lf)        pi_Inventory_Cost AS ""Inventory Cost"",#(lf)        pi_Sell_Price_1_Master_File AS ""Sell Price""#(lf)    FROM#(lf)        jdis_Part_Information#(lf)    WHERE#(lf)        pi_On_Hand_Qty > 0#(lf)        #(lf)),#(lf)#(lf)InMaster_Filtered AS (#(lf)    SELECT #(lf)        PART_NO, #(lf)        user_field_3, #(lf)        STK_ORDER_PRICE,#(lf)        Branch #(lf)    FROM #(lf)        InMaster#(lf))#(lf)#(lf)SELECT #(lf)    jdis_Part_Info_Filtered.Branch,#(lf)    jdis_Part_Info_Filtered.Franchise,#(lf)    jdis_Part_Info_Filtered.""Part No"",#(lf)    jdis_Part_Info_Filtered.Description,#(lf)    jdis_Part_Info_Filtered.Bin,#(lf)    jdis_Part_Info_Filtered.""Bin Qty"",#(lf)    jdis_Part_Info_Filtered.""Bulk Bin"",#(lf)    jdis_Part_Info_Filtered.""Bulk Bin Qty"",#(lf)    jdis_Part_Info_Filtered.""On Hand Qty"",#(lf)    jdis_Part_Info_Filtered.""Pending Qty"",#(lf)    jdis_Part_Info_Filtered.""Date Last Requested"",#(lf)    jdis_Part_Info_Filtered.""Stock Take Date"",#(lf)   jdis_Part_Info_Filtered.""List Price Manuf"",#(lf)     jdis_Part_Info_Filtered.Cost,#(lf)    jdis_Part_Info_Filtered.""List Price"",#(lf)    jdis_Part_Info_Filtered.""Inventory Cost"",#(lf)    jdis_Part_Info_Filtered.""Sell Price"",#(lf)    COALESCE(InMaster_Filtered.user_field_3, '') AS user_field_3,#(lf)    COALESCE(InMaster_Filtered.STK_ORDER_PRICE, 0) AS STK_ORDER_PRICE#(lf)FROM#(lf)    jdis_Part_Info_Filtered#(lf)LEFT JOIN #(lf)    InMaster_Filtered#(lf)ON#(lf)    jdis_Part_Info_Filtered.""Part No"" = InMaster_Filtered.PART_NO#(lf)    AND jdis_Part_Info_Filtered.Branch = InMaster_Filtered.Branch;")
in
  Source