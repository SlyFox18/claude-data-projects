	measure AgingCountSlicer =
			
			SWITCH (
			    TRUE (),
			    SELECTEDVALUE ( RepairOrderDetail[Aging] ) = "1 - 7 Days",
			        CALCULATE (
			            DISTINCTCOUNT ( RepairOrderDetail[RONumber] ),
			            FILTER (
			                RepairOrderDetail,
			                RepairOrderDetail[DaysSinceLastLabor] >= 1
			                    && RepairOrderDetail[DaysSinceLastLabor] <= 7
			            )
			        ),
			    SELECTEDVALUE ( RepairOrderDetail[Aging] ) = "8 - 14 Days",
			        CALCULATE (
			            DISTINCTCOUNT ( RepairOrderDetail[RONumber] ),
			            FILTER (
			                RepairOrderDetail,
			                RepairOrderDetail[DaysSinceLastLabor] >= 8
			                    && RepairOrderDetail[DaysSinceLastLabor] <= 14
			            )
			        ),
			    SELECTEDVALUE ( RepairOrderDetail[Aging] ) = "15 - 30 Days",
			        CALCULATE (
			            DISTINCTCOUNT ( RepairOrderDetail[RONumber] ),
			            FILTER (
			                RepairOrderDetail,
			                RepairOrderDetail[DaysSinceLastLabor] >= 15
			                    && RepairOrderDetail[DaysSinceLastLabor] <= 30
			            )
			        ),
			    SELECTEDVALUE ( RepairOrderDetail[Aging] ) = "31 - 60 Days",
			        CALCULATE (
			            DISTINCTCOUNT ( RepairOrderDetail[RONumber] ),
			            FILTER (
			                RepairOrderDetail,
			                RepairOrderDetail[DaysSinceLastLabor] >= 31
			                    && RepairOrderDetail[DaysSinceLastLabor] <= 60
			            )
			        ),
			    SELECTEDVALUE ( RepairOrderDetail[Aging] ) = "60+ Days",
			        CALCULATE (
			            DISTINCTCOUNT ( RepairOrderDetail[RONumber] ),
			            FILTER (
			                RepairOrderDetail,
			                RepairOrderDetail[DaysSinceLastLabor] > 60
			                    && RepairOrderDetail[DaysSinceLastLabor] <= 45719
			            )
			        ),
			    SELECTEDVALUE ( RepairOrderDetail[Aging] ) = "Not Started",
			        CALCULATE (
			            DISTINCTCOUNT ( RepairOrderDetail[RONumber] ),
			            FILTER ( RepairOrderDetail, RepairOrderDetail[DaysSinceLastLabor] = BLANK () )
			        ),
			    BLANK ()
			)
		formatString: 0
		lineageTag: cb36976a-3c9e-46e5-8958-87a70f231c9b

	measure 'YTD 1-7 Days' =
			
