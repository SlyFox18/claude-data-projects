	measure 'Conditional Formatting Last Labor' =
			
			SWITCH (
			    TRUE (),
			    [Last Labor] >= 1
			        && [Last Labor] <= 15, 1,
			    [Last Labor] >= 16
			        && [Last Labor] <= 30, 2,
			    [Last Labor] >= 31
			        && [Last Labor] <= 45, 3,
			    [Last Labor] >= 46
			        && [Last Labor] <= 60, 4,
			    [Last Labor] >= 61
			        && [Last Labor] <= 75, 5,
			    [Last Labor] >= 76
			        && [Last Labor] <= 90, 6,
			    [Last Labor] >= 91
			        && [Last Labor] < 45719, 7,
			    BLANK ()
			)
		formatString: 0
		lineageTag: 522ed6da-192c-4159-82af-2fe38440f99a

	measure 'Last Labor' =
			
			MIN ( 'RepairOrderDetail'[DaysSinceLastLabor] )
		formatString: 0
		lineageTag: b250d794-8a4a-4905-bac4-02787dd0d3f9

	measure 'Total Sales by RONumber' =
			
			SUMX (
			    DISTINCT ( 'RepairOrderDetail'[RONumber] ),
			    CALCULATE ( SUM ( 'RepairOrderDetail'[TotalSale] ) )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a94ef6eb-62f4-4ab6-a576-4d50188f7092

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

