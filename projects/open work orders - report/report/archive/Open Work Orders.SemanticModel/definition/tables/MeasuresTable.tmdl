	measure 'Not Started' =
			
			CALCULATE (
			    DISTINCTCOUNT ( RepairOrderDetail[RONumber] ),
			    FILTER ( RepairOrderDetail, RepairOrderDetail[DaysSinceLastLabor] >= 45718 )
