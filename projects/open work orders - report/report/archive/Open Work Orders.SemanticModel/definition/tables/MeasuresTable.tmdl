	measure 'YOY 1-7 Days' =
			
			VAR __ValueCurrentPeriod = [1-7 Days]
			VAR __ValuePreviousPeriod = [PY 1-7 Days]
			VAR __Result =
			    IF (
			        NOT ISBLANK ( __ValueCurrentPeriod ) && NOT ISBLANK ( __ValuePreviousPeriod ),
			        __ValueCurrentPeriod - __ValuePreviousPeriod
			    )
			RETURN
			    __Result
		formatString: 0
		displayFolder: Time intelligence\Growth\1-7 Days
		lineageTag: 71411f6e-04e2-4383-8e3e-e243616726b5

		annotation SQLBI_Template = TimeIntelligence

