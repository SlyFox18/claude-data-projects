table MeasuresTable
	lineageTag: c24fff90-8fff-462f-9007-829e7b23af8d

	measure '1-7 Days' =
			
			CALCULATE (
			    DISTINCTCOUNT ( RepairOrderDetail[RONumber] ),
			    FILTER (
			        RepairOrderDetail,
			        RepairOrderDetail[DaysSinceCreationDate] >= 1
			            && RepairOrderDetail[DaysSinceCreationDate] <= 7
			    )
			)
		formatString: 0
		lineageTag: 0ddf2b24-6f73-4b5c-bfa7-7fc7b8885bda

	measure '8-14 Days' =
			
			CALCULATE (
			    DISTINCTCOUNT ( RepairOrderDetail[RONumber] ),
			    FILTER (
			        RepairOrderDetail,
			        RepairOrderDetail[DaysSinceCreationDate] >= 8
			            && RepairOrderDetail[DaysSinceCreationDate] <= 14
			    )
			)
		formatString: 0
		lineageTag: 1159a1c3-f127-4352-9982-92469d053a86

	measure '15-30 Days' =
			
