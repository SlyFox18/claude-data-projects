	measure ShowFilterBranch =
			
			IF (
			    ISFILTERED ( Dim_Branch[Branch] ),
			    VAR _Location =
			        VALUES ( Dim_Branch[Branch] )
			    VAR _Itemscombined =
			        CONCATENATEX ( _Location, Dim_Branch[Branch], UNICHAR ( 10 ) )
			    RETURN
			        _Itemscombined & UNICHAR ( 10 ),
			    ""
			)
		lineageTag: 5210ffd5-4b28-460e-b52a-ba83331cf714

	measure 'Total Open Repair Orders' =
			
			[1-7 Days] + [15-30 Days] + [31-60 Days] + [60+ Days] + [8-14 Days] + [Not Started]
		formatString: 0
		lineageTag: 795c4bda-2fc4-4602-b198-069774e33f60

