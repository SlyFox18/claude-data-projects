	partition DimDate = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR("2024-01-01", TODAY()),    
				    "DateInt", FORMAT([Date], "YYYYMMDD"),
				    "Year", YEAR([Date]),
				    "Monthnumber", FORMAT ([Date], "MM"),
				    "MonthNameShort", FORMAT ([Date], "mmm"),
				    "MonthNameLong", FORMAT([Date], "mmmm"),
				    "DaysOfWeekNumber", WEEKDAY([Date], 2), --Monday = 1, Sunday = 7
				    "DayOfWeek", FORMAT([Date], "dddd"),
				    "DayOfWeekShort", FORMAT([Date], "ddd"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "YearQuarter", FORMAT([Date], "YYYY") & "/Q" & FORMAT([Date], "Q"),
				    "EndOfMonth", EOMONTH([Date], 0)
				)
				```

	annotation PBI_Id = d0fba3201c5045a8bb409aab0d87bad5

