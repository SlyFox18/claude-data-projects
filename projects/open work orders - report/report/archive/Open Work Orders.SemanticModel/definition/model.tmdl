		  "templateUri": "file:///C:/Users/bfox/AppData/Local/Bravo/.temp/ManageDates/Templates/Config-01.template.json",
		  "isCurrent": false,
		  "isCustom": false,
		  "name": "Config-01",
		  "description": "Standard gregorian calendar",
		  "autoScan": 127,
		  "onlyTablesColumns": [],
		  "exceptTablesColumns": [],
		  "isoCountry": "US",
		  "autoNaming": 1,
		  "targetMeasures": [],
		  "defaults": {
		    "firstDayOfWeek": 0
		  },
		  "dateAvailable": true,
		  "dateEnabled": true,
		  "dateTableName": "Date",
