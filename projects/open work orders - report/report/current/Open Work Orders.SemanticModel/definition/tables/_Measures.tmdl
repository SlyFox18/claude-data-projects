	measure 'Work Orders by Selected Aging' =
			VAR _SelectedBucket = SELECTEDVALUE(dim_AgingBucket[AgingBucket])
			RETURN
			    IF(
			        ISBLANK(_SelectedBucket),
			        DISTINCTCOUNT(Fact_OpenWorkOrders[WorkOrder]),
			        CALCULATE(
			            DISTINCTCOUNT(Fact_OpenWorkOrders[WorkOrder]),
			            Fact_OpenWorkOrders[AgingBucket] = _SelectedBucket
			        )
			    )
		lineageTag: 50000019-0000-0000-0000-000000000019

	measure 'Sales by Selected Aging' =
			VAR _SelectedBucket = SELECTEDVALUE(dim_AgingBucket[AgingBucket])
			RETURN
