	measure 'Days Since Last Labor Color' =
			VAR _Days = MAX(Fact_OpenWorkOrders[DaysSinceLastLabor])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_Days), "#757575",
			        _Days > 14, "#D32F2F",
			        _Days > 7, "#F57C00",
			        "#388E3C"
			    )
		lineageTag: 50000022-0000-0000-0000-000000000022

	measure 'WO by Branch and Aging' = DISTINCTCOUNT(Fact_OpenWorkOrders[WorkOrder])
		lineageTag: 50000023-0000-0000-0000-000000000023

	measure 'Last Labor' = MIN(Fact_OpenWorkOrders[DaysSinceLastLabor])
		formatString: 0
		lineageTag: 0e8dd2e8-d388-4f25-88dc-b8bdadd13de2

	measure 'Conditional Formatting Last Labor' =
			
			SWITCH (
			    TRUE (),
			    [Last Labor] >= 1
			        && [Last Labor] <= 15, 1,
			    [Last Labor] >= 16
			        && [Last Labor] <= 30, 2,
			    [Last Labor] >= 31
			        && [Last Labor] <= 45, 3,
			    [Last Labor] >= 46
			        && [Last Labor] <= 60, 4,
			    [Last Labor] >= 61
			        && [Last Labor] <= 75, 5,
			    [Last Labor] >= 76
			        && [Last Labor] <= 90, 6,
			    [Last Labor] >= 91
			        && [Last Labor] < 45719, 7,
			    BLANK ()
			)
		formatString: 0
		lineageTag: c1281df8-ff21-4af1-acfb-502501ce3c8c

