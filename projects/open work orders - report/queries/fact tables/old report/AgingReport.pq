let
  Source = Odbc.Query("dsn=EquipRDB64", "select #(lf)#(lf)Branch, Repair_Order, Total_Hours, Customer_Hours, Internal_Hrs, Warranty_Hrs, Expense_Hrs, Total_Cost, Customer_Cost, #(lf)Internal_Cost, Warranty_Cost, Expense_Cost, Total_$ales, Customer_$ales, Internal_$ales, Warranty_$ales, Expense_$ales, Total_Count, #(lf)Customer_Count, Internal_Count, Warranty_Count, Expense_Count, Days_Since_Start_Date, Aging_Since_Started, #(lf)Days_Since_Last_Work, Aging_Since_Last_Work#(lf)#(lf)from (#(lf)select branch as 'Branch', ro as Repair_Order, sum(hrs_used) as 'Total_Hours', #(lf)sum(hrs_usedr) + sum(hrs_usedp) + sum(hrs_usedf) + sum(hrs_usede) + sum(hrs_usedb) as 'Customer_Hours', #(lf)sum(hrs_usedi) as 'Internal_Hrs', sum(hrs_usedw) as 'Warranty_Hrs', sum(hrs_useds) as 'Expense_Hrs',#(lf)#(lf)sum(labor_cost) as 'Total_Cost', #(lf)sum(labor_costr) + sum( labor_costp) + sum( labor_costf) + sum( labor_coste) + sum( labor_costb) as 'Customer_Cost', #(lf)sum( labor_costi) as 'Internal_Cost', sum( labor_costw) as 'Warranty_Cost', sum( labor_costs) as 'Expense_Cost', #(lf)#(lf)sum( labor_sale) as 'Total_$ales', sum( labor_saler) + sum( labor_salep) + sum( labor_salef) + sum( labor_salee) + sum( labor_saleb) as 'Customer_$ales', #(lf)sum( labor_salei) as 'Internal_$ales', sum( labor_salew)as 'Warranty_$ales', sum( labor_sales) as 'Expense_$ales', #(lf)#(lf)sum( labor_counti) as 'Total_Count', sum( labor_countp) + sum( labor_countf) + sum( labor_counte) + sum( labor_countb) as 'Customer_Count', #(lf)sum( labor_countr) as 'Internal_Count', sum( labor_countw) as 'Warranty_Count', sum( labor_counts) as 'Expense_Count'#(lf)#(lf)from (#(lf)select #(tab)branch = w.branch, #(lf)#(tab)#(tab)#(tab)ro_number = w.ro_number, #(lf)#(tab)#(tab)#(tab)cust_veh_fa = w.cust_veh_fa, #(lf)#(tab)#(tab)#(tab)reg = w.reg, #(lf)#(tab)#(tab)#(tab)stock_no = w.stock_no, #(lf)#(tab)#(tab)#(tab)driver = w.driver, #(lf)#(tab)#(tab)#(tab)salesman = w.salesman, #(lf)#(tab)#(tab)#(tab)req_datetime = w.req_datetime,#(tab)#(tab)#(tab)#(lf)#(tab)#(tab)#(tab)quote_val = sum(j.quote_val),#(lf)#(lf)#(tab)#(tab)#(tab)hrs_used = sum(j.hrs_used),#(lf)#(tab)#(tab)#(tab)hrs_usedi = sum(if j.ro_type = 'I' then j.hrs_used else 0.00 endif),   #(lf)         hrs_usedr = sum(if j.ro_type = 'R' then j.hrs_used else 0.00 endif),   #(lf)         hrs_usedw = sum(if j.ro_type = 'W' then j.hrs_used else 0.00 endif),   #(lf)         hrs_usedp = sum(if j.ro_type = 'P' then j.hrs_used else 0.00 endif),   #(lf)         hrs_usedf = sum(if j.ro_type = 'F' then j.hrs_used else 0.00 endif),   #(lf)         hrs_usede = sum(if j.ro_type = 'E' then j.hrs_used else 0.00 endif),   #(lf)         hrs_useds = sum(if j.ro_type = 'S' then j.hrs_used else 0.00 endif),   #(lf)         hrs_usedb = sum(if j.ro_type = 'B' then j.hrs_used else 0.00 endif),   #(lf)#(tab)#(lf)#(tab)#(tab)#(tab)labour_cost = sum(j.labour_cost),#(lf)#(tab)#(tab)#(tab)labour_costi = sum(if j.ro_type = 'I' then j.labour_cost else 0.00 endif),   #(lf)         labour_costr = sum(if j.ro_type = 'R' then j.labour_cost else 0.00 endif),   #(lf)         labour_costw = sum(if j.ro_type = 'W' then j.labour_cost else 0.00 endif),   #(lf)         labour_costp = sum(if j.ro_type = 'P' then j.labour_cost else 0.00 endif),   #(lf)         labour_costf = sum(if j.ro_type = 'F' then j.labour_cost else 0.00 endif),   #(lf)         labour_coste = sum(if j.ro_type = 'E' then j.labour_cost else 0.00 endif),   #(lf)         labour_costs = sum(if j.ro_type = 'S' then j.labour_cost else 0.00 endif),   #(lf)         labour_costb = sum(if j.ro_type = 'B' then j.labour_cost else 0.00 endif),   #(lf)#(lf)#(tab)#(tab)#(tab)labour_sale = sum(j.labour_sale),#(lf)#(tab)#(tab)#(tab)labour_salei = sum(if j.ro_type = 'I' then j.labour_sale else 0.00 endif),   #(lf)         labour_saler = sum(if j.ro_type = 'R' then j.labour_sale else 0.00 endif),   #(lf)         labour_salew = sum(if j.ro_type = 'W' then j.labour_sale else 0.00 endif),   #(lf)         labour_salep = sum(if j.ro_type = 'P' then j.labour_sale else 0.00 endif),   #(lf)         labour_salef = sum(if j.ro_type = 'F' then j.labour_sale else 0.00 endif),   #(lf)         labour_salee = sum(if j.ro_type = 'E' then j.labour_sale else 0.00 endif),   #(lf)         labour_sales = sum(if j.ro_type = 'S' then j.labour_sale else 0.00 endif),   #(lf)         labour_saleb = sum(if j.ro_type = 'B' then j.labour_sale else 0.00 endif),#(lf)#(lf)#(tab)#(tab)#(tab)labour_counti = sum(if j.ro_type = 'I' then 1 else 0 endif),   #(lf)         labour_countr = sum(if j.ro_type = 'R' then 1 else 0 endif),   #(lf)         labour_countw = sum(if j.ro_type = 'W' then 1 else 0 endif),   #(lf)         labour_countp = sum(if j.ro_type = 'P' then 1 else 0 endif),   #(lf)         labour_countf = sum(if j.ro_type = 'F' then 1 else 0 endif),   #(lf)         labour_counte = sum(if j.ro_type = 'E' then 1 else 0 endif),   #(lf)         labour_counts = sum(if j.ro_type = 'S' then 1 else 0 endif),   #(lf)         labour_countb = sum(if j.ro_type = 'B' then 1 else 0 endif)#(lf)#(lf)from WKROFILE w , #(lf)#(tab)( #(lf)#(tab)#(tab)select o.ro_branch, o.ro_number, o.job_code, o.type, #(lf)#(tab)#(tab)#(tab)#(tab) quote_val = IsNull(o.est_part_val, 0.00) + IsNull(o.est_sub_val, 0.00) + IsNull(o.est_lab_val, 0.00) + IsNull(o.est_oth_val, 0.00),#(lf)#(tab)#(tab)#(tab)#(tab) hrs_used = IsNull(labour.hrs_used,0.00),#(lf)#(tab)#(tab)#(tab)#(tab) labour_cost = IsNull(labour.labour_cost,0.00),#(lf)#(tab)#(tab)#(tab)#(tab) labour_sale = IsNull(labour.labour_sales,0.00)#(lf)#(tab)#(tab)from wkothsub o #(lf)#(lf)#(tab)#(tab)/* LABOUR */#(lf)#(tab)#(tab)left outer join#(lf)#(tab)#(tab)#(tab)( #(lf)#(tab)#(tab)#(tab)#(tab)select ro_branch, ro_number, job_code, job_type, sum(hours_work), sum(cost_val), sum(sell_val)#(lf)#(tab)#(tab)#(tab)#(tab)from wkmechwk#(lf)#(tab)#(tab)#(tab)#(tab)group by ro_branch, ro_number, job_code, job_type#(lf)#(tab)#(tab)#(tab)) #(lf)#(tab)#(tab)#(tab)AS labour (ro_branch, ro_number, job_code, job_type, hrs_used, labour_cost, labour_sales)#(lf)#(tab)#(tab)#(tab)ON (o.ro_branch = labour.ro_branch AND o.ro_number = labour.ro_number AND o.job_code = labour.job_code AND o.type = labour.job_type)#(lf)#(tab)#(tab)#(lf)#(tab)#(tab)where isnull(o.invoice_no,'') = '' and o.invoice_date is null#(lf)#(lf)#(tab)) #(lf)#(tab)AS j (ro_branch, ro_number, ro_job_code, ro_type, quote_val, hrs_used, labour_cost, labour_sale) #(lf)#(tab)#(lf)where ( DATE( w.req_datetime) >= NULL or NULL is null ) AND  #(lf)#(tab)#(tab)( DATE( w.req_datetime) <= NULL or NULL is null)  AND  #(lf)#(tab)#(tab)( w.branch >= NULL or NULL is null ) AND  #(lf)#(tab)#(tab)( w.branch <= NULL or NULL is null)  AND#(lf)#(tab)#(tab)(IsNUll(w.ro_status,'') <> 'I' ) AND#(lf)#(tab)#(tab)(w.branch *= j.ro_branch and w.ro_number *= j.ro_number) AND #(lf)#(tab)#(tab)(IF 'W' = 'Q' THEN 'Y' ELSE 'N' ENDIF = ISNULL(w.quotation_ind,'N'))#(lf)group by w.branch, w.ro_number, w.cust_veh_fa, w.reg, w.stock_no, w.driver, w.salesman, w.req_datetime#(lf)order by w.ro_number#(lf)) as temp1(branch, ro, customer_veh_fa, reg, stock_no, driver, salesman, req_date, quote_val, #(lf)hrs_used, hrs_usedi, hrs_usedr, hrs_usedw, hrs_usedp, hrs_usedf, hrs_usede, hrs_useds, hrs_usedb, #(lf)labor_cost, labor_costi,labor_costr, labor_costw, labor_costp, labor_costf, labor_coste, labor_costs, labor_costb, #(lf)labor_sale, labor_salei, labor_saler, labor_salew, labor_salep, labor_salef, labor_salee, labor_sales, labor_saleb, #(lf)labor_counti, labor_countr, labor_countw, labor_countp, labor_countf, labor_counte, labor_counts, labor_countb)#(lf)group by branch, Repair_Order#(lf))#(lf)as temp2(Branch, Repair_Order, Total_Hours, Customer_Hours, Internal_Hrs, Warranty_Hrs, Expense_Hrs, Total_Cost, Customer_Cost, #(lf)Internal_Cost, Warranty_Cost, Expense_Cost, Total_$ales, Customer_$ales, Internal_$ales, Warranty_$ales, Expense_$ales, Total_Count, #(lf)Customer_Count, Internal_Count, Warranty_Count, Expense_Count)#(lf)inner join #(lf)(#(lf)SELECT wkmechwk.ro_number as 'ROage', #(lf)datediff(day, min(date(start_time)), getdate()) as 'Days_Since_Start_Date', #(lf)#(tab)if datediff(day, min(date(start_time)), getdate())  between 0 and 7 then ' 0-7 days' else #(lf)#(tab)if datediff(day, min(date(start_time)), getdate())   between 8 and 30 then ' 8-30 days' else#(lf)#(tab)if datediff(day, min(date(start_time)), getdate())   between 31 and 60 then '31-60 days' else#(lf)#(tab)if datediff(day, min(date(start_time)), getdate())   between 61 and 90 then '61-90 days' else '90+ days' endif endif endif endif#(lf) as 'Aging_Since_Started',#(lf)datediff(day, max(date(finish_time)), getdate()) as 'Days_Since_Last_Work', #(lf)#(tab)if datediff(day, max(date(finish_time)), getdate())  between 0 and 7 then ' 0-7 days' else #(lf)#(tab)if datediff(day, max(date(finish_time)), getdate())   between 8 and 30 then ' 8-30 days' else#(lf)#(tab)if datediff(day, max(date(finish_time)), getdate())   between 31 and 60 then '31-60 days' else#(lf)#(tab)if datediff(day, max(date(finish_time)), getdate())   between 61 and 90 then '61-90 days' else '90+ days' endif endif endif endif#(lf) as 'Aging_Since_Last_Work'#(lf)FROM wkmechwk inner join WKROFILE w on wkmechwk.ro_number = w.ro_number#(lf)where IsNull(w.ro_status,'') <> 'I'#(lf)GROUP BY wkmechwk.ro_number#(lf)ORDER BY wkmechwk.ro_number#(lf)) as temp3(ROage, Days_Since_Start_Date, Aging_Since_Started, Days_Since_Last_Work, Aging_Since_Last_Work)#(lf)on Repair_Order = temp3.roage#(lf)order by branch, Repair_Order#(lf);")
in
  Source