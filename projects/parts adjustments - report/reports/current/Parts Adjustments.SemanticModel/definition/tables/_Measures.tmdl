	measure 'Adjustment Qty to Inventory Qty' =
			
			DIVIDE([Total Qty (R12)], [On Hand Qty], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b2e06eab-4c10-42ca-8ba6-7525fdb9d55d

	measure 'Adjustment Lines to Inventory Lines' =
			
