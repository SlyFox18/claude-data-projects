	measure 'Exact Pair Adj $ (12Mo)' =
			
			VAR _MaxDate = MAX(Fact_PartsAdjustments[TransDatetime])
			VAR _Ids =
			    CALCULATETABLE(
			        DISTINCT(Fact_AdjustmentPairs[NegTransId]),
			        Fact_AdjustmentPairs[IsExact] = TRUE,
			        Fact_AdjustmentPairs[IsWithin12Mo] = TRUE
			    )
			RETURN
			CALCULATE(
			    SUM(Fact_PartsAdjustments[AbsCost]),
			    DATESINPERIOD(dim_DateTable[Date], _MaxDate, -12, MONTH),
			    TREATAS(_Ids, Fact_PartsAdjustments[TransId])
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567807

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Similar Pair Adj $ (12Mo)' =
			
			VAR _MaxDate = MAX(Fact_PartsAdjustments[TransDatetime])
			VAR _Ids =
			    CALCULATETABLE(
			        DISTINCT(Fact_AdjustmentPairs[NegTransId]),
			        Fact_AdjustmentPairs[IsExact] = FALSE,
			        Fact_AdjustmentPairs[IsWithin12Mo] = TRUE
			    )
			RETURN
			CALCULATE(
			    SUM(Fact_PartsAdjustments[AbsCost]),
			    DATESINPERIOD(dim_DateTable[Date], _MaxDate, -12, MONTH),
			    TREATAS(_Ids, Fact_PartsAdjustments[TransId])
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567808

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

