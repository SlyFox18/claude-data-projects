	measure 'PA Type % of Total' = ```
			
			VAR SelectedMetric = [_SelectedMetric]
			
			// Current PA Type total (in filter context)
			VAR CurrentTotal = [_DynamicTotal]
			
			// Grand total - remove filter from the TYPE column in fact table
			VAR GrandTotal = 
			    CALCULATE(
			        [_DynamicTotal],
			        ALL(Fact_PartsAdjustments[PAType])  // ← Replace with actual column name
			    )
			
			RETURN DIVIDE(CurrentTotal, GrandTotal, 0)
