				    "Pct",   "0.0%",
				    "Count", "#,0",
				    "Cost",  "$#,0",
				    "0.0%"
				)

	measure _MatchViewFormat =
			SWITCH(
			    [_MatchViewSelected],
			    "Pct",   "0.0%",
			    "Count", "#,0",
			    "Cost",  "$#,0",
			    "0.0%"
			)
		lineageTag: b2c3d4e5-f6a7-8901-bcde-f12345678927

	measure 'Pairs - No Match Cost (12Mo)' =
			CALCULATE(
			    SUM(Fact_AdjPairs_Summary[NegAbsCost]),
			    Fact_AdjPairs_Summary[MatchType_12Mo] = "No Match"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b2c3d4e5-f6a7-8901-bcde-f12345678928

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% Neg Txns Exact (24Mo)' = DIVIDE([Pairs - Exact Count (24Mo)], [Pairs - Neg Txns Total], 0)
