	measure 'Page 1 - Hero Card' =
			
			VAR TotalAdjustments = [Total Adjustments $ (R12)]
			VAR TotalInventory = [Total Inventory $]
			VAR PctDollars = [Adjustment $ to Inventory $]
			
			VAR TotalQty = [Total Qty (R12)]
			VAR OnHandQty = [On Hand Qty]
			VAR PctQty = [Adjustment Qty to Inventory Qty]
			
			VAR TotalLines = [Total Adjustment Lines (R12)]
			VAR TotalParts = [Total Parts]
			VAR PctLines = [Adjustment Lines to Inventory Lines]
			
			VAR PctExact12 = [% Neg Txns Exact (12Mo)]
			VAR PctExact24 = [% Neg Txns Exact (24Mo)]
			VAR PctSimilar12 = [% Neg Txns Similar (12Mo)]
			VAR PctSimilar24 = [% Neg Txns Similar (24Mo)]
			
			// Number formatting for display
			VAR AdjText = "$" & FORMAT(TotalAdjustments, "#,##0")
			
			VAR InvText =
			    IF(TotalInventory >= 1000000,
			        "$" & FORMAT(TotalInventory/1000000, "#,##0.0") & "M",
			        "$" & FORMAT(TotalInventory/1000, "#,##0") & "K"
			    )
			VAR QtyText = FORMAT(TotalQty, "#,##0")
			
			VAR OnHandText =
			    IF(OnHandQty >= 1000000,
			        FORMAT(OnHandQty/1000000, "#,##0.0") & "M",
			        FORMAT(OnHandQty/1000, "#,##0") & "K"
			    )
			VAR LinesText = FORMAT(TotalLines, "#,##0")
			
			VAR PartsText =
			    IF(TotalParts >= 1000000,
			        FORMAT(TotalParts/1000000, "#,##0.0") & "M",
			        FORMAT(TotalParts/1000, "#,##0") & "K"
			    )
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 25px 30px 20px 30px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    box-shadow: 0 8px 24px rgba(0,0,0,0);
			    color: white;
			    min-height: 160px;
			'>
			    <!-- Main Metrics Row -->
			    <div style='display: flex; justify-content: space-around; align-items: center; gap: 20px;'>
			
			        <!-- Section 1: Total Adjustments $ -->
			        <div style='flex: 1; text-align: center;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                Total Adjustments $ (R12)
			            </div>
			            <div style='font-size: 42px; font-weight: 700; line-height: 1; margin-bottom: 6px;'>
			                " & AdjText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75;'>
			                Total Inventory $: " & InvText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75; margin-top: 4px;'>
			                Adjustment $ to Inventory $: " & FORMAT(PctDollars, "0.0%") & "
			            </div>
			        </div>
			
			        <!-- Section 2: Total Qty -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                Total Qty (R12)
			            </div>
			            <div style='font-size: 42px; font-weight: 700; line-height: 1; margin-bottom: 6px;'>
			                " & QtyText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75;'>
			                On Hand Qty: " & OnHandText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75; margin-top: 4px;'>
			                Adjustment Qty to Inventory Qty: " & FORMAT(PctQty, "0.0%") & "
			            </div>
			        </div>
			
			        <!-- Section 3: Total Lines -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                Total Adjustment Lines (R12)
			            </div>
			            <div style='font-size: 42px; font-weight: 700; line-height: 1; margin-bottom: 6px;'>
			                " & LinesText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75;'>
			                Total Parts: " & PartsText & "
			            </div>
			            <div style='font-size: 18px; opacity: 0.75; margin-top: 4px;'>
			                Adjustment Lines to Inventory Lines: " & FORMAT(PctLines, "0.0%") & "
			            </div>
			        </div>
			    </div>
			    <!-- Pair Match Footer -->
			    <div style='margin-top: 16px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.2); display: flex; justify-content: center; gap: 40px; font-size: 15px; opacity: 0.85;'>
			        <span><strong>Exact Match:</strong> " & FORMAT(PctExact12, "0.0%") & " (12Mo) &nbsp;|&nbsp; " & FORMAT(PctExact24, "0.0%") & " (24Mo)</span>
			        <span style='border-left: 1px solid rgba(255,255,255,0.3); padding-left: 40px;'><strong>Similar Match:</strong> " & FORMAT(PctSimilar12, "0.0%") & " (12Mo) &nbsp;|&nbsp; " & FORMAT(PctSimilar24, "0.0%") & " (24Mo)</span>
			    </div>
			</div>"
		lineageTag: eccb5f17-1341-463a-8b29-b038fca98060

