	measure 'Pairs - Total Neg Cost' = SUM(Fact_AdjPairs_Summary[NegAbsCost])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b2c3d4e5-f6a7-8901-bcde-f12345678921

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Duplicates - Hero Card' =
			
			VAR TotalAnalyzed = [Pairs - Neg Txns Total]
			VAR PairedCount12 = [Pairs - Paired Count (12Mo)]
			VAR PairedCount24 = [Pairs - Paired Count (24Mo)]
			VAR ExactCount12 = [Pairs - Exact Count (12Mo)]
			VAR ExactCount24 = [Pairs - Exact Count (24Mo)]
			VAR SimilarCount12 = [Pairs - Similar Count (12Mo)]
			VAR SimilarCount24 = [Pairs - Similar Count (24Mo)]
			VAR ExactCost12 = [Pairs - Exact Cost (12Mo)]
			VAR ExactCost24 = [Pairs - Exact Cost (24Mo)]
			VAR SimilarCost12 = [Pairs - Similar Cost (12Mo)]
			VAR SimilarCost24 = [Pairs - Similar Cost (24Mo)]
			VAR TotalNegCost = [Pairs - Total Neg Cost]
			VAR PctExact12 = [% Adj Cost Exact (12Mo)]
			VAR PctSimilar12 = [% Adj Cost Similar (12Mo)]
			VAR PctPairedTxns12 = [% Neg Txns Paired (12Mo)]
			
			VAR TotalCostText =
			    IF(TotalNegCost >= 1000000,
			        "$" & FORMAT(TotalNegCost / 1000000, "#,##0.0") & "M",
			        "$" & FORMAT(TotalNegCost / 1000, "#,##0") & "K"
			    )
			VAR ExactCost12Text =
			    IF(ExactCost12 >= 1000000,
			        "$" & FORMAT(ExactCost12 / 1000000, "#,##0.0") & "M",
			        "$" & FORMAT(ExactCost12 / 1000, "#,##0") & "K"
			    )
			VAR ExactCost24Text =
			    IF(ExactCost24 >= 1000000,
			        "$" & FORMAT(ExactCost24 / 1000000, "#,##0.0") & "M",
			        "$" & FORMAT(ExactCost24 / 1000, "#,##0") & "K"
			    )
			VAR SimilarCost12Text =
			    IF(SimilarCost12 >= 1000000,
			        "$" & FORMAT(SimilarCost12 / 1000000, "#,##0.0") & "M",
			        "$" & FORMAT(SimilarCost12 / 1000, "#,##0") & "K"
			    )
			VAR SimilarCost24Text =
			    IF(SimilarCost24 >= 1000000,
			        "$" & FORMAT(SimilarCost24 / 1000000, "#,##0.0") & "M",
			        "$" & FORMAT(SimilarCost24 / 1000, "#,##0") & "K"
			    )
			
			RETURN
			"<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 25px 30px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    box-shadow: 0 8px 24px rgba(0,0,0,0);
			    color: white;
			    min-height: 160px;
			'>
			    <div style='display: flex; justify-content: space-around; align-items: flex-start; gap: 20px; padding-top: 10px;'>
			
			        <!-- Section 1: Adjustments Analyzed -->
			        <div style='flex: 1; text-align: center;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                Adjustments Analyzed
			            </div>
			            <div style='font-size: 42px; font-weight: 700; line-height: 1; margin-bottom: 4px;'>
			                " & FORMAT(TotalAnalyzed, "#,##0") & "
			            </div>
			            <div style='font-size: 15px; opacity: 0.55; letter-spacing: 1px; margin-bottom: 6px;'>
			                LAST 24 MONTHS
			            </div>
			            <div style='font-size: 18px; opacity: 0.75;'>
			                Total Cost: " & TotalCostText & "
			            </div>
			            <div style='margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.15);'>
			                <div style='font-size: 18px; opacity: 0.75; margin-bottom: 4px;'>
			                    With a Match (12 Mo): " & FORMAT(PairedCount12, "#,##0") & " (" & FORMAT(PctPairedTxns12, "0.0%") & ")
			                </div>
			                <div style='font-size: 18px; opacity: 0.75;'>
			                    With a Match (24 Mo): " & FORMAT(PairedCount24, "#,##0") & "
			                </div>
			            </div>
			        </div>
			
			        <!-- Section 2: Exact Matches -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                Exact Matches
			            </div>
			            <div style='font-size: 42px; font-weight: 700; line-height: 1; margin-bottom: 4px;'>
			                " & FORMAT(ExactCount12, "#,##0") & "
			            </div>
			            <div style='font-size: 15px; opacity: 0.55; letter-spacing: 1px; margin-bottom: 6px;'>
			                12 MONTHS
			            </div>
			            <div style='font-size: 18px; opacity: 0.75;'>
			                Cost: " & ExactCost12Text & " (" & FORMAT(PctExact12, "0.0%") & " of total)
			            </div>
			            <div style='margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.15);'>
			                <div style='font-size: 28px; font-weight: 600; line-height: 1; margin-bottom: 4px;'>
			                    " & FORMAT(ExactCount24, "#,##0") & "
			                </div>
			                <div style='font-size: 15px; opacity: 0.55; letter-spacing: 1px; margin-bottom: 4px;'>
			                    24 MONTHS
			                </div>
			                <div style='font-size: 18px; opacity: 0.75;'>
			                    Cost: " & ExactCost24Text & "
			                </div>
			            </div>
			        </div>
			
			        <!-- Section 3: Similar Matches -->
			        <div style='flex: 1; text-align: center; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 20px;'>
			            <div style='font-size: 18px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin-bottom: 8px;'>
			                Similar Matches
			            </div>
			            <div style='font-size: 42px; font-weight: 700; line-height: 1; margin-bottom: 4px;'>
			                " & FORMAT(SimilarCount12, "#,##0") & "
			            </div>
			            <div style='font-size: 15px; opacity: 0.55; letter-spacing: 1px; margin-bottom: 6px;'>
			                12 MONTHS
			            </div>
			            <div style='font-size: 18px; opacity: 0.75;'>
			                Cost: " & SimilarCost12Text & " (" & FORMAT(PctSimilar12, "0.0%") & " of total)
			            </div>
			            <div style='margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.15);'>
			                <div style='font-size: 28px; font-weight: 600; line-height: 1; margin-bottom: 4px;'>
			                    " & FORMAT(SimilarCount24, "#,##0") & "
			                </div>
			                <div style='font-size: 15px; opacity: 0.55; letter-spacing: 1px; margin-bottom: 4px;'>
			                    24 MONTHS
			                </div>
			                <div style='font-size: 18px; opacity: 0.75;'>
			                    Cost: " & SimilarCost24Text & "
			                </div>
			            </div>
			        </div>
			
			    </div>
			</div>"
		lineageTag: c3d4e5f6-a7b8-9012-cdef-123456789021

	measure '% Neg Txns No Match (12Mo)' = DIVIDE([Pairs - No Match Count (12Mo)], [Pairs - Neg Txns Total], 0)
		formatString: 0.0%;-0.0%;0.0%
