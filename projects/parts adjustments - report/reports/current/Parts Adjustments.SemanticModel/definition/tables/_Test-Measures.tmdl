	measure 'TEST - Sum of All PA Types' =
			
			VAR StockCheck = CALCULATE([_DynamicTotal], dim_AdjustmentType[AdjustmentTypeName] = "Stock Check")
			VAR CountOff = CALCULATE([_DynamicTotal], dim_AdjustmentType[AdjustmentTypeName] = "Count Off")
			VAR CustomerBIN = CALCULATE([_DynamicTotal], dim_AdjustmentType[AdjustmentTypeName] = "Customer BIN")
			VAR Overage = CALCULATE([_DynamicTotal], dim_AdjustmentType[AdjustmentTypeName] = "Overage")
			VAR Damaged = CALCULATE([_DynamicTotal], dim_AdjustmentType[AdjustmentTypeName] = "Damaged")
			VAR Lost = CALCULATE([_DynamicTotal], dim_AdjustmentType[AdjustmentTypeName] = "Lost")
			VAR AllTypesSum = StockCheck + CountOff + CustomerBIN + Overage + Damaged + Lost
			VAR GrandTotal = [_DynamicTotal]
			VAR Difference = GrandTotal - AllTypesSum
			RETURN
			"All Types Sum: " & FORMAT(AllTypesSum, "$#,##0") & UNICHAR(10) &
			"Grand Total: " & FORMAT(GrandTotal, "$#,##0") & UNICHAR(10) &
			"Difference: " & FORMAT(Difference, "$#,##0") & UNICHAR(10) &
			"% Missing: " & FORMAT(DIVIDE(Difference, GrandTotal, 0), "0.0%")
		lineageTag: 97e4d15b-d670-4777-bbdf-e7b20136682b

	measure 'DEBUG - PA Type %' = ```
			
			VAR CurrentTypeTotal = [_DynamicTotal]
			
			VAR GrandTotal = 
			    CALCULATE(
			        [_DynamicTotal],
			        REMOVEFILTERS(dim_AdjustmentType)
			    )
			
			RETURN 
			"Current: " & FORMAT(CurrentTypeTotal, "#,##0") & 
			" | Grand: " & FORMAT(GrandTotal, "#,##0") & 
			" | Pct: " & FORMAT(DIVIDE(CurrentTypeTotal, GrandTotal, 0), "0.0%")
			```
		lineageTag: e25c8c18-f3c9-4c4b-a8f2-5579d86a919d

