			    )
			)
		formatString: 0
		lineageTag: bb0aa4e4-5a9f-4cec-9392-9f31157d2e9d

	measure 'Adjust Qty / Inv Qty (Net) (R12)' = [Adjustment Qty (Net) (R12)] / [On Hand Qty]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 72c6d528-3be0-4998-81ea-11d407e43788

	measure 'Adjust Lines / Inv Lines (Net) (R12)' = [Adjustment Lines (Net) (R12)] / [Total Parts]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9e4851a1-326c-45d4-b4c4-cd85ec032365

	measure 'TotalQty PartNo' =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[QTY]),
			    DATESINPERIOD('InTrans_Parts_Adjust'[Trans_Date], MAX('InTrans_Parts_Adjust'[Trans_Date]), -12, MONTH)
			)
		lineageTag: 21de20e7-7e38-4b27-8881-c44e65950d15

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ExactDuplicates =
			
			FILTER(
			    VALUES('InTrans_Parts_Adjust'[Part_No]),
			    CALCULATE(SUM('InTrans_Parts_Adjust'[QTY])) = 0 &&
			    CALCULATE(SUM('InTrans_Parts_Adjust'[Qty (out)])) < 0 &&
			    CALCULATE(SUM('InTrans_Parts_Adjust'[Qty (in)])) > 0
			)
		lineageTag: 49883d87-e29a-46eb-91b9-d97480499ae2

	measure NetQtyLast12Months =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[QTY]),
			    DATESINPERIOD('InTrans_Parts_Adjust'[Trans_Date], MAX('InTrans_Parts_Adjust'[Trans_Date]), -12, MONTH)
			)
		formatString: 0
		lineageTag: 63e9075d-f56a-4beb-8418-712824ee99ed

	measure FilteredParts =
			
			FILTER(
			    VALUES('InTrans_Parts_Adjust'[Part_No]),
			    [NetQtyLast12Months] = 0
			)
		lineageTag: 6b845a14-956c-4b03-865f-fb64b3d9da24

