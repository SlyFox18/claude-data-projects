			    'InTrans_Parts_Adjust'[QTY] < 0
			)
		lineageTag: 7e5b6703-05bd-48a3-9ca0-05dab0c3f58d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Positive Qty (R12)' =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[QTY]),
			    'InTrans_Parts_Adjust'[QTY] > 0,
			    DATESINPERIOD(
			        'InTrans_Parts_Adjust'[Trans_Date],
			        MAX('InTrans_Parts_Adjust'[Trans_Date]),
