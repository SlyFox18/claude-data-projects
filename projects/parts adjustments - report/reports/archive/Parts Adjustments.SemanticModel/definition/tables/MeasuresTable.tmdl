		lineageTag: 1f3817ef-9104-4259-ab84-5d4f24356b6e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Parts' = COUNT('jdis___Parts_Adjust'[Part_No])
		formatString: 0
		lineageTag: bee9921f-9cdd-4c7a-86f4-6b16c97f8e3c

	measure 'Total Cost' = SUM('jdis___Parts_Adjust'[Cost])
		lineageTag: 5e96a189-bfaf-4a37-8931-4c3751b3904c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Adjustment Lines' = COUNTROWS(InTrans_Parts_Adjust)
		formatString: 0
