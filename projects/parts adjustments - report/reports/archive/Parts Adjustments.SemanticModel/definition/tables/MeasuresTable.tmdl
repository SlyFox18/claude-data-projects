			)
		formatString: 0
		lineageTag: bc94c1d8-5daa-4d2b-95fc-7ee8b8e7b44c

	measure 'Negative Adjustment Lines' =
			
			CALCULATE(
			    -1 * COUNTROWS(InTrans_Parts_Adjust),
			    InTrans_Parts_Adjust[Qty] <= 0
			)
		formatString: 0
		lineageTag: 50d8e5a0-097e-41c4-a201-127e9612ca85

	measure 'Adjustment Lines (Net) (R12)' = [Negative Adjustment Lines (R12)] + [Positive Adjustment Lines (R12)]
		formatString: 0
		lineageTag: f3628cba-3d1b-4232-b6a6-104f544ac9a4

	measure 'Adjustment $ (Net) (R12)' =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[Cost]),
			    DATESINPERIOD(
			        'InTrans_Parts_Adjust'[Trans_Date],
			        LASTDATE('InTrans_Parts_Adjust'[Trans_Date]),
			        -12,
			        MONTH
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a72e578b-525b-4ae0-a45d-29beef335502

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Adjust $ / Inv $ (Net) (R12)' = [Adjustment $ (Net) (R12)] / [Total Inventory $]
