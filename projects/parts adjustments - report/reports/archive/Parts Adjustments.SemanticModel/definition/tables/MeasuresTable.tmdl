	measure 'Total Inventory $' = SUM('jdis___Parts_Adjust'[In_Stock_Cost])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 90fce06d-2fbb-4889-bc83-35909cd3e369

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Adjustment $ to Inventory $' = DIVIDE([Total Adjustments $ (R12)] , [Total Inventory $], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 880b283e-0f14-4aca-9ddc-7dabdc631608

	measure 'Adjustment Lines to Inventory Lines' = DIVIDE([Total Adjustment Lines (R12)], [Total Parts], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 247f86f4-2cc8-4344-945f-879410aa831c

	measure 'Adjustment Qty to Inventory Qty' = DIVIDE([Total Qty (R12)] , [On Hand Qty], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f1c2eb89-80b3-4ac0-a588-b29e3c6ff28b

	measure 'Negative Adjustment $' =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[Cost]),
			    'InTrans_Parts_Adjust'[Cost] < 0
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 122049dd-bd50-491f-af24-b18ea02e69f9

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Positive Adjustment $' =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[Cost]),
			    'InTrans_Parts_Adjust'[Cost] > 0
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 287a4031-3af5-4959-bc9c-763180b976df

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Cost Percentage' =
			
			DIVIDE(
			    [Adjustment $ (Net)],
			    CALCULATE([Adjustment $ (Net)], ALLSELECTED(GlTrans___Parts_Adjust)),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 49ef1ca0-04ec-403b-b632-b981bf76ea09

	measure 'PA Type Adjustment $' =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[Cost]),
			    ALLEXCEPT('GlTrans___Parts_Adjust', 'GlTrans___Parts_Adjust'[PA Type])
			)
		lineageTag: 4273097b-dd5b-495f-b074-4725084f210d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Cost $' = SUM('InTrans_Parts_Adjust'[Cost])
		lineageTag: 3ec0e0c8-439a-4ac0-9c25-587d66acd13d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PA Type Percentage' =
			
			DIVIDE(
			    [PA Type Adjustment $],
			    [Total Cost $],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d1b9ccac-94cf-4348-83fb-d79f14c7dd13

	measure 'Absolute Adjustment $' = SUMX('InTrans_Parts_Adjust', ABS('InTrans_Parts_Adjust'[Cost]))
		lineageTag: 5186174b-1388-48b9-948f-f5e921c73b58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Absolute Adjustment $' =
			
			CALCULATE(
			    [Absolute Adjustment $],
			    ALLSELECTED('GlTrans___Parts_Adjust')
			)
		lineageTag: e551aeb6-4565-423b-ab81-c483dc227e5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cost Percentage 1' =
			
			DIVIDE(
			    [Absolute Adjustment $],
			    [Total Absolute Adjustment $],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: abde9a4f-0d10-42db-9af3-1720c199cf1e

	measure 'On Hand Qty' = SUM('jdis___Parts_Adjust'[On_Hand_Qty])
		lineageTag: 75650984-2c96-4c65-b8a0-1635eb289e63

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Adjustments $' =
			
			[Positive Adjustment $] + ABS([Negative Adjustment $])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e7e1bdc5-a7fc-4fb6-8b1a-cb6a0c5a07d4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Positive Adjustment $ (R12)' =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[Cost]),
			    'InTrans_Parts_Adjust'[Cost] > 0,
			    DATESINPERIOD(
			        'InTrans_Parts_Adjust'[Trans_Date],
			        MAX('InTrans_Parts_Adjust'[Trans_Date]),
			        -12,
			        MONTH
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 4fd4859b-de79-46e9-b857-8497b6347b6a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Negative Adjustment $ (R12)' =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[Cost]),
			    'InTrans_Parts_Adjust'[Cost] < 0,
			    DATESINPERIOD(
			        'InTrans_Parts_Adjust'[Trans_Date],
			        MAX('InTrans_Parts_Adjust'[Trans_Date]),
			        -12,
			        MONTH
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 20ac3d0c-cc53-4504-b08a-ef9229c0cbd3

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Adjustments $ (R12)' =
			
			[Positive Adjustment $ (R12)] + ABS([Negative Adjustment $ (R12)])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: dc480ebc-6aaa-4a06-afa7-85f56e8b6c5d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Selected Measure' =
			
			SWITCH(
			    SELECTEDVALUE(MeasureSelector[MeasureIndex]),
			    0, [Adjustment $ to Inventory $],
			    1, [Adjustment Qty to Inventory Qty],
			    2, [Adjustment Lines to Inventory Lines],
			    BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f3ef3dd3-a8a0-4187-8771-46ada4b4e3c6

	measure 'Combined Adjustments $ (R12)' =
			
			[Positive Adjustment $ (R12)] + ABS([Negative Adjustment $ (R12)])
		lineageTag: 41bd945e-51d5-4d1c-909f-152b4fbfdd22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Adjustment $ (R12)' =
			
			SWITCH(
			    SELECTEDVALUE(AdjustmentTypes[AdjustmentType]),
			    "Positive Adjustment $ (R12)", [Positive Adjustment $ (R12)],
			    "Negative Adjustment $ (R12)", [Negative Adjustment $ (R12)],
			    BLANK()
			)
		lineageTag: c911e7c3-0260-4d80-95b7-2aec1bbb2704

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Positive Qty' =
			
			CALCULATE(
