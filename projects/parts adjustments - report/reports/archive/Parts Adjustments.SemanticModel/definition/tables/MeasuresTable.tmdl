		lineageTag: 9a32321f-9502-4227-9442-f4f89fbaf694

	measure 'Adjustment Qty (Net) (R12)' =
			
			CALCULATE(
			    SUM('InTrans_Parts_Adjust'[QTY]),
			    DATESINPERIOD(
			        'InTrans_Parts_Adjust'[Trans_Date],
			        LASTDATE('InTrans_Parts_Adjust'[Trans_Date]),
			        -12,
