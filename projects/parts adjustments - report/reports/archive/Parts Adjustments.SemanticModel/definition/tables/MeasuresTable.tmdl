	measure 'Total Qty (R12)' =
			
			[Positive Qty (R12)] + ABS([Negative Qty (R12)])
		formatString: 0
		lineageTag: c2e968d7-f9b2-4191-98be-5afc4a213e97

	measure 'Total Adjustment Lines (R12)' =
			
			CALCULATE(
			    COUNTROWS(InTrans_Parts_Adjust),
			    DATESINPERIOD(
			        InTrans_Parts_Adjust[Trans_Date],
			        LASTDATE(InTrans_Parts_Adjust[Trans_Date]),
			        -12,
			        MONTH
			    ),
			    InTrans_Parts_Adjust[Qty] <> 0
			)
		formatString: 0
		lineageTag: 5f6bb6cc-3a59-4031-8aec-733fee8c0325

	measure 'Negative Adjustment Lines (R12)' =
			
			CALCULATE(
			    -1 * COUNTROWS(InTrans_Parts_Adjust),
			    DATESINPERIOD(
			        InTrans_Parts_Adjust[Trans_Date],
			        LASTDATE(InTrans_Parts_Adjust[Trans_Date]),
			        -12,
			        MONTH
			    ),
			    InTrans_Parts_Adjust[Qty] < 0
			)
		formatString: 0
		lineageTag: ff2edfef-e2a3-4b45-8c8a-03c3305961e0

	measure 'Positive Adjustment Lines (R12)' =
			
			CALCULATE(
			    COUNTROWS(InTrans_Parts_Adjust),
			    DATESINPERIOD(
			        InTrans_Parts_Adjust[Trans_Date],
			        LASTDATE(InTrans_Parts_Adjust[Trans_Date]),
			        -12,
			        MONTH
			    ),
			    InTrans_Parts_Adjust[Qty] > 0
			)
		formatString: 0
		lineageTag: 5ee79e4d-52f9-4a29-81f7-2d0fba1fc78f

	measure 'Adjustment $ to Inventory $  (Net)' = [Adjustment $ (Net)] / [Total Inventory $]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 65563ad3-082c-4f1e-a8b9-552da4ae8463

	measure 'Adjustment Qty to Inventory Qty (Net)' = [Adjustment Qty (Net)] / [On Hand Qty]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b5fe15c9-046d-4660-a796-091ff219fbf2

	measure 'Positive Adjustment Lines' =
			
			CALCULATE(
			    COUNTROWS(InTrans_Parts_Adjust),
