			            'Fact_Part_Transactions'[SaleAmount] > 0,
			            ALL(Price_Matrix)  // Remove any Price_Matrix filters to get true total
			        )
			    RETURN
			    DIVIDE(RangeTransactionCount, TotalTransactionCount),
			    
			    // Total row - show 100%
			    1.00
