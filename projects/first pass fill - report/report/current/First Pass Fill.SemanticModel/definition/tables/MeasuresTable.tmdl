	measure 'Best Performing Area' = ```
			
			VAR CounterPct = [R12-Counter]
			VAR ShopPct = [R12-Shop] 
			VAR TotalPct = [R12-Total]
			VAR BestValue = MAX(MAX(CounterPct, ShopPct), TotalPct)
			RETURN
			SWITCH(
			    TRUE(),
			    CounterPct = BestValue, "COUNTER • " & FORMAT(CounterPct, "0.0%"),
			    ShopPct = BestValue, "SHOP • " & FORMAT(ShopPct, "0.0%"),
			    "TOTAL • " & FORMAT(TotalPct, "0.0%")
			)
			```
		lineageTag: da05404b-74af-40f5-b472-724277da2a12

	measure 'Biggest Improvement' =
			
			VAR CounterImprove = [R12 Counter % vs PY Change]
			VAR ShopImprove = [R12 Shop % vs PY Change]
			VAR TotalImprove = [R12 Total % vs PY Change]
			VAR BestImprovement = MAX(MAX(CounterImprove, ShopImprove), TotalImprove)
			RETURN
			SWITCH(
			    TRUE(),
			    CounterImprove = BestImprovement, "COUNTER +" & FORMAT(BestImprovement, "0.0%"),
			    ShopImprove = BestImprovement, "SHOP +" & FORMAT(BestImprovement, "0.0%"),
			    "TOTAL +" & FORMAT(BestImprovement, "0.0%")
			)
		lineageTag: 2e36e813-9878-4873-a4f0-909ee96453eb

	measure 'Needs Attention' =
			
			VAR CounterPct = [R12-Counter]
			VAR ShopPct = [R12-Shop]
			VAR TotalPct = [R12-Total]
			VAR LowestValue = MIN(MIN(CounterPct, ShopPct), TotalPct)
			RETURN
			SWITCH(
			    TRUE(),
			    CounterPct = LowestValue, "COUNTER • " & FORMAT(CounterPct, "0.0%"),
			    ShopPct = LowestValue, "SHOP • " & FORMAT(ShopPct, "0.0%"),
			    "TOTAL • " & FORMAT(TotalPct, "0.0%")
			)
		lineageTag: 91258684-0169-48f3-9bf0-3029c34dfd6f

