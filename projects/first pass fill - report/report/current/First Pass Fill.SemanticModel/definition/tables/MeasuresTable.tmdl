	measure '02. Counter % YTD' =
			
			CALCULATE(
			    [01. Counter %],
			    dim_DateTable[IsYearToDate] = TRUE
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 545a9fd7-a66f-46d8-a68a-00b76641b350

	measure 'Counter % Same Period LY' =
			
			VAR SelectedDates = VALUES(dim_DateTable[Date])
			VAR MinDate = MINX(SelectedDates, dim_DateTable[Date])
			VAR MaxDate = MAXX(SelectedDates, dim_DateTable[Date])
			VAR PYStartDate = DATE(YEAR(MinDate) - 1, MONTH(MinDate), DAY(MinDate))
			VAR PYEndDate = DATE(YEAR(MaxDate) - 1, MONTH(MaxDate), DAY(MaxDate))
			RETURN
			CALCULATE(
			    [01. Counter %],
			    dim_DateTable[Date] >= PYStartDate && dim_DateTable[Date] <= PYEndDate,
			    ALL(dim_DateTable[Date])  // Remove existing date filter
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 00d63e1e-3c46-47cc-9fd6-0b82e889ebe1

	measure 'Counter+Transfer % Same Period LY' =
			
			VAR SelectedDates = VALUES(dim_DateTable[Date])
			VAR MinDate = MINX(SelectedDates, dim_DateTable[Date])
			VAR MaxDate = MAXX(SelectedDates, dim_DateTable[Date])
			VAR PYStartDate = DATE(YEAR(MinDate) - 1, MONTH(MinDate), DAY(MinDate))
			VAR PYEndDate = DATE(YEAR(MaxDate) - 1, MONTH(MaxDate), DAY(MaxDate))
			RETURN
			CALCULATE(
			    [Counter+Transfer %],
			    dim_DateTable[Date] >= PYStartDate && dim_DateTable[Date] <= PYEndDate,
			    ALL(dim_DateTable[Date])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 92f164ba-71d7-46bf-8c4d-7c887b5f0abd

