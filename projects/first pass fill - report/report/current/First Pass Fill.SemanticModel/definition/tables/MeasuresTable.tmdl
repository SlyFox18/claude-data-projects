	measure Measure
		lineageTag: 0ac58c35-5158-4079-9d9e-439a25f3ff0e

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'R12-Counter (Working)' = ```
			
			VAR SelectedMaxDate = 
			    IF(
			        ISFILTERED(dim_DateTable[MonthName]),
			        -- When month filtered, use end of selected month in current data year
			        EOMONTH(DATE(IF(MONTH(MAX(dim_DateTable[Date])) <= MONTH(TODAY()), YEAR(TODAY()), YEAR(TODAY()) - 1), MONTH(MAX(dim_DateTable[Date])), 1), 0),
			        -- When no filter, use current month
			        EOMONTH(TODAY(), 0)
			    )
			VAR RollingStartDate = EOMONTH(SelectedMaxDate, -12) + 1  -- 12 months back
			RETURN
			CALCULATE(
			    [01. Counter %],
			    dim_DateTable[Date] >= RollingStartDate &&
			    dim_DateTable[Date] <= SelectedMaxDate
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 677ad806-c690-4eaa-b1fd-c515b737a409

	measure 'Period Verification' = ```
			
			VAR SelectedMaxDate = 
			    IF(
			        ISFILTERED(dim_DateTable[MonthName]),
			        EOMONTH(DATE(IF(MONTH(MAX(dim_DateTable[Date])) <= MONTH(TODAY()), YEAR(TODAY()), YEAR(TODAY()) - 1), MONTH(MAX(dim_DateTable[Date])), 1), 0),
			        EOMONTH(TODAY(), 0)
			    )
			VAR RollingStartDate = EOMONTH(SelectedMaxDate, -12) + 1
			VAR PYMaxDate = EOMONTH(SelectedMaxDate, -12)
			VAR PYRollingStart = EOMONTH(PYMaxDate, -12) + 1
			RETURN
			"R12 Selected Period: " & FORMAT(RollingStartDate, "MMM YYYY") & " to " & FORMAT(SelectedMaxDate, "MMM YYYY") &
			" | PY: " & FORMAT(PYRollingStart, "MMM YYYY") & " to " & FORMAT(PYMaxDate, "MMM YYYY")
			```
		lineageTag: 049fd4ee-5390-4ca6-9f4b-78148d49ccd5

