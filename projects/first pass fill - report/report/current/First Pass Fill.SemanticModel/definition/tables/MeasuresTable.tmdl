	measure 'Branches Above Target' = ```
			
			VAR BranchesAbove = 
			    SUMX(
			        FILTER(
			            FILTER(
			                ALL(dim_BranchLocation),
			                dim_BranchLocation[BranchType] = "Main Branch"
			            ),
			            [Total %] >= 0.81
			        ),
			        1
			    )
			RETURN BranchesAbove & " of 19 branches above 81% target"
			```
		lineageTag: 1babc5be-0da8-4728-8580-2ac96ded42c7

	measure 'Average Branch Performance' = ```
			
			VAR AvgPerformance = 
			    AVERAGEX(
			        FILTER(
			            ALL(dim_BranchLocation),
			            dim_BranchLocation[BranchType] = "Main Branch"
			        ),
			        [Total %]
			    )
			RETURN "Average: " & FORMAT(AvgPerformance, "0.0%")
			```
		lineageTag: 04ca09c5-80ba-49cb-b74d-ceb6f44fda07

	measure 'Biggest Improver' = ```
			
			VAR MaxImprovement = 
			    MAXX(
			        FILTER(
			            ALL(dim_BranchLocation),
			            dim_BranchLocation[BranchType] = "Main Branch"
			        ),
			        [Total % YoY Change]
			    )
			VAR BestBranch = 
			    MAXX(
			        FILTER(
			            ALL(dim_BranchLocation),
			            dim_BranchLocation[BranchType] = "Main Branch" && 
			            [Total % YoY Change] = MaxImprovement
			        ),
			        dim_BranchLocation[Branch]
			    )
			RETURN BestBranch & " (+" & FORMAT(MaxImprovement, "0.0%") & ")"
			```
		lineageTag: 34839e06-caae-46da-804d-72294b0b0137

	measure 'Needs Most Attention' = ```
			
			VAR MinPerformance = 
			    MINX(
			        FILTER(
			            ALL(dim_BranchLocation),
			            dim_BranchLocation[BranchType] = "Main Branch"
			        ),
			        [Total %]
			    )
			VAR WorstBranch = 
			    MAXX(
			        FILTER(
			            ALL(dim_BranchLocation),
			            dim_BranchLocation[BranchType] = "Main Branch" && 
			            [Total %] = MinPerformance
			        ),
			        dim_BranchLocation[Branch]
			    )
