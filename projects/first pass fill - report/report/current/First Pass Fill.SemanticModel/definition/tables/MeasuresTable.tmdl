	measure 'Month Performance Rank' = ```
			
			VAR CurrentMonth = MONTH(MAX(dim_DateTable[Date]))
			VAR AvgForMonth = 
			    CALCULATE(
			        AVERAGEX(VALUES(dim_DateTable[Date]), [Performance by Metric]),
			        dim_DateTable[Month] = CurrentMonth,
			        ALL(dim_DateTable[Year])
			    )
			VAR AllMonthsAvg = 
			    AVERAGEX(
