	measure 'Dynamic Target - Total %' =
			
			VAR FixedTarget = 0.81
			VAR BranchSelected = SELECTEDVALUE(dim_BranchLocation[BranchID])
			VAR HasBranchFilter = NOT ISBLANK(BranchSelected)
			RETURN
			IF(
			    HasBranchFilter,
			    // When branch is selected, show rolling 12-month average for that branch
			    CALCULATE(
			        AVERAGE(Fact_FirstPassFill[TotalFirstPassRate]),
			        dim_DateTable[IsRolling12Months] = TRUE,
			        REMOVEFILTERS(dim_DateTable[Month])  // Remove month filter to get 12-month average
			    ),
			    // When no branch filter, use fixed target
			    FixedTarget
			)
		lineageTag: 8c05c28e-585f-41b8-83b3-a77be75e3612

		annotation PBI_FormatHint = {"isGeneralNumber":true}

