	measure '09. Datalabel variance Counter %-PY MTD/YTD' = ```
			
			VAR PYValue = [11. Counter % PY suppl MTD/YTD]
			VAR AbsVar = [07. Abs var Counter %-PY MTD/YTD]
			VAR RelVar = [08. Rel var Counter %-PY MTD/YTD]
			RETURN
			FORMAT(PYValue, "0.0%") & " " & 
			FORMAT(AbsVar, "+0.0pp;-0.0pp") & " " &
			FORMAT(RelVar, "+0.0%;-0.0%") & 
			IF(AbsVar > 0, " ▲", IF(AbsVar < 0, " ▼", ""))
			```
		lineageTag: 9616fedd-890c-410e-a314-bf52b3305bd9

	measure 'Counter % Trend' =
			
			CALCULATE(
			    [Counter % MTD/YTD],
			    dim_DateTable[IsRolling12Months] = TRUE)
