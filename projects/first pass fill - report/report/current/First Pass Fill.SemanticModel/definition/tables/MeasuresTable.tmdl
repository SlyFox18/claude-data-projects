table MeasuresTable
	lineageTag: 0d039455-6ff6-47ec-acba-7d08b99b993f

	measure '01. Counter %' =
			
			DIVIDE(
			    SUM(Fact_FirstPassFill[CounterFirstPassSuccesses]),
			    SUM(Fact_FirstPassFill[CounterFirstPassAttempts]),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2e4766f9-b90a-41d7-9c13-77eb45ad0b69

	measure 'Counter+Transfer %' =
			
			DIVIDE(
			    SUM(Fact_FirstPassFill[CounterFirstPassSuccesses]) + SUM(Fact_FirstPassFill[CounterTransferSuccesses]),
			    SUM(Fact_FirstPassFill[CounterFirstPassAttempts]),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ada82087-ef79-46a4-9d6a-07af71e8f2c5

	measure 'Shop %' =
			
