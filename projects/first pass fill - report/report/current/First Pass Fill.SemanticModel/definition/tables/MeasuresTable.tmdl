		lineageTag: 94569914-9a7a-43b3-9c9f-03c0f04bacdc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '20.1 Scale factor - Data label position variance' = 1.21
		lineageTag: e8738b07-fa7e-47f4-a39f-0f60a82da896

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '18.2 Max Y-axis Range' = ```
			
			VAR __ScaleFactor = [18.1 Scale factor - Max Y-axis]
			VAR __Values = 
			    ADDCOLUMNS(
			        ALLSELECTED(Date_Supplemental[Month Number], Date_Supplemental[Month]),
			        "__AC", [10. Counter % suppl MTD/YTD],
			        "__Comparison", [11. Counter % PY suppl MTD/YTD]
			    )
			
			VAR __MaxAC = MAXX(__Values, [__AC])
			VAR __MaxComparison = MAXX(__Values, [__Comparison])
			VAR __MinAC = MINX(__Values, [__AC])
			VAR __MinComparison = MINX(__Values, [__Comparison])
			
			VAR __MaxValue = MAX(__MaxAC, __MaxComparison)
			VAR __MinValue = MIN(__MinAC, __MinComparison)
			VAR __MinNegative = IF(__MinValue < 0, __MinValue, 0)
			VAR __Range = __MaxValue - __MinNegative
			VAR __Result = __Range * __ScaleFactor + __MinNegative
			
			RETURN __Result
			```
		lineageTag: 7916099a-da5f-4d30-a5d0-22137283b5bc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '19. Data label position Counter % value' =
			
			IF([003. Month number suppl] = 1, [18.2 Max Y-axis Range], BLANK())
		lineageTag: 71e9b2c2-d076-41df-9e75-a0e66031dbd8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '20.2 Data label position Counter % variance' = ```
			
			IF(
			    [003. Month number suppl] = 1,
			
			    VAR __ScaleFactor = [20.1 Scale factor - Data label position variance] 
			    VAR __Values = 
			    ADDCOLUMNS(
			        ALLSELECTED(Date_Supplemental[Month Number], Date_Supplemental[Month]),
			            "__AC", [10. Counter % suppl MTD/YTD],
			            "__Comparison", [11. Counter % PY suppl MTD/YTD]
			        )
			    
			    VAR __MaxAC = MAXX(__Values, [__AC])
			    VAR __MaxComparison = MAXX(__Values, [__Comparison])
			    VAR __MinAC = MINX(__Values, [__AC])
			    VAR __MinComparison = MINX(__Values, [__Comparison])
			    VAR __MaxValue = MAX(__MaxAC, __MaxComparison)
			    VAR __MinValue = MIN(__MinAC, __MinComparison)
			    VAR __MinNegative = IF(__MinValue < 0, __MinValue, 0)
			    VAR __Range = __MaxValue - __MinNegative
			    
			    RETURN __Range * __ScaleFactor + __MinNegative,
			    
			    BLANK()
			)
			```
		lineageTag: e3cd1236-ba60-4e22-b030-7e5e30cc2f92

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '17. Min Y-axis Range' = ```
			
			VAR __Values = 
			    ADDCOLUMNS(
			        ALLSELECTED(Date_Supplemental[Month Number], Date_Supplemental[Month]),
			        "__AC", [10. Counter % suppl MTD/YTD],
			        "__Comparison", [11. Counter % PY suppl MTD/YTD]
			    )
			VAR __MinAC = MINX(__Values, [__AC])
			VAR __MinComparison = MINX(__Values, [__Comparison])
