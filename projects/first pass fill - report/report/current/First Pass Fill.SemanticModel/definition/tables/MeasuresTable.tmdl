	measure 'PY-R12-Shop+Trans (Working)' = ```
			
			VAR SelectedMaxDate = 
			    IF(
			        ISFILTERED(dim_DateTable[MonthName]),
			        EOMONTH(DATE(IF(MONTH(MAX(dim_DateTable[Date])) <= MONTH(TODAY()), YEAR(TODAY()), YEAR(TODAY()) - 1), MONTH(MAX(dim_DateTable[Date])), 1), 0),
			        EOMONTH(TODAY(), 0)
			    )
			VAR PYMaxDate = EOMONTH(SelectedMaxDate, -12)
			VAR PYRollingStart = EOMONTH(PYMaxDate, -12) + 1
			RETURN
			CALCULATE(
			    [Shop + Transfer %],
			    dim_DateTable[Date] >= PYRollingStart &&
			    dim_DateTable[Date] <= PYMaxDate
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f8037990-92d6-4742-9cc0-1d9c4d7ea305

