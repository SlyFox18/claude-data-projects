model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Data Refresh","dim_BranchLocation","dim_DateTable","dim_JobCode","dim_Parts","Fact_FirstPassFill","Metric Names","TBL Time Period"]

annotation PBI_ProTooling = ["DevMode"]

ref table MeasuresTable
ref table 'Data Refresh'
ref table dim_BranchLocation
ref table dim_DateTable
ref table 'New Report Tables'
ref table 'New Report Relationships'
ref table 'New Report Columns'
ref table dim_JobCode
ref table dim_Parts
ref table Fact_FirstPassFill
ref table 'Performance Metrics'
ref table 'Metric Names'
ref table Date_Supplemental
ref table 'TBL Time Period'
ref table 'New Report Measures'
ref table 'Time Period Table'
ref table 'Time Granularity Table'

ref cultureInfo en-US

