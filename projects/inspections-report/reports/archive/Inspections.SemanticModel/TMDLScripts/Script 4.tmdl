createOrReplace

	table RelevantWoNumbers
		lineageTag: 60fe7f95-076f-4ad6-baef-466132d9f607

		/// Calculates the total labor value including inspection for relevant work orders by summing unique invoice labor values
		measure InpectionLaborWithInspection =
				
				SUMX (
				    DISTINCT (
				        SELECTCOLUMNS (
				            FILTER ( 'Job_Code_Times', 'Job_Code_Times'[wo_number] IN RelevantWoNumbers ),
				            "wo_number", 'Job_Code_Times'[wo_number],
				            "Inv_Lab_Val", 'Job_Code_Times'[Inv_Lab_Val]
				        )
				    ),
				    [Inv_Lab_Val]
				)
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: f8e92c21-756d-4b8b-b493-430f77517fc1

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Calculates the average labor value per inspection by dividing total labor by count of distinct inspection job codes
		measure AverageLaborWithInspection =
				
				DIVIDE ( [TestTotalLaborWithInspection], [DistinctInspectionJobCodesCount] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: 2f14f9cd-11d1-41d6-9b6d-431b5e7cc1d6

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Calculates the average parts value per inspection by dividing total parts revenue by count of distinct inspection job codes
		measure AveragePartsPerInspection =
				
				DIVIDE ( [Parts $ Total], [DistinctInspectionJobCodesCount] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: 6bf52a02-6594-485e-a257-4eaaa4ecf808

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Calculates the total labor discount by summing negative absolute sale values for specific part numbers ("LEGACY" and "ADV")
		measure TotalLaborDiscount =
				
				SUMX (
				    DISTINCT (
				        SELECTCOLUMNS (
				            FILTER ( 'InTrans_Inspect', 'InTrans_Inspect'[PART_NO] IN { "LEGACY", "ADV" } ),
				            "SALE_VAL", 'InTrans_Inspect'[SALE_VAL]
				        )
				    ),
				    - ABS ( [SALE_VAL] )
				)
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: 36cdba7c-7572-40f3-9b15-7961a8664a27

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Calculates the average labor discount per inspection by dividing total labor discount by count of distinct inspection job codes
		measure AverageLaborDiscount =
				
				DIVIDE ( [TestTotalLaborDiscount], [DistinctInspectionJobCodesCount] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: a8eb1f01-d02e-4dc6-80f5-05c0c17aac2a

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Calculates the average combined labor and parts value per inspection
		measure AverageLaborAndParts =
				
				DIVIDE (
				    [TestTotalLaborWithInspection] + [Parts $ Total],
				    [DistinctInspectionJobCodesCount]
				)
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: 6ae0e2e5-654a-4993-8b4d-027158971264

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Calculates the net revenue after discounts by adding total labor, parts revenue, labor discount, and parts discount
		measure TotalMinusDiscounts =
				
				[TestTotalLaborWithInspection] + [Parts $ Total] + [TestTotalLaborDiscount] + [Parts Discount]
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: 97ac0d13-bc6b-4b41-8b9b-20541fcc714f

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Calculates the average discount percentage by dividing the absolute sum of discounts by total labor and parts revenue
		measure AveragePercentDiscounted =
				
				DIVIDE (
				    ABS ( [TestTotalLaborDiscount] + [Parts Discount] ),
				    [TestTotalLaborWithInspection] + [Parts $ Total]
				)
			formatString: 0.0%;-0.0%;0.0%
			lineageTag: 2900eb74-52a5-42ed-8bf8-94d37299a960

		/// Counts distinct inspection job codes by work order, checking if job codes exist in the JobCodes table
		measure DistinctInspectionJobCodesCount =
				
				SUMX (
				    VALUES ( 'Job_Code_Times'[wo_number] ),
				    CALCULATE (
				        DISTINCTCOUNT ( 'Job_Code_Times'[job_code] ),
				        'Job_Code_Times'[job_code] IN VALUES ( JobCodes[job_code] )
				    )
				)
			formatString: 0
			lineageTag: 72b7ccad-f5c8-4550-b2a3-33f3534e9e39

		/// Calculates the average parts discount per inspection by dividing total parts discount by count of distinct inspection job codes
		measure AveragePartDiscountPerInspection =
				
				DIVIDE ( [Parts Discount], [DistinctInspectionJobCodesCount] )
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: 4b76e127-2948-43c8-ac0b-95f4826da68e

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Calculates total labor revenue for work orders that have inspection job codes by filtering the DistinctLaborValuesByWoNumber table
		measure TestTotalLaborWithInspection =
				
				SUMX (
				    FILTER (
				        'DistinctLaborValuesByWoNumber',
				        'DistinctLaborValuesByWoNumber'[wo_number]
				            IN VALUES ( 'Job_Code_Times'[wo_number] )
				                && 'DistinctLaborValuesByWoNumber'[HasInspectionJobCode] = 1
				    ),
				    'DistinctLaborValuesByWoNumber'[TotalInv_Lab_Val]
				)
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: 412a8501-6f56-42ef-9cf8-ef7a3533aaed

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Calculates the total labor discount by multiplying the per-instance labor discount by the count of distinct inspection job codes
		measure TestTotalLaborDiscount = [TotalLaborDiscount] * [DistinctInspectionJobCodesCount]
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			lineageTag: bd8c3714-d54f-42e4-a7a1-1519f1c92e3f

			annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		column wo_number
			formatString: 0
			lineageTag: 0d49a1eb-a9be-4c7d-8ac8-af2cc6f7e517
			summarizeBy: sum
			isNameInferred
			sourceColumn: Job_Code_Times[wo_number]
			columnOrigin: Job_Code_Times.wo_number

			annotation SummarizationSetBy = Automatic

		partition RelevantWoNumbers = calculated
			mode: import
			source =
					
					CALCULATETABLE(
					    VALUES('Job_Code_Times'[wo_number]),
					    FILTER(
					        'Job_Code_Times',
					        'Job_Code_Times'[job_code] IN VALUES(JobCodes[job_code])
					    )
					)

		annotation PBI_Id = 202216aec3664e17a3f60d584bed7554