	column HasInspectionJobCode =
			
			IF(
			    CALCULATE(
			        COUNTROWS(
			            SUMMARIZE(
			                FILTER(
			                    'RepairOrderDetail',
			                    'RepairOrderDetail'[JobCode] IN VALUES(JobCodes[job_code])
			                ),
			                'RepairOrderDetail'[RONumber],
			                'RepairOrderDetail'[JobCode]
			            )
			        )
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 9f98fd10-e9aa-4560-b801-0ca6f8c98080
		summarizeBy: count

		annotation SummarizationSetBy = Automatic

	column HoursWorked = ```
			
			VAR Hours = 
			    SUMX(
			        FILTER(
			            TechnicianPunchedDetail, 
			            TechnicianPunchedDetail[RepairOrderNumber] = RepairOrderDetail[RONumber]
			        ), 
			        TechnicianPunchedDetail[HoursWorked]
			    )
			RETURN 
			    IF(
			        Hours = 0, 
			        0, 
			        Hours
			    )
			```
		formatString: 0.0
		lineageTag: 5d58bfee-ebce-41ba-b78f-125d0ddf6aa5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

