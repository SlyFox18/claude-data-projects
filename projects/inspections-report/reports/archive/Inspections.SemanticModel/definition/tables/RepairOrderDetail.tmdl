table RepairOrderDetail
	lineageTag: 77dfe639-8e8a-4c71-a667-432326752e56

	measure JobCodeCount =
			
			COUNT ( 'RepairOrderDetail'[JobCode] )
		formatString: 0
		lineageTag: 68a65c6d-0462-4e65-ae43-e6eb4d1056f0

	measure CreationDateAge =
			
			SWITCH (
			    TRUE (),
			    MAX ( 'RepairOrderDetail'[CreationDate] )
			        < TODAY () - 60, 2,
			    -- Over 2 months old
			    MAX ( 'RepairOrderDetail'[CreationDate] )
			        < TODAY () - 30, 1,
			    -- Over 1 month old
			    0 -- Within the last month
			)
		formatString: 0
		lineageTag: 63f4c044-caa3-4888-a0eb-620defd0f5ba

	measure LastPunchDateAge =
			
			SWITCH (
			    TRUE (),
			    MAX ( 'RepairOrderDetail'[LastLaborPunch] )
			        < TODAY () - 60, 2,
			    -- Over 2 months old
			    MAX ( 'RepairOrderDetail'[LastLaborPunch] )
			        < TODAY () - 30, 1,
			    -- Over 1 month old
			    0 -- Within the last month
			)
		formatString: 0
		lineageTag: d1345a41-d4b8-40a4-8205-14e7db72e358

