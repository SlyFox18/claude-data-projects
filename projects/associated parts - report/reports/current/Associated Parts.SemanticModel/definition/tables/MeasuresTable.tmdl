table MeasuresTable
	lineageTag: 472e60f3-1b63-4097-bbc8-e926e606925c

	measure 'Co-Occurrence Count' =
			
			SUM ( Fact_PartAssociation[CoOccurrenceCount] )
		formatString: #,0
		lineageTag: 60a9d935-57e1-498c-99c3-329b3c49a5ba
	measure 'Anchor Invoices' =
			
			SUMX (
				SUMMARIZE ( Fact_PartAssociation, Fact_PartAssociation[Franchise], Fact_PartAssociation[PartA], Fact_PartAssociation[AnchorInvoiceCount] ),
				Fact_PartAssociation[AnchorInvoiceCount]
			)
		formatString: #,0
		lineageTag: 5aaa970b-25e7-4011-9841-da67a79556b6
	measure 'Associated Invoices' =
			
			SUMX (
				SUMMARIZE ( Fact_PartAssociation, Fact_PartAssociation[Franchise], Fact_PartAssociation[PartB], Fact_PartAssociation[AssociatedInvoiceCount] ),
				Fact_PartAssociation[AssociatedInvoiceCount]
			)
		formatString: #,0
		lineageTag: 1472a474-77be-444d-9e0d-8a207d32fc58
	measure 'Total Invoices' =
			
			SUMX (
				SUMMARIZE ( Fact_PartAssociation, Fact_PartAssociation[Franchise], Fact_PartAssociation[TotalInvoiceCount] ),
				Fact_PartAssociation[TotalInvoiceCount]
			)
		formatString: #,0
		lineageTag: 8071817f-91fd-4069-9879-26c2c65e7c40
	measure 'Confidence %' =
			
			DIVIDE ( [Co-Occurrence Count], [Anchor Invoices] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cac631e4-3beb-4a7a-9bbe-d7468fe077a3
	measure 'Baseline %' =
			
			DIVIDE ( [Associated Invoices], [Total Invoices] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c5dd03d5-3424-45f2-b4f7-5249315fac8f
	measure Lift =
			
			DIVIDE ( [Confidence %], [Baseline %] )
		formatString: 0.00
		lineageTag: 86ae6be6-ea1b-4517-9f03-fccafb4040df

	column Value
		isHidden
		lineageTag: 0375f2ba-5a28-4d73-99ae-7f57f6892730
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition MeasuresTable = calculated
		mode: import
		source = { "This table holds all measures for the Associated Parts report" }
