	measure 'Margin % Color' =
			
			VAR MarginPct = [Margin %]
			RETURN
			    SWITCH(
			        TRUE(),
			        MarginPct >= 0.40, "#10B981",  // Green (good margin)
			        MarginPct >= 0.30, "#F59E0B",  // Yellow (acceptable)
			        MarginPct < 0.30, "#EF4444",   // Red (low margin)
			        "#6B7280"                       // Gray (no data)
			    )
		lineageTag: e64051db-412b-455d-be87-c9ca61744a7b

	measure 'Stock Status' = ```
			
			VAR QtyOnHand = SUM(dim_Branch12_Parts[QuantityOnHand])
			VAR DemandsR12 = [Demands]  // Transaction count R12
			VAR SalesQtyR12 = [Qty]     // Actual quantity sold R12
			VAR DaysSinceLastSale = [Days - Last Sale]
			
			// Calculate monthly velocity from R12 sales
			VAR MonthlyVelocity = DIVIDE(SalesQtyR12, 12, 0)
			VAR MonthsOfSupply = 
			    IF(
			        MonthlyVelocity > 0,
			        DIVIDE(QtyOnHand, MonthlyVelocity, 999),
			        999
			    )
			
			// Activity classification (refined)
			VAR HasRecentActivity = NOT ISBLANK(DaysSinceLastSale) && DaysSinceLastSale <= 90
			VAR HasModerateActivity = NOT ISBLANK(DaysSinceLastSale) && DaysSinceLastSale > 90 && DaysSinceLastSale <= 365
			VAR IsStagnant = NOT ISBLANK(DaysSinceLastSale) && DaysSinceLastSale > 365
			VAR HasNoDemand = ISBLANK(DaysSinceLastSale) || (DemandsR12 = 0 && SalesQtyR12 = 0)
			
			// Demand indicators
			VAR HasDemandR12 = DemandsR12 > 0 && SalesQtyR12 > 0
			
			RETURN
			    SWITCH(
			        TRUE(),
			        
			        // ========== PRIORITY 1: OUT OF STOCK ==========
			        // No inventory but has recent demand/sales
			        QtyOnHand = 0 && HasDemandR12 && NOT ISBLANK(DaysSinceLastSale), 
			            "⚠️ Out of Stock",
			        
			        // ========== PRIORITY 2: CRITICAL LOW STOCK ==========
			        // Less than 1 month supply with recent activity (< 90 days)
			        MonthsOfSupply < 1 && HasRecentActivity && QtyOnHand > 0, 
			            "🔴 Critical Low",
			        
			        // ========== PRIORITY 3: LOW STOCK ==========
			        // 1-2 months supply with recent activity
			        MonthsOfSupply >= 1 && MonthsOfSupply < 2 && HasRecentActivity && QtyOnHand > 0, 
			            "⚡ Low Stock",
			        
			        // ========== PRIORITY 4: HEALTHY ==========
			        // 2-6 months supply with recent activity (< 90 days)
			        MonthsOfSupply >= 2 && MonthsOfSupply <= 6 && HasRecentActivity && QtyOnHand > 0, 
			            "✅ Healthy",
			        
			        // ========== PRIORITY 5: ADEQUATE ==========
			        // 6-12 months supply with recent activity
			        MonthsOfSupply > 6 && MonthsOfSupply <= 12 && HasRecentActivity && QtyOnHand > 0, 
			            "📊 Adequate",
			        
			        // ========== PRIORITY 6: SLOW MOVING - MONITOR ==========
			        // Has stock, moderate activity (90-180 days), regardless of months supply
			        // OR very low velocity but sold within 180 days
			        QtyOnHand > 0 && HasModerateActivity, 
			            "🟡 Slow - Monitor",
			        
			        // ========== PRIORITY 7: OVERSTOCK - RECENT SALES ==========
			        // More than 12 months supply BUT sold within last 90 days
			        // Keep this separate from total stagnant - these are just overstocked
			        MonthsOfSupply > 12 && HasRecentActivity && QtyOnHand > 0, 
			            "📦 Overstock - Active",
			        
			        // ========== PRIORITY 8: STAGNANT STOCK ==========
			        // Has stock but no sales in 180+ days
			        QtyOnHand > 0 && IsStagnant, 
			            "💤 Stagnant Stock",
			        
			        // ========== PRIORITY 9: INACTIVE - NO STOCK ==========
			        // No stock and no demand in R12
			        QtyOnHand = 0 && HasNoDemand, 
			            "⚪ Inactive - No Stock",
			        
			        // ========== PRIORITY 10: INACTIVE - HAS STOCK ==========
			        // Has stock but absolutely no sales/demand in R12
			        QtyOnHand > 0 && HasNoDemand, 
			            "💤 Inactive - Has Stock",
			        
			        // Fallback - should rarely hit this
			        "❓ Unknown"
			    )
			```
		lineageTag: ff2443d3-842a-4a1f-a018-bcb9d900a7cc

