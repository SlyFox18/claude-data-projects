	measure 'Transfer Insights Narrative' = ```
			
			VAR TopBranch = 
			    CALCULATE(
			        MAX(dim_BranchLocation[Branch]),
			        TOPN(1, ALL(dim_BranchLocation[Branch]), [Sales R12], DESC)
			    )
			VAR TopBranchSales = 
			    CALCULATE(
			        [Sales R12],
			        TOPN(1, ALL(dim_BranchLocation[Branch]), [Sales R12], DESC)
			    )
			VAR TotalLocations = 
			    CALCULATE(
			        DISTINCTCOUNT(Fact_Branch12_Transactions[TransferBranch]),
			        Fact_Branch12_Transactions[IsSale] = TRUE,
			        Fact_Branch12_Transactions[TransferBranch] <> BLANK(),
			        dim_DateTable[IsRolling365Days] = TRUE
			    )
			VAR TotalTransferSales = [Sales R12]
			VAR TopShare = DIVIDE(TopBranchSales, TotalTransferSales, 0)
			
			RETURN
			"<div style='font-family: Segoe UI; font-size: 14px; line-height: 1.6; padding: 10px;'>
			<p><strong>Transfer Distribution Summary (Rolling 12 Months):</strong></p>
			<ul style='margin-top: 8px;'>
			<li>Branch 12 served <strong>" & TotalLocations & " locations</strong> with <strong>" & FORMAT(TotalTransferSales, "$#,0K") & "</strong> in total transfers</li>
			<li><strong>" & TopBranch & "</strong> is the primary destination at <strong>" & FORMAT(TopBranchSales, "$#,0K") & "</strong> (" & FORMAT(TopShare, "0%") & " of transfers)</li>
			<li>Total transfer demands: <strong>" & FORMAT([Demands], "#,0") & "</strong> transactions</li>
			</ul>
			</div>"
			```
		lineageTag: 0f50f5c3-afec-4ba0-a344-71f644837de1

	measure 'Transfer Qty by Branch' =
			
			VAR CurrentBranch = SELECTEDVALUE(dim_BranchLocation[Branch])
			RETURN
			IF(
			    NOT ISBLANK(CurrentBranch),
			    CALCULATE(
			        SUM(fact_Branch12_Transactions[SalesQty]),
			        fact_Branch12_Transactions[IsSale] = TRUE,
			        fact_Branch12_Transactions[TransferBranch] = CurrentBranch,
			        dim_DateTable[IsRolling365Days] = TRUE
			    ),
			    BLANK()
			)
		formatString: 0
