	measure 'Top 3 Parts' = ```
			
			VAR TopParts = 
			    TOPN(
			        3,
			        SUMMARIZE(
			            dim_Branch12_Parts,
			            dim_Branch12_Parts[Description],
			            "PartSales", [Sales Last 365],
			            "PartMargin", [Margin % Last 365]
			        ),
			        [PartSales],
			        DESC
			    )
