			    CONCATENATEX(
			        TopParts,
			        "• " & [Description] & ": " & 
			        FORMAT([PartSales], "$#,##0") & 
			        " (" & FORMAT([PartMargin], "0%") & ")",
			        UNICHAR(10),
			        [PartSales],
			        DESC
			    )
			RETURN
