	measure 'Info Page HTML' =
			
			"<!DOCTYPE html>
			<html>
			<head>
			<meta charset='UTF-8'>
			<style>
			* { margin: 0; padding: 0; box-sizing: border-box; }
			body { font-family: 'Segoe UI', Tahoma, sans-serif; line-height: 1.6; color: #333; background: white; }
			.container { width: 100%; margin: 0; background: white; }
			.header { background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%); color: white; padding: 40px; text-align: center; }
			.header h1 { font-size: 36px; margin-bottom: 10px; font-weight: 700; letter-spacing: -0.5px; }
			.header p { font-size: 18px; opacity: 0.95; font-weight: 300; }
			.content { padding: 40px 50px; }
			.section { margin-bottom: 45px; }
			.section-title { font-size: 26px; color: #2E5266; margin-bottom: 25px; padding-bottom: 12px; border-bottom: 4px solid #3A7CA5; font-weight: 700; display: flex; align-items: center; gap: 12px; }
			.intro { font-size: 17px; color: #555; margin-bottom: 30px; background: #E8F4F8; padding: 25px; border-radius: 10px; border-left: 5px solid #3A7CA5; line-height: 1.8; }
			.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
			.card { background: white; border-radius: 12px; padding: 22px; border: 2px solid #e8e8e8; transition: all 0.3s; position: relative; overflow: hidden; }
			.card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(0,0,0,0.12); }
			.card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 5px; }
			.urgent::before { background: linear-gradient(90deg, #dc3545 0%, #c82333 100%); }
			.urgent { background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%); border-color: #dc3545; }
			.low::before { background: linear-gradient(90deg, #ffc107 0%, #ff9800 100%); }
			.low { background: linear-gradient(180deg, #fffbf0 0%, #ffffff 100%); border-color: #ffc107; }
			.healthy::before { background: linear-gradient(90deg, #28a745 0%, #20c997 100%); }
			.healthy { background: linear-gradient(180deg, #f0fff4 0%, #ffffff 100%); border-color: #28a745; }
			.monitor::before { background: linear-gradient(90deg, #fd7e14 0%, #e83e8c 100%); }
			.monitor { background: linear-gradient(180deg, #fff8f0 0%, #ffffff 100%); border-color: #fd7e14; }
			.review::before { background: linear-gradient(90deg, #6c757d 0%, #495057 100%); }
			.review { background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%); border-color: #6c757d; }
			.card-header { font-size: 22px; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; color: #1a1a1a; }
			.card-icon { font-size: 32px; }
			.card-desc { font-size: 15px; color: #666; margin-bottom: 15px; line-height: 1.6; }
			.card-action { font-size: 14px; font-weight: 700; padding: 10px 15px; border-radius: 8px; display: inline-block; margin-top: 8px; }
			.urgent .card-action { background: #dc3545; color: white; }
			.low .card-action { background: #ffc107; color: #333; }
			.healthy .card-action { background: #28a745; color: white; }
			.monitor .card-action { background: #fd7e14; color: white; }
			.review .card-action { background: #6c757d; color: white; }
			.info-box { background: linear-gradient(135deg, #E8F4F8 0%, #C3E3EE 100%); border-left: 5px solid #3A7CA5; padding: 25px; margin: 25px 0; border-radius: 10px; box-shadow: 0 3px 10px rgba(58,124,165,0.1); }
			.info-box h3 { color: #1D3C4E; margin-bottom: 15px; font-size: 20px; font-weight: 700; }
			.info-box p { color: #424242; font-size: 15px; line-height: 1.8; margin-bottom: 10px; }
			.calc-box { background: linear-gradient(135deg, #fff9e6 0%, #ffe082 100%); border: 3px solid #ffd54f; border-radius: 12px; padding: 25px; margin: 25px 0; box-shadow: 0 3px 10px rgba(255,193,7,0.15); }
			.calc-box h4 { color: #f57f17; margin-bottom: 15px; font-size: 19px; font-weight: 700; }
			.calc-step { padding: 10px 0; font-size: 15px; font-family: 'Courier New', monospace; color: #424242; border-left: 3px solid #ffc107; padding-left: 15px; margin: 8px 0; background: rgba(255,255,255,0.6); border-radius: 4px; }
			.field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 25px; }
			.field { background: #f8f9fa; padding: 18px; border-radius: 8px; border-left: 4px solid #3A7CA5; }
			.field-name { font-weight: 700; color: #1a1a1a; margin-bottom: 8px; font-size: 16px; }
			.field-desc { font-size: 14px; color: #666; line-height: 1.6; }
			.workflow { counter-reset: step; list-style: none; padding: 0; }
			.workflow li { counter-increment: step; margin-bottom: 20px; padding-left: 60px; position: relative; font-size: 16px; line-height: 1.7; }
			.workflow li::before { content: counter(step); position: absolute; left: 0; top: -2px; width: 42px; height: 42px; background: linear-gradient(135deg, #1D3C4E 0%, #3A7CA5 100%); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px; box-shadow: 0 4px 10px rgba(29,60,78,0.3); }
			.tips { background: linear-gradient(135deg, #2E5266 0%, #1D3C4E 100%); color: white; padding: 30px; border-radius: 12px; margin-top: 35px; box-shadow: 0 5px 20px rgba(29,60,78,0.3); }
			.tips h3 { margin-bottom: 20px; font-size: 24px; font-weight: 700; }
			.tips ul { list-style: none; padding: 0; }
			.tips li { padding: 10px 0 10px 30px; position: relative; font-size: 15px; line-height: 1.7; }
			.tips li::before { content: '✓'; position: absolute; left: 0; font-weight: 900; font-size: 20px; }
			.footer { background: #f8f9fa; padding: 25px; text-align: center; color: #666; font-size: 14px; border-top: 2px solid #e0e0e0; }
			.footer strong { color: #2E5266; }
			</style>
			</head>
			<body>
			<div class='container'>
			<div class='header'>
			<h1>📊 Combine Vault Sales Report</h1>
			<p>Complete User Guide & Reference Documentation</p>
			</div>
			<div class='content'>
			<div class='section'>
			<h2 class='section-title'>🎯 What This Report Does</h2>
			<div class='intro'>
			This report helps you manage your parts inventory by tracking sales performance, monitoring stock levels in real-time, and providing intelligent restocking recommendations. It analyzes the last 12 months of sales activity to help you make data-driven purchasing decisions, avoid stockouts, and reduce excess inventory.
			</div>
			</div>
			<div class='section'>
			<h2 class='section-title'>🚦 Stock Status Categories Explained</h2>
			<div class='grid'>
			<div class='card urgent'>
			<div class='card-header'><span class='card-icon'>⚠️</span> Out of Stock</div>
			<div class='card-desc'>No inventory available but customers are actively buying this part (sold within 90 days).</div>
			<div class='card-action'>⚡ ORDER IMMEDIATELY</div>
			</div>
			<div class='card urgent'>
			<div class='card-header'><span class='card-icon'>🔴</span> Critical Low</div>
			<div class='card-desc'>Less than 1 month of supply remaining based on current sales velocity.</div>
			<div class='card-action'>⚡ ORDER VERY SOON</div>
			</div>
			<div class='card low'>
			<div class='card-header'><span class='card-icon'>⚡</span> Low Stock</div>
			<div class='card-desc'>Between 1-2 months of supply on hand. Still time but should order soon.</div>
			<div class='card-action'>📋 ORDER THIS WEEK</div>
			</div>
			<div class='card healthy'>
			<div class='card-header'><span class='card-icon'>✅</span> Healthy</div>
			<div class='card-desc'>2-6 months of supply. Perfect inventory level - actively selling with good stock.</div>
			<div class='card-action'>✓ NO ACTION NEEDED</div>
			</div>
			<div class='card healthy'>
			<div class='card-header'><span class='card-icon'>📊</span> Adequate</div>
			<div class='card-desc'>6-12 months of supply. Slightly overstocked but still selling regularly.</div>
			<div class='card-action'>👀 MONITOR CLOSELY</div>
			</div>
			<div class='card monitor'>
			<div class='card-header'><span class='card-icon'>🟡</span> Slow - Monitor</div>
			<div class='card-desc'>Last sale was 90-180 days ago. Moving slowly but has some recent activity.</div>
			<div class='card-action'>⚠️ WATCH & REDUCE</div>
			</div>
			<div class='card monitor'>
			<div class='card-header'><span class='card-icon'>📦</span> Overstock - Active</div>
			<div class='card-desc'>Over 12 months of supply but still selling (within last 90 days).</div>
			<div class='card-action'>🛑 STOP ORDERING</div>
			</div>
			<div class='card review'>
			<div class='card-header'><span class='card-icon'>💤</span> Stagnant Stock</div>
			<div class='card-desc'>Has inventory but no sales in 180+ days. Dead stock tying up capital.</div>
			<div class='card-action'>🔄 RETURN/LIQUIDATE</div>
			</div>
			<div class='card review'>
			<div class='card-header'><span class='card-icon'>⚪</span> Inactive</div>
			<div class='card-desc'>No inventory and no demand in the last year. Part is inactive.</div>
			<div class='card-action'>— NO ACTION</div>
			</div>
			</div>
			</div>
			<div class='section'>
			<h2 class='section-title'>🧮 How Stock Status is Calculated</h2>
			<div class='info-box'>
			<h3>📐 Three Key Factors</h3>
			<p><strong>1. Quantity on Hand:</strong> Current physical inventory in stock</p>
			<p><strong>2. Sales Velocity:</strong> Average monthly sales calculated over the last 12 months</p>
			<p><strong>3. Recent Activity:</strong> Number of days since the last customer purchase</p>
			</div>
			<div class='calc-box'>
			<h4>📊 Calculation Example</h4>
			<div class='calc-step'><strong>Step 1:</strong> Monthly Velocity = Total Sales (R12) ÷ 12 months</div>
			<div class='calc-step'>           Example: 60 units sold ÷ 12 = 5 units/month velocity</div>
			<div class='calc-step'><strong>Step 2:</strong> Months of Supply = Qty on Hand ÷ Monthly Velocity</div>
			<div class='calc-step'>           Example: 10 units ÷ 5 units/month = 2.0 months supply</div>
			<div class='calc-step'><strong>Step 3:</strong> Check Days Since Last Sale for activity level</div>
			<div class='calc-step'>           Example: Last sale 45 days ago = Active (< 90 days)</div>
			<div class='calc-step'><strong>RESULT:</strong> 2 months supply + Active = <strong>✅ Healthy Status</strong></div>
			</div>
			<div class='info-box'>
			<h3>💡 Suggested Order Quantity Logic</h3>
			<p>The report targets maintaining <strong>3 months of supply</strong> for actively selling parts. Formula: (Monthly Velocity × 3) - Qty on Hand = Suggested Order.</p>
			<p>For slow-moving parts selling less than 4 units per year, the system suggests a minimum of 1 unit to avoid zero recommendations while preventing over-ordering.</p>
			</div>
			</div>
			<div class='section'>
			<h2 class='section-title'>🔍 Key Fields Dictionary</h2>
			<div class='field-grid'>
			<div class='field'>
			<div class='field-name'>Qty on Hand</div>
			<div class='field-desc'>Physical inventory currently available in stock</div>
			</div>
			<div class='field'>
			<div class='field-name'>Bin Qty</div>
			<div class='field-desc'>Expected quantity (may differ from actual due to receiving/returns)</div>
			</div>
			<div class='field'>
			<div class='field-name'>Pending Qty</div>
			<div class='field-desc'>Parts on order but not yet received from vendor</div>
			</div>
			<div class='field'>
			<div class='field-name'>Qty Sold</div>
			<div class='field-desc'>Total number of units sold in the selected time period</div>
			</div>
			<div class='field'>
			<div class='field-name'>Demands</div>
			<div class='field-desc'>Number of sales transactions (not quantity). Example: 3 transactions of 5 units each = 3 demands, 15 qty sold</div>
			</div>
			<div class='field'>
			<div class='field-name'>Months of Supply</div>
			<div class='field-desc'>How long current inventory will last at current sales rate. 999.0 = virtually infinite (no sales)</div>
			</div>
			<div class='field'>
			<div class='field-name'>Days - Last Sale</div>
			<div class='field-desc'>Calendar days since this part last sold. Blank = never sold or no sales in 365 days</div>
			</div>
			<div class='field'>
			<div class='field-name'>Suggested Order Qty</div>
			<div class='field-desc'>Recommended order quantity to maintain 3 months supply (only for parts sold within 180 days)</div>
			</div>
			</div>
			</div>
			<div class='section'>
			<h2 class='section-title'>📋 Suggested Daily Workflow</h2>
			<ol class='workflow'>
			<li>Filter to <strong>Out of Stock</strong> status and order these parts immediately to prevent lost sales</li>
			<li>Review <strong>Critical Low</strong> and <strong>Low Stock</strong> categories to plan your purchasing for the week</li>
			<li>Check the <strong>Suggested Order Qty</strong> column for calculated recommended quantities</li>
			<li>Export filtered lists to Excel for easy integration with your purchasing system</li>
			<li><strong>Weekly:</strong> Review Slow-Monitor and Overstock categories to adjust future ordering</li>
			<li><strong>Monthly:</strong> Analyze Stagnant Stock for potential returns, transfers, or liquidation opportunities</li>
			</ol>
			</div>
			<div class='tips'>
			<h3>💡 Pro Tips for Maximum Efficiency</h3>
			<ul>
			<li>Use the Stock Status slicer to focus on one action category at a time</li>
			<li>Check Days Since Last Sale to verify actual activity levels and catch trends early</li>
			<li>Consider seasonal patterns</li>
			<li>Parts showing 999 months supply have essentially zero sales velocity</li>
			<li>Export your filtered reorder lists directly to Excel for seamless ordering</li>
			<li>Review inventory value trends weekly to optimize cash flow and working capital</li>
			<li>Set reminders to review stagnant stock monthly to free up warehouse space</li>
			</ul>
			</div>
			</div>
			<div class='footer'>
			<p><strong>Combine Vault Sales Report</strong> | Version 2.0 | Updated October 2025</p>
			<p>Questions or need assistance? Contact your inventory manager or reporting team</p>
			</div>
			</div>
			</body>
			</html>"
		lineageTag: f3264b6c-a7e4-45f6-9a34-b72956487a9d

	measure 'Sales Previous R12' =
			
			CALCULATE(
			    SUM(fact_Branch12_Transactions[SaleValue]),
			    fact_Branch12_Transactions[IsSale] = TRUE,
			    dim_DateTable[IsRolling730Days] = TRUE,
			    dim_DateTable[IsRolling365Days] = FALSE
			)
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: b4760c82-c2fc-498c-8cff-9335a44d4a21

	measure 'Sales R12 vs Previous $ Change' = [Sales R12] - [Sales Previous R12]
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: 9edcf3a4-02c8-4398-9e05-1c32db5f1126

	measure 'Sales R12 vs Previous % Change' =
			VAR PercentChange = DIVIDE([Sales R12] - [Sales Previous R12], [Sales Previous R12], 0)
			VAR Arrow = IF(PercentChange > 0, "↑", IF(PercentChange < 0, "↓", "─"))
			RETURN Arrow & " " & FORMAT(PercentChange, "0.0%")
