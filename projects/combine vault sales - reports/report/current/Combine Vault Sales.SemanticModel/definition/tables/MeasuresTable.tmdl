	measure 'Column Color Formatting' =
			
			VAR CurrentSales = [Sales]
			VAR PriorYearSales = [Previous Year Sales]
			VAR CurrentMonth = SELECTEDVALUE(dim_DateTable[Month])
			VAR CurrentYear = SELECTEDVALUE(dim_DateTable[Year])
			VAR IsDecember2024 = CurrentMonth = 12 && CurrentYear = 2024
			RETURN
			    SWITCH(
			        TRUE(),
			        IsDecember2024, 2,                      // Exceptional month (December 2024)
			        CurrentSales > PriorYearSales, 1,       // Better than last year (Blue)
			        0                                        // Worse than last year (Grey)
			    )
		formatString: 0
		lineageTag: c82c99da-2a04-44aa-93a7-b1e52eb36725

	measure 'Column Color Formatting  Custom' = ```
			
			VAR CurrentSales = [Sales]
			VAR PriorYearSales = [Previous Year Sales]
			VAR AverageSales = 
			    CALCULATE(
			        AVERAGE(fact_Branch12_Transactions[SaleValue]),
			        fact_Branch12_Transactions[IsSale] = TRUE,
			        dim_DateTable[Date] >= TODAY() - 365
			    )
			VAR IsExceptional = CurrentSales > (AverageSales * 3)  // 3x average = exceptional
			RETURN
			    SWITCH(
			        TRUE(),
			        IsExceptional, 2,                       // Exceptional (Amber)
			        CurrentSales > PriorYearSales, 1,       // Better than last year (Blue)
			        0                                        // Worse than last year (Grey)
			    )
			```
		formatString: 0
		lineageTag: 8c5b4374-f012-4062-becf-11982b3b1c17

