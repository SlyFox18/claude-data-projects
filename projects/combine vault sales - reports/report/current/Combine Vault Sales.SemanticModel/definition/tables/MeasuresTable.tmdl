	measure 'TEST Sales R12 Check' = ```
			
			VAR CalculatedSales = [Sales R12]
			VAR ExpectedSales = 148740  // Update with your actual old report value
			VAR Difference = CalculatedSales - ExpectedSales
			VAR PercentDiff = DIVIDE(Difference, ExpectedSales, 0)
			RETURN
			    "Calculated: " & FORMAT(CalculatedSales, "$#,##0") & 
			    " | Expected: " & FORMAT(ExpectedSales, "$#,##0") & 
			    " | Diff: " & FORMAT(Difference, "$#,##0") & 
			    " (" & FORMAT(PercentDiff, "0.0%") & ")"
			```
