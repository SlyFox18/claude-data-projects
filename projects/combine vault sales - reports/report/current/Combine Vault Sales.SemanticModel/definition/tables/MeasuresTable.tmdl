	measure 'Restock Hero Card' = ```
			
			VAR OutOfStock = [Parts Out of Stock]
			VAR CriticalLow = [Parts Critical + Low Stock]
			VAR SlowMoving = [Slow Moving Parts]
			VAR Stagnant = [Stagnant Parts]
			VAR Overstock = [Parts Overstock Active]
			VAR Healthy = [Healthy Parts]
			VAR ReorderCost = [Estimated Reorder Cost]
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 25px 20px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 12px;
			    box-shadow: 0 8px 24px rgba(0,0,0,0);
			    color: white;
			    height: 140px;
			    display: flex;
			    align-items: center;
			    justify-content: space-around;
			'>
			    <!-- Section 1: Out of Stock (URGENT) -->
			    <div style='text-align: center; flex: 1;'>
			        <div style='font-size: 11px; opacity: 0.85; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;'>
			            Out of Stock
			        </div>
			        <div style='font-size: 42px; font-weight: 700; line-height: 1; color: #fca5a5;'>
			            " & FORMAT(OutOfStock, "#,##0") & "
			        </div>
			        <div style='font-size: 11px; margin-top: 6px; opacity: 0.8; font-weight: 600;'>
			            ⚡ ORDER NOW
			        </div>
			    </div>
			    
			    <!-- Divider -->
			    <div style='width: 1.5px; height: 90px; background: rgba(255,255,255,0.25); margin: 0 15px;'></div>
			    
			    <!-- Section 2: Critical + Low Stock -->
			    <div style='text-align: center; flex: 1;'>
			        <div style='font-size: 11px; opacity: 0.85; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;'>
			            Critical + Low
			        </div>
			        <div style='font-size: 42px; font-weight: 700; line-height: 1; color: #fca5a5;'>
			            " & FORMAT(CriticalLow, "#,##0") & "
			        </div>
			        <div style='font-size: 11px; margin-top: 6px; opacity: 0.8; font-weight: 600;'>
			            🔴 URGENT
			        </div>
			    </div>
			    
			    <!-- Divider -->
			    <div style='width: 1.5px; height: 90px; background: rgba(255,255,255,0.25); margin: 0 15px;'></div>
			    
			    <!-- Section 3: Slow Moving -->
			    <div style='text-align: center; flex: 1;'>
			        <div style='font-size: 11px; opacity: 0.85; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;'>
			            Slow Moving
			        </div>
			        <div style='font-size: 42px; font-weight: 700; line-height: 1; color: #fcd34d;'>
			            " & FORMAT(SlowMoving, "#,##0") & "
			        </div>
			        <div style='font-size: 11px; margin-top: 6px; opacity: 0.8; font-weight: 600;'>
			            🟡 MONITOR
			        </div>
			    </div>
			    
			    <!-- Divider -->
			    <div style='width: 1.5px; height: 90px; background: rgba(255,255,255,0.25); margin: 0 15px;'></div>
			    
			    <!-- Section 4: Stagnant -->
			    <div style='text-align: center; flex: 1;'>
			        <div style='font-size: 11px; opacity: 0.85; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;'>
			            Stagnant
			        </div>
			        <div style='font-size: 42px; font-weight: 700; line-height: 1;'>
			            " & FORMAT(Stagnant, "#,##0") & "
			        </div>
			        <div style='font-size: 11px; margin-top: 6px; opacity: 0.8; font-weight: 600;'>
			            💤 REVIEW
			        </div>
			    </div>
			    
			    <!-- Divider -->
			    <div style='width: 1.5px; height: 90px; background: rgba(255,255,255,0.25); margin: 0 15px;'></div>
			    
			    <!-- Section 5: Overstock -->
			    <div style='text-align: center; flex: 1;'>
			        <div style='font-size: 11px; opacity: 0.85; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;'>
			            Overstock
			        </div>
			        <div style='font-size: 42px; font-weight: 700; line-height: 1; color: #fdba74;'>
			            " & FORMAT(Overstock, "#,##0") & "
			        </div>
			        <div style='font-size: 11px; margin-top: 6px; opacity: 0.8; font-weight: 600;'>
			            📦 STOP ORDER
			        </div>
			    </div>
			    
			    <!-- Divider -->
			    <div style='width: 1.5px; height: 90px; background: rgba(255,255,255,0.25); margin: 0 15px;'></div>
			    
			    <!-- Section 6: Healthy -->
			    <div style='text-align: center; flex: 1;'>
			        <div style='font-size: 11px; opacity: 0.85; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;'>
			            Healthy
			        </div>
			        <div style='font-size: 42px; font-weight: 700; line-height: 1; color: #86efac;'>
			            " & FORMAT(Healthy, "#,##0") & "
			        </div>
			        <div style='font-size: 11px; margin-top: 6px; opacity: 0.8; font-weight: 600;'>
			            ✅ ON TRACK
			        </div>
			    </div>
			    
			    <!-- Divider -->
			    <div style='width: 1.5px; height: 90px; background: rgba(255,255,255,0.25); margin: 0 15px;'></div>
			    
			    <!-- Section 7: Reorder Cost -->
			    <div style='text-align: center; flex: 1;'>
			        <div style='font-size: 11px; opacity: 0.85; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;'>
			            Reorder Cost
			        </div>
			        <div style='font-size: 36px; font-weight: 700; line-height: 1;'>
			            " & FORMAT(ReorderCost, "$#,##0") & "
			        </div>
			        <div style='font-size: 11px; margin-top: 6px; opacity: 0.8; font-weight: 600;'>
			            💰 ESTIMATED
			        </div>
			    </div>
			</div>
			"
			```
		lineageTag: 3a2edee0-4683-4f7d-ad14-7dcc68577c34

