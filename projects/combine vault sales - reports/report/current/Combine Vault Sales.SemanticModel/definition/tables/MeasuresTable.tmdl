	measure 'Months of Supply' =
			
			VAR QtyOnHand = SUM(dim_Branch12_Parts[QuantityOnHand])
			VAR QtySold = [Qty]
			VAR Demands = [Demands]
			
			RETURN
			    IF(
			        Demands > 0 && QtySold > 0,
			        (QtyOnHand / QtySold) * 12,  // Simple formula: (OnHand / Annual Sales) * 12
			        IF(QtyOnHand > 0 && Demands = 0, 999, BLANK())
			    )
		formatString: 0.0
		lineageTag: d0ca2944-bb4c-4860-81e2-a70428f81da0

	measure 'Suggested Order Qty Advanced' = ```
			
			VAR OnHand = SUM(dim_Branch12_Parts[QuantityOnHand])
			VAR SalesQtyR12 = [Qty]
			VAR DemandsR12 = [Demands]  // Number of transactions
			VAR DaysSinceLastSale = [Days - Last Sale]
			
			// Calculate typical order size (how much they buy per transaction)
			VAR AvgOrderSize = DIVIDE(SalesQtyR12, DemandsR12, 1)
			VAR MonthlyVelocity = DIVIDE(SalesQtyR12, 12, 0)
			
			// Only suggest orders for items with recent or moderate activity
			VAR HasRelevantActivity = NOT ISBLANK(DaysSinceLastSale) && DaysSinceLastSale <= 180
			
			// Calculate order quantity
			VAR TargetMonthsSupply = 3
			VAR TargetQty = MonthlyVelocity * TargetMonthsSupply
			VAR CalculatedOrder = TargetQty - OnHand
			
			// Smart minimum: use average order size as minimum
			// This ensures you have enough for at least 1 customer order
			VAR MinimumOrder = 
			    IF(
			        AvgOrderSize > 0,
			        ROUNDUP(AvgOrderSize, 0),
			        1
			    )
			
			VAR SuggestedOrder = 
			    IF(
			        HasRelevantActivity && SalesQtyR12 > 0 && CalculatedOrder > 0,
			        MAX(MinimumOrder, ROUNDUP(CalculatedOrder, 0)),
			        BLANK()
			    )
			
			RETURN SuggestedOrder
			```
		formatString: 0
		lineageTag: 45c332bb-aa15-4adc-81a4-6ee92775dd21

	measure 'Reorder Priority Score' = ```
			
			VAR _Status = [Stock Status]
			VAR SalesQtyR12 = [Qty]
			VAR DaysSinceLastSale = [Days - Last Sale]
			
			// Base score from status
			VAR StatusScore = 
			    SWITCH(
			        _Status,
			        "⚠️ Out of Stock", 10000,
			        "🔴 Critical Low", 5000,
			        "⚡ Low Stock", 2500,
			        "🟡 Slow - Monitor", 500,
			        "✅ Healthy", 100,
			        0
			    )
			
			// Velocity multiplier (higher sales = higher priority)
			VAR VelocityMultiplier = SalesQtyR12 * 10
			
			// Recency bonus (more recent sales = higher priority)
			VAR RecencyBonus = 
			    SWITCH(
			        TRUE(),
			        ISBLANK(DaysSinceLastSale), 0,
			        DaysSinceLastSale <= 30, 1000,
			        DaysSinceLastSale <= 60, 500,
			        DaysSinceLastSale <= 90, 250,
			        DaysSinceLastSale <= 180, 100,
			        0
			    )
			
			RETURN
			    StatusScore + VelocityMultiplier + RecencyBonus
			
			
			```
		lineageTag: 31004fab-020a-47a0-be2f-80578d840c07

