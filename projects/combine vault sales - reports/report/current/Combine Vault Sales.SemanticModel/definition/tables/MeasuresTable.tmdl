	measure 'Tooltip Variance' = ```
			
			VAR CurrentSales = [Sales]
			VAR PriorSales = [Previous Year Sales]
			VAR Difference = CurrentSales - PriorSales
			VAR FormattedDiff = FORMAT(ABS(Difference), "$#,##0")
			VAR Arrow = IF(Difference > 0, "▲", IF(Difference < 0, "▼", "●"))
			VAR Sign = IF(Difference > 0, "+", IF(Difference < 0, "-", ""))
			RETURN
			    Sign & FormattedDiff & " " & Arrow
			
			```
		lineageTag: 94413484-452b-4303-9af0-41d0e088fdfb

	measure 'Tooltip Variance %' = ```
			
			VAR CurrentSales = [Sales]
			VAR PriorSales = [Previous Year Sales]
			VAR GrowthRate = 
			    IF(
			        PriorSales > 0,
			        DIVIDE(CurrentSales - PriorSales, PriorSales),
			        BLANK()
			    )
			VAR FormattedPct = FORMAT(ABS(GrowthRate), "0.0%")
			VAR Arrow = IF(GrowthRate > 0, "▲", IF(GrowthRate < 0, "▼", "●"))
			VAR Sign = IF(GrowthRate > 0, "+", IF(GrowthRate < 0, "-", ""))
			RETURN
			    IF(
			        NOT ISBLANK(GrowthRate),
			        Sign & FormattedPct & " " & Arrow,
			        "N/A"
			    )
			```
		lineageTag: 25197936-3de0-4816-a6f4-b9cb96ad10b8

	measure 'Tooltip Performance' =
			
			VAR CurrentSales = [Sales]
			VAR PriorSales = [Previous Year Sales]
			VAR Difference = CurrentSales - PriorSales
			VAR GrowthRate = IF(PriorSales > 0, DIVIDE(Difference, PriorSales), BLANK())
			VAR CurrentMonth = SELECTEDVALUE(dim_DateTable[Month])
			VAR CurrentYear = SELECTEDVALUE(dim_DateTable[Year])
			VAR IsExceptional = CurrentMonth = 12 && CurrentYear = 2024
			RETURN
			    SWITCH(
			        TRUE(),
			        IsExceptional, "🔥 Exceptional Performance",
			        GrowthRate > 0.20, "🚀 Strong Growth",
			        GrowthRate > 0, "✅ Growth vs Last Year",
			        GrowthRate = 0, "➖ Flat",
			        GrowthRate > -0.20, "📉 Slight Decline",
			        "⚠️ Significant Decline"
			    )
		lineageTag: c2c00e7f-8fac-43e4-a281-e4f653695775

