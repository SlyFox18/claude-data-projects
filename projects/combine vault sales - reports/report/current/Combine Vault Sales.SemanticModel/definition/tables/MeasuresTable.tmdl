	measure 'Days Since Last Transfer' = ```
			
			VAR LastTransferDate = 
			    CALCULATE(
			        MAX(Fact_Branch12_Transactions[TransDatetime]),
			        Fact_Branch12_Transactions[IsSale] = TRUE,
			        Fact_Branch12_Transactions[TransferBranch] <> BLANK()
