	measure 'Sales R12 vs Previous Status' = ```
			VAR PercentChange = DIVIDE([Sales R12] - [Sales Previous R12], [Sales Previous R12], 0)
			RETURN 
			    IF(PercentChange > 0, 1,  // Growth = 1
			    IF(PercentChange < 0, 0,  // Decline = 0
			    -1))                      // No Change = -1
