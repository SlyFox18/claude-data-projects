	measure 'Sales Change Status' = ```
			
			VAR PercentChange = DIVIDE([Sales R12] - [Sales Previous R12], [Sales Previous R12], 0)
			RETURN
			    IF(PercentChange >= 0.5, 2,      -- Strong growth (>50%)
			    IF(PercentChange > 0, 1,          -- Moderate growth (0-50%)
			    IF(PercentChange = 0, 0,          -- No change
			    IF(PercentChange > -0.5, -1,      -- Moderate decline (0 to -50%)
			    -2)))) 
			```
		formatString: 0
		lineageTag: d308a71c-5aff-466c-ac69-fc0060d99a14

	measure 'Branch Sales Share' = ```
			
