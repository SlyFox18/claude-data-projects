	measure 'Sales Change R12' = ```
			
			VAR DollarChange = [Sales R12] - [Sales Previous R12]
			VAR PercentChange = DIVIDE(DollarChange, [Sales Previous R12], 0)
			VAR Arrow = 
			    IF(PercentChange > 0, "▲", 
			    IF(PercentChange < 0, "▼", 
