		lineageTag: m0017-pyt3-c1d1-d1e1-e1f1f1f1f1f1

	measure 'Hours YoY Variance' = [Total Hours] - [LY Hours]
		formatString: #,##0.00
		lineageTag: m0018-var1-c2d2-d2e2-e2f2f2f2f2f2

	measure 'Efficiency YoY Variance' = [Efficiency] - [LY Efficiency]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: m0019-var2-c3d3-d3e3-e3f3f3f3f3f3

	measure 'Productivity YoY Variance' = [Productivity] - [LY Productivity]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: m0020-var3-c4d4-d4e4-e4f4f4f4f4f4

	measure 'YTD vs PYTD Hours' = [YTD Hours] - [PYTD Hours]
		formatString: #,##0.00
		lineageTag: m0021-var4-c5d5-d5e5-e5f5f5f5f5f5

	measure 'PM Hours' =
			CALCULATE(
			    [Total Hours],
			    DATEADD(dim_DateTable[Date], -1, MONTH)
			)
		formatString: 0
		lineageTag: m0022-pm01-a1a1-b1b1-c1c1c1c1c1c1

	measure 'PM Efficiency' =
			CALCULATE(
