	measure 'MoM Labor Performance Variance' = [Labor Performance] - [PM Labor Performance]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: m0029-mom4-a8a8-b8b8-c8c8c8c8c8c8

	/// Color measure for PM Hours conditional formatting
	/// Green if PM Hours > Total Hours (last month was higher)
	/// Red if PM Hours < Total Hours (last month was lower)
	measure 'PM Hours Color' =
			VAR PMValue = [PM Hours]
			VAR CurrentValue = [Total Hours]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(PMValue) || ISBLANK(CurrentValue), "#FFFFFF",
			        PMValue > CurrentValue, "#A2F0B7",
			        PMValue < CurrentValue, "#EEF09E",
			        "#FFFFFF"
			    )
		lineageTag: m0030-clr1-b1b1-c1c1-d1d1d1d1d1d1

	measure 'Total Hours Color' =
			VAR TotalValue = [Total Hours]
			VAR CurrentValue = [LY Hours]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(TotalValue) || ISBLANK(CurrentValue), "#FFFFFF",
			        TotalValue > CurrentValue, "#A2F0B7",
			        TotalValue < CurrentValue, "#EEF09E",
			        "#FFFFFF"
			    )
		lineageTag: d17eea27-56d3-4a0e-b05e-272d0e426d16

	measure 'Total Hours Icon' = ```
			
			VAR TotalValue   = [Total Hours]
			VAR CurrentValue = [LY Hours]
			RETURN
			IF(
			    OR(ISBLANK(TotalValue), ISBLANK(CurrentValue)),
			    BLANK(),                                      -- hides icons when either side is blank
			    SWITCH(
			        TRUE(),
			        TotalValue > CurrentValue, 1,             -- positive
			        TotalValue < CurrentValue, 2,             -- negative
			        0                                         -- equal (neutral)
			    )
			)
			
			```
		formatString: 0
		lineageTag: 45e7905d-7341-4488-a08a-41a4219ce26f

	measure 'Total LY Hours Color' =
			VAR TotalValue = [Total Hours]
			VAR CurrentValue = [LY Hours]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(TotalValue) || ISBLANK(CurrentValue), "#FFFFFF",
			        TotalValue > CurrentValue, "#EEF09E",
			        TotalValue < CurrentValue, "#A2F0B7",
			        "#FFFFFF"
			    )
		lineageTag: 541d4f12-0ebd-40d2-b3fe-8dd02cf4f551

	measure 'MoM Var Icon' = ```
			
			VAR TotalValue = [MoM Hours Variance]
			RETURN
			IF(
			    ISBLANK(TotalValue) || TotalValue = 0,
			    BLANK(),
			    IF(TotalValue > 0, 1, 2)
			)
			
			```
		formatString: 0
		lineageTag: 5212dea2-10e7-4df9-b301-530664bba4dd

	measure 'MoM Labor Icon' =
			
