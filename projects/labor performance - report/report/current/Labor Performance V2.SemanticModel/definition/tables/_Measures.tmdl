		formatString: 0
		lineageTag: 1f2de7ee-073e-4e5f-a42d-82b020d6b896

	measure 'LY Hours Variance' = [Total Hours] - [LY Hours]
		formatString: 0
		lineageTag: 99a9f835-9750-4d28-b09e-6432b52f6e5e

	measure 'LY Labor Performance Variance' = [Labor Performance] - [LY Labor Performance]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 35eae6db-9872-49f0-abcb-7a3560ab71a5

	measure 'LY Labor Icon' =
			
