	measure 'MoM Hours Variance' = [Total Hours] - [PM Hours]
		formatString: 0
		lineageTag: m0026-mom1-a5a5-b5b5-c5c5c5c5c5c5

	measure 'MoM Efficiency Variance' = [Efficiency] - [PM Efficiency]
		formatString: 0.00%;-0.00%;0.00%
