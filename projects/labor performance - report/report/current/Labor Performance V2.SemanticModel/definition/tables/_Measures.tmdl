			    SAMEPERIODLASTYEAR(dim_DateTable[Date])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: m0010-ly03-caca-dada-eaeaeaeaeaea

	measure 'LY Labor Performance' =
			CALCULATE(
			    [Labor Performance],
			    SAMEPERIODLASTYEAR(dim_DateTable[Date])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: m0011-ly04-cbcb-dbdb-ebebebebebeb

	measure 'YTD Hours' =
