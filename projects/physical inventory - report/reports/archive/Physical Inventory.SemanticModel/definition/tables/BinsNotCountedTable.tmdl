	partition BinsNotCountedTable = calculated
		mode: import
		source =
				
				VAR CurrentYear = YEAR(TODAY())
				RETURN
				FILTER(
				    'jdis_Phy_Inv',
				    NOT (
				        CALCULATE(
				            COUNTROWS('jdis_Phy_Inv'),
				            YEAR('jdis_Phy_Inv'[Stocktake Date]) = CurrentYear
				        ) > 0
				    )
				)

	annotation PBI_Id = 530b8a7dfe9844c6b19214a0f7902842

