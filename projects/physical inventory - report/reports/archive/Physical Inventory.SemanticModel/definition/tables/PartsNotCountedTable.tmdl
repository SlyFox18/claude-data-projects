	partition PartsNotCountedTable = calculated
		mode: import
		source =
				
				VAR CurrentYear = YEAR(TODAY())
				RETURN
				FILTER(
				    'jdis_Phy_Inv',
				    NOT (
				        CALCULATE(
				            COUNTROWS('jdis_Phy_Inv'),
				            YEAR('jdis_Phy_Inv'[Stocktake Date]) = CurrentYear
				        ) > 0
				    )
				)

	annotation PBI_Id = b5ceb96fbf58409980b0f13554694fb5

