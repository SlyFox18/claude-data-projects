table MeasuresTable
	lineageTag: 280c971c-3818-4839-911d-999bc42fe009

	measure 'Bins Counted' = ```
			
			    CALCULATE(
			        DISTINCTCOUNT(jdis_Phy_Inv[Bin]),
			        YEAR(jdis_Phy_Inv[Stocktake Date]) = YEAR(TODAY())
			    )
			```
		formatString: 0
		lineageTag: 2b942f6c-19f4-4b94-a565-9685e277c90a

	measure 'Parts Counted' = ```
			
			    CALCULATE(
			        DISTINCTCOUNT(jdis_Phy_Inv[Part No]),
			        YEAR(jdis_Phy_Inv[Stocktake Date]) = YEAR(TODAY())
			    )
			```
		formatString: 0
		lineageTag: f1b8e371-ffa0-4825-973f-8ef040f01d51

	measure 'Total Parts' = DISTINCTCOUNT(jdis_Phy_Inv[Part No])
		formatString: 0
		lineageTag: 84be7e06-2613-4b06-bc46-1ab01980bd60

	measure 'Total Bins' = DISTINCTCOUNT(jdis_Phy_Inv[Bin])
		formatString: 0
		lineageTag: 058f533f-dd36-4bd6-87ae-0472b9a65d0e

	measure 'Bins Left to Count' = [Total Bins] - [Bins Counted]
		formatString: 0
		lineageTag: aef7c51c-8ab6-4630-bf81-8c57f83b6b4e

	measure 'Parts Left to Count' = [Total Parts] - [Parts Counted]
		formatString: 0
		lineageTag: 720a1d4a-82fc-4b61-a86c-196cc5e544d1

	measure '% Bins Counted' = DIVIDE([Bins Counted], [Total Bins], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e74a1ecf-fa89-4f82-85c5-3bee1ae1cd52

	measure '% Parts Counted' = DIVIDE([Parts Counted], [Total Parts], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 58ff9db9-9f8d-443b-9739-a65b57424156

	measure 'Weeks Remaining' =
			
			VAR CurrentWeek = WEEKNUM(TODAY())
			VAR WeeksInYear = 52
			RETURN WeeksInYear - CurrentWeek
		formatString: 0
		lineageTag: a99dfa83-6ce8-424c-a267-3fe041d0e451

	measure 'Bins Per Week Remaining' = DIVIDE([Bins Left to Count], [Weeks Remaining], 0)
		formatString: 0
		lineageTag: 8785387b-b944-42f4-a40a-f19aa3216ce1

	measure 'Bins To Count Per Week' = ```
			
			VAR TotalBins = [Total Bins]  
			VAR WeeksInYear = 52
			RETURN DIVIDE(TotalBins, WeeksInYear, 0)
			```
		formatString: 0
		lineageTag: 35e51c53-1069-4d54-b4f0-fc77278d520a

	measure 'Weeks Passed' =
			
			VAR CurrentWeek = WEEKNUM(TODAY())
			RETURN CurrentWeek
		formatString: 0
		lineageTag: 410e7c31-a84f-48c6-901d-6ab235c0da29

	measure 'On Track % Bins1' = ```
			
			    [Bins To Count Per Week] * [Weeks Passed] / [Total Bins]
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0ce42190-3383-4076-9d54-faac55b2f412

	measure 'On Track % Bins Counted' = [% Bins Counted] / [On Track % Bins1]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d268662c-8f79-4d6f-b975-2b8f81222566

	measure OnTrackColorCode =
			
			SWITCH(
			    TRUE(),
			    [Target % Bins] < 0.75 || [Target % Parts] < 0.75, 1,
			    ([Target % Bins] >= 0.70 && [Target % Bins] < 0.9) || ([Target % Parts] >= 0.70 && [Target % Parts] < 0.9), 2,
			    ([Target % Bins] >= 0.9 && [Target % Bins] < 1) || ([Target % Parts] >= 0.9 && [Target % Parts] < 1), 3,
			    [Target % Bins] >= 1 || [Target % Parts] >= 1, 4,
			    BLANK()
			)
		formatString: 0
		lineageTag: 18084b98-7d46-4b48-b5f1-aaba163dd50a

	measure 'Parts Per Week Remaining' = DIVIDE([Parts Left to Count], [Weeks Remaining], 0)
		formatString: 0
		lineageTag: e2093ba3-0631-414c-b76d-9a693700759c

	measure 'On Track % Parts1' =
			
			VAR AvgPartsPerWeek = [Parts To Count Per Week]
			VAR WeeksPassed = [Weeks Passed]
			VAR TotalParts = [Total Parts]
			VAR Calculatio = AvgPartsPerWeek * WeeksPassed
			RETURN
			    DIVIDE(Calculatio, TotalParts)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 35395323-1b18-4df7-ad86-61ac058be415

	measure 'Parts To Count Per Week' = DIVIDE([Total Parts], 52, 0)
		formatString: 0
		lineageTag: 1ebccf1e-6dfb-4fa8-ad5f-8fc6e1185988

	measure 'On Track % Part Counted' = [% Parts Counted] / [On Track % Parts1]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 56e376bc-9d4e-4254-a4a3-d61be18cc0b4

	measure CalculationByBranchParts = ROUND([Parts To Count Per Week] * [Weeks Passed], 0)
		formatString: 0
		lineageTag: 72e2b42c-26b0-4a4b-b847-89736091cd9a

	measure 'Target % Parts' = DIVIDE([CalculationByBranchParts], [Total Parts], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 237225d5-5c84-4676-9556-6a59c2bf4ddf

	measure 'Total Parts by Branch' = CALCULATE([Total Parts], ALLEXCEPT('jdis_Phy_Inv', 'jdis_Phy_Inv'[Branch]))
		formatString: 0
		lineageTag: 04965075-f214-496d-a9a0-fe60fb73c725

	measure CalculationByBranchBin = ROUND([Bins To Count Per Week] * [Weeks Passed], 0)
		formatString: 0
		lineageTag: bc488ff6-f40b-4658-9975-b264478688f2

	measure 'Target % Bins' = DIVIDE([CalculationByBranchBin], [Total Bins], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e9bba686-ffaa-4f94-a36d-279683f0c5ed

	measure BinsNotCounted = ```
			
			VAR CurrentYear = YEAR(TODAY())
			VAR BinsList = 
			    CONCATENATEX(
			        FILTER(
			            VALUES(jdis_Phy_Inv[Bin]),
			            NOT (
			                CALCULATE(
			                    COUNTROWS(jdis_Phy_Inv),
			                    YEAR(jdis_Phy_Inv[Stocktake Date]) = CurrentYear
			                ) > 0
			            )
			        ),
			        jdis_Phy_Inv[Bin],
			        ", "
			    )
			RETURN
			BinsList
			```
		lineageTag: aba3cba7-ee7d-4267-88ae-ebdad65768f5

	measure 'Not Counted' = DISTINCTCOUNT(BinsNotCountedTable[Bin])
		formatString: 0
		lineageTag: dbffe080-a922-4d14-b008-1f383bd0ba05

	measure 'GaugeColor Bins' = ```
			
			IF(
			    [% Bins Counted] < [Target % Bins], 
			    "Red", 
			    "Green"
			)
			```
		lineageTag: 97fc1f17-b3e8-4f9e-8392-559e767cc53e

	measure 'GaugeColor Parts' = ```
			
			IF(
			    [% Parts Counted] < [Target % Parts], 
			    "Red", 
			    "Green"
			)
			```
		lineageTag: 3b296011-4980-4716-a7ea-1d5d62f8699a

	measure 'Show Filter 1' =
			
			VAR MaxFilters = 3
			RETURN
			    IF (
			        ISFILTERED ( Dim_Branch[Branch] ),
			        VAR ___f =
			            FILTERS ( Dim_Branch[Branch] )
			        VAR ___r =
			            COUNTROWS ( ___f )
			        VAR ___t =
			            TOPN ( MaxFilters, ___f, Dim_Branch[Branch] )
			        VAR ___d =
			            CONCATENATEX ( ___t, Dim_Branch[Branch], ", " )
			        VAR ___x =
			            "Branch:  " & ___d
			                & IF ( ___r > MaxFilters, ", ... [" & ___r & " items selected]" ) & " "
			        RETURN
			            ___x & UNICHAR ( 13 )
			                & UNICHAR ( 10 )
			    )
		lineageTag: 69670a7f-f397-41f0-ade5-a54da3c1fb64

	measure ShowFilterBranch =
			
			IF (
			    ISFILTERED ( Dim_Branch[Branch] ),
			    VAR _Location =
			        VALUES ( Dim_Branch[Branch] )
			    VAR _Itemscombined =
			        CONCATENATEX ( _Location, Dim_Branch[Branch], UNICHAR ( 10 ) )
			    RETURN
			        _Itemscombined & UNICHAR ( 10 ),
			    ""
			)
		lineageTag: 7e35780a-5323-48d8-b080-27de4bc60d19

	measure 'Total Parts with Qty' =
			
			CALCULATE(
			    DISTINCTCOUNT(jdis_Phy_Inv[Part No]),
			    jdis_Phy_Inv[Bin Qty] > 0
			)
		formatString: 0
		lineageTag: 74404d0d-fdb1-4e30-b6fa-b9d7a9dfeb8e

	measure 'Parts with Qty Counted' =
			
