	measure 'Not Counted Export Header' = ```
			
			VAR SelectedBranch = SELECTEDVALUE(dim_BranchLocation[Branch], "All Branches")
			VAR BranchName = 
			    IF(
			        SelectedBranch = "All Branches",
			        "All Branches",
			        SELECTEDVALUE(dim_BranchLocation[BranchName], SelectedBranch)
			    )
			
			// USE DASHBOARD MEASURES (single source of truth)
			VAR TotalPartsUncounted = [Parts Left to Count]
			VAR TotalBinsUncounted = [Bins Left to Count]
			
			// CORRECTED WEEKLY TARGET CALCULATION
			VAR CurrentDate = TODAY()
			VAR YearEnd = DATE(YEAR(CurrentDate), 12, 31)
			VAR DaysLeft = YearEnd - CurrentDate
			VAR WeeksLeft = ROUND(DaysLeft / 7, 0)
			VAR WeeksLeftSafe = IF(WeeksLeft < 1, 1, WeeksLeft)
			VAR BinsPerWeek = ROUND(DIVIDE(TotalBinsUncounted, WeeksLeftSafe, 0), 0)
			
			RETURN
			"<div style='background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%); 
			            padding: 16px 20px 12px 20px; 
			            border-radius: 8px; 
			            color: white; 
			            font-family: ""Segoe UI"", Arial, sans-serif;
			            box-shadow: 0 3px 5px rgba(0,0,0,0.15);'>
			    
			    <!-- HEADER ROW -->
			    <div style='display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;'>
			        <div>
			            <div style='font-size: 20px; font-weight: 700; margin-bottom: 2px;'>
			                📦 Physical Inventory Export
			            </div>
			            <div style='font-size: 14px; opacity: 0.85;'>
			                " & BranchName & " - Items Requiring Physical Count
			            </div>
			        </div>
			        <div style='text-align: right;'>
			            <div style='font-size: 13px; opacity: 0.75; margin-bottom: 2px;'>Weekly Target (" & WeeksLeftSafe & " weeks left)</div>
			            <div style='font-size: 22px; font-weight: 700;'>~" & FORMAT(BinsPerWeek, "#,##0") & " bins</div>
			        </div>
			    </div>
			    
			    <!-- STATS ROW -->
			    <div style='display: flex; gap: 24px; margin-bottom: 12px;'>
			        <div>
			            <div style='font-size: 13px; opacity: 0.75; margin-bottom: 2px;'>Parts Not Counted</div>
			            <div style='font-size: 24px; font-weight: 700;'>" & FORMAT(TotalPartsUncounted, "#,##0") & "</div>
			        </div>
			        <div>
			            <div style='font-size: 13px; opacity: 0.75; margin-bottom: 2px;'>Bins Not Counted</div>
			            <div style='font-size: 24px; font-weight: 700;'>" & FORMAT(TotalBinsUncounted, "#,##0") & "</div>
			        </div>
			    </div>
			    
			    <!-- SUBTLE TAB-STYLE VIEW SELECTOR -->
			    <div style='border-top: 1px solid rgba(255,255,255,0.2); padding-top: 10px;'>
			        <div style='display: flex; gap: 8px; align-items: center;'>
			            <div style='font-size: 11px; opacity: 0.75; margin-right: 4px;'>View:</div>
			            
			            <div style='background: rgba(255,215,0,0.15);
			                        border: 1px solid rgba(255,215,0,0.4);
			                        color: #FFD700;
			                        padding: 6px 16px;
			                        border-radius: 4px;
			                        font-size: 13px;
			                        font-weight: 600;
			                        cursor: pointer;'>
			                🔧 Parts
			            </div>
			            
			            <div style='background: rgba(74,144,226,0.15);
			                        border: 1px solid rgba(74,144,226,0.4);
			                        color: #4A90E2;
			                        padding: 6px 16px;
			                        border-radius: 4px;
			                        font-size: 13px;
			                        font-weight: 600;
			                        cursor: pointer;'>
			                📦 Bins
			            </div>
			            
			            <div style='margin-left: 8px; font-size: 14px; opacity: 0.7;'>
			                → Export: Click view → ""..."" on table → Export to Excel → Use <b>Suggested Week</b> column
			            </div>
			        </div>
			    </div>
			    
			</div>"
			```
		lineageTag: fb89e2f7-a97c-4a0e-a5d9-fc85ca329f48

	measure 'Is Part Uncounted This Year' = ```
			
			IF(
			    HASONEVALUE('Physical Inventory'[PartNumber]),
			    VAR PartStocktakeDate = MAX('Physical Inventory'[StocktakeDate])
			    RETURN
			        IF(
			            ISBLANK(PartStocktakeDate) || 
			            YEAR(PartStocktakeDate) < YEAR(TODAY()),
			            1,  // Uncounted
			            0   // Counted
			        ),
			    BLANK()
			)
			```
		formatString: 0
		lineageTag: 1cc3031c-8567-4aee-9ca6-2a67e8bc936c

	measure 'Is Bin Uncounted This Year' = ```
			
			IF(
			    HASONEVALUE('Physical Inventory'[Bin]),
			    VAR CurrentBin = VALUES('Physical Inventory'[Bin])
			    VAR AnyPartCountedInBin = 
			        CALCULATE(
			            COUNTROWS('Physical Inventory'),
			            'Physical Inventory'[Is Part Counted] = 1,
			            CurrentBin
			        )
			    RETURN
			        IF(AnyPartCountedInBin > 0, 0, 1)  // If any part counted, bin is counted (0), else uncounted (1)
			    ,
			    BLANK()
			)
			```
		formatString: 0
		lineageTag: 6bb90922-939f-4c9b-8f6a-6e6e35334597

	measure 'Help Panel - Not Counted Page' = ```
			
			"<div style='background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%); 
			            padding: 24px; 
			            border-radius: 12px; 
			            color: white; 
			            font-family: ""Segoe UI"", Arial, sans-serif;
			            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
			            max-width: 900px;'>
			    
			    <!-- HEADER -->
			    <div style='text-align: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 2px solid rgba(255,255,255,0.2);'>
			        <div style='font-size: 28px; font-weight: 700; margin-bottom: 8px;'>
			            ℹ️ Physical Inventory Export - Help Guide
			        </div>
			        <div style='font-size: 14px; opacity: 0.85;'>
			            Everything you need to know about this page
			        </div>
			    </div>
			    
			    <!-- SECTION 1: WHAT THIS PAGE DOES -->
			    <div style='background: rgba(255,255,255,0.08); 
			                border-radius: 8px; 
			                padding: 18px; 
			                margin-bottom: 18px;
			                border-left: 4px solid #FFD700;'>
			        <div style='font-size: 18px; font-weight: 700; margin-bottom: 12px; color: #FFD700;'>
			            📋 What This Page Does
			        </div>
			        <div style='font-size: 14px; line-height: 1.8; opacity: 0.95;'>
			            This page shows <b>all parts and bins that have NOT been counted yet this year</b>. Use it to:<br/>
			            • Export lists of uncounted items to Excel<br/>
			            • Track which items your branch still needs to count<br/>
			            • Plan your counting schedule using the Suggested Week column<br/>
			            • Monitor progress toward completing your annual physical inventory
			        </div>
			    </div>
			    
			    <!-- SECTION 2: HOW COUNTING WORKS -->
			    <div style='background: rgba(255,255,255,0.08); 
			                border-radius: 8px; 
			                padding: 18px; 
			                margin-bottom: 18px;
			                border-left: 4px solid #4A90E2;'>
			        <div style='font-size: 18px; font-weight: 700; margin-bottom: 12px; color: #4A90E2;'>
			            🔍 How ""Counted"" is Determined
			        </div>
			        <div style='font-size: 14px; line-height: 1.8; opacity: 0.95;'>
			            <b>For Parts:</b> A part is counted when its Stocktake Date is in the current year (2025).<br/><br/>
			            
			            <b>For Bins:</b> A bin is counted when <u>at least one part</u> in that bin has been counted this year.<br/>
			            <span style='font-size: 12px; opacity: 0.8; font-style: italic;'>
			            → Example: If bin ""A-001"" has 5 parts and you count 1 of them, the entire bin is marked as counted.<br/>
			            → Why? Physical inventory is done by bin location, not individual parts.
			            </span><br/><br/>
			            
			            <b>Date Filter:</b> Only items created before 12/31/2024 are included (excludes brand new items that haven't been properly stocked yet).
			        </div>
			    </div>
			    
			    <!-- SECTION 3: THE TWO VIEWS -->
			    <div style='background: rgba(255,255,255,0.08); 
			                border-radius: 8px; 
			                padding: 18px; 
			                margin-bottom: 18px;
			                border-left: 4px solid #9B59B6;'>
			        <div style='font-size: 18px; font-weight: 700; margin-bottom: 12px; color: #BB8FCE;'>
			            👁️ Understanding the Two Views
			        </div>
			        <div style='font-size: 14px; line-height: 1.8; opacity: 0.95;'>
			            <div style='margin-bottom: 12px;'>
			                <b style='color: #FFD700;'>🔧 Parts View:</b> Shows every individual part that hasn't been counted.<br/>
			                <span style='font-size: 12px; opacity: 0.8;'>
			                → Use this for detailed part-by-part tracking<br/>
			                → Includes Part Number, Description, Bin Qty, and dates<br/>
			                → Best for: Finding specific parts or drilling into details
			                </span>
			            </div>
			            <div>
			                <b style='color: #4A90E2;'>📦 Bins View:</b> Shows bins that haven't been counted (summary by location).<br/>
			                <span style='font-size: 12px; opacity: 0.8;'>
			                → Use this for location-based counting workflow<br/>
			                → Shows Part Count and Total Bin Qty per bin<br/>
			                → Best for: Walking through the warehouse by bin location
			                </span>
			            </div>
			        </div>
			    </div>
			    
			    <!-- SECTION 4: SUGGESTED WEEK COLUMN -->
			    <div style='background: rgba(255,255,255,0.08); 
			                border-radius: 8px; 
			                padding: 18px; 
			                margin-bottom: 18px;
			                border-left: 4px solid #E67E22;'>
			        <div style='font-size: 18px; font-weight: 700; margin-bottom: 12px; color: #F39C12;'>
			            📅 How Suggested Week Works
			        </div>
			        <div style='font-size: 14px; line-height: 1.8; opacity: 0.95;'>
			            <b>Purpose:</b> Helps you spread counting evenly throughout the year.<br/><br/>
			            
			            <b>How it's calculated:</b><br/>
			            • Each bin in your branch is assigned a week number (1-52)<br/>
			            • Bins are sorted alphabetically (A-001, A-002, etc.)<br/>
			            • Week numbers cycle: Week 1, Week 2, ... Week 52, then back to Week 1<br/><br/>
			            
			            <span style='font-size: 12px; opacity: 0.8; font-style: italic;'>
			            → Example: If your branch has 520 bins, ~10 bins are assigned to each week<br/>
			            → This creates a balanced workload across the entire year
			            </span>
			        </div>
			    </div>
			    
			    <!-- SECTION 5: WEEKLY TARGET CALCULATION -->
			    <div style='background: rgba(255,255,255,0.08); 
			                border-radius: 8px; 
			                padding: 18px; 
			                margin-bottom: 18px;
			                border-left: 4px solid #E74C3C;'>
			        <div style='font-size: 18px; font-weight: 700; margin-bottom: 12px; color: #EC7063;'>
			            🎯 Weekly Target Calculation
			        </div>
			        <div style='font-size: 14px; line-height: 1.8; opacity: 0.95;'>
			            <b>Formula:</b> Bins Not Counted ÷ Weeks Left in Year = Weekly Target<br/><br/>
			            
			            <b>Example (December with 4 weeks left):</b><br/>
			            8,586 bins not counted ÷ 4 weeks = ~2,147 bins per week<br/><br/>
			            
			            <span style='background: rgba(231,76,60,0.2); padding: 8px 12px; border-radius: 4px; display: inline-block; font-size: 13px;'>
			            ⚠️ <b>Important:</b> This number changes throughout the year! Early in the year, targets are lower (~165/week). 
			            Late in the year, they spike to show urgency. Use this to stay on track!
			            </span>
			        </div>
			    </div>
			    
			    <!-- SECTION 6: STEP-BY-STEP INSTRUCTIONS -->
			    <div style='background: rgba(255,255,255,0.08); 
			                border-radius: 8px; 
			                padding: 18px; 
			                margin-bottom: 18px;
			                border-left: 4px solid #27AE60;'>
			        <div style='font-size: 18px; font-weight: 700; margin-bottom: 12px; color: #52BE80;'>
			            ✅ Step-by-Step: How to Use This Page
			        </div>
			        <div style='font-size: 14px; line-height: 1.9; opacity: 0.95;'>
			            <b>1. Select Your Branch</b><br/>
			            <span style='margin-left: 20px; font-size: 13px; opacity: 0.85;'>
			            Use the branch slicer at the top of the page to filter to your location
			            </span><br/><br/>
			            
			            <b>2. Choose Your View</b><br/>
			            <span style='margin-left: 20px; font-size: 13px; opacity: 0.85;'>
			            Click ""🔧 Parts"" for detailed part listing, or ""📦 Bins"" for location summary
			            </span><br/><br/>
			            
			            <b>3. Export to Excel</b><br/>
			            <span style='margin-left: 20px; font-size: 13px; opacity: 0.85;'>
			            Click the ""..."" (More options) button at the top-right of the table<br/>
			            Select ""Export data"" → Choose ""Summarized data"" → Click ""Export""
			            </span><br/><br/>
			            
			            <b>4. Use the Suggested Week Column</b><br/>
			            <span style='margin-left: 20px; font-size: 13px; opacity: 0.85;'>
			            In Excel, sort or filter by ""Suggested Week"" to plan your counting schedule<br/>
			            Focus on counting items for the current week number
			            </span><br/><br/>
			            
			            <b>5. Count and Update</b><br/>
			            <span style='margin-left: 20px; font-size: 13px; opacity: 0.85;'>
			            As you complete physical counts in your system, items automatically disappear from this page<br/>
			            Refresh the report to see updated progress
			            </span>
			        </div>
			    </div>
			    
			    <!-- SECTION 7: TIPS & BEST PRACTICES -->
			    <div style='background: rgba(255,255,255,0.08); 
			                border-radius: 8px; 
			                padding: 18px;
			                border-left: 4px solid #3498DB;'>
			        <div style='font-size: 18px; font-weight: 700; margin-bottom: 12px; color: #5DADE2;'>
			            💡 Tips & Best Practices
			        </div>
			        <div style='font-size: 14px; line-height: 1.8; opacity: 0.95;'>
			            • <b>Export early in the week</b> to give your team time to count all assigned items<br/>
			            • <b>Check the Weekly Target</b> regularly to ensure you're staying on pace<br/>
			            • <b>Focus on bins, not individual parts</b> - count everything in a bin at once<br/>
			            • <b>Watch for spikes</b> in Weekly Target toward year-end - don't fall behind!<br/>
			            • <b>Re-export periodically</b> as items get counted to get updated lists
			        </div>
			    </div>
			    
			    <!-- FOOTER -->
			    <div style='text-align: center; margin-top: 24px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.2);'>
			        <div style='font-size: 12px; opacity: 0.7;'>
			            Questions? Contact your regional inventory coordinator
			        </div>
			    </div>
			    
			</div>"
			```
		lineageTag: 5d23c3e7-0e97-4d56-a710-038739a49aef

