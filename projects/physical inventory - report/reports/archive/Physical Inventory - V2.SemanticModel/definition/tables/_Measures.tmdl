	measure 'Status - Bins' =
			
			VAR _Variance = [Variance vs Target - Bins]
			VAR AbsVariance = ABS(_Variance)
			RETURN
			    SWITCH(
			        TRUE(),
			        _Variance >= 0.05, "🟢 Ahead of Schedule",
			        _Variance >= 0, "🟡 On Track",
			        _Variance >= -0.05, "🟠 Slightly Behind",
			        "🔴 Behind Schedule"
			    )
		lineageTag: b7e13b9c-eca4-415e-a7f4-a1dd08c3b7ab

	measure 'Status - Parts' =
			
			VAR _Variance = [Variance vs Target - Parts]
			VAR AbsVariance = ABS(_Variance)
			RETURN
			    SWITCH(
			        TRUE(),
			        _Variance >= 0.05, "🟢 Ahead of Schedule",
			        _Variance >= 0, "🟡 On Track",
			        _Variance >= -0.05, "🟠 Slightly Behind",
			        "🔴 Behind Schedule"
			    )
		lineageTag: c764c887-0809-4f2b-af4a-fc4d65f57458

	measure 'Days to Catch Up - Bins' =
			
			VAR _Variance = [Variance vs Target - Bins]
			VAR BinsRemaining = [Bins Left to Count]
			VAR DaysLeft = DATE(YEAR(TODAY()), 12, 31) - TODAY()
			VAR CurrentDailyRate = DIVIDE([Bins Counted], [Weeks Elapsed This Year] * 7, 0)
			VAR RequiredDailyRate = DIVIDE(BinsRemaining, DaysLeft, 0)
			VAR AdditionalBinsPerDay = RequiredDailyRate - CurrentDailyRate
			RETURN
			    IF(
			        _Variance < 0,
			        "Need " & FORMAT(AdditionalBinsPerDay, "#,##0") & " more bins/day to finish on time",
			        "On pace to finish on time"
			    )
		lineageTag: 124196ae-d861-45a1-9e10-5da134f028d9

	measure 'Progress Status Card' = ```
			
			VAR WeeksElapsed = [Weeks Elapsed This Year]
			VAR WeeksLeft = 52 - WeeksElapsed
			VAR ExpectedPct = [Expected % Complete]
			VAR ActualBinsPct = [Actual % Complete - Bins]
			VAR ActualPartsPct = [Actual % Complete - Parts]
			VAR BinsVariance = [Variance vs Target - Bins]
			VAR PartsVariance = [Variance vs Target - Parts]
			VAR BinsStatus = [Status - Bins]
			VAR PartsStatus = [Status - Parts]
			
			// Determine status color
			VAR BinsColor = 
			    SWITCH(
			        TRUE(),
			        BinsVariance >= 0.05, "#27AE60",  // Green
			        BinsVariance >= 0, "#F39C12",     // Yellow
			        BinsVariance >= -0.05, "#E67E22", // Orange
			        "#E74C3C"                          // Red
			    )
			
			VAR PartsColor = 
			    SWITCH(
			        TRUE(),
			        PartsVariance >= 0.05, "#27AE60",
			        PartsVariance >= 0, "#F39C12",
			        PartsVariance >= -0.05, "#E67E22",
			        "#E74C3C"
			    )
			
			RETURN
			"<div style='background: linear-gradient(135deg, #2C3E50 0%, #34495E 100%); 
			            padding: 20px; 
			            border-radius: 10px; 
			            color: white; 
			            font-family: ""Segoe UI"", Arial, sans-serif;'>
			    
			    <div style='text-align: center; margin-bottom: 16px;'>
			        <div style='font-size: 18px; font-weight: 700; margin-bottom: 4px;'>
			            📊 Counting Progress vs Target
			        </div>
			        <div style='font-size: 12px; opacity: 0.8;'>
			            Week " & WeeksElapsed & " of 52 (" & WeeksLeft & " weeks remaining)
			        </div>
			    </div>
			    
			    <!-- BINS STATUS -->
			    <div style='background: rgba(255,255,255,0.1); 
			                padding: 14px; 
			                border-radius: 8px; 
			                margin-bottom: 12px;
			                border-left: 4px solid " & BinsColor & ";'>
			        <div style='display: flex; justify-content: space-between; align-items: center;'>
			            <div>
			                <div style='font-size: 14px; font-weight: 600; margin-bottom: 6px;'>
			                    📦 Bins Progress
			                </div>
			                <div style='font-size: 20px; font-weight: 700; color: " & BinsColor & ";'>
			                    " & BinsStatus & "
			                </div>
			            </div>
			            <div style='text-align: right;'>
			                <div style='font-size: 11px; opacity: 0.8; margin-bottom: 4px;'>Expected vs Actual</div>
			                <div style='font-size: 16px; font-weight: 600;'>
			                    " & FORMAT(ExpectedPct, "0.0%") & " vs " & FORMAT(ActualBinsPct, "0.0%") & "
			                </div>
			                <div style='font-size: 13px; margin-top: 4px; color: " & BinsColor & ";'>
			                    " & IF(BinsVariance >= 0, "↑ +" & FORMAT(BinsVariance, "0.0%") & " ahead", "↓ " & FORMAT(BinsVariance, "0.0%") & " behind") & "
			                </div>
			            </div>
			        </div>
			    </div>
			    
			    <!-- PARTS STATUS -->
			    <div style='background: rgba(255,255,255,0.1); 
			                padding: 14px; 
			                border-radius: 8px;
			                border-left: 4px solid " & PartsColor & ";'>
			        <div style='display: flex; justify-content: space-between; align-items: center;'>
			            <div>
			                <div style='font-size: 14px; font-weight: 600; margin-bottom: 6px;'>
			                    🔧 Parts Progress
			                </div>
			                <div style='font-size: 20px; font-weight: 700; color: " & PartsColor & ";'>
			                    " & PartsStatus & "
			                </div>
			            </div>
			            <div style='text-align: right;'>
			                <div style='font-size: 11px; opacity: 0.8; margin-bottom: 4px;'>Expected vs Actual</div>
			                <div style='font-size: 16px; font-weight: 600;'>
			                    " & FORMAT(ExpectedPct, "0.0%") & " vs " & FORMAT(ActualPartsPct, "0.0%") & "
			                </div>
			                <div style='font-size: 13px; margin-top: 4px; color: " & PartsColor & ";'>
			                    " & IF(PartsVariance >= 0, "↑ +" & FORMAT(PartsVariance, "0.0%") & " ahead", "↓ " & FORMAT(PartsVariance, "0.0%") & " behind") & "
			                </div>
			            </div>
			        </div>
			    </div>
			    
			</div>"
			```
