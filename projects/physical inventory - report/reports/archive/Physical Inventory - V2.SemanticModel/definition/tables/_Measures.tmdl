	measure 'Expected % Complete Alt' =
			
			VAR YearStart = DATE(YEAR(TODAY()), 1, 1)
			VAR YearEnd = DATE(YEAR(TODAY()), 12, 31)
			VAR DaysInYear = YearEnd - YearStart + 1
			VAR DaysElapsed = TODAY() - YearStart
			VAR ExpectedPct = DIVIDE(DaysElapsed, DaysInYear, 0)
			RETURN
			    ExpectedPct
