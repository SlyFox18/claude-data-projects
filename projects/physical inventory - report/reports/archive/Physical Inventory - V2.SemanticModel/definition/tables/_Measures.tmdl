			        animation: pulse-partsqty0 1.5s infinite;
			    }
			    @keyframes pulse-partsqty0 {
			        0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }
			        70% { box-shadow: 0 0 0 10px rgba(255,255,255,0); }
			        100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
			    }
			  </style>
			
			  <!-- HEADER with Status Badge (identical spacing to Bins card) -->
			  <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:12px'>
			    <div style='font-weight:600; letter-spacing:.5px; font-size:20px'>🎯 % Parts Counted (Qty &gt; 0)</div>
			    <div class='" & IF(_Variance < 0, "pulse-partsqty0", "") & "' style='
