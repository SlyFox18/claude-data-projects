			    <!-- Progress bar -->
			    <div style='position:relative; width:100%; height:16px; background: rgba(255,255,255,0.22); border-radius:10px'>
			      <div class='bar-fill'></div>
			      <div style='position:absolute; left:" & TargetLeftPct & "; top:-4px; height:24px; width:2px; background:#ffffff; opacity:.95'></div>
