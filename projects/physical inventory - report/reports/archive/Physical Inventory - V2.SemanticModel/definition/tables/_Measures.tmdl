			  <!-- CONTEXT INFO -->
			  <div style='font-size:16px; opacity:.9; margin-bottom:14px'>
			    " & FORMAT(PartsWithQtyCounted, "#,##0") & " of " & FORMAT(PartsWithQty, "#,##0") & " • 
			    <span style='background:rgba(255,255,255,0.2); padding:4px 10px; border-radius:6px; font-weight:600'>" & FORMAT(PartsRemaining, "#,##0") & " left</span>
			  </div>
			
			  <!-- EXPLANATION ROW (same format as Bins card) -->
			  <div style='font-size:14px; opacity:.85; margin-bottom:10px; line-height:1.4'>
			    Week " & WeeksElapsed & " target: <strong>" & ExpectedText & "</strong> • 
			    <span style='color:" & SeverityColor & "; font-weight:700'>" & VarianceText & " " & VarianceLabel & "</span>
			  </div>
			
			  <!-- PROGRESS BAR with Marker (same height & margin) -->
			  <div style='position:relative; width:100%; height:16px; background:rgba(255,255,255,0.2); border-radius:10px; margin-top:10px'>
			    <div class='progress-bar-partsqty0'></div>
			    <!-- Expected progress marker (white line) -->
			    <div style='position:absolute; left:" & ExpectedLeftPct & "; top:-4px; height:24px; width:2px; background:#ffffff; opacity:.95; box-shadow: 0 0 8px rgba(255,255,255,0.5)'></div>
			  </div>
			
			  <!-- SIMPLE LEGEND -->
			  <div style='display:flex; justify-content:space-between; font-size:14px; margin-top:8px; opacity:.8'>
			    <div>0%</div>
			    <div style='font-size:12px; margin-top:-2px'>↑ week " & WeeksElapsed & " target</div>
