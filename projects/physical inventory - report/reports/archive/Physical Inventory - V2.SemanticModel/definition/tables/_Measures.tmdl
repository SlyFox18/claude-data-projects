	measure 'PI – Bins Progress Bar (HTML)' = ```
			
			VAR BinsCounted = [Bins Counted]
			VAR TotalBins   = [Total Bins]
			VAR BinsLeft    = [Bins Left to Count]
			VAR Pct         = [% Bins Counted]              -- 0–1
			VAR Target      = [Target % Bins]               -- 0–1
			VAR OnTrack     = Pct >= Target
			VAR PctText     = FORMAT(Pct, "0.0%")
			VAR TargetText  = FORMAT(Target, "0.0%")
			VAR DeltaText   = FORMAT(Pct - Target, "+0.0%;-0.0%")
			VAR ProgressColor = IF(OnTrack, "#4ade80", "#fbbf24")
			VAR TrackColor    = "#e6edf3"
			VAR BarWidthPct   = FORMAT(100 * Pct, "0") & "%"
			VAR TargetLeftPct = FORMAT(100 * Target, "0") & "%"
			RETURN
			"
			<div style='font-family: Segoe UI, Arial; padding:18px; background:#0f2a3a; border-radius:12px; color:#fff; box-shadow:0 6px 20px rgba(0,0,0,.2)'>
			  <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:10px'>
			    <div style='font-weight:600; letter-spacing:.5px'>% Bins Counted</div>
			    <div style='font-size:12px; padding:4px 10px; border-radius:999px; background:" & ProgressColor & "; color:#0f172a; font-weight:700'>" & DeltaText & "</div>
			  </div>
			
			  <div style='position:relative; width:100%; height:22px; background:" & TrackColor & "; border-radius:12px; overflow:hidden'>
			    <div style='width:" & BarWidthPct & "; height:100%; background:" & ProgressColor & "; border-radius:12px'></div>
			    <div style='position:absolute; left:" & TargetLeftPct & "; top:-6px; height:34px; width:2px; background:#fff; opacity:.9'></div>
			  </div>
			
			  <div style='display:flex; justify-content:space-between; margin-top:10px; font-size:13px; opacity:.9'>
			    <div><strong style='font-size:18px; color:" & ProgressColor & "'>" & PctText & "</strong> • goal " & TargetText & "</div>
			    <div>" & FORMAT(BinsCounted, "#,##0") & " of " & FORMAT(TotalBins, "#,##0") & " • <span style='background:rgba(255,255,255,.2); padding:2px 8px; border-radius:6px; font-weight:600'>" & FORMAT(BinsLeft, "#,##0") & " left</span></div>
			  </div>
			</div>
			"
			
			```
		lineageTag: 1824b817-20ce-4436-b394-64dcbbb3383f

	measure 'PI – Bins Bullet (HTML)' = ```
			
			VAR BinsCounted = [Bins Counted]
			VAR TotalBins   = [Total Bins]
			VAR BinsLeft    = [Bins Left to Count]
			VAR Pct         = [% Bins Counted]
			VAR Target      = [Target % Bins]
			VAR OnTrack     = Pct >= Target
			VAR PctText     = FORMAT(Pct, "0.0%")
			VAR TargetText  = FORMAT(Target, "0.0%")
			VAR DeltaText   = FORMAT(Pct - Target, "+0.0%;-0.0%")
			-- Bands (tune as you like)
			VAR LowBand     = 0.70
			VAR MidBand     = 0.90
			VAR LowStop     = FORMAT(100 * LowBand, "0") & "%"
			VAR MidStop     = FORMAT(100 * MidBand, "0") & "%"
			VAR BarWidthPct = FORMAT(100 * Pct, "0") & "%"
			VAR TargetLeftPct = FORMAT(100 * Target, "0") & "%"
			RETURN
			"
			<div style='font-family: Segoe UI, Arial; padding:18px; background:#0f2a3a; border-radius:12px; color:#fff; box-shadow:0 6px 20px rgba(0,0,0,.2)'>
			  <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:10px'>
			    <div style='font-weight:600; letter-spacing:.5px'>% Bins Counted</div>
			    <div style='font-size:12px; padding:4px 10px; border-radius:999px; background:" & IF(OnTrack, "#4ade80", "#fbbf24") & "; color:#0f172a; font-weight:700'>" & DeltaText & "</div>
			  </div>
			
			  <div style='position:relative; width:100%; height:40px; border-radius:10px; overflow:hidden;
			              background: linear-gradient(to right,
			                #334155 0% " & LowStop & ",
			                #64748b " & LowStop & " " & MidStop & ",
			                #93c5fd " & MidStop & " 100%)'>
			    <div style='position:absolute; left:0; top:10px; height:20px; width:" & BarWidthPct & "; background:" & IF(OnTrack, "#4ade80", "#fbbf24") & "; border-radius:8px'></div>
			    <div style='position:absolute; left:" & TargetLeftPct & "; top:0; height:40px; width:2px; background:#ffffff; opacity:.95'></div>
			  </div>
			
			  <div style='display:flex; justify-content:space-between; margin-top:10px; font-size:13px; opacity:.9'>
			    <div><strong style='font-size:18px; color:" & IF(OnTrack, "#4ade80", "#fbbf24") & "'>" & PctText & "</strong> • goal " & TargetText & "</div>
			    <div>" & FORMAT(BinsCounted, "#,##0") & " of " & FORMAT(TotalBins, "#,##0") & " • <span style='background:rgba(255,255,255,.2); padding:2px 8px; border-radius:6px; font-weight:600'>" & FORMAT(BinsLeft, "#,##0") & " left</span></div>
			  </div>
			</div>
			"
			
			```
		lineageTag: 634eb6ed-ffcd-498f-ab83-7f220dddbf9c

	measure 'PI – Bins Circular Ring (HTML)' = ```
			
			VAR BinsCounted = [Bins Counted]
			VAR TotalBins   = [Total Bins]
			VAR BinsLeft    = [Bins Left to Count]
			VAR Pct         = [% Bins Counted]
			VAR Target      = [Target % Bins]
			VAR OnTrack     = Pct >= Target
			VAR PctText     = FORMAT(Pct, "0.0%")
			VAR TargetText  = FORMAT(Target, "0.0%")
			VAR DeltaText   = FORMAT(Pct - Target, "+0.0%;-0.0%")
			VAR R           = 70
			VAR C           = 2 * PI() * R
			VAR DashProgress = ROUND(Pct * C, 0)
			VAR DashRemaining = ROUND(C - DashProgress, 0)
			VAR TargetDeg   = FORMAT(Target * 360, "0")   -- degrees
			RETURN
			"
			<div style='font-family: Segoe UI, Arial; padding:18px; background:#0f2a3a; border-radius:12px; color:#fff; box-shadow:0 6px 20px rgba(0,0,0,.2); display:flex; align-items:center; gap:18px'>
			  <svg width='160' height='160' viewBox='0 0 160 160' style='flex:0 0 auto'>
			    <g transform='rotate(-90 80 80)'>
			      <!-- Track -->
			      <circle cx='80' cy='80' r='" & R & "' stroke='#e6edf3' stroke-width='14' fill='none' />
			      <!-- Progress -->
			      <circle cx='80' cy='80' r='" & R & "' stroke='" & IF(OnTrack, "#4ade80", "#fbbf24") & "' stroke-width='14' fill='none'
			              stroke-linecap='round' stroke-dasharray='" & DashProgress & " " & DashRemaining & "' />
			    </g>
			    <!-- Target tick -->
			    <line x1='80' y1='80' x2='80' y2='14' stroke='#ffffff' stroke-width='2' opacity='.95'
			          transform='rotate(" & TargetDeg & " 80 80)' />
			    <!-- Center label -->
			    <text x='80' y='86' text-anchor='middle' font-size='26' font-weight='700' fill='" & IF(OnTrack, "#4ade80", "#fbbf24") & "'>" & PctText & "</text>
			    <text x='80' y='110' text-anchor='middle' font-size='12' fill='#e6edf3'>goal " & TargetText & "</text>
			  </svg>
			
			  <div style='flex:1'>
			    <div style='font-weight:600; letter-spacing:.5px; margin-bottom:6px'>% Bins Counted</div>
			    <div style='font-size:12px; padding:4px 10px; border-radius:999px; background:" & IF(OnTrack, "#4ade80", "#fbbf24") & "; color:#0f172a; font-weight:700; display:inline-block'>" & DeltaText & "</div>
			    <div style='margin-top:10px; font-size:14px; opacity:.9'>" & FORMAT(BinsCounted, "#,##0") & " of " & FORMAT(TotalBins, "#,##0") & " • <span style='background:rgba(255,255,255,.2); padding:2px 8px; border-radius:6px; font-weight:600'>" & FORMAT(BinsLeft, "#,##0") & " left</span></div>
			  </div>
			</div>
			"
			
			```
		lineageTag: 96ba6327-2d44-4e23-9201-6fb8b111c74c

