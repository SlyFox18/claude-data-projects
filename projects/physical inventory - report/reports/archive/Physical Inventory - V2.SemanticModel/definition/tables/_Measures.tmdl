	measure 'Bins Counting Progress Enhanced' = ```
			
			VAR BinsCounted = [Bins Counted]
			VAR TotalBins = [Total Bins]
			VAR BinsLeft = [Bins Left to Count]
			VAR ActualPct = [% Bins Counted]
			VAR GoalPct = [Target % Bins]  -- 94.2%
			VAR ExpectedPct = [Expected % Complete]  -- 92.3% for week 48
			VAR PctText = FORMAT(ActualPct, "0.0%")
			VAR GoalText = FORMAT(GoalPct, "0.0%")
			VAR ExpectedText = FORMAT(ExpectedPct, "0.0%")
			
			-- Calculate both variances
			VAR VarianceFromGoal = ActualPct - GoalPct
			VAR VarianceFromExpected = ActualPct - ExpectedPct
			VAR GoalDeltaText = FORMAT(VarianceFromGoal, "+0.0%;-0.0%")
			VAR ExpectedDeltaText = FORMAT(VarianceFromExpected, "+0.0%;-0.0%")
			
			-- Status based on time-based expectation (more relevant for pacing)
			VAR OnPace = VarianceFromExpected >= 0
			VAR StatusIcon = IF(VarianceFromExpected >= 0, "✓", "⚠")
			
			-- Bar and marker positions
			VAR BarWidthPct = FORMAT(100 * ActualPct, "0") & "%"
			VAR GoalLeftPct = FORMAT(100 * GoalPct, "0") & "%"
			VAR ExpectedLeftPct = FORMAT(100 * ExpectedPct, "0") & "%"
			
			-- Color based on status
			VAR SeverityColor =
			    SWITCH(
			        TRUE(),
			        VarianceFromExpected >= 0.05, "#10b981",     -- ahead
			        VarianceFromExpected >= 0, "#14b8a6",        -- on track
			        VarianceFromExpected >= -0.05, "#f59e0b",    -- slightly behind
			        "#e11d48"                                     -- behind
			    )
			
			VAR GradientStart =
			    SWITCH(
			        TRUE(),
			        VarianceFromExpected >= 0.05, "#6ee7b7",
			        VarianceFromExpected >= 0, "#99f6e4",
			        VarianceFromExpected >= -0.05, "#fde68a",
			        "#fda4af"
			    )
			
			VAR BadgeGradient = "linear-gradient(135deg, " & GradientStart & " 0%, " & SeverityColor & " 100%)"
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 16px;
			    color: #fff;
			    padding: 28px;
			    width: 100%;
			    height: 100%;
			    display: flex;
			    flex-direction: column;
			'>
			  <style>
			    .progress-bar-bins-new {
			        width: 0%;
			        height: 100%;
			        background: linear-gradient(to right, " & GradientStart & ", " & SeverityColor & ");
			        border-radius:10px;
			        animation: grow-bins-new 1.5s ease-out forwards;
			    }
			    @keyframes grow-bins-new {
			        to { width:" & BarWidthPct & "; }
			    }
			    .pulse-bins-new {
			        animation: pulse-bins-new 1.5s infinite;
			    }
			    @keyframes pulse-bins-new {
			        0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }
			        70% { box-shadow: 0 0 0 10px rgba(255,255,255,0); }
			        100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
			    }
			  </style>
			
			  <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:12px'>
			    <div style='font-weight:600; letter-spacing:.5px; font-size:20px'>📦 Bins Counting Progress</div>
			    <div class='" & IF(VarianceFromExpected < 0, "pulse-bins-new", "") & "' style='
			        font-size:13px; 
			        padding:5px 12px; 
			        border-radius:12px; 
			        background:" & BadgeGradient & "; 
			        color:#1a1a1a; 
			        font-weight:700;
			        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
			    '>" & StatusIcon & " " & ExpectedDeltaText & "</div>
			  </div>
			
			  <div style='font-size:54px; font-weight:800; margin-top:6px; margin-bottom:8px; color:" & SeverityColor & "'>" & PctText & "</div>
			  
			  <div style='font-size:16px; opacity:.9; margin-bottom:16px'>
			    " & FORMAT(BinsCounted, "#,##0") & " of " & FORMAT(TotalBins, "#,##0") & " • 
			    <span style='background:rgba(255,255,255,.2); padding:4px 10px; border-radius:6px; font-weight:600'>" & FORMAT(BinsLeft, "#,##0") & " left</span>
			  </div>
			
			  <div style='position:relative; width:100%; height:16px; background:rgba(255,255,255,.2); border-radius:10px; margin-top:auto; margin-bottom:12px'>
			    <div class='progress-bar-bins-new'></div>
			    
			    <!-- Expected progress marker (white) -->
			    <div style='position:absolute; left:" & ExpectedLeftPct & "; top:-4px; height:24px; width:2px; background:#ffffff; opacity:.95; box-shadow: 0 0 8px rgba(255,255,255,0.5)'></div>
			    
			    <!-- Year-end goal marker (yellow) -->
			    <div style='position:absolute; left:" & GoalLeftPct & "; top:-4px; height:24px; width:2px; background:#fbbf24; opacity:.95; box-shadow: 0 0 8px rgba(251,191,36,0.5)'></div>
			  </div>
			
			  <div style='display:flex; justify-content:space-between; font-size:13px; opacity:.85'>
			    <div>0%</div>
			    <div style='text-align:center'>
			      <div style='color:#fbbf24; font-weight:600'>goal " & GoalText & "</div>
			      <div style='color:#ffffff; font-size:11px; margin-top:2px'>expected " & ExpectedText & "</div>
			    </div>
			    <div>100%</div>
			  </div>
			</div>
			"
			```
		lineageTag: 2a07bcf1-4894-4325-a4cd-8e911134742a

	measure 'Bins Counting Progress' = ```
			
			VAR BinsCounted = [Bins Counted]
			VAR TotalBins = [Total Bins]
			VAR BinsLeft = [Bins Left to Count]
			VAR ActualPct = [% Bins Counted]
			
			-- Time-based expectation (where you SHOULD be right now)
			VAR WeeksElapsed = [Weeks Elapsed This Year]
			VAR ExpectedPct = DIVIDE(WeeksElapsed, 52, 0)
			VAR ExpectedText = FORMAT(ExpectedPct, "0.0%")
			
			-- Calculate pace variance
			VAR VarianceFromPace = ActualPct - ExpectedPct
			VAR VarianceText = FORMAT(VarianceFromPace, "+0.0%;-0.0%")
			VAR VarianceLabel = IF(VarianceFromPace >= 0, "ahead of pace", "behind pace")
			
			VAR PaceStatus = 
			    SWITCH(
			        TRUE(),
			        VarianceFromPace >= 0.05, "Ahead",
			        VarianceFromPace >= 0, "On Pace",
			        VarianceFromPace >= -0.05, "Slightly Behind",
			        "Behind"
			    )
			
			VAR PaceIcon = 
			    SWITCH(
			        TRUE(),
			        VarianceFromPace >= 0.05, "🟢",
			        VarianceFromPace >= 0, "🟡",
			        VarianceFromPace >= -0.05, "🟠",
			        "🔴"
			    )
			
			-- Visual positioning
			VAR BarWidthPct = FORMAT(100 * ActualPct, "0") & "%"
			VAR ExpectedLeftPct = FORMAT(100 * ExpectedPct, "0") & "%"
			
			-- Color based on pace
			VAR SeverityColor =
			    SWITCH(
			        TRUE(),
			        VarianceFromPace >= 0.05, "#10b981",
			        VarianceFromPace >= 0, "#14b8a6",
			        VarianceFromPace >= -0.05, "#f59e0b",
			        "#e11d48"
			    )
			
			VAR GradientStart =
			    SWITCH(
			        TRUE(),
			        VarianceFromPace >= 0.05, "#6ee7b7",
			        VarianceFromPace >= 0, "#99f6e4",
			        VarianceFromPace >= -0.05, "#fde68a",
			        "#fda4af"
			    )
			
			VAR BadgeGradient = "linear-gradient(135deg, " & GradientStart & " 0%, " & SeverityColor & " 100%)"
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 16px;
			    color: #fff;
			    padding: 28px;
			    width: 100%;
			'>
			  <style>
			    .progress-bar-bins {
			        width: 0%;
			        height: 100%;
			        background: linear-gradient(to right, " & GradientStart & ", " & SeverityColor & ");
			        border-radius:10px;
			        animation: grow-bins 1.5s ease-out forwards;
			    }
			    @keyframes grow-bins {
			        to { width:" & BarWidthPct & "; }
			    }
			    .pulse-bins {
			        animation: pulse-bins 1.5s infinite;
			    }
			    @keyframes pulse-bins {
			        0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }
			        70% { box-shadow: 0 0 0 10px rgba(255,255,255,0); }
			        100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
			    }
			  </style>
			
			  <!-- HEADER with Status Badge -->
			  <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:12px'>
			    <div style='font-weight:600; letter-spacing:.5px; font-size:20px'>📦 % Bins Counted</div>
			    <div class='" & IF(VarianceFromPace < 0, "pulse-bins", "") & "' style='
			        font-size:13px; 
			        padding:5px 12px; 
			        border-radius:12px; 
			        background:" & BadgeGradient & "; 
			        color:#1a1a1a; 
			        font-weight:700;
			        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
			    '>" & PaceIcon & " " & PaceStatus & "</div>
			  </div>
			
			  <!-- MAIN PERCENTAGE -->
			  <div style='font-size:54px; font-weight:800; margin-top:6px; color:" & SeverityColor & "'>" & FORMAT(ActualPct, "0.0%") & "</div>
			  
			  <!-- CONTEXT INFO -->
			  <div style='font-size:16px; opacity:.9; margin-bottom:14px'>
			    " & FORMAT(BinsCounted, "#,##0") & " of " & FORMAT(TotalBins, "#,##0") & " • 
			    <span style='background:rgba(255,255,255,.2); padding:4px 10px; border-radius:6px; font-weight:600'>" & FORMAT(BinsLeft, "#,##0") & " left</span>
			  </div>
			
			  <!-- COMPACT EXPLANATION -->
			  <div style='font-size:14px; opacity:.85; margin-bottom:10px; line-height:1.4'>
			    Week " & WeeksElapsed & " target: <strong>" & ExpectedText & "</strong> • 
			    <span style='color:" & SeverityColor & "; font-weight:700'>" & VarianceText & " " & VarianceLabel & "</span>
			  </div>
			
			  <!-- PROGRESS BAR with Marker -->
			  <div style='position:relative; width:100%; height:16px; background:rgba(255,255,255,.2); border-radius:10px; margin-top:10px'>
			    <div class='progress-bar-bins'></div>
			    
			    <!-- Expected progress marker (white line) -->
			    <div style='position:absolute; left:" & ExpectedLeftPct & "; top:-4px; height:24px; width:2px; background:#ffffff; opacity:.95; box-shadow: 0 0 8px rgba(255,255,255,0.5)'></div>
			  </div>
			
			  <!-- SIMPLE LEGEND -->
			  <div style='display:flex; justify-content:space-between; font-size:14px; margin-top:8px; opacity:.8'>
			    <div>0%</div>
			    <div style='font-size:12px; margin-top:-2px'>↑ week " & WeeksElapsed & " target</div>
			    <div>100%</div>
			  </div>
			</div>
			"
			```
		lineageTag: 0e52b8d9-ae89-4c6f-a3e0-b0b4c03246dc

	measure 'Parts Counting Progress' = ```
			
			VAR PartsCounted = [Parts Counted]
			VAR TotalParts = [Total Parts]
			VAR PartsLeft = [Parts Left to Count]
			VAR ActualPct = [% Parts Counted]
			
			-- Time-based expectation
			VAR WeeksElapsed = [Weeks Elapsed This Year]
			VAR ExpectedPct = DIVIDE(WeeksElapsed, 52, 0)
			VAR ExpectedText = FORMAT(ExpectedPct, "0.0%")
			
			-- Calculate pace variance
			VAR VarianceFromPace = ActualPct - ExpectedPct
			VAR VarianceText = FORMAT(VarianceFromPace, "+0.0%;-0.0%")
			VAR VarianceLabel = IF(VarianceFromPace >= 0, "ahead of pace", "behind pace")
			
			VAR PaceStatus = 
			    SWITCH(
			        TRUE(),
			        VarianceFromPace >= 0.05, "Ahead",
			        VarianceFromPace >= 0, "On Pace",
			        VarianceFromPace >= -0.05, "Slightly Behind",
			        "Behind"
			    )
			
			VAR PaceIcon = 
			    SWITCH(
			        TRUE(),
			        VarianceFromPace >= 0.05, "🟢",
			        VarianceFromPace >= 0, "🟡",
			        VarianceFromPace >= -0.05, "🟠",
			        "🔴"
			    )
			
			-- Visual positioning
			VAR BarWidthPct = FORMAT(100 * ActualPct, "0") & "%"
			VAR ExpectedLeftPct = FORMAT(100 * ExpectedPct, "0") & "%"
			
			-- Color based on pace
			VAR SeverityColor =
			    SWITCH(
			        TRUE(),
			        VarianceFromPace >= 0.05, "#10b981",
			        VarianceFromPace >= 0, "#14b8a6",
			        VarianceFromPace >= -0.05, "#f59e0b",
			        "#e11d48"
			    )
			
			VAR GradientStart =
			    SWITCH(
			        TRUE(),
			        VarianceFromPace >= 0.05, "#6ee7b7",
			        VarianceFromPace >= 0, "#99f6e4",
			        VarianceFromPace >= -0.05, "#fde68a",
			        "#fda4af"
			    )
			
			VAR BadgeGradient = "linear-gradient(135deg, " & GradientStart & " 0%, " & SeverityColor & " 100%)"
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 16px;
			    color: #fff;
			    padding: 28px;
			    width: 100%;
			'>
			  <style>
			    .progress-bar-parts {
			        width: 0%;
			        height: 100%;
			        background: linear-gradient(to right, " & GradientStart & ", " & SeverityColor & ");
			        border-radius:10px;
			        animation: grow-parts 1.5s ease-out forwards;
			    }
			    @keyframes grow-parts {
			        to { width:" & BarWidthPct & "; }
			    }
			    .pulse-parts {
			        animation: pulse-parts 1.5s infinite;
			    }
			    @keyframes pulse-parts {
			        0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }
			        70% { box-shadow: 0 0 0 10px rgba(255,255,255,0); }
			        100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
			    }
			  </style>
			
			  <!-- HEADER with Status Badge -->
			  <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:12px'>
			    <div style='font-weight:600; letter-spacing:.5px; font-size:20px'>🔧 % Parts Counted</div>
			    <div class='" & IF(VarianceFromPace < 0, "pulse-parts", "") & "' style='
			        font-size:13px; 
			        padding:5px 12px; 
			        border-radius:12px; 
			        background:" & BadgeGradient & "; 
			        color:#1a1a1a; 
			        font-weight:700;
			        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
			    '>" & PaceIcon & " " & PaceStatus & "</div>
			  </div>
			
			  <!-- MAIN PERCENTAGE -->
			  <div style='font-size:54px; font-weight:800; margin-top:6px; color:" & SeverityColor & "'>" & FORMAT(ActualPct, "0.0%") & "</div>
			  
			  <!-- CONTEXT INFO -->
			  <div style='font-size:16px; opacity:.9; margin-bottom:14px'>
			    " & FORMAT(PartsCounted, "#,##0") & " of " & FORMAT(TotalParts, "#,##0") & " • 
			    <span style='background:rgba(255,255,255,.2); padding:4px 10px; border-radius:6px; font-weight:600'>" & FORMAT(PartsLeft, "#,##0") & " left</span>
			  </div>
			
			  <!-- COMPACT EXPLANATION -->
			  <div style='font-size:14px; opacity:.85; margin-bottom:10px; line-height:1.4'>
			    Week " & WeeksElapsed & " target: <strong>" & ExpectedText & "</strong> • 
			    <span style='color:" & SeverityColor & "; font-weight:700'>" & VarianceText & " " & VarianceLabel & "</span>
			  </div>
			
			  <!-- PROGRESS BAR with Marker -->
			  <div style='position:relative; width:100%; height:16px; background:rgba(255,255,255,.2); border-radius:10px; margin-top:10px'>
			    <div class='progress-bar-parts'></div>
			    
			    <!-- Expected progress marker (white line) -->
			    <div style='position:absolute; left:" & ExpectedLeftPct & "; top:-4px; height:24px; width:2px; background:#ffffff; opacity:.95; box-shadow: 0 0 8px rgba(255,255,255,0.5)'></div>
			  </div>
			
			  <!-- SIMPLE LEGEND -->
			  <div style='display:flex; justify-content:space-between; font-size:14px; margin-top:8px; opacity:.8'>
			    <div>0%</div>
			    <div style='font-size:12px; margin-top:-2px'>↑ week " & WeeksElapsed & " target</div>
			    <div>100%</div>
			  </div>
			</div>
			"
			```
		lineageTag: 7652d6da-7471-4bcf-bb40-3f4377933e15

