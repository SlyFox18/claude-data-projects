			        animation: pulse 1.5s ease-in-out infinite;
			      }
			      @keyframes pulse {
			        0%   { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }
			        70%  { box-shadow: 0 0 0 12px rgba(255,255,255,0); }
			        100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
			      }
			    </style>
			
			    <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:10px'>
			      <div style='font-weight:600; letter-spacing:.5px; font-size:20px'>% Bins Counted</div>
			      <div class='badge " & IF(Pct < Target, "pulse", "") & "'>" & DeltaText & "</div>
			    </div>
			
			    <div style='font-size:52px; font-weight:800; line-height:1; margin-top:4px; color:" & SeverityColor & "'>" & PctText & "</div>
			    <div style='font-size:15px; opacity:.9; margin-bottom:14px'>
			      " & FORMAT(BinsCounted, "#,##0") & " of " & FORMAT(TotalBins, "#,##0") & "
			      • <span style='background: rgba(255,255,255,0.28); padding: 4px 10px; border-radius: 8px; font-weight:600'>
			          " & FORMAT(BinsLeft, "#,##0") & " left
			        </span>
