	measure 'Bins KPI Tile Animated Gradient' = ```
			
			VAR BinsCounted   = [Bins Counted]
			VAR TotalBins     = [Total Bins]
			VAR BinsLeft      = [Bins Left to Count]
			VAR Pct           = [% Bins Counted]
			VAR Target        = [Target % Bins]
			VAR PctText       = FORMAT(Pct, "0.0%")
			VAR TargetText    = FORMAT(Target, "0.0%")
			VAR DeltaText     = FORMAT(Pct - Target, "+0.0%;-0.0%")
			VAR BarWidthPct   = FORMAT(100 * Pct, "0") & "%"
			VAR TargetLeftPct = FORMAT(100 * Target, "0") & "%"
			
			-- Status indicators (matching hero card)
			VAR OnTrack       = Pct >= Target
			VAR StatusIcon    = IF(OnTrack, "✓", "⚠")
			
			-- Expanded severity color scale
			VAR SeverityColor =
			    SWITCH(
			        TRUE(),
			        Pct >= Target, "#10b981",           // emerald
			        Pct >= Target * 0.95, "#14b8a6",    // teal
			        Pct >= Target * 0.90, "#0ea5e9",    // sky blue
			        Pct >= Target * 0.80, "#f59e0b",    // amber
			        "#e11d48"                           // rose
			    )
			
			-- Gradient start color (lighter tone)
			VAR GradientStart =
			    SWITCH(
			        TRUE(),
			        Pct >= Target, "#6ee7b7",           // light emerald
			        Pct >= Target * 0.95, "#99f6e4",    // light teal
			        Pct >= Target * 0.90, "#7dd3fc",    // light sky blue
			        Pct >= Target * 0.80, "#fde68a",    // light amber
			        "#fda4af"                           // light rose
			    )
			
			-- Badge gradient background (matching hero card style)
			VAR BadgeGradient = "linear-gradient(135deg, " & GradientStart & " 0%, " & SeverityColor & " 100%)"
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 16px;
			    color: #fff;
			    padding: 28px;
			    width: 100%;
			'>
			  <style>
			    .progress-bar {
			        width: 0%;
			        height: 100%;
			        background: linear-gradient(to right, " & GradientStart & ", " & SeverityColor & ");
			        border-radius:10px;
			        animation: grow 1.5s ease-out forwards;
			    }
			    @keyframes grow {
			        to { width:" & BarWidthPct & "; }
			    }
			    .pulse {
			        animation: pulse 1.5s infinite;
			    }
			    @keyframes pulse {
			        0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }
			        70% { box-shadow: 0 0 0 10px rgba(255,255,255,0); }
			        100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
			    }
			  </style>
			
			  <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:12px'>
			    <div style='font-weight:600; letter-spacing:.5px; font-size:20px'>📦 % Bins Counted</div>
			    <div class='" & IF(Pct < Target, "pulse", "") & "' style='
			        font-size:13px; 
			        padding:5px 12px; 
			        border-radius:12px; 
			        background:" & BadgeGradient & "; 
			        color:#1a1a1a; 
			        font-weight:700;
			        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
			    '>" & StatusIcon & " " & DeltaText & "</div>
			  </div>
			
			  <div style='font-size:54px; font-weight:800; margin-top:6px; color:" & SeverityColor & "'>" & PctText & "</div>
			  <div style='font-size:16px; opacity:.9; margin-bottom:14px'>" & FORMAT(BinsCounted, "#,##0") & " of " & FORMAT(TotalBins, "#,##0") & " • <span style='background:rgba(255,255,255,.2); padding:4px 10px; border-radius:6px; font-weight:600'>" & FORMAT(BinsLeft, "#,##0") & " left</span></div>
			
			  <div style='position:relative; width:100%; height:16px; background:rgba(255,255,255,.2); border-radius:10px; margin-top:10px'>
			    <div class='progress-bar'></div>
			    <div style='position:absolute; left:" & TargetLeftPct & "; top:-4px; height:24px; width:2px; background:#ffffff; opacity:.95'></div>
			  </div>
			
			  <div style='display:flex; justify-content:space-between; font-size:14px; margin-top:8px; opacity:.8'>
			    <div>0%</div>
			    <div>goal " & TargetText & "</div>
			    <div>100%</div>
			  </div>
			</div>
			"
			```
		lineageTag: 9e4d8fc9-bd26-4c8d-a37c-0defc5077f65

	measure 'PI – Bins KPI Glass (HTML)' =
			
			VAR BinsCounted   = [Bins Counted]
