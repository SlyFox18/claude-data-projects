			VAR _Variance              = CurrentPct - ExpectedPct
			
			VAR PartsWithQty           = [Total Parts with Qty]
			VAR PartsWithQtyCounted    = [Parts with Qty Counted]
			VAR PartsRemaining         = PartsWithQty - PartsWithQtyCounted
			
			-- For label consistency with the Bins card
			VAR WeeksElapsed   = [Weeks Elapsed This Year]               -- same weeks measure used in Bins card
			VAR ExpectedText   = FORMAT(ExpectedPct, "0.0%")
			VAR VarianceText   = FORMAT(_Variance, "+0.0%;-0.0%")
			VAR VarianceLabel  = IF(_Variance >= 0, "ahead of pace", "behind pace")
			
			-- Visual positioning (bar & marker)
			VAR BarWidthPct      = FORMAT(100 * CurrentPct, "0") & "%"
			VAR ExpectedLeftPct  = FORMAT(100 * ExpectedPct, "0") & "%"
			
			-- Severity color (match Bins card thresholds & palette)
			VAR SeverityColor =
			    SWITCH(
			        TRUE(),
