	measure 'PI – Bins Glass Ring (HTML)' = ```
			
			VAR BinsCounted   = [Bins Counted]
			VAR TotalBins     = [Total Bins]
			VAR BinsLeft      = [Bins Left to Count]
			VAR Pct           = [% Bins Counted]
			VAR Target        = [Target % Bins]
			VAR PctText       = FORMAT(Pct, "0.0%")
			VAR TargetText    = FORMAT(Target, "0.0%")
			VAR DeltaText     = FORMAT(Pct - Target, "+0.0%;-0.0%")
			VAR SeverityColor =
			    SWITCH(
			        TRUE(),
			        Pct >= Target,        "#4ade80",
			        Pct >= Target * 0.9,  "#f97316",
			        "#fb7185"
			    )
			VAR R             = 70
			VAR C             = 2 * PI() * R
			VAR DashProgress  = ROUND(Pct * C, 0)
			VAR DashRemain    = ROUND(C - DashProgress, 0)
			VAR TargetDeg     = FORMAT(Target * 360, "0")
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    padding: 24px;
			    border-radius: 18px;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    box-shadow: 0 12px 30px rgba(0,0,0,0.25);
			    width: 100%;
			'>
			  <div style='
			      background: rgba(255,255,255,0.14);
			      border: 1px solid rgba(255,255,255,0.35);
			      border-radius: 16px;
			      padding: 18px 22px;
			      color: #ffffff;
			      backdrop-filter: blur(8px);
			      -webkit-backdrop-filter: blur(8px);
			      box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 8px 20px rgba(0,0,0,0.25);
			      display:flex; align-items:center; gap:18px;
			  '>
			    <style>
			      .ring-progress {
			        stroke: " & SeverityColor & ";
			        stroke-width: 14;
			        stroke-linecap: round;
			        fill: none;
			        stroke-dasharray: 0 " & C & ";
			        animation: fill 1.2s ease-out forwards;
			      }
			      @keyframes fill {
			        to { stroke-dasharray: " & DashProgress & " " & DashRemain & "; }
			      }
			      .badge {
			        font-size: 14px; padding: 6px 14px; border-radius: 999px; font-weight: 700;
			        background: " & SeverityColor & "; color: #0f172a;
			      }
			      .badge.pulse { animation: pulse 1.5s ease-in-out infinite; }
			      @keyframes pulse {
			        0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }
			        70% { box-shadow: 0 0 0 12px rgba(255,255,255,0); }
			        100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
			      }
			    </style>
			
			    <svg width='160' height='160' viewBox='0 0 160 160' style='flex:0 0 auto'>
			      <g transform='rotate(-90 80 80)'>
			        <circle cx='80' cy='80' r='" & R & "' stroke='#e6edf3' stroke-width='14' fill='none' />
			        <circle class='ring-progress' cx='80' cy='80' r='" & R & "' />
			      </g>
			      <line x1='80' y1='80' x2='80' y2='14' stroke='#ffffff' stroke-width='2' opacity='.95'
			            transform='rotate(" & TargetDeg & " 80 80)' />
			      <text x='80' y='86' text-anchor='middle' font-size='26' font-weight='700' fill='" & SeverityColor & "'>" & PctText & "</text>
			      <text x='80' y='110' text-anchor='middle' font-size='12' fill='#e6edf3'>goal " & TargetText & "</text>
			    </svg>
			
			    <div style='flex:1'>
			      <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:8px'>
			        <div style='font-weight:600; letter-spacing:.5px; font-size:18px'>% Bins Counted</div>
			        <div class='badge " & IF(Pct < Target, "pulse", "") & "'>" & DeltaText & "</div>
			      </div>
			      <div style='font-size:14px; opacity:.9'>
			        " & FORMAT(BinsCounted, "#,##0") & " of " & FORMAT(TotalBins, "#,##0") & "
			        • <span style='background: rgba(255,255,255,0.28); padding: 4px 10px; border-radius: 8px; font-weight:600'>
			            " & FORMAT(BinsLeft, "#,##0") & " left
			          </span>
			      </div>
			    </div>
			  </div>
			</div>
			"
			
			```
		lineageTag: 87f59b6b-4954-4331-8db7-408e0d1a40c2

	measure 'Parts KPI Tile Animated Gradient' = ```
			
			VAR PartsCounted   = [Parts Counted]
			VAR TotalParts     = [Total Parts]
			VAR PartsLeft      = [Parts Left to Count]
			VAR Pct            = [% Parts Counted]            -- 0–1
			VAR Target         = [Target % Parts]             -- 0–1
			VAR PctText        = FORMAT(Pct, "0.0%")
			VAR TargetText     = FORMAT(Target, "0.0%")
			VAR DeltaText      = FORMAT(Pct - Target, "+0.0%;-0.0%")
			VAR BarWidthPct    = FORMAT(100 * Pct, "0") & "%"
			VAR TargetLeftPct  = FORMAT(100 * Target, "0") & "%"
			
			-- Status indicators (matching hero card)
			VAR OnTrack        = Pct >= Target
			VAR StatusIcon     = IF(OnTrack, "✓", "⚠")
			
			-- Expanded severity color scale (same as Bins)
			VAR SeverityColor =
			    SWITCH(
			        TRUE(),
			        Pct >= Target, "#10b981",           -- emerald
			        Pct >= Target * 0.95, "#14b8a6",    -- teal
			        Pct >= Target * 0.90, "#0ea5e9",    -- sky blue
			        Pct >= Target * 0.80, "#f59e0b",    -- amber
			        "#e11d48"                           -- rose
			    )
			
			-- Gradient start color (lighter tone)
			VAR GradientStart =
			    SWITCH(
			        TRUE(),
			        Pct >= Target, "#6ee7b7",           -- light emerald
			        Pct >= Target * 0.95, "#99f6e4",    -- light teal
			        Pct >= Target * 0.90, "#7dd3fc",    -- light sky blue
			        Pct >= Target * 0.80, "#fde68a",    -- light amber
			        "#fda4af"                           -- light rose
			    )
			
			-- Badge gradient background (matching hero card style)
			VAR BadgeGradient = "linear-gradient(135deg, " & GradientStart & " 0%, " & SeverityColor & " 100%)"
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 16px;
			    color: #fff;
			    padding: 28px;
			    width: 100%;
			'>
			  <style>
			    .progress-bar {
			        width: 0%;
			        height: 100%;
			        background: linear-gradient(to right, " & GradientStart & ", " & SeverityColor & ");
			        border-radius:10px;
			        animation: grow 1.5s ease-out forwards;
			    }
			    @keyframes grow { to { width:" & BarWidthPct & "; } }
			    .pulse { animation: pulse 1.5s infinite; }
			    @keyframes pulse {
			        0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }
			        70% { box-shadow: 0 0 0 10px rgba(255,255,255,0); }
			        100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
			    }
			  </style>
			
			  <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:12px'>
			    <div style='font-weight:600; letter-spacing:.5px; font-size:20px'>🔧 % Parts Counted</div>
			    <div class='" & IF(Pct < Target, "pulse", "") & "' style='
			        font-size:13px; 
			        padding:5px 12px; 
			        border-radius:12px; 
			        background:" & BadgeGradient & "; 
			        color:#1a1a1a; 
			        font-weight:700;
			        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
			    '>" & StatusIcon & " " & DeltaText & "</div>
			  </div>
			
			  <div style='font-size:54px; font-weight:800; margin-top:6px; color:" & SeverityColor & "'>" & PctText & "</div>
			  <div style='font-size:16px; opacity:.9; margin-bottom:14px'>
			    " & FORMAT(PartsCounted, "#,##0") & " of " & FORMAT(TotalParts, "#,##0") & "
			    • <span style='background:rgba(255,255,255,.2); padding:4px 10px; border-radius:6px; font-weight:600'>" & FORMAT(PartsLeft, "#,##0") & " left</span>
			  </div>
			
			  <div style='position:relative; width:100%; height:16px; background:rgba(255,255,255,.2); border-radius:10px; margin-top:10px'>
			    <div class='progress-bar'></div>
			    <div style='position:absolute; left:" & TargetLeftPct & "; top:-4px; height:24px; width:2px; background:#ffffff; opacity:.95'></div>
			  </div>
			
			  <div style='display:flex; justify-content:space-between; font-size:14px; margin-top:8px; opacity:.8'>
			    <div>0%</div>
			    <div>goal " & TargetText & "</div>
			    <div>100%</div>
			  </div>
			</div>
			"
			```
		lineageTag: 5011f113-626e-4bdd-9380-cda38c7c2e79

	measure 'Bin Qty Counted Pace Card' = ```
			
			VAR CurrentPct          = [% Bin Qty Counted (Qty)]        -- 0–1, quantity-based
			VAR ExpectedPct         = [Expected % Complete]            -- 0–1, time-based target
			VAR _Variance           = CurrentPct - ExpectedPct
			
			-- QUANTITY-BASED context values (replace row-based ones)
			VAR QtyTotal            = [Total Bin Qty (All Dates)]
			VAR QtyCounted          = [Bin Qty Counted (This Year)]
			VAR QtyLeft             = [Bin Qty Left (Qty)]
			
			-- For label consistency with the Bins card
			VAR WeeksElapsed        = [Weeks Elapsed This Year]
			VAR ExpectedText        = FORMAT(ExpectedPct, "0.0%")
			VAR VarianceText        = FORMAT(_Variance, "+0.0%;-0.0%")
			VAR VarianceLabel       = IF(_Variance >= 0, "ahead of pace", "behind pace")
			
			-- Row visuals (positions)
			VAR BarWidthPct         = FORMAT(100 * CurrentPct, "0") & "%"
			VAR ExpectedLeftPct     = FORMAT(100 * ExpectedPct, "0") & "%"
			
			-- Severity color (match Bins card thresholds & palette)
			VAR SeverityColor =
			    SWITCH(
			        TRUE(),
			        _Variance >= 0.05, "#10b981",  -- emerald
			        _Variance >= 0,    "#14b8a6",  -- teal
			        _Variance >= -0.05,"#f59e0b",  -- amber
			        "#e11d48"                      -- rose
			    )
			
			VAR GradientStart =
			    SWITCH(
			        TRUE(),
			        _Variance >= 0.05, "#6ee7b7",
			        _Variance >= 0,    "#99f6e4",
			        _Variance >= -0.05,"#fde68a",
			        "#fda4af"
			    )
			
			VAR PaceStatus =
			    SWITCH(
			        TRUE(),
			        _Variance >= 0.05, "Ahead",
			        _Variance >= 0,    "On Pace",
			        _Variance >= -0.05,"Slightly Behind",
			        "Behind"
			    )
			
			VAR PaceIcon =
			    SWITCH(
			        TRUE(),
			        _Variance >= 0.05, "🟢",
			        _Variance >= 0,    "🟡",
			        _Variance >= -0.05,"🟠",
			        "🔴"
			    )
			
			VAR BadgeGradient = "linear-gradient(135deg, " & GradientStart & " 0%, " & SeverityColor & " 100%)"
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial;
			    background: linear-gradient(135deg, #1D3C4E 0%, #2E5266 50%, #3A7CA5 100%);
			    border-radius: 16px;
			    color: #fff;
			    padding: 28px;         /* SAME as Bins Counting Progress */
			    width: 100%;
			'>
			  <style>
			    .progress-bar-binqty {
			        width: 0%;
			        height: 100%;
			        background: linear-gradient(to right, " & GradientStart & ", " & SeverityColor & ");
			        border-radius:10px;
			        animation: grow-binqty 1.5s ease-out forwards;
			    }
			    @keyframes grow-binqty {
			        to { width:" & BarWidthPct & "; }
			    }
			    .pulse-binqty {
			        animation: pulse-binqty 1.5s infinite;
			    }
			    @keyframes pulse-binqty {
			        0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }
			        70% { box-shadow: 0 0 0 10px rgba(255,255,255,0); }
			        100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
			    }
			  </style>
			
			  <!-- HEADER with Status Badge -->
			  <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:12px'>
			    <div style='font-weight:600; letter-spacing:.5px; font-size:20px'>📊 % Bin Qty Counted</div>
			    <div class='" & IF(_Variance < 0, "pulse-binqty", "") & "' style='
			        font-size:13px; 
			        padding:5px 12px; 
			        border-radius:12px; 
			        background:" & BadgeGradient & "; 
			        color:#1a1a1a; 
			        font-weight:700;
			        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
			    '>" & PaceIcon & " " & PaceStatus & "</div>
			  </div>
			
			  <!-- MAIN PERCENTAGE -->
			  <div style='font-size:54px; font-weight:800; margin-top:6px; color:" & SeverityColor & "'>" & FORMAT(CurrentPct, "0.0%") & "</div>
			  
			  <!-- CONTEXT INFO (QUANTITY-BASED) -->
			  <div style='font-size:16px; opacity:.9; margin-bottom:14px'>
			    " & FORMAT(QtyCounted, "#,##0") & " of " & FORMAT(QtyTotal, "#,##0") & " • 
			    <span style='background:rgba(255,255,255,.2); padding:4px 10px; border-radius:6px; font-weight:600'>" & FORMAT(QtyLeft, "#,##0") & " left</span>
			  </div>
			
			  <!-- EXPLANATION ROW -->
			  <div style='font-size:14px; opacity:.85; margin-bottom:10px; line-height:1.4'>
			    Week " & WeeksElapsed & " target: <strong>" & ExpectedText & "</strong> • 
			    <span style='color:" & SeverityColor & "; font-weight:700'>" & VarianceText & " " & VarianceLabel & "</span>
			  </div>
			
			  <!-- PROGRESS BAR with Marker -->
			  <div style='position:relative; width:100%; height:16px; background:rgba(255,255,255,.2); border-radius:10px; margin-top:10px'>
			    <div class='progress-bar-binqty'></div>
			    <div style='position:absolute; left:" & ExpectedLeftPct & "; top:-4px; height:24px; width:2px; background:#ffffff; opacity:.95; box-shadow: 0 0 8px rgba(255,255,255,0.5)'></div>
			  </div>
			
			  <!-- SIMPLE LEGEND -->
			  <div style='display:flex; justify-content:space-between; font-size:14px; margin-top:8px; opacity:.8'>
			    <div>0%</div>
			    <div style='font-size:12px; margin-top:-2px'>↑ week " & WeeksElapsed & " target</div>
			    <div>100%</div>
			  </div>
			</div>
			"
			
			```
		lineageTag: 4213c1b2-9a60-49e1-a924-85cd6920ce54

	measure 'Parts Counted Qty Pace Card' = ```
			
			VAR CurrentPct             = [% Parts Counted with Qty]      -- 0–1
